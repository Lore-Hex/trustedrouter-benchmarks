Sending keys: ['cat > /app/extract_final.py << \'PYEOF\'\nimport os, re, glob\n\n# Get all OCR files sorted by timestamp embedded in filename\nocr_files = sorted(glob.glob(\'/app/ocr_kf/*.txt\'), key=lambda x: float(re.search(r\'(\\d+\\.\\d+)\\.txt\', x).group(1)))\n\ndef read_lines(fpath):\n    with open(fpath, \'r\', errors=\'replace\') as f:\n        return [l.rstrip(\'\\n\') for l in f.readlines()]\n\n# Print all \'>\' lines from all frames\nprint("=== All \'>\' lines per keyframe ===")\nfor fpath in ocr_files:\n    fname = os.path.basename(fpath)\n    lines = read_lines(fpath)\n    gt_lines = [l.strip() for l in lines if l.strip().startswith(\'>\')]\n    for l in gt_lines:\n        cmd = l[1:].strip()\n        if cmd and len(cmd) < 80:\n            print(f"{fname}: >{cmd}")\n\nprint()\n\n# Diff approach: find new lines in each frame vs previous\nprint("=== New command lines per keyframe diff ===")\nprev_lines = []\nprev_set = set()\nfor fpath in ocr_files:\n    fname = os.path.basename(fpath)\n    lines = read_lines(fpath)\n    curr_set = set(lines)\n    new_lines = [l for l in lines if l not in prev_set]\n    for l in new_lines:\n        ls = l.strip()\n        if ls.startswith(\'>\'):\n            cmd = ls[1:].strip()\n            if cmd and len(cmd) < 80:\n                print(f"{fname}: >{cmd}")\n    prev_lines = lines\n    prev_set = curr_set\nPYEOF\npython3 /app/extract_final.py > /app/moves_final.txt 2>&1; cat /app/moves_final.txt\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
