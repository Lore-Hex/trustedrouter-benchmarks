Sending keys: ['cat > /app/extract_smart.py << \'PYEOF\'\nimport os, re, glob\n\nocr_files = sorted(glob.glob(\'/app/ocr_kf/*.txt\'), key=lambda x: float(re.search(r\'(\\d+\\.\\d+)\\.txt\', x).group(1)))\n\ndef read_text(fpath):\n    with open(fpath, \'r\', errors=\'replace\') as f:\n        return f.read()\n\ndef get_gt_commands(text):\n    lines = text.splitlines()\n    cmds = []\n    for l in lines:\n        ls = l.strip()\n        if ls.startswith(\'>\'):\n            cmd = ls[1:].strip()\n            if cmd and len(cmd) < 80:\n                cmds.append(cmd)\n    return cmds\n\n# For each keyframe, get the last \'>\' command\ncmds_per_frame = []\nfor fpath in ocr_files:\n    fname = os.path.basename(fpath)\n    text = read_text(fpath)\n    cmds = get_gt_commands(text)\n    last_cmd = cmds[-1] if cmds else \'\'\n    cmds_per_frame.append((fname, last_cmd, text))\n\n# Now group: when the last command changes or the game responds (text changes significantly),\n# we have a new move. Keep the longest version of each command before it changes.\nmoves = []\ncurrent_cmd = \'\'\ncurrent_cmd_max = \'\'\n\nfor i, (fname, cmd, text) in enumerate(cmds_per_frame):\n    if cmd != current_cmd:\n        # Command changed - save the previous command\'s longest version\n        if current_cmd_max and current_cmd_max != \'\':\n            moves.append(current_cmd_max)\n        current_cmd = cmd\n        current_cmd_max = cmd\n    else:\n        if len(cmd) > len(current_cmd_max):\n            current_cmd_max = cmd\n\n# Don\'t forget the last one\nif current_cmd_max:\n    moves.append(current_cmd_max)\n\nprint(f"Total moves extracted: {len(moves)}")\nfor i, m in enumerate(moves, 1):\n    print(f"{i}: {m}")\nPYEOF\npython3 /app/extract_smart.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
