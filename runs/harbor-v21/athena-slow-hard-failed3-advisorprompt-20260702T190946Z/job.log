Sending keys: ['cat > /app/extract_movecount.py << \'PYEOF\'\nimport os, re, glob\n\nocr_files = sorted(glob.glob(\'/app/ocr_kf/*.txt\'), key=lambda x: float(re.search(r\'(\\d+\\.\\d+)\\.txt\', x).group(1)))\n\nfor fpath in ocr_files:\n    fname = os.path.basename(fpath)\n    with open(fpath, \'r\', errors=\'replace\') as f:\n        text = f.read()\n    # Look for Moves: N in the text\n    m = re.search(r\'Moves:\\s*(\\d+)\', text)\n    moves = m.group(1) if m else \'?\'\n    # Get last > command\n    cmds = [l.strip()[1:].strip() for l in text.splitlines() if l.strip().startswith(\'>\') and len(l.strip()) > 1]\n    last_cmd = cmds[-1] if cmds else \'\'\n    print(f"{fname}\\tMoves: {moves}\\tCmd: {last_cmd}")\nPYEOF\npython3 /app/extract_movecount.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
