Sending keys: ['cat > /app/extract_moves.py << \'PYEOF\'\nimport os, re, glob\nfrom difflib import unified_diff\n\nocr_files = sorted(glob.glob(\'/app/ocr/frame_*.txt\'))\nprev_lines = []\nmoves = []\nseen = set()\n\nfor fpath in ocr_files:\n    with open(fpath, \'r\', errors=\'replace\') as f:\n        lines = [l.rstrip(\'\\n\') for l in f.readlines()]\n    # Find lines that are new compared to previous frame\n    prev_set = set(prev_lines)\n    new_lines = [l for l in lines if l not in prev_set]\n    for l in new_lines:\n        l_stripped = l.strip()\n        # Player input often appears after \'>\' prompt\n        # It could be on a line starting with \'>\' or on a line by itself after a \'>\' line\n        if l_stripped.startswith(\'>\'):\n            cmd = l_stripped[1:].strip()\n            if cmd:\n                moves.append((os.path.basename(fpath), cmd))\n        # Also check for lines that look like commands (short, lowercase, no period at end typically)\n    prev_lines = lines\n\n# Also look for lines that appear right after a \'>\' line\nfor idx, fpath in enumerate(ocr_files):\n    with open(fpath, \'r\', errors=\'replace\') as f:\n        lines = [l.rstrip(\'\\n\') for l in f.readlines()]\n    for i, l in enumerate(lines):\n        l_stripped = l.strip()\n        if l_stripped == \'>\' and i+1 < len(lines):\n            next_line = lines[i+1].strip()\n            if next_line and not next_line.startswith(\'>\') and len(next_line) < 50:\n                # Check if this looks like a command (not game text)\n                if re.match(r\'^[a-z]\', next_line) and not next_line.endswith(\'.\') and not next_line.endswith(\',\') and not \'you\' in next_line.lower()[:10]:\n                    pass  # We\'ll handle this differently\n\nprint("=== Moves found from \'>\' lines ===")\nfor fname, cmd in moves:\n    print(f"{fname}: {cmd}")\n\nprint(f"\\nTotal moves from \'>\' lines: {len(moves)}")\nPYEOF\npython3 /app/extract_moves.py\n'] min_timeout_sec: 1.0 max