[?2004l[?2004h>     new_lines = [l for l in curr_lines if l not in prev_set]
[?2004l[?2004h>     
[?2004l[?2004h>     for l in new_lines:
[?2004l[?2004h>         ls = l.strip()
[?2004l[?2004h>         # Command on same line as prompt: >cmd
[?2004l[?2004h>         if ls.startswith('>'):
[?2004l[?2004h>             cmd = ls[1:].strip()
[?2004l[?2004h>             if cmd and len(cmd) < 60:
[?2004l[?2004h>                 moves.append((i+1, cmd))
[?2004l[?2004h>         # Command on its own line after > prompt (already captured above in some frames)
[?2004l[?2004h>     prev = curr
[?2004l[?2004h> 
[?2004l[?2004h> # Deduplicate consecutive identical moves but keep order
[?2004l[?2004h> # Print all with frame numbers
[?2004l[?2004h> print("=== Raw moves (frame, command) ===")
[?2004l[?2004h> for frame, cmd in moves:
[?2004l[?2004h>     print(f"{frame}: {cmd}")
[?2004l[?2004h> print(f"\nTotal raw: {len(moves)}")
