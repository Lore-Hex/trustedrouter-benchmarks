[?2004l[?2004h> import os, re, glob
[?2004l[?2004h> 
[?2004l[?2004h> ocr_files = sorted(glob.glob('/app/ocr_kf/*.txt'), key=lambda x: float(re.search(r'(\d+\.\d+)\.txt', x).group(1)))
[?2004l[?2004h> 
[?2004l[?2004h> for fpath in ocr_files:
[?2004l[?2004h>     fname = os.path.basename(fpath)
[?2004l[?2004h>     with open(fpath, 'r', errors='replace') as f:
[?2004l[?2004h>         text = f.read()
[?2004l[?2004h>     # Look for Moves: N in the text
[?2004l[?2004h>     m = re.search(r'Moves:\s*(\d+)', text)
[?2004l[?2004h>     moves = m.group(1) if m else '?'
[?2004l[?2004h>     # Get last > command
[?2004l[?2004h>     cmds = [l.strip()[1:].strip() for l in text.splitlines() if l.strip().startswith('>') and len(l.strip()) > 1]
[?2004l[?2004h>     last_cmd = cmds[-1] if cmds else ''
[?2004l[?2004h>     print(f"{fname}\tMoves: {moves}\tCmd: {last_cmd}")
[?2004l[?2004h> PYEOF
