[?2004l[?2004h>             cmd = ls[1:].strip()
[?2004l[?2004h>             if cmd and len(cmd) < 60 and not any(kw in cmd.lower() for kw in ['copyright', 'trademark']):
[?2004l[?2004h>                 print(f"{i+1}: {cmd}")
