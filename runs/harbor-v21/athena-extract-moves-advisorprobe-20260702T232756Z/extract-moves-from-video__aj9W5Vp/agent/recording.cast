[374.912498, "o", "\u001b[32m\u001b[K20\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_002.png ===\r\n\u001b[32m\u001b[K39\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_003.png ===\r\n\u001b[32m\u001b[K71\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_004.png ===\r\n\u001b[32m\u001b[K111\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_005.png ===\r\n\u001b[32m\u001b[K149\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_006.png ===\r\n\u001b[32m\u001b[K185\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_007.png ===\r\n\u001b[32m\u001b[K220\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_008.png ===\r\n\u001b[32m\u001b[K242\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_009.png ===\r\n\u001b[32m\u001b[K280\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_010.png ===\r\n\u001b[32m\u001b[K314\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_011.png ===\r\n\u001b[32m\u001b[K351\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_012.png ===\r\n\u001b[32m\u001b[K388\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_013.png ===\r\n\u001b[32m\u001b[K422\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_014.png ===\r\n\u001b[32m\u001b[K444\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_015.png ===\r\n\u001b[32m\u001b[K479\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_016.png ===\r\n\u001b[32m\u001b[K501\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_017.png ===\r\n\u001b[32m\u001b[K536\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_018.png ===\r\n\u001b[32m\u001b[K559\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_019.png ===\r\n\u001b[32m\u001b[K581\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_020.png ===\r\n\u001b[32m\u001b[K619\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_021.png ===\r\n\u001b[32m\u001b[K656\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_022.png ===\r\n\u001b[32m\u001b[K692\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_023.png ===\r\n\u001b[32m\u001b[K714\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_024.png ===\r\n\u001b[32m\u001b[K749\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_025.png ===\r\n\u001b[32m\u001b[K785\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_026.png ===\r\n\u001b[32m\u001b[K821\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_027.png ===\r\n\u001b[32m\u001b[K840\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_028.png ===\r\n\u001b[32m\u001b[K863\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_029.png ===\r\n\u001b[32m\u001b[K897\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_030.png ===\r\n\u001b[32m\u001b[K936\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_031.png ===\r\n\u001b[32m\u001b[K971\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_032.png ===\r\n\u001b[32m\u001b[K1006\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_033.png ===\r\n\u001b[32m\u001b[K1040\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_034.png ===\r\n\u001b[32m\u001b[K1076\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_035.png ===\r\n\u001b[32m\u001b[K1098\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_036.png ===\r\n\u001b[32m\u001b[K1136\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_037.png ===\r\n\u001b[32m\u001b[K1158\u001b[m\u001b[K\u001b[36m\u001b[K:\u001b[m\u001b[K\u001b[01;31m\u001b[K=== \u001b[m\u001b[Ksample_038.png ===\r\n"]
