[1596.913213, "i", "python3 - <<'PY'\nimport re\nlines=open('/app/prompt_ocr6.txt').read().splitlines()\nents=[]\nfor i,l in enumerate(lines,1):\n    m=re.match(r'(\\d+)\\s+(.*)', l)\n    if not m: continue\n    fr=int(m.group(1)); txt=m.group(2).strip()\n    ents.append((fr,txt))\ndef clean(t):\n    t=t.replace('_','').strip()\n    if t.startswith('>'): t=t[1:].strip()\n    return t.strip()\ndef has_letter(t):\n    return bool(re.search(r'[A-Za-z]', t))\ngroups=[]; cur=[]; lastfr=None\nfor fr,txt in ents:\n    c=clean(txt)\n    if txt.startswith('>') and has_letter(c):\n        if cur and lastfr is not None and fr-lastfr>6:\n            groups.append(cur); cur=[]\n        cur.append((fr,txt,c)); lastfr=fr\n    else:\n        if cur: groups.append(cur); cur=[]\n        lastfr=fr\nif cur: groups.append(cur)\nfor idx,g in enumerate(groups,1):\n    longest=max(g,key=lambda x:len(x[2]))\n    print(f'{idx:03d} {g[0][0]:04d}-{g[-1][0]:04d} {longest[2]}')\nPY\n"]
[1596.915229, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> lines=open('/app/prompt_ocr6.txt').read().splitlines()\r\n\u001b[?2004l\r\u001b[?2004h> ents=[]\r\n\u001b[?2004l\r\u001b[?2004h> for i,l in enumerate(lines,1):\r\n\u001b[?2004l\r\u001b[?2004h>     m=re.match(r'(\\d+)\\s+(.*)', l)\r\n\u001b[?2004l\r\u001b[?2004h>     if not m: continue\r\n\u001b[?2004l\r\u001b[?2004h>     fr=int(m.group(1)); txt=m.group(2).strip()\r\n\u001b[?2004l\r\u001b[?2004h>     ents.append((fr,txt))\r\n\u001b[?2004l\r\u001b[?2004h> def clean(t):\r\n\u001b[?2004l\r\u001b[?2004h>     t=t.replace('_','').strip()\r\n\u001b[?2004l\r\u001b[?2004h>     if t.startswith('>'): t=t[1:].strip()\r\n\u001b[?2004l\r\u001b[?2004h>     return t.strip()\r\n\u001b[?2004l\r\u001b[?2004h> def has_letter(t):\r\n\u001b[?2004l\r\u001b[?2004h>     return bool(re.search(r'[A-Za-z]', t))\r\n\u001b[?2004l\r\u001b[?2004h> groups=[]; cur=[]; lastfr=None\r\n\u001b[?2004l\r\u001b[?2004h> for fr,txt in ents:\r\n\u001b[?2004l\r\u001b[?2004h>     c=clean(txt)\r\n\u001b[?2004l\r\u001b[?2004h>     if txt.startswith('>') and has_letter(c):\r\n\u001b[?2004l\r\u001b[?2004h>         if cur and lastfr is not None and fr-lastfr>6:\r\n\u001b[?2004l\r\u001b[?2004h>             groups.append(cur); cur=[]\r\n\u001b[?2004l\r\u001b[?2004h>         cur.append((fr,txt,c)); lastfr=fr\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         if cur: groups.append(cur); cur=[]\r\n\u001b[?2004l\r\u001b[?2004h>         lastfr=fr\r\n\u001b[?2004l\r\u001b[?2004h> if cur: groups.append(cur)\r\n\u001b[?2004l\r\u001b[?2004h> for idx,g in enumerate(groups,1):\r\n\u001b[?2004l\r\u001b[?2004h>     longest=max(g,key=lambda x:len(x[2]))\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'{idx:03d} {g[0][0]:04d}-{g[-1][0]:04d} {longest[2]}')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
