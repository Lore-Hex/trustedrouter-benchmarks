[1147.17329, "i", "python3 - <<'PY'\nimport re\nlines=open('/app/prompt_ocr.txt').read().splitlines()\nents=[]\nfor i,l in enumerate(lines,1):\n    m=re.match(r'(\\d+)\\s+(.*)', l)\n    if not m:\n        continue\n    fr=int(m.group(1)); txt=m.group(2).strip()\n    ents.append((fr,txt))\ndef clean(t):\n    t=t.replace('_','').strip()\n    if t.startswith('>'):\n        t=t[1:].strip()\n    return t.strip()\ngroups=[]\ncur=[]\nfor fr,txt in ents:\n    if txt.startswith('>') and re.search(r'[A-Za-z]', txt):\n        cur.append((fr,txt,clean(txt)))\n    else:\n        if cur:\n            groups.append(cur); cur=[]\nif cur: groups.append(cur)\nprint('groups',len(groups))\nfor g in groups:\n    frs=[x[0] for x in g]\n    # pick longest cleaned text as candidate\n    longest=max(g,key=lambda x:len(x[2]))\n    print(f'[{frs[0]:04d}-{frs[-1]:04d}] candidate={longest[2]!r}')\n    print('   ',' | '.join(f'{fr}:{c!r}' for fr,raw,c in g))\nPY\n"]
[1147.174072, "o", "python3 - <<'PY'\r\n"]
