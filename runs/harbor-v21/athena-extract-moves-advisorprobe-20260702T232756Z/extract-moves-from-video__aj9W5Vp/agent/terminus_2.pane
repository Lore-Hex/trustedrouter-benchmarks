[?2004hroot@6d7a26636c3b:/app# python3 - <<'PY'
[?2004l[?2004h> import re
[?2004l[?2004h> lines=open('/app/prompt_ocr.txt').read().splitlines()
[?2004l[?2004h> ents=[]
[?2004l[?2004h> for i,l in enumerate(lines,1):
[?2004l[?2004h>     m=re.match(r'(\d+)\s+(.*)', l)
[?2004l[?2004h>     if not m:
[?2004l[?2004h>         continue
[?2004l[?2004h>     fr=int(m.group(1)); txt=m.group(2).strip()
[?2004l[?2004h>     ents.append((fr,txt))
[?2004l[?2004h> def clean(t):
[?2004l[?2004h>     t=t.replace('_','').strip()
[?2004l[?2004h>     if t.startswith('>'):
[?2004l[?2004h>         t=t[1:].strip()
