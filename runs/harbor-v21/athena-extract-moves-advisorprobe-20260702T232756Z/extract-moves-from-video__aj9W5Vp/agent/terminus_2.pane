[?2004hroot@6d7a26636c3b:/app# python3 - <<'PY' > /app/prompt6_groups.txt
[?2004l[?2004h> import re
[?2004l[?2004h> lines=open('/app/prompt_ocr6.txt').read().splitlines()
[?2004l[?2004h> ents=[]
[?2004l[?2004h> for i,l in enumerate(lines,1):
[?2004l[?2004h>     m=re.match(r'(\d+)\s+(.*)', l)
[?2004l[?2004h>     if not m: continue
[?2004l[?2004h>     fr=int(m.group(1)); txt=m.group(2).strip()
[?2004l[?2004h>     ents.append((fr,txt))
[?2004l[?2004h> 
[?2004l[?2004h> def clean(t):
[?2004l[?2004h>     t=t.replace('_','').strip()
[?2004l[?2004h>     if t.startswith('>'): t=t[1:].strip()
[?2004l[?2004h>     # remove trailing cursor artifacts
[?2004l[?2004h>     t=t.rstrip('[]|').strip()
[?2004l[?2004h>     return t.strip()
[?2004l[?2004h> 
[?2004l[?2004h> def has_letter(t):
[?2004l[?2004h>     return bool(re.search(r'[A-Za-z]', t))
[?2004l[?2004h> 
[?2004l[?2004h> groups=[]
[?2004l[?2004h> cur=[]
[?2004l[?2004h> lastfr=None
[?2004l[?2004h> for fr,txt in ents:
[?2004l[?2004h>     c=clean(txt)
[?2004l[?2004h>     if txt.startswith('>') and has_letter(c):
[?2004l[?2004h>         if cur and lastfr is not None and fr-lastfr>6:
[?2004l[?2004h>             groups.append(cur); cur=[]
[?2004l[?2004h>         cur.append((fr,txt,c))
[?2004l[?2004h>         lastfr=fr
[?2004l[?2004h>     else:
[?2004l[?2004h>         if cur:
[?2004l[?2004h>             groups.append(cur); cur=[]
[?2004l[?2004h>         lastfr=fr
[?2004l[?2004h> if cur: groups.append(cur)
[?2004l[?2004h> 
[?2004l[?2004h> print('groups',len(groups))
[?2004l[?2004h> for idx,g in enumerate(groups,1):
[?2004l[?2004h>     frs=[x[0] for x in g]
[?2004l[?2004h>     longest=max(g,key=lambda x:len(x[2]))
[?2004l[?2004h>     print(f'{idx:03d} [{frs[0]:04d}-{frs[-1]:04d}] candidate={longest[2]!r}')
[?2004l[?2004h>     print('   '+' | '.join(f'{fr}:{c!r}' for fr,raw,c in g))
[?2004l[?2004h> PY
