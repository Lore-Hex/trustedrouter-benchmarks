python3 << 'EOF'
import socket, time
def send_cmd(cmd):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect("/tmp/qemu-monitor.sock")
    time.sleep(0.2)
    s.recv(4096)
    s.send(cmd.encode() + b"\n")
    time.sleep(0.3)
    try:
        print(s.recv(4096).decode(), end="")
    except:
        pass
    s.close()
for key in ["d", "i", "r", "ret"]:
    send_cmd(f"sendkey {key}")
    time.sleep(0.2)
EOF
