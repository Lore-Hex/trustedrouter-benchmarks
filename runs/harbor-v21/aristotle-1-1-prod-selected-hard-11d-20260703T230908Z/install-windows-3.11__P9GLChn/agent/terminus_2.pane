(qemu) python3 << 'EOF'
data = open('/tmp/vga_text.bin','rb').read()
for row in range(0, 4000, 160):
    line = bytearray()
    for i in range(row, row+160, 2):
        ch = data[i]
        if 32 <= ch < 127:
            line.append(ch)
        elif ch == 0:
            line.append(ord(' '))
        else:
            line.append(ord('.'))
    text = bytes(line).rstrip(b' ')
    print(f"{row//160:02d}: {text.decode()}")
EOF
