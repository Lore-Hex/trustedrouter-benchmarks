[?2004lpython3 << 'EOF'
import os
path = '/tmp/vga_text.bin'
if os.path.exists(path):
    data = open(path, 'rb').read()
    for row in range(0, min(len(data), 4000), 160):
        line = bytearray()
        for i in range(row, min(row+160, len(data)), 2):
            ch = data[i]
            if 32 <= ch < 127:
                line.append(ch)
            elif ch == 0:
                line.append(ord(' '))
            else:
                line.append(ord('.'))
        text = bytes(line).rstrip()
        if text:
            print(f"{row//160:02d}: {text.decode()}")
else:
    print("No VGA text file found")
EOF
