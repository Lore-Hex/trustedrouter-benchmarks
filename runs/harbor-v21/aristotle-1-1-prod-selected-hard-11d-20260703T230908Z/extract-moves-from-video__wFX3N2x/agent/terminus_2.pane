[?2004l[?2004h> frames=[]
[?2004l[?2004h> for k in range(1,len(parts),2):
[?2004l[?2004h>     t=int(parts[k])
[?2004l[?2004h>     content=parts[k+1].strip()
[?2004l[?2004h>     frames.append((t,content))
[?2004l[?2004h> # Save full transcript from last frame
[?2004l[?2004h> with open('/app/last_frame_ocr.txt','w') as f:
[?2004l[?2004h>     f.write(frames[-1][1])
[?2004l[?2004h> # Save first 30 frames
[?2004l[?2004h> with open('/app/first_30_frames.txt','w') as f:
[?2004l[?2004h>     for t,c in frames[:30]:
[?2004l[?2004h>         f.write(f'===== {t} =====\n{c}\n\n')
[?2004l[?2004h> # Extract all unique command progressions
[?2004l[?2004h> # Track all > lines across all frames
[?2004l[?2004h> all_cmds=[]
[?2004l[?2004h> seen=set()
[?2004l[?2004h> for t,c in frames:
[?2004l[?2004h>     lines=c.splitlines()
[?2004l[?2004h>     for l in lines:
[?2004l[?2004h>         if l.startswith('>'):
[?2004l[?2004h>             cmd=l[1:].strip()
[?2004l[?2004h>             key=(t,cmd)
[?2004l[?2004h>             if key not in seen:
[?2004l[?2004h>                 seen.add(key)
[?2004l[?2004h>                 all_cmds.append((t,cmd))
[?2004l[?2004h> with open('/app/all_cmds_timeline.txt','w') as f:
[?2004l[?2004h>     for t,cmd in all_cmds:
[?2004l[?2004h>         f.write(f'{t:3d}: {cmd}\n')
[?2004l[?2004h> PY
