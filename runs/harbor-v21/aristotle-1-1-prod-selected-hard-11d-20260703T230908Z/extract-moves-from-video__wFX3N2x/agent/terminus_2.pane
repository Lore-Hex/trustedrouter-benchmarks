[?2004l[?2004h> # Build move sequence by tracking ALL > lines across all frames
[?2004l[?2004h> # For each frame, collect all command lines
[?2004l[?2004h> # A new move is detected when a new command appears that wasn't in previous frames
[?2004l[?2004h> # Track using the set of all previously seen commands
[?2004l[?2004h> all_seen=set()
[?2004l[?2004h> moves_raw=[]  # (t, cmd, mc)
[?2004l[?2004h> for t,cmds,mc,content in frames:
[?2004l[?2004h>     for cmd in cmds:
[?2004l[?2004h>         cmd_clean=cmd.rstrip('_').strip()
[?2004l[?2004h>         if not cmd_clean:
[?2004l[?2004h>             continue
[?2004l[?2004h>         # Check if this is a new command or a longer version of an existing one
[?2004l[?2004h>         # We use exact match first
[?2004l[?2004h>         if cmd_clean not in all_seen:
[?2004l[?2004h>             moves_raw.append((t,cmd_clean,mc))
[?2004l[?2004h>             all_seen.add(cmd_clean)
[?2004l[?2004h> 
[?2004l[?2004h> # Now we have all unique commands but in order of first appearance
[?2004l[?2004h> # Problem: partial commands appear before full commands
[?2004l[?2004h> # Let's merge: if a later command is a longer version starting with a shorter one, merge
[?2004l[?2004h> merged=[]
[?2004l[?2004h> used=set()
[?2004l[?2004h> for i,(t,cmd,mc) in enumerate(moves_raw):
[?2004l[?2004h>     if i in used:
[?2004l[?2004h>         continue
[?2004l[?2004h>     best_cmd=cmd
[?2004l[?2004h>     best_t=t
[?2004l[?2004h>     best_mc=mc
[?2004l[?2004h>     for j in range(i+1,len(moves_raw)):
[?2004l[?2004h>         if j in used:
[?2004l[?2004h>             continue
[?2004l[?2004h>         t2,cmd2,mc2=moves_raw[j]
[?2004l[?2004h>         # If cmd2 starts with cmd or cmd starts with cmd2, they might be same command growing
[?2004l[?2004h>         if cmd2.startswith(best_cmd) or best_cmd.startswith(cmd2):
[?2004l[?2004h>             if len(cmd2)>len(best_cmd):
[?2004l[?2004h>                 best_cmd=cmd2
[?2004l[?2004h>                 best_t=t2
[?2004l[?2004h>                 best_mc=mc2
[?2004l[?2004h>                 used.add(j)
[?2004l[?2004h>     merged.append((best_t,best_cmd,best_mc))
[?2004l[?2004h> 
[?2004l[?2004h> # Write raw moves for review
[?2004l[?2004h> with open('/app/moves_merged.txt','w') as f:
[?2004l[?2004h>     for i,(t,cmd,mc) in enumerate(merged,1):
[?2004l[?2004h>         f.write(f'{i:3d} t={t:3d} Moves={str(mc):>4s}: {cmd}\n')
[?2004l[?2004h> 
[?2004l[?2004h> print(f'Total merged moves: {len(merged)}')
[?2004l[?2004h> print(f'Max moves counter: {max((f[2] for f in frames if f[2]), default=0)}')
