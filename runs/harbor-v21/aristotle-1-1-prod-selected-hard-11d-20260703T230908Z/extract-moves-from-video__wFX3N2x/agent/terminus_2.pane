[?2004hroot@bbf58f922fc3:/app# python3 - <<'PY'
[?2004l[?2004h> import re
[?2004l[?2004h> # Parse OCR by frame sections
[?2004l[?2004h> text=open('/app/ocr_all.txt').read()
[?2004l[?2004h> parts=re.split(r'===== (\d+) =====', text)
[?2004l[?2004h> # parts[0] is before first header, then alternating number, content
[?2004l[?2004h> frames=[]
[?2004l[?2004h> for k in range(1,len(parts),2):
[?2004l[?2004h>     t=int(parts[k])
[?2004l[?2004h>     content=parts[k+1]
[?2004l[?2004h>     frames.append((t,content))
[?2004l[?2004h> # For each frame, print timestamp and command lines after >
[?2004l[?2004h> with open('/app/frame_commands.txt','w') as out:
[?2004l[?2004h>     for t,content in frames:
[?2004l[?2004h>         cmds=re.findall(r'>(.*)', content)
[?2004l[?2004h>         cmds=[c.strip() for c in cmds if c.strip()]
[?2004l[?2004h>         if cmds:
[?2004l[?2004h>             out.write(f'{t}: ' + ' | '.join(cmds) + '\n')
[?2004l[?2004h> PY
