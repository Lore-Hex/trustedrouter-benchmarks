[?2004l[?2004h> print(f'Frame range: {frames[0][0]} to {frames[-1][0]}')
[?2004l[?2004h> max_mc=max((f[2] for f in frames if f[2]), default=0)
[?2004l[?2004h> print(f'Max moves counter: {max_mc}')
[?2004l[?2004h> 
[?2004l[?2004h> # Track all > command lines across frames in chronological order
[?2004l[?2004h> # Detect new commands by comparing current frame's command list to previous
[?2004l[?2004h> prev_cmds=[]
[?2004l[?2004h> all_moves=[]  # (t, cmd, mc) - new or updated commands
[?2004l[?2004h> for t,cmds,mc,content in frames:
[?2004l[?2004h>     # Find new commands in this frame
[?2004l[?2004h>     for cmd in cmds:
[?2004l[?2004h>         cmd_clean=cmd.rstrip('_').strip()
[?2004l[?2004h>         if not cmd_clean:
[?2004l[?2004h>             continue
[?2004l[?2004h>         # Check if this command or a prefix/superset was seen before
[?2004l[?2004h>         found=False
[?2004l[?2004h>         for pc in prev_cmds:
[?2004l[?2004h>             pc_clean=pc.rstrip('_').strip()
[?2004l[?2004h>             if cmd_clean==pc_clean or cmd_clean.startswith(pc_clean) or pc_clean.startswith(cmd_clean):
[?2004l[?2004h>                 found=True
[?2004l[?2004h>                 break
[?2004l[?2004h>         if not found:
[?2004l[?2004h>             all_moves.append([t,cmd_clean,mc])
[?2004l[?2004h>     # Also check for longer versions of existing commands
[?2004l[?2004h>     for cmd in cmds:
[?2004l[?2004h>         cmd_clean=cmd.rstrip('_').strip()
[?2004l[?2004h>         for move in all_moves:
[?2004l[?2004h>             if cmd_clean.startswith(move[1]) and len(cmd_clean)>len(move[1]):
[?2004l[?2004h>                 move[1]=cmd_clean
[?2004l[?2004h>                 move[0]=t
[?2004l[?2004h>                 if mc: move[2]=mc
[?2004l[?2004h>     prev_cmds=cmds
[?2004l[?2004h> 
[?2004l[?2004h> # Write moves for review
[?2004l[?2004h> with open('/app/moves_chrono.txt','w') as f:
[?2004l[?2004h>     for i,(t,cmd,mc) in enumerate(all_moves,1):
[?2004l[?2004h>         f.write(f'{i:3d} t={t:3d} Moves={str(mc):>4s}: {cmd}\n')
[?2004l[?2004h> 
