[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> text=open('/app/ocr_1s.txt').read()
[?2004l[?2004h> parts=re.split(r'===== (\d+) =====', text)
[?2004l[?2004h> frames=[]
[?2004l[?2004h> for k in range(1,len(parts),2):
[?2004l[?2004h>     t=int(parts[k])
[?2004l[?2004h>     content=parts[k+1].strip()
[?2004l[?2004h>     lines=content.splitlines()
[?2004l[?2004h>     cmds=[l[1:].strip() for l in lines if l.startswith('>')]
[?2004l[?2004h>     m=re.search(r'Moves:\s*(\d+)', content)
[?2004l[?2004h>     mc=int(m.group(1)) if m else None
[?2004l[?2004h>     frames.append((t,cmds,mc,content))
[?2004l[?2004h> 
[?2004l[?2004h> # Print summary
[?2004l[?2004h> print(f'Total frames: {len(frames)}')
[?2004l[?2004h> print(f'First frame t={frames[0][0]}, Last frame t={frames[-1][0]}')
[?2004l[?2004h> # Find max moves counter
[?2004l[?2004h> max_mc=max((f[2] for f in frames if f[2]), default=0)
[?2004l[?2004h> print(f'Max moves counter: {max_mc}')
[?2004l[?2004h> 
[?2004l[?2004h> # Print all frame numbers and move counts
[?2004l[?2004h> for t,cmds,mc,content in frames:
[?2004l[?2004h>     if mc is not None:
[?2004l[?2004h>         print(f't={t:3d} Moves={mc:3d} cmds={cmds[:3]}...')
[?2004l[?2004h> PY
