[?2004l[?2004h> import re
[?2004l[?2004h> text=open('/app/ocr_1s.txt').read()
[?2004l[?2004h> parts=re.split(r'===== (\d+) =====', text)
[?2004l[?2004h> frames=[]
[?2004l[?2004h> for k in range(1,len(parts),2):
[?2004l[?2004h>     t=int(parts[k])
[?2004l[?2004h>     content=parts[k+1]
[?2004l[?2004h>     lines=content.splitlines()
[?2004l[?2004h>     cmds=[l[1:].strip() for l in lines if l.startswith('>')]
[?2004l[?2004h>     # Get last command line (the one being typed)
[?2004l[?2004h>     last = cmds[-1] if cmds else ''
[?2004l[?2004h>     frames.append((t,last,cmds))
[?2004l[?2004h> with open('/app/last_cmd_per_frame.txt','w') as out:
[?2004l[?2004h>     for t,last,cmds in frames:
[?2004l[?2004h>         out.write(f'{t:3d}: last={last!r} all={cmds}\n')
[?2004l[?2004h> PY
