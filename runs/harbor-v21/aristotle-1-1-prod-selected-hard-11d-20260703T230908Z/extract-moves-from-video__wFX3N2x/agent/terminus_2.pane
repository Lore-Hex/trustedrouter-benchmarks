[?2004l[?2004h> import re
[?2004l[?2004h> text=open('/app/ocr_1s.txt').read()
[?2004l[?2004h> parts=re.split(r'===== (\d+) =====', text)
[?2004l[?2004h> frames=[]
[?2004l[?2004h> for k in range(1,len(parts),2):
[?2004l[?2004h>     t=int(parts[k])
[?2004l[?2004h>     content=parts[k+1].strip()
[?2004l[?2004h>     lines=content.splitlines()
[?2004l[?2004h>     cmds=[l[1:].strip() for l in lines if l.startswith('>')]
[?2004l[?2004h>     last=cmds[-1] if cmds else ''
[?2004l[?2004h>     frames.append((t,last,cmds,content))
[?2004l[?2004h> 
[?2004l[?2004h> # Reconstruct moves: track last command line changes
[?2004l[?2004h> moves=[]
[?2004l[?2004h> prev_last=''
[?2004l[?2004h> prev_t=None
[?2004l[?2004h> current_cmd='' 
[?2004l[?2004h> for t,last,cmds,content in frames:
[?2004l[?2004h>     if last != prev_last:
[?2004l[?2004h>         # The last command line changed
[?2004l[?2004h>         # If previous was non-empty and current is empty or different, previous command may have been completed
[?2004l[?2004h>         if prev_last and prev_last != '':
[?2004l[?2004h>             # Check if this frame has a game response (non-> lines after the prompt)
[?2004l[?2004h>             # or if a new > prompt appeared
[?2004l[?2004h>             moves.append((prev_t, prev_last))
[?2004l[?2004h>         prev_last=last
[?2004l[?2004h>         prev_t=t
[?2004l[?2004h>     # If same, keep growing
[?2004l[?2004h> # Don't forget last
[?2004l[?2004h> if prev_last:
[?2004l[?2004h>     moves.append((prev_t, prev_last))
[?2004l[?2004h> 
[?2004l[?2004h> # Now we have raw moves with partials. Let's deduplicate by taking longest version
[?2004l[?2004h> # Print all
[?2004l[?2004h> with open('/app/reconstructed_moves.txt','w') as f:
[?2004l[?2004h>     for i,(t,cmd) in enumerate(moves,1):
[?2004l[?2004h>         f.write(f'{i:3d} t={t:3d}: {cmd}\n')
