[?2004l[?2004h> import re
[?2004l[?2004h> 
[?2004l[?2004h> text=open('/app/ocr_1s.txt').read()
[?2004l[?2004h> parts=re.split(r'===== (\d+) =====', text)
[?2004l[?2004h> frames=[]
[?2004l[?2004h> for k in range(1,len(parts),2):
[?2004l[?2004h>     t=int(parts[k])
[?2004l[?2004h>     content=parts[k+1].strip()
[?2004l[?2004h>     lines=content.splitlines()
[?2004l[?2004h>     cmds=[l[1:].strip() for l in lines if l.startswith('>')]
[?2004l[?2004h>     last=cmds[-1] if cmds else None
[?2004l[?2004h>     frames.append((t,last,cmds,content))
[?2004l[?2004h> 
[?2004l[?2004h> # Track changes in the last command line
[?2004l[?2004h> # Group frames where last command grows (prefix relationship)
[?2004l[?2004h> moves=[]
[?2004l[?2004h> i=0
[?2004l[?2004h> prev_last=None
[?2004l[?2004h> prev_t=None
[?2004l[?2004h> 
[?2004l[?2004h> # Simple approach: collect sequence of (t, last_cmd) and then post-process
[?2004l[?2004h> groups=[]
[?2004l[?2004h> current_group=[]
[?2004l[?2004h> for t,last,cmds,content in frames:
[?2004l[?2004h>     if last is None:
[?2004l[?2004h>         continue
[?2004l[?2004h>     # Normalize: remove trailing underscores and OCR artifacts
[?2004l[?2004h>     norm = last.rstrip('_').strip()
[?2004l[?2004h>     if not current_group:
[?2004l[?2004h>         current_group=[(t,norm)]
[?2004l[?2004h>     else:
[?2004l[?2004h>         prev_t2,prev_cmd=current_group[-1]
[?2004l[?2004h>         # If current is a continuation/growth of previous or same
[?2004l[?2004h>         if norm.startswith(prev_cmd) or prev_cmd.startswith(norm) or norm==prev_cmd:
[?2004l[?2004h>             current_group.append((t,norm))
[?2004l[?2004h>         else:
[?2004l[?2004h>             # New command group
[?2004l[?2004h>             groups.append(current_group)
[?2004l[?2004h>             current_group=[(t,norm)]
[?2004l[?2004h> if current_group:
[?2004l[?2004h>     groups.append(current_group)
[?2004l[?2004h> 
[?2004l[?2004h> # For each group, take the longest command
[?2004l[?2004h> moves=[]
[?2004l[?2004h> for g in groups:
[?2004l[?2004h>     best=max(g, key=lambda x: len(x[1]))
[?2004l[?2004h>     moves.append(best)
[?2004l[?2004h> 
[?2004l[?2004h> with open('/app/moves_grouped.txt','w') as f:
[?2004l[?2004h>     for i,(t,cmd) in enumerate(moves,1):
[?2004l[?2004h>         f.write(f'{i:3d} t={t:3d}: {cmd}\n')
[?2004l[?2004h> print(f'Total groups: {len(moves)}')
[?2004l[?2004h> PY
