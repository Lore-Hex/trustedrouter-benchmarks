Sending keys: ['python3 - <<\'PY\'\nimport sys\n\n# === PROTEIN SEQUENCES ===\n# 1. Antibody binder: FLAG epitope DYKDDDDK\n# BLAST confirmed anti-FLAG M2 (100% match to 8RMO_H)\nflag_seq = "DYKDDDDK"  # 8 aa, no N-term Met\n\n# 2. Donor: Clover (PDB 5WJ2, FPbase ex_max=505 em_max=515)\n# FPbase seq matches PDB 5WJ2 after removing His-tag and expanding X->GYG\nclover_full = "MVSKGEELFTGVVPILVELDGDVNGHKFSVRGEGEGDATNGKLTLKFICTTGKLPVPWPTLVTTFGYGVACFSRYPDHMKQHDFFKSAMPEGYVQERTISFKDDGTYKTRAEVKFEGDTLVNRIELKGIDFKEDGNILGHKLEYNFNSHNVYITADKQKNGIKANFKIRHNVEDGSVQLADHYQQNTPIGDGPVLLPDNHYLSHQSALSKDPNEKRDHMVLLEFVTAAGITHGMDELYK"\nclover_seq = clover_full[1:]  # 238 aa, N-term Met removed\n\n# 3. DHFR from plasmid.gb\ndhfr_full = "MISLIAALAVDRVIGMENAMPWNLPADLAWFKRNTLNKPVIMGRHTWESIGRPLPGRKNIILSSQPGTDDRVTWVKSVDEAIAACGDVPEIMVIGGGRVYEQFLPKAQKLYLTHIDAEVEGDTHFPDYEPDDWESVFSEFHDADAQNSHSYCFEILERR"\ndhfr_seq = dhfr_full[1:]  # 158 aa, N-term Met removed\n\n# 4. Acceptor: mCherry (PDB 2H5Q, FPbase ex_max=587 em_max=610)\n# FPbase seq matches PDB 2H5Q after expanding X->MYG\nmcherry_full = "MVSKGEEDNMAIIKEFMRFKVHMEGSVNGHEFEIEGEGEGRPYEGTQTAKLKVTKGGPLPFAWDILSPQFMYGSKAYVKHPADIPDYLKLSFPEGFKWERVMNFEDGGVVTVTQDSSLQDGEFIYKVKLRGTNFPSDGPVMQKKTMGWEASSERMYPEDGALKGEIKQRLKLKDGGHYDAEVKTTYKAKKPVQLPGAYNVNIKLDITSHNEDYTIVEQYERAEGRHSTGGMDELYK"\nmcherry_seq = mcherry_full[1:]  # 235 aa, N-term Met removed\n\n# 5. Molecule binder: SNAP-tag (PDB 3KZY, MGMT, binds O6-benzylguanine)\n# PDB FASTA, starts with G (no N-term Met to remove)\nsnap_seq = "GPGSDKDCEMKRTTLDSPLGKLELSGCEQGLHEIIFLGKGTSAADAVEVPAPAAVLGGPEPLMQATAWLNAYFHQPEAIEEFPVPALHHPVFQQESFTRQVLWKLLKVVKFGEVISYSHLAALAGNPAATAAVKTALSGNPVPILIPCHRVVQGDLDVGGYEGGLAVKEWLLAHEGHRLGKR"  # 182 aa\n\n# GS linker (5 aa, within 5-20 aa requirement)\nlinker_seq = "GGGGS"\n\n# === ASSEMBLE FUSION PROTEIN ===\n# Order: antibody binder - donor - dhfr - acceptor - molecule binder\nfusion = flag_seq + linker_seq + clover_seq + linker_seq + dhfr_seq + linker_seq + mcherry_seq + linker_seq + snap_seq\n\nprint(f"Fusion protein: {len(fusion)} aa, DNA: {len(fusion)*3} nt")\nprint(f"Components: FLAG({len(flag_seq)}) + L({len(linker_seq)}) + Clover({len(clover_seq)}) + L({len(linker_seq)}) + DHFR({len(dhfr_seq)}) + L({len(linker_seq)}) + mCherry({len(mcherry_seq)}) + L({len(linker_seq)}) + SNAP({len(snap_seq)})")\n\n# === REVERSE TRANSLATION WITH GC OPTIMIZATION ===\ncodon_choices = {\n    \'A\': [\'GCG\', \'GCT\', \'GCA\', \'GCC\'],\n    \'R\': [\'CGT\', \'CGC\', \'CGA\', \'AGA\', \'AGG\'],\n    \'N\': [\'AAC\', \'AAT\'],\n    \'D\': [\'GAC\', \'GAT\'],\n    \'C\': [\'TGC\', \'TGT\'],\n    \'Q\': [\'CAG\', \'CAA\'],\n    \'E\': [\'GAA\', \'GAG\'],\n    \'G\': [\'GGT\', \'GGC\', \'GGA\', \'GGG\'],\n    \'H\': [\'CAC\', \'CAT\'],\n    \'I\': [\'ATC\', \'ATT\', \'ATA\'],\n    \'L\': [\'CTG\', \'CTT\', \'CTA\', \'CTC\', \'TTA\', \'TTG\'],\n    \'K\': [\'AAG\', \'AAA\'],\n    \'M\': [\'ATG\'],\n    \'F\': [\'TTC\', \'TTT\'],\n    \'P\': [\'CCG\', \'CCT\', \'CCC\', \'CCA\'],\n    \'S\': [\'TCT\', \'AGC\', \'TCC\', \'AGT\', \'TCA\', \'TCG\'],\n    \'T\': [\'ACC\', \'ACT\', \'ACA\', \'ACG\'],\n    \'W\': [\'TGG\'],\n    \'Y\': [\'TAC\', \'TAT\'],\n    \'V\': [\'GTT\', \'GTA\', \'GTG\', \'GTC\'],\n}\n\ndef gc_content(seq):\n    if not seq:\n        return 0\n    return 100 * (seq.count(\'G\') + seq.count(\'C\')) / len(seq)\n\ndef reverse_translate_gc(protein):\n    dna = ""\n    for aa in protein:\n        best_codon = None\n        best_score = (float(\'inf\'), float(\'inf\'))\n        for codon in codon_choices[aa]:\n            trial = dna + codon\n            violations = 0\n            dist = 0\n            for start in range(max(0, len(trial)-52), max(1, len(trial)-49)):\n                if start >= 0 and start + 50 <= len(trial):\n                    window = trial[start:start+50]\n                    gc = gc_content(window)\n                    if gc < 30 or gc > 70:\n                        violations += 1\n                    dist += abs(gc - 50)\n            score = (violations, dist)\n            if score < best_score:\n                best_score = score\n                best_codon = codon\n        dna += best_codon\n    return dna\n\ndef fix_gc_violations(dna, protein, max_iter=200):\n    for iteration in range(max_iter):\n        bad = []\n        for i in range(len(dna)-49):\n            window = dna[i:i+50]\n            gc = gc_content(window)\n            if gc < 30 or gc > 70:\n                bad.append((i, gc))\n        if not bad:\n            print(f"  Fixed after {iteration} iterations")\n            return dna\n        \n        worst_i, worst_gc = max(bad, key=lambda x: abs(x[1]-50))\n        \n        best_swap = None\n        best_improvement = 0\n        \n        for ci in range(0, len(dna), 3):\n            if ci + 3 <= worst_i or ci >= worst_i + 50:\n                continue\n            aa_idx = ci // 3\n            if aa_idx >= len(protein):\n                continue\n            aa = protein[aa_idx]\n            current = dna[ci:ci+3]\n            \n            for new_codon in codon_choices[aa]:\n                if new_codon == current:\n                    continue\n                new_dna = dna[:ci] + new_codon + dna[ci+3:]\n                \n                old_v = 0\n                new_v = 0\n                for j in range(max(0, ci-49), min(len(dna)-49, ci+50)):\n                    if j + 50 <= len(dna):\n                        old_gc = gc_content(dna[j:j+50])\n                        new_gc = gc_content(new_dna[j:j+50])\n                        if old_gc < 30 or old_gc > 70:\n                            old_v += 1\n                        if new_gc < 30 or new_gc > 70:\n                            new_v += 1\n                \n                improvement = old_v - new_v\n                if improvement > best_improvement:\n                    best_improvement = improvement\n                    best_swap = (ci, new_codon, new_dna)\n        \n        if best_swap:\n            dna = 