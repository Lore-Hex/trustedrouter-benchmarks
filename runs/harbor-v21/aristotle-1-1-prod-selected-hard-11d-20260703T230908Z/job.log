Sending keys: ['python3 - <<\'PY\'\nimport urllib.request, urllib.parse, json, sys\n\nsmiles=\'Nc3nc(OCc1ccccc1)c2nc[nH]c2n3\'\nprint(\'SMILES:\', smiles, flush=True)\n\n# Try chemical search via RCSB search API\nq={\n  "query": {\n    "type": "terminal",\n    "service": "chemical",\n    "parameters": {\n      "value": smiles,\n      "type": "descriptor",\n      "match_type": "exact"\n    }\n  },\n  "return_type": "entry",\n  "request_options": {"results_content_type": ["experimental"], "paginate": {"start": 0, "rows": 25}}\n}\nsearch_url=\'https://search.rcsb.org/rcsbsearch/v2/query?json=\' + urllib.parse.quote(json.dumps(q))\nprint(\'Search URL length:\', len(search_url), flush=True)\ntry:\n    req=urllib.request.Request(search_url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n    resp=urllib.request.urlopen(req, timeout=30).read().decode(\'utf-8\',\'replace\')\n    print(\'Search response:\', resp[:5000], flush=True)\nexcept Exception as e:\n    print(\'SMILES search ERR\', repr(e), flush=True)\n    # Try POST\n    try:\n        post_url=\'https://search.rcsb.org/rcsbsearch/v2/query\'\n        data=json.dumps(q).encode()\n        req=urllib.request.Request(post_url, data=data, headers={\'User-Agent\':\'Mozilla/5.0\',\'Content-Type\':\'application/json\'})\n        resp=urllib.request.urlopen(req, timeout=30).read().decode(\'utf-8\',\'replace\')\n        print(\'POST response:\', resp[:5000], flush=True)\n    except Exception as e2:\n        print(\'POST search ERR\', repr(e2), flush=True)\n\n# Also try searching for the ligand directly in PDB chemical component API\n# The SMILES looks like a pterin/folate derivative. Try to find chemical components\nprint(\'\\n=== Try RCSB chemical component search ===\', flush=True)\nfor term in [\'benzyl pterin\',\'aminopterin\',\'pemetrexed\',\'trimethoprim\',\'methotrexate\',\'folate\',\'pterin\']:\n    try:\n        url=f\'https://search.rcsb.org/rcsbsearch/v2/query?json=\' + urllib.parse.quote(json.dumps({\n            "query":{"type":"terminal","service":"text","parameters":{"attribute":"struct_keywords.text","value":term}},\n            "return_type":"entry",\n            "request_options":{"paginate":{"start":0,"rows":5}}\n        }))\n        req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n        resp=urllib.request.urlopen(req, timeout=20).read().decode(\'utf-8\',\'replace\')\n        j=json.loads(resp)\n        total=j.get(\'total_count\',0)\n        hits=[r.get(\'identifier\') for r in j.get(\'result_set\',[])]\n        print(f\'{term}: total={total}, hits={hits}\', flush=True)\n    except Exception as e:\n        print(f\'{term}: ERR {repr(e)}\', flush=True)\nPY\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
