Sending keys: ['python3 - <<\'PY\'\nimport urllib.request, urllib.parse, json, re, sys, time\n\n# ---- 1. Parse PDB FASTA for key entries ----\nprint(\'=== PDB FASTA for key entries ===\', flush=True)\nkey_ids=[\'5WJ2\',\'2H5Q\',\'3KZY\',\'1AK4\',\'5P21\',\'1KFD\',\'2CHA\']\npdb_seqs={}\nfor pid in key_ids:\n    try:\n        url=f\'https://www.rcsb.org/fasta/entry/{pid}\'\n        req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n        data=urllib.request.urlopen(req, timeout=15).read().decode(\'utf-8\',\'replace\')\n        # Parse all records\n        records=[]\n        for rec in data.strip().split(\'>\')[1:]:\n            lines=rec.split(\'\\n\')\n            hdr=lines[0]\n            seq=\'\'.join(lines[1:])\n            records.append((hdr,seq,len(seq)))\n        pdb_seqs[pid]=records\n        print(f\'{pid}:\', flush=True)\n        for hdr,seq,l in records:\n            print(f\'  hdr={hdr[:90]}\', flush=True)\n            print(f\'  len={l} seq={seq}\', flush=True)\n    except Exception as e:\n        print(f\'{pid} ERR {repr(e)}\', flush=True)\n\n# ---- 2. Get 3KZY ligand details ----\nprint(\'\\n=== 3KZY ligand details ===\', flush=True)\nfor pid in [\'3KZY\',\'1AK4\',\'5P21\']:\n    for eid in range(1,6):\n        try:\n            url=f\'https://data.rcsb.org/rest/v1/core/nonpolymer_entity/{pid}/{eid}\'\n            req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n            j=json.loads(urllib.request.urlopen(req, timeout=10).read().decode(\'utf-8\',\'replace\'))\n            comp_id=j.get(\'nonpolymer_comp\',{}).get(\'id\',\'\')\n            comp_name=j.get(\'chem_comp\',{}).get(\'name\',\'\')\n            formula=j.get(\'chem_comp\',{}).get(\'formula\',\'\')\n            desc=j.get(\'pdbx_entity_nonpoly\',{}).get(\'name\',\'\')\n            print(f\'{pid} entity {eid}: comp_id={comp_id}, name={comp_name}, desc={desc}, formula={formula}\', flush=True)\n        except Exception:\n            break\n\n# ---- 3. FPbase sequences ----\nprint(\'\\n=== FPbase sequences ===\', flush=True)\nurl=\'https://www.fpbase.org/api/proteins/?format=json\'\nreq=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\nprots=json.loads(urllib.request.urlopen(req, timeout=60).read().decode(\'utf-8\',\'replace\'))\nfpbase={}\nfor p in prots:\n    if p.get(\'slug\') in (\'clover\',\'mcherry\'):\n        fpbase[p[\'slug\']]=p\n        seq=p.get(\'seq\',\'\')\n        print(f"\\n{p[\'name\']} ({p[\'slug\']}): pdb={p.get(\'pdb\')}, states={[(s.get(\'ex_max\'),s.get(\'em_max\')) for s in p.get(\'states\',[])]}", flush=True)\n        print(f\'  len={len(seq)}\', flush=True)\n        print(f\'  seq={seq}\', flush=True)\n\n# Compare Clover\nif \'clover\' in fpbase and \'5WJ2\' in pdb_seqs:\n    fp_seq=fpbase[\'clover\'].get(\'seq\',\'\')\n    pdb_seq=pdb_seqs[\'5WJ2\'][0][1]\n    print(\'\\n=== Clover comparison ===\', flush=True)\n    print(f\'FPbase len={len(fp_seq)}, PDB len={len(pdb_seq)}\', flush=True)\n    # Find best alignment\n    for i in range(len(pdb_seq)-len(fp_seq)+1):\n        mm=sum(1 for a,b in zip(pdb_seq[i:i+len(fp_seq)], fp_seq) if a!=b and a!=\'X\')\n        if mm<=3:\n            print(f\'FPbase matches PDB at offset {i}, mismatches(excluding X)={mm}\', flush=True)\n            diff=[(j, pdb_seq[i+j], fp_seq[j]) for j in range(min(len(fp_seq),len(pdb_seq)-i)) if pdb_seq[i+j]!=fp_seq[j]]\n            print(f\'  Differences: {diff}\', flush=True)\n            break\n\n# Compare mCherry\nif \'mcherry\' in fpbase and \'2H5Q\' in pdb_seqs:\n    fp_seq=fpbase[\'mcherry\'].get(\'seq\',\'\')\n    pdb_seq=pdb_seqs[\'2H5Q\'][0][1]\n    print(\'\\n=== mCherry comparison ===\', flush=True)\n    print(f\'FPbase len={len(fp_seq)}, PDB len={len(pdb_seq)}\', flush=True)\n    mm=sum(1 for a,b in zip(pdb_seq, fp_seq) if a!=b and a!=\'X\')\n    diff=[(i, pdb_seq[i], fp_seq[i]) for i in range(min(len(fp_seq),len(pdb_seq))) if pdb_seq[i]!=fp_seq[i]]\n    print(f\'Mismatches (excluding X)={mm}, diff={diff}\', flush=True)\n\n# ---- 4. Extract DHFR ----\nprint(\'\\n=== DHFR from plasmid ===\', flush=True)\ngb=open(\'/app/plasmid.gb\').read()\nm=re.search(r\'/translation="([^"]+)"\', gb.replace(\'\\n\',\' \').replace(\'  \',\' \'))\ndhfr_full=m.group(1).replace(\' \',\'\') if m else \'\'\nprint(f\'DHFR full: len={len(dhfr_full)}\', flush=True)\nprint(f\'  seq={dhfr_full}\', flush=True)\ndhfr_no_met=dhfr_full[1:] if dhfr_full[0]==\'M\' else dhfr_full\nprint(f\'DHFR no Met: len={len(dhfr_no_met)}\', flush=True)\n\n# ---- 5. Antibody target identification ----\nprint(\'\\n=== Antibody sequences ===\', flush=True)\nseqs={}\ncur=None\nfor line in open(\'/app/antibody.fasta\'):\n    line=line.strip()\n    if line.startswith(\'>\'):\n        cur=line[1:].split()[0]\n        seqs[cur]=\'\'\n    elif cur:\n        seqs[cur]+=line\nheavy=seqs[\'heavy\']\nlight=seqs[\'light\']\n# Extract variable regions\nhv=re.match(r\'^(.*?WGQG.{0,10}TVSS)\', heavy)\nhv_seq=hv.group(1) if hv else heavy[:120]\nlv=re.match(r\'^(.*?FGGGTKLEI)\', light)\nlv_seq=lv.group(1) if lv else light[:110]\nprint(f\'Heavy var len={len(hv_seq)}: {hv_seq}\', flush=True)\nprint(f\'Light var len={len(lv_seq)}: {lv_seq}\', flush=True)\n\n# Extract CDR3s\nh_cdr3=re.search(r\'(CARE?KFYGYDYWGQG)\', heavy)\nl_cdr3=re.search(r\'(FQGSHVPYTFGGGTKLEI)\', light)\nprint(f\'Heavy CDR3 region: {h_cdr3.group(1) if h_cdr3 else "not found"}\', flush=True)\nprint(f\'Light CDR3 region: {l_cdr3.group(1) if l_cdr3 else "not found"}\', flush=True)\n\n# Search NCBI E-utilities for CDR3 sequences\nprint(\'\\n=== NCBI ESearch for CDR3 ===\', flush=True)\nfor query in [\'"EKFYGYDY"[All Fields] AND antibody\', \'"EKFYGYDY" AND "heavy chain"\', \'EKFYGYDY\', \'"FQGSHVPYT"\']:\n    try:\n        params={\'db\':\'protein\',\'term\':query,\'retmode\':\'json\',\'retmax\':5}\n        url=\'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?\'+urllib.parse.urlencode(params)\n        req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n        j=json.loads(urllib.request.urlopen(req, timeout=15).read().decode(\'utf-8\',\'replace\'))\n        ids=j.get(\'esearchresult\',{}).get(\'idlist\',[])\n        count=j.get(\'esearchresult\',{}).get(\'count\',\'0\')\n        print(f\'Query: {query} -> count={count}, ids={ids}\', flush=True)\n        # Fetch summaries\n        if ids:\n            sparams={\'db\':\'protein\',\'id\':\',\'.join(ids[:3]),\'retmode\':\'json\'}\n            surl=\'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?\'+urllib.parse.urlencode(sparams)\n            sreq=urllib.request.Request(surl, headers={\'User-Agent\':\'Mozilla/5.0\'})\n            sj=json.loads(urllib.request.urlopen(sreq, timeout=15).read().decode(\'utf-8\',\'replace\'))\n            for uid in ids[:3]:\n                r=sj.get(\'result\',{}).get(uid,{})\n                print(f\'  {uid}: {r.get("title","")[:120]}\', flush=True)\n    except Exception as e:\n        print(f\'Query: {query} -> ERR {repr(e)}\', flush=True)\n\n# Also search with full variable region\nprint(\'\\n=== NCBI ESearch for full variable region ===\', flush=True)\nfor name, seq in [(\'heavy_var\', hv_seq[:50]), (\'light_var\', lv_seq[:50])]:\n    # Use first 50 aa as search term\n    query=f\'"{seq}"[All Fields]\'\n    try:\n        params={\'db\':\'protein\',\'term\':query,\'retmode\':\'json\',\'retmax\':5}\n        url=\'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?\'+urllib.parse.urlencode(params)\n        req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n        j=json.loads(urllib.request.urlopen(req, timeout=15).read().decode(\'utf-8\',\'replace\'))\n        ids=j.get(\'esearchresult\',{}).get(\'idlist\',[])\n        count=j.get(\'esearchresult\',{}).get(\'count\',\'0\')\n        print(f\'{name} first50: count={count}, ids={ids}\', flush=True)\n        if ids:\n            sparams={\'db\':\'protein\',\'id\':\',\'.join(ids[:3]),\'retmode\':\'json\'}\n            surl=\'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi?\'+urllib.parse.urlencode(sparams)\n            sreq=urllib.request.Request(surl, headers={\'User-Agent\':\'Mozilla/5.0\'})\n            sj=json.loads(urllib.request.urlopen(sreq, timeout=15).read().decode(\'utf-8\',\'replace\'))\n            for uid in ids[:3]:\n                r=sj.get(\'result\',{}).get(uid,{})\n                print(f\'  {uid}: {r.get("title","")[:120]}\', flush=True)\n    except Exception as e:\n        print(f\'{name}: ERR {repr(e)}\', flush=True)\nPY\n'] min_timeout_sec: 25.0 max_timeout_sec: 180.0
