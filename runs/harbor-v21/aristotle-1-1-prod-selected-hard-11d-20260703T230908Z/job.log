         }\n        },\n        "return_type":"entry",\n        "request_options":{\n            "results_content_type":["experimental"],\n            "paginate":{"start":0,"rows":10}\n        }\n    }\n    url=\'https://search.rcsb.org/rcsbsearch/v2/query?json=\'+urllib.parse.quote(json.dumps(q))\n    req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n    resp=urllib.request.urlopen(req, timeout=30).read().decode(\'utf-8\',\'replace\')\n    print(\'RCSB search response:\', resp[:3000], flush=True)\nexcept Exception as e:\n    print(\'RCSB search error:\', repr(e), flush=True)\n\n# 3. Confirm 3KZY is MGMT\nprint(\'\\n=== 3KZY entry details ===\', flush=True)\ntry:\n    url=\'https://data.rcsb.org/rest/v1/core/entry/3KZY\'\n    req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n    j=json.loads(urllib.request.urlopen(req, timeout=15).read().decode(\'utf-8\',\'replace\'))\n    print(\'Title:\', j.get(\'struct\',{}).get(\'title\',\'\'), flush=True)\n    print(\'Keywords:\', j.get(\'struct_keywords\',{}).get(\'text\',\'\'), flush=True)\n    for eid in range(1,4):\n        try:\n            purl=f\'https://data.rcsb.org/rest/v1/core/polymer_entity/3KZY/{eid}\'\n            preq=urllib.request.Request(purl, headers={\'User-Agent\':\'Mozilla/5.0\'})\n            pj=json.loads(urllib.request.urlopen(preq, timeout=15).read().decode(\'utf-8\',\'replace\'))\n            desc=pj.get(\'rcsb_polymer_entity\',{}).get(\'pdbx_description\',\'\')\n            print(f\'Entity {eid}: {desc}\', flush=True)\n        except:\n            break\nexcept Exception as e:\n    print(\'3KZY error:\', repr(e), flush=True)\n\n# 4. Also try UniProt search for CDR3\nprint(\'\\n=== UniProt search for CDR3 ===\', flush=True)\nfor cdr in [\'EKFYGYDY\',\'FQGSHVPYT\']:\n    try:\n        url=\'https://rest.uniprot.org/uniprotkb/search?query=\'+urllib.parse.quote(cdr)+\'&format=json&size=5\'\n        req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n        resp=urllib.request.urlopen(req, timeout=15).read().decode(\'utf-8\',\'replace\')\n        j=json.loads(resp)\n        results=j.get(\'results\',[])\n        print(f\'{cdr}: {len(results)} results\', flush=True)\n        for r in results[:3]:\n            print(f\'  {r.get("primaryAccession","")}: {r.get("proteinDescription",{}).get("recommendedName",{}).get("fullName",{"":{"value":""}}).get("value","")}\', flush=True)\n    except Exception as e:\n        print(f\'{cdr}: error {repr(e)}\', flush=True)\nPY\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
