Sending keys: ['python3 - <<\'PY\'\nimport urllib.request, urllib.parse, json, sys, time\n\n# 1. Search PubChem for the SMILES\nsmiles=\'Nc3nc(OCc1ccccc1)c2nc[nH]c2n3\'\nprint(\'=== PubChem search for SMILES ===\', flush=True)\ntry:\n    url=\'https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/smiles/\'+urllib.parse.quote(smiles)+\'/property/Title,IUPACName,MolecularFormula,MolecularWeight,CID/JSON\'\n    req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n    resp=urllib.request.urlopen(req, timeout=20).read().decode(\'utf-8\',\'replace\')\n    print(\'PubChem response:\', resp[:2000], flush=True)\nexcept Exception as e:\n    print(\'PubChem ERR\', repr(e), flush=True)\n\n# 2. RCSB chemical search - try POST\nprint(\'\\n=== RCSB chemical search ===\', flush=True)\nq={"query":{"type":"terminal","service":"chemical","parameters":{"value":smiles,"type":"descriptor","match_type":"exact"}},"return_type":"entry","request_options":{"results_content_type":["experimental"],"paginate":{"start":0,"rows":25}}}\nfor method in [\'POST\',\'GET\']:\n    try:\n        if method==\'POST\':\n            req=urllib.request.Request(\'https://search.rcsb.org/rcsbsearch/v2/query\', data=json.dumps(q).encode(), headers={\'User-Agent\':\'Mozilla/5.0\',\'Content-Type\':\'application/json\'})\n        else:\n            req=urllib.request.Request(\'https://search.rcsb.org/rcsbsearch/v2/query?json=\'+urllib.parse.quote(json.dumps(q)), headers={\'User-Agent\':\'Mozilla/5.0\'})\n        resp=urllib.request.urlopen(req, timeout=30).read().decode(\'utf-8\',\'replace\')\n        print(f\'{method} response:\', resp[:3000], flush=True)\n        break\n    except Exception as e:\n        print(f\'{method} ERR\', repr(e), flush=True)\n\n# 3. Query each PDB entry for ligands/nonpolymer entities\nprint(\'\\n=== PDB entry ligands ===\', flush=True)\nids=[x.strip().upper() for x in open(\'/app/pdb_ids.txt\') if x.strip()]\nfor pid in ids:\n    try:\n        url=f\'https://data.rcsb.org/rest/v1/core/entry/{pid}\'\n        req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n        j=json.loads(urllib.request.urlopen(req, timeout=15).read().decode(\'utf-8\',\'replace\'))\n        # Look for nonpolymer entity info\n        info=j.get(\'rcsb_entry_info\',{})\n        nonpoly_count=info.get(\'nonpolymer_entity_count\',0)\n        # Try to get polymer entities and nonpolymer entities\n        entities=[]\n        for k,v in j.items():\n            if \'nonpolymer\' in k.lower() or \'ligand\' in k.lower():\n                entities.append((k, str(v)[:200]))\n        # Also get struct title\n        title=j.get(\'struct\',{}).get(\'title\',\'\')\n        print(f\'{pid}: nonpoly_count={nonpoly_count}, title={title[:80]}\', flush=True)\n        if entities:\n            print(f\'  entity fields: {entities[:3]}\', flush=True)\n    except Exception as e:\n        print(f\'{pid}: ERR {repr(e)}\', flush=True)\n\n# 4. Try to get nonpolymer entities for each PDB entry\nprint(\'\\n=== PDB nonpolymer entity details ===\', flush=True)\nfor pid in ids:\n    ligands=[]\n    for eid in range(1, 6):\n        try:\n            url=f\'https://data.rcsb.org/rest/v1/core/nonpolymer_entity/{pid}/{eid}\'\n            req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n            j=json.loads(urllib.request.urlopen(req, timeout=10).read().decode(\'utf-8\',\'replace\'))\n            comp=j.get(\'nonpolymer_comp\',{})\n            comp_id=comp.get(\'id\',\'\')\n            name=comp.get(\'name\',\'\') or j.get(\'rcsb_nonpolymer_entity_container_identifiers\',{}).get(\'comp_id\',\'\')\n            formula=j.get(\'chem_comp\',{}).get(\'formula\',\'\')\n            desc=j.get(\'chem_comp\',{}).get(\'name\',\'\') or j.get(\'pdbx_entity_nonpoly\',{}).get(\'name\',\'\')\n            ligands.append((eid, comp_id, name, desc, formula))\n        except Exception:\n            break\n    if ligands:\n        print(f\'{pid}: {ligands}\', flush=True)\nPY\n'] min_timeout_sec: 20.0 max_timeout_sec: 180.0
Sending keys: ["python3 - <<'PY'\nimport urllib.request, urllib.parse, json, re, sys, time\n\n# Read antibody sequences\nseqs={}\ncur=None\nfor line in open('/app/antibody.fasta'):\n    line=line.strip()\n    if line.startswith('>'):\n        cur=line[1:].split()[0]\n        seqs[cur]=''\n    elif cur:\n        seqs[cur]+=line\n\nheavy=seqs['heavy']\nlight=seqs['light']\n\n# Extract variable regions (before constant region)\n# Heavy chain variable: up to WGQGTLVTVSS or similar\nhv=re.match(r'^(.*?WGQG.{0,10}TVSS)', heavy)\nhv_seq=hv.group(1) if hv else heavy[:120]\n# Light chain variable: up to FGGGTKLEI or similar\nlv=re.match(r'^(.*?FGGGTKLEI)', light)\nlv_seq=lv.group(1) if lv else light[:110]\n\nprint('Heavy variable:', len(hv_seq), hv_seq[-30:], flush=True)\nprint('Light variable:', len(lv_seq), lv_seq[-30:], flush=True)\n\n# Check old BLAST RID\nprint('\\n=== Checking old BLAST RID ===', flush=True)\ntry:\n    params={'CMD':'Get','FORMAT_OBJECT':'SearchInfo','RID':'4H69T3HW014'}\n    req=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode(params), headers={'User-Agent':'Mozilla/5.0'})\n    resp=urllib.request.urlopen(req, timeout=20).read().decode('utf-8','replace')\n    status=re.search(r'Status=(\\S+)', resp)\n    print('Old RID status:', status.group(1) if status else 'unknown', flush=True)\n    if status and status.group(1)=='READY':\n        rparams={'CMD':'Get','FORMAT_TYPE':'JSON2','ALIGNMENT_VIEW':'Pairwise','RID':'4H69T3HW014','RESULTS_FILE':'true'}\n        rreq=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode(rparams), headers={'User-Agent':'Mozilla/5.0'})\n        rresp=urllib.request.urlopen(rreq, timeout=60).read().decode('utf-8','replace')\n        print('Old BLAST results:', rresp[:3000], flush=True)\nexcept Exception as e:\n    print('Old RID check ERR', repr(e), flush=True)\n\n# New BLAST against pdb (faster)\nprint('\\n=== BLAST heavy variable against pdb ===', flush=True)\nfor name, seq in [('heavy_var', hv_seq), ('light_var', lv_seq)]:\n    try:\n        params={'CMD':'Put','PROGRAM':'blastp','DATABASE':'pdb','QUERY':seq,'FORMAT_TYPE':'JSON2','HITLIST_SIZE':'10','EXPECT':'10'}\n        data=urllib.parse.urlencode(params).encode()\n        req=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi', data=data, headers={'User-Agent':'Mozilla/5.0'})\n        resp=urllib.request.urlopen(req, timeout=20).read().decode('utf-8','replace')\n        rid=re.search(r'RID = (\\S+)', resp)\n        if rid:\n            rid=rid.group(1)\n            print(f'{name} RID:', rid, flush=True)\n            for i in range(15):\n                time.sleep(5)\n                gparams={'CMD':'Get','FORMAT_OBJECT':'SearchInfo','RID':rid}\n                greq=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode(gparams), headers={'User-Agent':'Mozilla/5.0'})\n                gresp=urllib.request.urlopen(greq, timeout=20).read().decode('utf-8','replace')\n                status=re.search(r'Status=(\\S+)', gresp)\n                if status:\n                    st=status.group(1)\n                    print(f'  status: {st}', flush=True)\n                    if st in ('READY','FAILED','UNKNOWN'):\n                        if st=='READY':\n                            rparams={'CMD':'Get','FORMAT_TYPE':'JSON2','ALIGNMENT_VIEW':'Pairwise','RID':rid,'RESULTS_FILE':'true'}\n                            rreq=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode(rparams), headers={'User-Agent':'Mozilla/5.0'})\n                            rresp=urllib.request.urlopen(rreq, timeout=60).read().decode('utf-8','replace')\n                            # Extract hit descriptions\n                            hits=re.findall(r'Description: (.+?)\\n', rresp)\n                            print(f'  Hits: {hits[:10]}', flush=True)\n                            print(f'  Results snippet: {rresp[:2000]}', flush=True)\n                        break\n                else:\n                    print('  no status', flush=True)\n                    break\n        else:\n            print(f'{name}: No RID', resp[:500], flush=True)\n    except Exception as e:\n        print(f'{name} BLAST ERR', repr(e), flush=True)\nPY\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
Sending keys: ['python3 - <<\'PY\'\nimport urllib.request, json, re, sys\n\n# Extract DHFR from plasmid.gb\nprint(\'=== Extract DHFR from plasmid ===\', flush=True)\ngenbank=open(\'/app/plasmid.gb\').read()\n# Get translation from CDS\ncds_match=re.search(r\'/translation="([^"]+)"\', genbank.replace(\'\\n\',\' \').replace(\'  \',\' \'))\nif cds_match:\n    dhfr_full=cds_match.group(1).replace(\' \',\'\')\n    print(\'DHFR full protein:\', len(dhfr_full), dhfr_full[:60], \'...\', dhfr_full[-30:], flush=True)\n    # Remove N-terminal Met\n    dhfr=dhfr_full[1:] if dhfr_full[0]==\'M\' else dhfr_full\n    print(\'DHFR without Met:\', len(dhfr), dhfr[:60], flush=True)\n\n# Also extract DNA sequence from CDS location 88..567\norigin_match=re.search(r\'ORIGIN(.+)//\', genbank, re.DOTALL)\nif origin_match:\n    raw=origin_match.group(1)\n    dna=\'\'.join(c for c in raw if c in \'ACGTacgt\')\n    print(\'Plasmid DNA length:\', len(dna), flush=True)\n    # DHFR CDS is at 88..567 (1-based)\n    dhfr_dna=dna[87:567]\n    print(\'DHFR DNA:\', dhfr_dna, flush=True)\n    print(\'DHFR DNA length:\', len(dhfr_dna), flush=True)\n\n# Get FPbase sequences for Clover and mCherry\nprint(\'\\n=== FPbase sequences ===\', flush=True)\nurl=\'https://www.fpbase.org/api/proteins/?format=json\'\nreq=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\nprots=json.loads(urllib.request.urlopen(req, timeout=60).read().decode(\'utf-8\',\'replace\'))\nfor p in prots:\n    if p.get(\'slug\') in (\'clover\',\'mcherry\'):\n        seq=p.get(\'seq\',\'\')\n        states=p.get(\'states\',[])\n        print(f"\\n{p[\'name\']} ({p[\'slug\']}):", flush=True)\n        print(f\'  pdb={p.get("pdb")}, states={[(s.get("ex_max"),s.get("em_max")) for s in states]}\', flush=True)\n        print(f\'  seqlen={len(seq)}, seq={seq}\', flush=True)\n\n# Get PDB FASTA for 5WJ2 and 2H5Q\nprint(\'\\n=== PDB FASTA for Clover/mCherry ===\', flush=True)\nfor pid in [\'5WJ2\',\'2H5Q\']:\n    url=f\'https://www.rcsb.org/fasta/entry/{pid}\'\n    req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n    data=urllib.request.urlopen(req, timeout=15).read().decode(\'utf-8\',\'replace\')\n    # Parse sequence\n    lines=data.strip().split(\'\\n\')\n    hdr=lines[0]\n    seq=\'\'.join(lines[1:])\n    print(f\'{pid}: hdr={hdr[:80]}\', flush=True)\n    print(f\'  seqlen={len(seq)}, seq={seq}\', flush=True)\n\n# Compare FPbase vs PDB\nprint(\'\\n=== Compare FPbase vs PDB ===\', flush=True)\nfpbase={}\nfor p in prots:\n    if p.get(\'slug\') in (\'clover\',\'mcherry\'):\n        fpbase[p[\'slug\']]=p.get(\'seq\',\'\')\n\n# Get PDB sequences again\npdb_seqs={}\nfor pid in [\'5WJ2\',\'2H5Q\']:\n    url=f\'https://www.rcsb.org/fasta/entry/{pid}\'\n    req=urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n    data=urllib.request.urlopen(req, timeout=15).read().decode(\'utf-8\',\'replace\')\n    lines=data.strip().split(\'\\n\')\n    pdb_seqs[pid]=\'\'.join(lines[1:])\n\nclover_fp=fpbase.get(\'clover\',\'\')\nclover_pdb=pdb_seqs.get(\'5WJ2\',\'\')\nmcherry_fp=fpbase.get(\'mcherry\',\'\')\nmcherry_pdb=pdb_seqs.get(\'2H5Q\',\'\')\n\nprint(\'Clover FPbase len:\', len(clover_fp), \'PDB len:\', len(clover_pdb), flush=True)\nprint(\'mCherry FPbase len:\', len(mcherry_fp), \'PDB len:\', len(mcherry_pdb), flush=True)\n\n# Find where FPbase sequence matches within PDB sequence\nif clover_fp and clover_pdb:\n    for i in range(len(clover_pdb)-len(clover_fp)+1):\n        mismatches=sum(1 for a,b in zip(clover_pdb[i:i+len(clover_fp)], clover_fp) if a!=b)\n        if mismatches<=5:\n            print(f\'Clover: FPbase matches PDB at offset {i}, mismatches={mismatches}\', flush=True)\n            diff=[(j, clover_pdb[i+j], clover_fp[j]) for j in range(min(len(clover_fp),len(clover_pdb)-i)) if clover_pdb[i+j]!=clover_fp[j]]\n            print(f\'  Differences: {diff}\', flush=True)\n            break\n\nif mcherry_fp and mcherry_pdb:\n    mismatches=sum(1 for a,b in zip(mcherry_pdb, mcherry_fp) if a!=b)\n    diff=[(i, mcherry_pdb[i], mcherry_fp[i]) for i in range(min(len(mcherry_fp),len(mcherry_pdb))) if mcherry_pdb[i]!=mcherry_fp[i]]\n    print(f\'mCherry: mismatches with PDB={mismatches}, diff={diff}\', flush=True)\nPY\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
