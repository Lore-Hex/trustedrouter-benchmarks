ase proteins with PDB overlap regardless of ex/em\nprint(\'\\nFPbase proteins with PDB overlap:\', flush=True)\nfor p in prots:\n    pdb_ids=set(p.get(\'pdb\',[]) or [])\n    if pdb_ids & idset:\n        states=p.get(\'states\',[])\n        print(p.get(\'name\'), \'slug\', p.get(\'slug\'), \'pdb\', pdb_ids & idset, \'states\', [(st.get(\'ex_max\'),st.get(\'em_max\')) for st in states], \'seqlen\', len(p.get(\'seq\',\'\')), flush=True)\n\n# Search RCSB for ligand by SMILES\nsmiles=\'Nc3nc(OCc1ccccc1)c2nc[nH]c2n3\'\nprint(\'\\nSearching RCSB for SMILES:\', smiles, flush=True)\nsearch_url=\'https://search.rcsb.org/rcsbsearch/v2/query?json=\' + urllib.parse.quote(json.dumps({\n  "query": {\n    "type": "terminal",\n    "service": "chemical",\n    "parameters": {\n      "value": smiles,\n      "type": "descriptor",\n      "match_type": "exact"\n    }\n  },\n  "return_type": "entry",\n  "request_options": {"results_content_type": ["experimental"], "paginate": {"start": 0, "rows": 25}}\n}))\ntry:\n    req=urllib.request.Request(search_url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n    resp=urllib.request.urlopen(req, timeout=30).read().decode(\'utf-8\',\'replace\')\n    print(\'Search response:\', resp[:3000], flush=True)\nexcept Exception as e:\n    print(\'SMILES search ERR\', repr(e), flush=True)\n    # Try simpler chemical search\n    for desc_type in [\'smiles\',\'inchi\',\'inchikey\']:\n        try:\n            q={"query":{"type":"terminal","service":"chemical","parameters":{"value":smiles,"type":"descriptor","match_type":"exact"}},"return_type":"entry","request_options":{"results_content_type":["experimental"],"paginate":{"start":0,"rows":25}}}\n            su=\'https://search.rcsb.org/rcsbsearch/v2/query?json=\'+urllib.parse.quote(json.dumps(q))\n            req=urllib.request.Request(su, headers={\'User-Agent\':\'Mozilla/5.0\'})\n            resp=urllib.request.urlopen(req, timeout=30).read().decode(\'utf-8\',\'replace\')\n            print(\'desc_type\', desc_type, resp[:2000], flush=True)\n            break\n        except Exception as e2:\n            print(\'desc_type\', desc_type, \'ERR\', repr(e2), flush=True)\nPY\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
Sending keys: ["python3 - <<'PY'\nimport urllib.request, urllib.parse, json, re, sys, time\n\n# Read antibody sequences\nseqs={}\ncur=None\nfor line in open('/app/antibody.fasta'):\n    line=line.strip()\n    if line.startswith('>'):\n        cur=line[1:].split()[0]\n        seqs[cur]=''\n    elif cur:\n        seqs[cur]+=line\nprint('Antibody seqs:', {k:len(v) for k,v in seqs.items()}, flush=True)\nheavy=seqs.get('heavy','')\nlight=seqs.get('light','')\nprint('Heavy first 80:', heavy[:80], flush=True)\nprint('Light first 80:', light[:80], flush=True)\n\n# Try NCBI BLAST URLAPI for heavy chain CDR3 region or full sequence\n# Use the full heavy chain variable region\nfor name,seq in [('heavy',heavy),('light',light)]:\n    print('\\n=== BLAST', name, '===', flush=True)\n    params={\n        'CMD':'Put',\n        'PROGRAM':'blastp',\n        'DATABASE':'nr',\n        'QUERY':seq,\n        'FORMAT_TYPE':'JSON2',\n        'HITLIST_SIZE':'10',\n        'EXPECT':'10',\n    }\n    try:\n        data=urllib.parse.urlencode(params).encode()\n        req=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi', data=data, headers={'User-Agent':'Mozilla/5.0'})\n        resp=urllib.request.urlopen(req, timeout=30).read().decode('utf-8','replace')\n        rid=re.search(r'RID = (\\S+)', resp)\n        if rid:\n            rid=rid.group(1)\n            print('RID', rid, flush=True)\n            for i in range(20):\n                time.sleep(8)\n                gparams={'CMD':'Get','FORMAT_OBJECT':'SearchInfo','RID':rid}\n                greq=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode(gparams), headers={'User-Agent':'Mozilla/5.0'})\n                gresp=urllib.request.urlopen(greq, timeout=30).read().decode('utf-8','replace')\n                status=re.search(r'Status=(\\S+)', gresp)\n                if status:\n                    print('status', status.group(1), flush=True)\n                    if status.group(1) in ('READY','FAILED','UNKNOWN'):\n                        if status.group(1)=='READY':\n                            rparams={'CMD':'Get','FORMAT_TYPE':'JSON2','ALIGNMENT_VIEW':'Pairwise','RID':rid,'RESULTS_FILE':'true'}\n                            rreq=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode(rparams), headers={'User-Agent':'Mozilla/5.0'})\n                            rresp=urllib.request.urlopen(rreq, timeout=60).read().decode('utf-8','replace')\n                            print('Results snippet:', rresp[:3000], flush=True)\n                        break\n                else:\n                    print('no status, snippet:', gresp[:500], flush=True)\n                    break\n        else:\n            print('No RID found, resp snippet:', resp[:1000], flush=True)\n    except Exception as e:\n        print('BLAST ERR', name, repr(e), flush=True)\nPY\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
