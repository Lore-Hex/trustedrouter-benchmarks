Sending keys: ["python3 - <<'PY'\nimport re\n\ntext=open('/app/ocr_1s.txt').read()\nparts=re.split(r'===== (\\d+) =====', text)\nframes=[]\nfor k in range(1,len(parts),2):\n    t=int(parts[k])\n    content=parts[k+1].strip()\n    lines=content.splitlines()\n    cmds=[l[1:].strip() for l in lines if l.startswith('>')]\n    last=cmds[-1] if cmds else None\n    frames.append((t,last,content))\n\n# Build sequence of (t, last_cmd) ignoring None\ngroups=[]\ncurrent=[]\nfor t,last,content in frames:\n    if last is None:\n        continue\n    norm=last.rstrip('_').strip()\n    if not norm and not current:\n        continue\n    if not current:\n        current=[(t,norm)]\n    else:\n        prev_t,prev_cmd=current[-1]\n        # Same or growing command\n        if norm==prev_cmd or norm.startswith(prev_cmd) or prev_cmd.startswith(norm):\n            current.append((t,norm))\n        else:\n            groups.append(current)\n            current=[(t,norm)]\nif current:\n    groups.append(current)\n\n# For each group take longest\ngrouped_moves=[]\nfor g in groups:\n    best=max(g,key=lambda x:len(x[1]))\n    grouped_moves.append(best)\n\n# Apply corrections\ncorrections={\n    'drpo':'drop',\n    'def late':'deflate',\n    'wW':'w',\n    'swW':'sw',\n    'Dopen':'open',\n    'eage':'cage',\n    'ease':'cage',\n    'elose':'close',\n    '1lid':'lid',\n    'dounuard':'downward',\n    'feaneh feacwid § poinp iehtY':'',\n    'bar ,eme':'bar,emeral',\n    'trun':'trunk',\n    'sha':'sharp',\n    'pu':'pump',\n    'ged':'get red',\n    'la':'launch',\n}\nmoves=[]\nfor t,cmd in grouped_moves:\n    for bad,good in corrections.items():\n        cmd=cmd.replace(bad,good)\n    cmd=cmd.strip()\n    if cmd:\n        moves.append((t,cmd))\n\nwith open('/app/moves_final.txt','w') as f:\n    for i,(t,cmd) in enumerate(moves,1):\n        f.write(f'{i:3d} t={t:3d}: {cmd}\\n')\nprint(f'Total moves: {len(moves)}')\nPY\ncat /app/moves_final.txt\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
