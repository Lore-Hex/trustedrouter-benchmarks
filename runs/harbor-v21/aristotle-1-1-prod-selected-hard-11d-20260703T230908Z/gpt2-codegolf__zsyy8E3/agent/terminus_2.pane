[?2004l[?2004h>             while k<len(s) and s[k].isspace():k+=1
[?2004l[?2004h>             if k<len(s) and k>i+1:k-=1
[?2004l[?2004h>         tokens.append(s[i:k]);i=k
[?2004l[?2004h>     return tokens
