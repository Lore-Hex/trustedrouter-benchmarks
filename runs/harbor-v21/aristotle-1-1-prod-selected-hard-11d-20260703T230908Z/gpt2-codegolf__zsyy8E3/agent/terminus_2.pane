python3 - <<'PY'
import struct,math
V,H,N,L,C,M,A,D=50257,768,1024,12,2304,3072,12,64
BS=7087872;P=C+H*C+H+H*H
f=open('/app/gpt2-124M.ckpt','rb')
def Fa(o,n):
 f.seek(o*4);return list(struct.unpack('<%df'%n,f.read(n*4)))
def ln(x,g,b):
 m=sum(x)/H;v=sum((xi-m)**2 for xi in x)/H;iv=1/math.sqrt(v+1e-5)
 return[(xi-m)*iv*gi+bi for xi,gi,bi in zip(x,g,b)]
def ge(x):return .5*x*(1+math.tanh(.7978845608*(x+.044715*x**3)))
def li(x,w,b,inn,out):
 y=b[:]
 for i in range(inn):
  xi=x[i];base=i*out
  for j in range(out):y[j]+=xi*w[base+j]
 return y
wte_all=Fa(85842432,V*H)
def top5(x):
 lf=ln(x,Fa(85055232,H),Fa(85054464,H))
 best=[]
 for j in range(V):
  base=j*H;s=sum(lf[i]*wte_all[base+i] for i in range(H))
  if len(best)<5 or s>best[0][0]:best.append((s,j));best=sorted(best,key=lambda t:t[0]);best=best[-5:]
 return [(j,round(s,2)) for s,j in reversed(best)]
# Get wpe for pos p in [N,H] layout (standard)
def wpe_NH(p):return Fa(85056000+p*H,H)
# Get wpe for pos p in [H,N] layout (transposed)
def wpe_HN(p):return [Fa(85056000+i*N+p,1)[0] for i in range(H)]
# Check if [H,N] wpe values look more reasonable
print('wpe [N,H] pos0 first4:', [round(x,4) for x in wpe_NH(0)[:4]])
print('wpe [N,H] pos1 first4:', [round(x,4) for x in wpe_NH(1)[:4]])
print('wpe [H,N] pos0 first4:', [round(x,4) for x in wpe_HN(0)[:4]])
print('wpe [H,N] pos1 first4:', [round(x,4) for x in wpe_HN(1)[:4]])
# Test forward pass with [H,N] wpe
def test_wpe_HN():
 kc=[[None]*N for _ in range(L)]
 vc=[[None]*N for _ in range(L)]
 def fwd(tok,pos):
  we=Fa(85842432+tok*H,H)
  pe=wpe_HN(pos)
  x=[a+b for a,b in zip(we,pe)]
  for l in range(L):
   o=l*BS
   lx=ln(x,Fa(o+P+H,H),Fa(o+P,H))
   q=li(lx,Fa(o+C,H*C),Fa(o,C),H,C)
   kc[l][pos]=q[H:2*H];vc[l][pos]=q[2*H:3*H]
   ao=[0]*H
   for h in range(A):
    qq=q[h*D:(h+1)*D];sc=[]
    for j in range(pos+1):
     k=kc[l][j][h*D:(h+1)*D];s=sum(qq[d]*k[d] for d in range(D))/8;sc.append(s)
    mx=max(sc);sm=sum(math.exp(s-mx) for s in sc);oo=[0]*D
    for j in range(pos+1):
     v=vc[l][j][h*D:(h+1)*D];w=math.exp(sc[j]-mx)/sm
     for d in range(D):oo[d]+=w*v[d]
    for d in range(D):ao[h*D+d]=oo[d]
   h2=li(ao,Fa(o+C+H*C+H,H*H),Fa(o+C+H*C,H),H,H)
   x=[x[i]+h2[i] for i in range(H)]
   lx=ln(x,Fa(o+P+3*H,H),Fa(o+P+2*H,H))
   h1=[ge(v) for v in li(lx,Fa(o+P+4*H+M,H*M),Fa(o+P+4*H,M),H,M)]
   h2=li(h1,Fa(o+P+4*H+M+H*M+H,M*H),Fa(o+P+4*H+M+H*M,H),M,H)
   x=[x[i]+h2[i] for i in range(H)]
  return top5(x)
 return fwd(15496,0),fwd(11,1)
print('wpe [H,N] test:',test_wpe_HN())
# Also test transposed wte for logits [H,V] instead of [V,H]
def test_wte_HV():
 kc=[[None]*N for _ in range(L)]
 vc=[[None]*N for _ in range(L)]
 def fwd(tok,pos):
  x=[a+b for a,b in zip(Fa(85842432+tok*H,H),Fa(85056000+pos*H,H))]
  for l in range(L):
   o=l*BS
   lx=ln(x,Fa(o+P+H,H),Fa(o+P,H))
   q=li(lx,Fa(o+C,H*C),Fa(o,C),H,C)
   kc[l][pos]=q[H:2*H];vc[l][pos]=q[2*H:3*H]
   ao=[0]*H
   for h in range(A):
    qq=q[h*D:(h+1)*D];sc=[]
    for j in range(pos+1):
     k=kc[l][j][h*D:(h+1)*D];s=sum(qq[d]*k[d] for d in range(D))/8;sc.append(s)
    mx=max(sc);sm=sum(math.exp(s-mx) for s in sc);oo=[0]*D
    for j in range(pos+1):
     v=vc[l][j][h*D:(h+1)*D];w=math.exp(sc[j]-mx)/sm
     for d in range(D):oo[d]+=w*v[d]
    for d in range(D):ao[h*D+d]=oo[d]
   h2=li(ao,Fa(o+C+H*C+H,H*H),Fa(o+C+H*C,H),H,H)
   x=[x[i]+h2[i] for i in range(H)]
   lx=ln(x,Fa(o+P+3*H,H),Fa(o+P+2*H,H))
   h1=[ge(v) for v in li(lx,Fa(o+P+4*H+M,H*M),Fa(o+P+4*H,M),H,M)]
   h2=li(h1,Fa(o+P+4*H+M+H*M+H,M*H),Fa(o+P+4*H+M+H*M,H),M,H)
   x=[x[i]+h2[i] for i in range(H)]
  lf=ln(x,Fa(85055232,H),Fa(85054464,H))
  # Transposed wte: [H,V], so token j, feature i = W[85056000+i*V+j]
  best=[]
  for j in range(V):
   s=sum(lf[i]*Fa(85842432+i*V+j,1)[0] for i in range(H))
   if len(best)<5 or s>best[0][0]:best.append((s,j));best=sorted(best,key=lambda t:t[0]);best=best[-5:]
  return [(j,round(s,2)) for s,j in reversed(best)]
 return fwd(15496,0),fwd(11,1)
print('wte [H,V] test:',test_wte_HV())
