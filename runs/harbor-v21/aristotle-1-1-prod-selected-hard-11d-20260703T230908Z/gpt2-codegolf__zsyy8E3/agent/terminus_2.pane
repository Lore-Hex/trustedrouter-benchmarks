python3 - <<'PY'
import struct,math
V,H,N,L,C,M,A,D=50257,768,1024,12,2304,3072,12,64
BS=7087872;P=C+H*C+H+H*H
f=open('/app/gpt2-124M.ckpt','rb')
def Fa(o,n):
 f.seek(o*4);return list(struct.unpack('<%df'%n,f.read(n*4)))
def ln(x,g,b):
 m=sum(x)/H;v=sum((xi-m)**2 for xi in x)/H;iv=1/math.sqrt(v+1e-5)
 return[(xi-m)*iv*gi+bi for xi,gi,bi in zip(x,g,b)]
def ge(x):return .5*x*(1+math.tanh(.7978845608*(x+.044715*x**3)))
def li(x,w,b,inn,out):
 y=b[:]
 for i in range(inn):
  xi=x[i];base=i*out
  for j in range(out):y[j]+=xi*w[base+j]
 return y
wte_all=Fa(85842432,V*H)
def get_top3(x):
 lf=ln(x,Fa(85055232,H),Fa(85054464,H))
 best=[]
 for j in range(V):
  base=j*H;s=sum(lf[i]*wte_all[base+i] for i in range(H))
  if len(best)<3 or s>best[0][0]:best.append((s,j));best=sorted(best,key=lambda t:t[0]);best=best[-3:]
 return [(j,round(s,2)) for s,j in reversed(best)]

# Test interleaved head structure
def test_interleaved():
 kc=[[None]*N for _ in range(L)]
 vc=[[None]*N for _ in range(L)]
 def fwd(tok,pos):
  x=[a+b for a,b in zip(Fa(85842432+tok*H,H),Fa(85056000+pos*H,H))]
  for l in range(L):
   o=l*BS
   lx=ln(x,Fa(o+P+H,H),Fa(o+P,H))
   q=li(lx,Fa(o+C,H*C),Fa(o,C),H,C)
   # Interleaved: each 192-block is [Q_head(64), K_head(64), V_head(64)]
   ao=[0]*H
   for h in range(A):
    base=h*3*D
    Q=q[base:base+D];K=q[base+D:base+2*D];Vv=q[base+2*D:base+3*D]
    kc[l][pos]=kc[l][pos] or [0]*H
    vc[l][pos]=vc[l][pos] or [0]*H
    # Store K,V for this head
    k_all=[0]*H;v_all=[0]*H
   # Need to store per-head K,V separately
   # Actually store all heads' K,V
   k_full=[0]*H;v_full=[0]*H
   for h in range(A):
    base=h*3*D
    for d in range(D):
     k_full[h*D+d]=q[base+D:base+2*D][d]
     v_full[h*D+d]=q[base+2*D:base+3*D][d]
   kc[l][pos]=k_full;vc[l][pos]=v_full
   for h in range(A):
    base=h*3*D
    qq=q[base:base+D];sc=[]
    for j in range(pos+1):
     k=kc[l][j][h*D:(h+1)*D];s=sum(qq[d]*k[d] for d in range(D))/8;sc.append(s)
    mx=max(sc);sm=sum(math.exp(s-mx) for s in sc);oo=[0]*D
    for j in range(pos+1):
     v=vc[l][j][h*D:(h+1)*D];w=math.exp(sc[j]-mx)/sm
     for d in range(D):oo[d]+=w*v[d]
    for d in range(D):ao[h*D+d]=oo[d]
   h2=li(ao,Fa(o+C+H*C+H,H*H),Fa(o+C+H*C,H),H,H)
   x=[x[i]+h2[i] for i in range(H)]
   lx=ln(x,Fa(o+P+3*H,H),Fa(o+P+2*H,H))
   h1=[ge(v) for v in li(lx,Fa(o+P+4*H+M,H*M),Fa(o+P+4*H,M),H,M)]
   h2=li(h1,Fa(o+P+4*H+M+H*M+H,M*H),Fa(o+P+4*H+M+H*M,H),M,H)
   x=[x[i]+h2[i] for i in range(H)]
  return get_top3(x)
 return fwd(15496,0),fwd(11,1)

# Test different attention scales
def test_scale(scale):
 kc=[[None]*N for _ in range(L)]
 vc=[[None]*N for _ in range(L)]
 def fwd(tok,pos):
  x=[a+b for a,b in zip(Fa(85842432+tok*H,H),Fa(85056000+pos*H,H))]
  for l in range(L):
   o=l*BS
   lx=ln(x,Fa(o+P+H,H),Fa(o+P,H))
   q=li(lx,Fa(o+C,H*C),Fa(o,C),H,C)
   kc[l][pos]=q[H:2H];vc[l][pos]=q[2H:3H]
   ao=[0]*H
   for h in range(A):
    qq=q[h*D:(h+1)*D];sc=[]
    for j in range(pos+1):
     k=kc[l][j][h*D:(h+1)*D];s=sum(qq[d]*k[d] for d in range(D))/scale;sc.append(s)
    mx=max(sc);sm=sum(math.exp(s-mx) for s in sc);oo=[0]*D
    for j in range(pos+1):
     v=vc[l][j][h*D:(h+1)*D];w=math.exp(sc[j]-mx)/sm
     for d in range(D):oo[d]+=w*v[d]
    for d in range(D):ao[h*D+d]=oo[d]
   h2=li(ao,Fa(o+C+H*C+H,H*H),Fa(o+C+H*C,H),H,H)
   x=[x[i]+h2[i] for i in range(H)]
   lx=ln(x,Fa(o+P+3*H,H),Fa(o+P+2*H,H))
   h1=[ge(v) for v in li(lx,Fa(o+P+4*H+M,H*M),Fa(o+P+4*H,M),H,M)]
   h2=li(h1,Fa(o+P+4*H+M+H*M+H,M*H),Fa(o+P+4*H+M+H*M,H),M,H)
   x=[x[i]+h2[i] for i in range(H)]
  return get_top3(x)
 return fwd(15496,0),fwd(11,1)

# Scan first block for 768-float windows with mean near 1.0 (wider range)
print('=== Scanning for LN gains (mean 0.5-3.0) ===')
for off in range(0,BS-H+1,H):
 v=Fa(off,H)
 m=sum(v)/H
 if 0.5<m<3.0:
  var=sum((x-m)**2 for x in v)/H
  pos_count=sum(1 for x in v if x>0)
  print(f'offset {off} ({off/BS*100:.1f}%): mean={m:.4f} var={var:.6f} pos={pos_count}/{H} first4={[round(x,3) for x in v[:4]]}')

print('=== Testing interleaved heads ===')
try: print(test_interleaved())
