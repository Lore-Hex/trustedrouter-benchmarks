import struct,math
V,H,N,L,C,M,A,D=50257,768,1024,12,2304,3072,12,64
BS=7087872;P=C+H*C+H+H*H
f=open('/app/gpt2-124M.ckpt','rb')
def Fa(o,n):
 f.seek(o*4);return list(struct.unpack('<%df'%n,f.read(n*4)))
def ln(x,g,b):
 m=sum(x)/H;v=sum((xi-m)**2 for xi in x)/H;iv=1/math.sqrt(v+1e-5)
 return[(xi-m)*iv*gi+bi for xi,gi,bi in zip(x,g,b)]
def ge(x):return .5*x*(1+math.tanh(.7978845608*(x+.044715*x**3)))
def li(x,w,b,inn,out):
 y=b[:]
 for i in range(inn):
  xi=x[i];base=i*out
  for j in range(out):y[j]+=xi*w[base+j]
 return y
kc=[[None]*N for _ in range(L)]
vc=[[None]*N for _ in range(L)]
def fwd(tok,pos,debug=False):
 x=[a+b for a,b in zip(Fa(85842432+tok*H,H),Fa(85056000+pos*H,H))]
 for l in range(L):
  o=l*BS
  lx=ln(x,Fa(o+P+H,H),Fa(o+P,H))
  q=li(lx,Fa(o+C,H*C),Fa(o,C),H,C)
  kc[l][pos]=q[H:2*H];vc[l][pos]=q[2*H:3*H]
  ao=[0]*H
  for h in range(A):
   qq=q[h*D:(h+1)*D];sc=[]
   for j in range(pos+1):
    k=kc[l][j][h*D:(h+1)*D];s=sum(qq[d]*k[d] for d in range(D))/8;sc.append(s)
   mx=max(sc);sm=sum(math.exp(s-mx) for s in sc);oo=[0]*D
   weights=[math.exp(sc[j]-mx)/sm for j in range(pos+1)]
   if debug and l==0 and h==0:
    print(f'  L0H0 pos{pos} scores={sc[:4]} weights={weights[:4]}')
    print(f'  L0H0 pos{pos} Q[:4]={qq[:4]} K0[:4]={kc[l][0][h*D:h*D+4]}')
   for j in range(pos+1):
    v=vc[l][j][h*D:(h+1)*D];w=weights[j]
    for d in range(D):oo[d]+=w*v[d]
   for d in range(D):ao[h*D+d]=oo[d]
  h2=li(ao,Fa(o+C+H*C+H,H*H),Fa(o+C+H*C,H),H,H)
  x=[x[i]+h2[i] for i in range(H)]
  if debug and l==0:print(f' L0 pos{pos} after attn norm={math.sqrt(sum(xi**2 for xi in x)/H):.3f}')
  lx=ln(x,Fa(o+P+3*H,H),Fa(o+P+2*H,H))
  h1=[ge(v) for v in li(lx,Fa(o+P+4*H+M,H*M),Fa(o+P+4*H,M),H,M)]
  h2=li(h1,Fa(o+P+4*H+M+H*M+H,M*H),Fa(o+P+4*H+M+H*M,H),M,H)
  x=[x[i]+h2[i] for i in range(H)]
  if debug and l==0:print(f' L0 pos{pos} after mlp norm={math.sqrt(sum(xi**2 for xi in x)/H):.3f}')
 lf=ln(x,Fa(85055232,H),Fa(85054464,H))
 wte=Fa(85842432,V*H)
 best=[]
 for j in range(V):
  base=j*H;s=sum(lf[i]*wte[base+i] for i in range(H))
  if len(best)<5 or s>best[0][0]:
   best.append((s,j));best=sorted(best,key=lambda t:t[0])
   if len(best)>5:best=best[1:]
 return [(j,round(s,2)) for s,j in reversed(best)]
print('=== Position 0 (Hello=15496) ===')
print('result:',fwd(15496,0,debug=True))
print('=== Position 1 (comma=11) ===')
print('result:',fwd(11,1,debug=True))
PY
