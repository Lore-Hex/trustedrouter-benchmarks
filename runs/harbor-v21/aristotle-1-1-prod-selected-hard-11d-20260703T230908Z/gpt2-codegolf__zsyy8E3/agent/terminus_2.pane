[?2004lpython3 - <<'PY'
import struct,math
V,H,N,L,C,M,A,D=50257,768,1024,12,2304,3072,12,64
BS=7087872;P=C+H*C+H+H*H
f=open('/app/gpt2-124M.ckpt','rb')
def Fa(o,n):
 f.seek(o*4);return list(struct.unpack('<%df'%n,f.read(n*4)))
def ln(x,g,b):
 m=sum(x)/H;v=sum((xi-m)**2 for xi in x)/H;iv=1/math.sqrt(v+1e-5)
 return[(xi-m)*iv*gi+bi for xi,gi,bi in zip(x,g,b)]
def ge(x):return .5*x*(1+math.tanh(.7978845608*(x+.044715*x**3)))
def li(x,w,b,inn,out):
 y=b[:]
 for i in range(inn):
  xi=x[i];base=i*out
  for j in range(out):y[j]+=xi*w[base+j]
 return y
def li_t(x,w,b,inn,out):
 y=b[:]
 for j in range(out):
  base=j*inn;s=0
  for i in range(inn):s+=x[i]*w[base+i]
  y[j]+=s
 return y
wte_all=Fa(85842432,V*H)
def top3_and_norm(x,debug_norm=False):
 lf=ln(x,Fa(85055232,H),Fa(85054464,H))
 best=[]
 for j in range(V):
  base=j*H;s=sum(lf[i]*wte_all[base+i] for i in range(H))
  if len(best)<3 or s>best[0][0]:best.append((s,j));best=sorted(best,key=lambda t:t[0]);best=best[-3:]
 return [(j,round(s,2)) for s,j in reversed(best)]
def test_transpose(t_attn,t_proj,t_fc,t_proj_mlp):
 kc=[[None]*N for _ in range(L)]
 vc=[[None]*N for _ in range(L)]
 def fwd(tok,pos):
  x=[a+b for a,b in zip(Fa(85842432+tok*H,H),Fa(85056000+pos*H,H))]
  for l in range(L):
   o=l*BS
   lx=ln(x,Fa(o+P+H,H),Fa(o+P,H))
   q=(li_t if t_attn else li)(lx,Fa(o+C,H*C),Fa(o,C),H,C)
   kc[l][pos]=q[H:2*H];vc[l][pos]=q[2*H:3*H]
   ao=[0]*H
   for h in range(A):
    qq=q[h*D:(h+1)*D];sc=[]
    for j in range(pos+1):
     k=kc[l][j][h*D:(h+1)*D];s=sum(qq[d]*k[d] for d in range(D))/8;sc.append(s)
    mx=max(sc);sm=sum(math.exp(s-mx) for s in sc);oo=[0]*D
    for j in range(pos+1):
     v=vc[l][j][h*D:(h+1)*D];w=math.exp(sc[j]-mx)/sm
     for d in range(D):oo[d]+=w*v[d]
    for d in range(D):ao[h*D+d]=oo[d]
   h2=(li_t if t_proj else li)(ao,Fa(o+C+H*C+H,H*H),Fa(o+C+H*C,H),H,H)
   x=[x[i]+h2[i] for i in range(H)]
   lx=ln(x,Fa(o+P+3*H,H),Fa(o+P+2*H,H))
   h1=[ge(v) for v in (li_t if t_fc else li)(lx,Fa(o+P+4*H+M,H*M),Fa(o+P+4*H,M),H,M)]
   h2=(li_t if t_proj_mlp else li)(h1,Fa(o+P+4*H+M+H*M+H,M*H),Fa(o+P+4*H+M+H*M,H),M,H)
   x=[x[i]+h2[i] for i in range(H)]
   if l==0 and pos==0:
    n0=math.sqrt(sum(xi**2 for xi in x)/H)
   if l==1 and pos==0:
    n1=math.sqrt(sum(xi**2 for xi in x)/H)
  return top3_and_norm(x),n0,n1
 r0,n0,n1=fwd(15496,0)
 r1,_,_=fwd(11,1)
 return r0,r1,n0,n1
tests=[
 ('none',False,False,False,False),
 ('attn',True,False,False,False),
 ('proj',False,True,False,False),
 ('fc',False,False,True,False),
 ('proj_mlp',False,False,False,True),
 ('attn+proj',True,True,False,False),
 ('fc+proj_mlp',False,False,True,True),
 ('all',True,True,True,True),
]
for name,ta,tp,tf,tm in tests:
 r0,r1,n0,n1=test_transpose(ta,tp,tf,tm)
 print(f'{name}: pos0={r0} pos1={r1} n0={n0:.2f} n1={n1:.2f}')
