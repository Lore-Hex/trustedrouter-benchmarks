[?2004l[?2004h>         if val < thresh:
[?2004l[?2004h>             continue
[?2004l[?2004h>         if val >= slope_jumps[i-1] and val >= slope_jumps[i+1] and val > 1e-5:
[?2004l[?2004h>             t0 = ts[i+1]
[?2004l[?2004h> 
[?2004l[?2004h>             # Refine kink by bisection: find where left/right slopes disagree.
