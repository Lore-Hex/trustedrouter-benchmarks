[?2004l[?2004h>                     if abs(s_far_left - s_left) > 1e-7:
[?2004l[?2004h>                         hi = mid
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         lo = mid
[?2004l[?2004h>                 else:
