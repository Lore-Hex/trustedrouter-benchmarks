[?2004l[?2004h>                     if mid < t0:
[?2004l[?2004h>                         lo = mid
[?2004l[?2004h>                     else:
[?2004l[?2004h>                         hi = mid
[?2004l[?2004h>             t_star = 0.5 * (lo + hi)
[?2004l[?2004h> 
[?2004l[?2004h>             # Gradients on either side of the boundary.
[?2004l[?2004h>             delta = 1e-3
[?2004l[?2004h>             gp = grad(x0 + (t_star + delta) * v, eps=1e-5)
