[?2004l[?2004h>     ys = np.array([forward(x0 + t * v) for t in ts])
[?2004l[?2004h> 
[?2004l[?2004h>     # Local slopes between adjacent samples.
[?2004l[?2004h>     ds = np.diff(ts)[0]
[?2004l[?2004h>     slopes = (ys[1:] - ys[:-1]) / ds
[?2004l[?2004h>     slope_jumps = np.abs(slopes[1:] - slopes[:-1])
[?2004l[?2004h> 
[?2004l[?2004h>     # Detect significant local maxima of slope jumps.
