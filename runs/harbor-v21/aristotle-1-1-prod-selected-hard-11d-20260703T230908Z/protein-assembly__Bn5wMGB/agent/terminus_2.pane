[?2004l[?2004h> import urllib.request, urllib.parse, json, sys, time
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Search PubChem for the SMILES
[?2004l[?2004h> smiles='Nc3nc(OCc1ccccc1)c2nc[nH]c2n3'
[?2004l[?2004h> print('=== PubChem search for SMILES ===', flush=True)
[?2004l[?2004h> try:
[?2004l[?2004h>     url='https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/smiles/'+urllib.parse.quote(smiles)+'/property/Title,IUPACName,MolecularFormula,MolecularWeight,CIDD/JSON'
[?2004l[?2004h>     req=urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0'})
[?2004l[?2004h>     resp=urllib.request.urlopen(req, timeout=20).read().decode('utf-8','replace')
[?2004l[?2004h>     print('PubChem response:', resp[:2000], flush=True)
[?2004l[?2004h> except Exception as e:
[?2004l[?2004h>     print('PubChem ERR', repr(e), flush=True)
[?2004l[?2004h> 
[?2004l[?2004h> # 2. RCSB chemical search - try POST
[?2004l[?2004h> print('\n=== RCSB chemical search ===', flush=True)
[?2004l[?2004h> q={"query":{"type":"terminal","service":"chemical","parameters":{"value":smiles,"type":"descriptor","match_type":"exact"}},"return_type":"entry","request_optioons":{"results_content_type":["experimental"],"paginate":{"start":0,"rows":25}}}
[?2004l[?2004h> for method in ['POST','GET']:
[?2004l[?2004h>     try:
[?2004l[?2004h>         if method=='POST':
[?2004l[?2004h>             req=urllib.request.Request('https://search.rcsb.org/rcsbsearch/v2/query', data=json.dumps(q).encode(), headers={'User-Agent':'Mozilla/5.0','Contentt-Type':'application/json'})
[?2004l[?2004h>         else:
[?2004l[?2004h>             req=urllib.request.Request('https://search.rcsb.org/rcsbsearch/v2/query?json='+urllib.parse.quote(json.dumps(q)), headers={'User-Agent':'Mozilla/5..0'})
[?2004l[?2004h>         resp=urllib.request.urlopen(req, timeout=30).read().decode('utf-8','replace')
[?2004l[?2004h>         print(f'{method} response:', resp[:3000], flush=True)
[?2004l[?2004h>         break
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f'{method} ERR', repr(e), flush=True)
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Query each PDB entry for ligands/nonpolymer entities
[?2004l[?2004h> print('\n=== PDB entry ligands ===', flush=True)
[?2004l[?2004h> ids=[x.strip().upper() for x in open('/app/pdb_ids.txt') if x.strip()]
[?2004l[?2004h> for pid in ids:
[?2004l[?2004h>     try:
[?2004l[?2004h>         url=f'https://data.rcsb.org/rest/v1/core/entry/{pid}'
[?2004l[?2004h>         req=urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0'})
[?2004l[?2004h>         j=json.loads(urllib.request.urlopen(req, timeout=15).read().decode('utf-8','replace'))
[?2004l[?2004h>         # Look for nonpolymer entity info
[?2004l[?2004h>         info=j.get('rcsb_entry_info',{})
[?2004l[?2004h>         nonpoly_count=info.get('nonpolymer_entity_count',0)
[?2004l[?2004h>         # Try to get polymer entities and nonpolymer entities
[?2004l[?2004h>         entities=[]
[?2004l[?2004h>         for k,v in j.items():
[?2004l[?2004h>             if 'nonpolymer' in k.lower() or 'ligand' in k.lower():
[?2004l[?2004h>                 entities.append((k, str(v)[:200]))
[?2004l[?2004h>         # Also get struct title
[?2004l[?2004h>         title=j.get('struct',{}).get('title','')
[?2004l[?2004h>         print(f'{pid}: nonpoly_count={nonpoly_count}, title={title[:80]}', flush=True)
[?2004l[?2004h>         if entities:
[?2004l[?2004h>             print(f'  entity fields: {entities[:3]}', flush=True)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f'{pid}: ERR {repr(e)}', flush=True)
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Try to get nonpolymer entities for each PDB entry
[?2004l[?2004h> print('\n=== PDB nonpolymer entity details ===', flush=True)
[?2004l[?2004h> for pid in ids:
[?2004l[?2004h>     ligands=[]
[?2004l[?2004h>     for eid in range(1, 6):
[?2004l[?2004h>         try:
[?2004l[?2004h>             url=f'https://data.rcsb.org/rest/v1/core/nonpolymer_entity/{pid}/{eid}'
[?2004l[?2004h>             req=urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0'})
[?2004l[?2004h>             j=json.loads(urllib.request.urlopen(req, timeout=10).read().decode('utf-8','replace'))
[?2004l[?2004h>             comp=j.get('nonpolymer_comp',{})
[?2004l[?2004h>             comp_id=comp.get('id','')
[?2004l[?2004h>             name=comp.get('name','') or j.get('rcsb_nonpolymer_entity_container_identifiers',{}).get('comp_id','')
[?2004l[?2004h>             formula=j.get('chem_comp',{}).get('formula','')
[?2004l[?2004h>             desc=j.get('chem_comp',{}).get('name','') or j.get('pdbx_entity_nonpoly',{}).get('name','')
[?2004l[?2004h>             ligands.append((eid, comp_id, name, desc, formula))
[?2004l[?2004h>         except Exception:
[?2004l[?2004h>             break
[?2004l[?2004h>     if ligands:
[?2004l[?2004h>         print(f'{pid}: {ligands}', flush=True)
