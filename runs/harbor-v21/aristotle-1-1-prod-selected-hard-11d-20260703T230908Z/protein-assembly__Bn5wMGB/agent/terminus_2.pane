[?2004hroot@ae3f81e621da:/app# python3 - <<'PY'
[?2004l[?2004h> import urllib.request, urllib.parse, json, re, sys, time
[?2004l[?2004h> 
[?2004l[?2004h> # Read antibody sequences
[?2004l[?2004h> seqs={}
[?2004l[?2004h> cur=None
[?2004l[?2004h> for line in open('/app/antibody.fasta'):
[?2004l[?2004h>     line=line.strip()
[?2004l[?2004h>     if line.startswith('>'):
[?2004l[?2004h>         cur=line[1:].split()[0]
[?2004l[?2004h>         seqs[cur]=''
[?2004l[?2004h>     elif cur:
[?2004l[?2004h>         seqs[cur]+=line
[?2004l[?2004h> 
[?2004l[?2004h> heavy=seqs['heavy']
[?2004l[?2004h> light=seqs['light']
[?2004l[?2004h> 
[?2004l[?2004h> # Extract variable regions (before constant region)
[?2004l[?2004h> # Heavy chain variable: up to WGQGTLVTVSS or similar
[?2004l[?2004h> hv=re.match(r'^(.*?WGQG.{0,10}TVSS)', heavy)
[?2004l[?2004h> hv_seq=hv.group(1) if hv else heavy[:120]
[?2004l[?2004h> # Light chain variable: up to FGGGTKLEI or similar
[?2004l[?2004h> lv=re.match(r'^(.*?FGGGTKLEI)', light)
[?2004l[?2004h> lv_seq=lv.group(1) if lv else light[:110]
[?2004l[?2004h> 
[?2004l[?2004h> print('Heavy variable:', len(hv_seq), hv_seq[-30:], flush=True)
[?2004l[?2004h> print('Light variable:', len(lv_seq), lv_seq[-30:], flush=True)
[?2004l[?2004h> 
[?2004l[?2004h> # Check old BLAST RID
[?2004l[?2004h> print('\n=== Checking old BLAST RID ===', flush=True)
[?2004l[?2004h> try:
[?2004l[?2004h>     params={'CMD':'Get','FORMAT_OBJECT':'SearchInfo','RID':'4H69T3HW014'}
[?2004l[?2004h>     req=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode(params), headers={'User-Agent':'Mozilla/5.0'})
[?2004l[?2004h>     resp=urllib.request.urlopen(req, timeout=20).read().decode('utf-8','replace')
[?2004l[?2004h>     status=re.search(r'Status=(\S+)', resp)
[?2004l[?2004h>     print('Old RID status:', status.group(1) if status else 'unknown', flush=True)
[?2004l[?2004h>     if status and status.group(1)=='READY':
[?2004l[?2004h>         rparams={'CMD':'Get','FORMAT_TYPE':'JSON2','ALIGNMENT_VIEW':'Pairwise','RID':'4H69T3HW014','RESULTS_FILE':'true'}
[?2004l[?2004h>         rreq=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode(rparams), headers={'User-Agent':'Mozilla/5.0'})
[?2004l[?2004h>         rresp=urllib.request.urlopen(rreq, timeout=60).read().decode('utf-8','replace')
[?2004l[?2004h>         print('Old BLAST results:', rresp[:3000], flush=True)
[?2004l[?2004h> except Exception as e:
[?2004l[?2004h>     print('Old RID check ERR', repr(e), flush=True)
[?2004l[?2004h> 
[?2004l[?2004h> # New BLAST against pdb (faster)
[?2004l[?2004h> print('\n=== BLAST heavy variable against pdb ===', flush=True)
[?2004l[?2004h> for name, seq in [('heavy_var', hv_seq), ('light_var', lv_seq)]:
[?2004l[?2004h>     try:
[?2004l[?2004h>         params={'CMD':'Put','PROGRAM':'blastp','DATABASE':'pdb','QUERY':seq,'FORMAT_TYPE':'JSON2','HITLIST_SIZE':'10','EXPECT':'10'}
[?2004l[?2004h>         data=urllib.parse.urlencode(params).encode()
[?2004l[?2004h>         req=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi', data=data, headers={'User-Agent':'Mozilla/5.0'})
[?2004l[?2004h>         resp=urllib.request.urlopen(req, timeout=20).read().decode('utf-8','replace')
[?2004l[?2004h>         rid=re.search(r'RID = (\S+)', resp)
[?2004l[?2004h>         if rid:
[?2004l[?2004h>             rid=rid.group(1)
[?2004l[?2004h>             print(f'{name} RID:', rid, flush=True)
[?2004l[?2004h>             for i in range(15):
[?2004l[?2004h>                 time.sleep(5)
[?2004l[?2004h>                 gparams={'CMD':'Get','FORMAT_OBJECT':'SearchInfo','RID':rid}
[?2004l[?2004h>                 greq=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode(gparams), headers={'User-Agent':'Mozilla/5.0'}) M>                 greq=urllib.request.Request('https://blast.ncbi.nlm.nih.gov/Blast.cgi?'+urllib.parse.urlencode(gparams), headers={'User-Agent':'Mozilla/5.0'}[K)
[?2004l[?2004h>                 gresp=urllib.request.urlopen(greq, timeout=20).read().decode('utf-8','replace')
[?2004l[?2004h>                 status=re.search(r'Status=(\S+)', gresp)
[?2004l[?2004h>                 if status:
[?2004l[?2004h>                     st=status.group(1)
[?2004l[?2004h>                     print(f'  status: {st}', flush=True)
[?2004l[?2004h>                     if st in ('READY','FAILED','UNKNOWN'):
