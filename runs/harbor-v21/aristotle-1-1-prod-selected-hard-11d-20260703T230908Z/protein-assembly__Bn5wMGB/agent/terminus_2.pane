### 1YZW
python3 - <<'PY'
import urllib.request, urllib.parse, json, sys
base='https://www.fpbase.org/api/'
for path in ['proteins/?format=json', 'proteins/', 'spectra/?format=json', 'spectrums/?format=json']:
    url=base+path
    try:
        req=urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0'})
        data=urllib.request.urlopen(req, timeout=20).read().decode('utf-8','replace')
        print('\n###', url, 'len', len(data), flush=True)
        print(data[:1500], flush=True)
    except Exception as e:
        print('ERR', url, repr(e), flush=True)
PY
