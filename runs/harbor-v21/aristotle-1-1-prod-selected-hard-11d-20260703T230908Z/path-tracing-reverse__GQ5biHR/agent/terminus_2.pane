[?2004lpython3 - <<'PY'
# Extract specific functions to files
lines=open('/tmp/disasm2.txt').readlines()
funcs={}
for i,l in enumerate(lines):
    if l.startswith('000000000040') and '<' in l:
        name=l.split('<')[1].split(':')[0].split('>')[0]
        funcs[name]=i
names=list(funcs)
for idx,name in enumerate(names):
    start=funcs[name]
    end=funcs[names[idx+1]] if idx+1<len(names) else len(lines)
    with open(f'/tmp/func_{name}.txt','w') as f:
        f.writelines(lines[start:end])
print('wrote', len(names), 'functions')
for n in names:
    import os
    print(n, os.path.getsize(f'/tmp/func_{n}.txt'))
PY
