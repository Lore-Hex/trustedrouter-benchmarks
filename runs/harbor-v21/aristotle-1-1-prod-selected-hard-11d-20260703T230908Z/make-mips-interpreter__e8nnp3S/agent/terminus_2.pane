   970	// Get size class index for a given size
   971	static int size_class_index(size_t size) {
   972	    // For small sizes, use direct mapping to optimize common cases
   973	  /*
   974	    if (size <= 16) return 0;
   975	    if (size <= 32) return 1;
   976	    if (size <= 64) return 2;
   977	    if (size <= 128) return 3;
   978	    if (size <= 256) return 4;
   979	    if (size <= 512) return 5;
   980	    if (size <= 1024) return 6;
   981	  */
   982	    
   983	    // For larger sizes, use bit operations to find log2
   984	    int index = 0;  // Start after direct mapping
   985	    size >>= 4;    // Divide by 1024
   986	    
   987	    while (size) {
   988	        size >>= 1;
   989	        index++;
   990	    }
   991	    
   992	    return (index < NUM_SIZE_CLASSES) ? index : NUM_SIZE_CLASSES - 1;
   993	}
