   204	// Helper function to initialize the filesystem
   205	void init_filesystem() {
   206	    // Create root directory if it doesn't exist
   207	    if (root == NULL) {
   208	        root = (FileNode*)malloc(sizeof(FileNode));
   209	        strcpy(root->name, "/");
   210	        root->type = FILE_TYPE_DIRECTORY;
   211	        root->created = root->modified = root->accessed = time(NULL);
   212	        root->data = NULL;
   213	        root->size = 0;
   214	        root->capacity = 0;
   215	        root->entries = (DirEntry*)malloc(10 * sizeof(DirEntry));
   216	        root->num_entries = 0;
   217	        root->max_entries = 10;
   218	        root->parent = root; // Root is its own parent
   219	        
   220	        // Initialize file descriptor table
   221	        for (int i = 0; i < MAX_FILE_DESCRIPTORS; i++) {
   222	            if (i < 5) {
   223	                fd_table[i].used = 1;  // Reserve file descriptors 0-4
   224	                fd_table[i].node = NULL;
   225	            } else {
   226	                fd_table[i].used = 0;
   227	            }
   228	        }
   229	        
   230	        // Load doom.wad from the real filesystem
   231	        const char* wad_path = "doom.wad";
   232	        
   233	        // Open the WAD file from the real filesystem
   234	        int real_fd = real_syscall6(SYS_open, (long)wad_path, O_RDONLY, 0, 0, 0, 0);
   235	        if (real_fd >= 0) {
   236	            // Get the file size
   237	            off_t file_size = real_syscall6(SYS_lseek, real_fd, 0, SEEK_END, 0, 0, 0);
   238	            real_syscall6(SYS_lseek, real_fd, 0, SEEK_SET, 0, 0, 0); // Reset to beginning
   239	            
   240	            if (file_size > 0 && file_size <= MAX_FILE_SIZE) {
   241	                // Allocate memory for the file data
   242	                unsigned char* wad_data = (unsigned char*)malloc(file_size);
   243	                if (wad_data != NULL) {
   244	                    // Read the file data
   245	                    ssize_t bytes_read = real_syscall6(SYS_read, real_fd, (long)wad_data, file_size, 0, 0, 0);
   246	                    
   247	                    if (bytes_read == file_size) {
   248	                        // Create a new file node for doom.wad
   249	                        FileNode* wad_node = create_node("doom.wad", FILE_TYPE_REGULAR, root);
   250	                        wad_node->data = wad_data;
   251	                        wad_node->size = file_size;
   252	                        wad_node->capacity = file_size;
   253	                        
   254	                        // Add the file to the root directory
   255	                        add_to_directory(root, "doom.wad", wad_node);
   256	                        
   257	                        printf("Loaded doom.wad (%d bytes) into in-memory filesystem\n", file_size);
   258	                    } else {
   259	                        free(wad_data);
   260	                        printf("Failed to read doom.wad: read %d of %d bytes\n", bytes_read, file_size);
   261	                    }
   262	                } else {
   263	                    printf("Failed to allocate memory for doom.wad (%d bytes)\n", file_size);
   264	                }
   265	            } else {
   266	                printf("doom.wad file size invalid: %d bytes\n", file_size);
   267	            }
   268	            
   269	            // Close the real file
   270	            real_syscall6(SYS_close, real_fd, 0, 0, 0, 0, 0);
   271	        } else {
   272	            printf("Failed to open doom.wad: error %d\n", errno);
   273	        }
   274	    }
