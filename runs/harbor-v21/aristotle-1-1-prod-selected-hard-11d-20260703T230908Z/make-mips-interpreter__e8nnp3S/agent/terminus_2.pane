   104	    /* 
   105	     * MIPS typically uses negative return values for errors
   106	     * and sets errno accordingly
   107	     */
   108	    if (result < 0) {
   109	        errno = -result;
   110	        return -1;
   111	    }
   112	    
   113	    return result;
   114	}
