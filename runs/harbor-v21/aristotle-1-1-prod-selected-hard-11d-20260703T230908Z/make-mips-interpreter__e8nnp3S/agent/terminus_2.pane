   594	// SYS_close: Close a file
   595	int sys_close(int fd) {
   596	    if (fd < 0 || fd >= MAX_FILE_DESCRIPTORS || !fd_table[fd].used) {
   597	        return -EBADF;
   598	    }
   599	    
   600	    fd_table[fd].used = 0;
   601	    return 0;
   602	}
