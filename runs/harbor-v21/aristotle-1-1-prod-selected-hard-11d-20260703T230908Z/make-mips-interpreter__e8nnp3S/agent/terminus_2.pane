    70	        "move $v0, %1\n\t"
    71	        
    72	        /* Load first four arguments into $a0-$a3 */
    73	        "move $a0, %2\n\t"
    74	        "move $a1, %3\n\t"
    75	        "move $a2, %4\n\t"
    76	        "move $a3, %5\n\t"
    77	        
    78	        /* Load additional arguments into $t0-$t1 */
    79	        "move $t0, %6\n\t"  /* 5th arg in $t0 */
    80	        "move $t1, %7\n\t"  /* 6th arg in $t1 */
    81	        
    82	        /* Make the syscall */
    83	        "syscall\n\t"
    84	        
    85	        /* Get the return value */
    86	        "move %0, $v0"
    87	        
    88	        /* Output parameter */
    89	        : "=r" (result)
    90	        
    91	        /* Input parameters */
    92	        : "r" (syscall_num),
    93	          "r" (arg1),
    94	          "r" (arg2),
    95	          "r" (arg3),
    96	          "r" (arg4),
    97	          "r" (arg5),
    98	          "r" (arg6)
