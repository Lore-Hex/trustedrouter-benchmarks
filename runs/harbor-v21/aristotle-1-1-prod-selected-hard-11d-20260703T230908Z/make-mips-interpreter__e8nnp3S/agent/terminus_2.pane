517    517	// SYS_open: Open a file
518    518	int sys_open(const char* pathname, int flags, mode_t mode) {
519    519	    if (root == NULL) {
520    520	        init_filesystem();
521    521	    }
522    522
523    523	    FileNode* parent_dir = NULL;
524    524	    FileNode* node = find_node(pathname, &parent_dir);
525    525
526    526	    if (node == NULL) {
527    527	        // File not found
528    528	        if (flags & O_CREAT) {
529    529	            // Create a new file
530    530	            char dir_path[MAX_PATH_LENGTH];
531    531	            char filename[MAX_PATH_LENGTH];
532    532
533    533	            split_path(pathname, dir_path, filename);
534    534
535    535	            if (strlen(filename) == 0) {
536    536	                return -EINVAL; // Invalid filename
