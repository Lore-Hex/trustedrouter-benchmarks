    79	        "move $t0, %6\n\t"  /* 5th arg in $t0 */
    80	        "move $t1, %7\n\t"  /* 6th arg in $t1 */
    81	        
    82	        /* Make the syscall */
    83	        "syscall\n\t"
    84	        
    85	        /* Get the return value */
    86	        "move %0, $v0"
    87	        
    88	        /* Output parameter */
    89	        : "=r" (result)
    90	        
    91	        /* Input parameters */
    92	        : "r" (syscall_num),
    93	          "r" (arg1),
    94	          "r" (arg2),
    95	          "r" (arg3),
    96	          "r" (arg4),
    97	          "r" (arg5),
    98	          "r" (arg6)
    99	        
   100	        /* Clobbered registers */
   101	        : "v0", "a0", "a1", "a2", "a3", "t0", "t1", "memory"
   102	    );
   103	    
   104	    /* 
   105	     * MIPS typically uses negative return values for errors
   106	     * and sets errno accordingly
   107	     */
   108	    if (result < 0) {
   109	        errno = -result;
   110	        return -1;
   111	    }
   112	    
   113	    return result;
   114	}
