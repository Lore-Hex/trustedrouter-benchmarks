  1086	// Initialize fixed-size pools for common allocations
  1087	static void init_fixed_pools() {
  1088	    static int initialized = 0;
  1089	    if (initialized) return;
  1090	    
  1091	    const size_t sizes[NUM_POOLS] = POOL_SIZES;
  1092	    
  1093	    for (int i = 0; i < NUM_POOLS; i++) {
  1094	        size_t chunk_size = ALIGN_UP(sizes[i]);
  1095	        size_t pool_size = POOL_CHUNK_COUNT * chunk_size;
  1096	        
  1097	        // Allocate pool from the heap
  1098	        fixed_pools[i].memory = heap + heap_pos;
  1099	        fixed_pools[i].chunk_size = chunk_size;
  1100	        fixed_pools[i].used_count = 0;
  1101	        fixed_pools[i].free_chunks = NULL;
  1102	        
  1103	        // Initialize all chunks as free
  1104	        for (size_t j = 0; j < POOL_CHUNK_COUNT; j++) {
  1105	            void* chunk = fixed_pools[i].memory + (j * chunk_size);
  1106	            *((void**)chunk) = fixed_pools[i].free_chunks;
  1107	            fixed_pools[i].free_chunks = chunk;
  1108	        }
  1109	        
  1110	        heap_pos += pool_size;
  1111	    }
  1112	    
  1113	    initialized = 1;
  1114	}
  1115	
  1116	// Fast fixed-size allocation
  1117	static void* fixed_malloc(size_t size) {
  1118	    init_fixed_pools();
  1119	    
  1120	    const size_t sizes[NUM_POOLS] = POOL_SIZES;
  1121	    
  1122	    // Find appropriate pool
  1123	    for (int i = 0; i < NUM_POOLS; i++) {
  1124	        if (sizes[i] >= size && fixed_pools[i].free_chunks) {
  1125	            // Get a chunk from the free list
  1126	            void* chunk = fixed_pools[i].free_chunks;
  1127	            fixed_pools[i].free_chunks = *((void**)chunk);
  1128	            fixed_pools[i].used_count++;
  1129	            return chunk;
  1130	        }
  1131	    }
  1132	    
  1133	    return NULL;  // No suitable pool or no free chunks
  1134	}
  1135	
  1136	// Fast fixed-size free
  1137	static size_t get_block_size(void* ptr) {
  1138	    block_header_t* block = (block_header_t*)((char*)ptr - HEADER_SIZE);
  1139	    return block->size;
  1140	}
  1141	    static int fixed_free(void* ptr) {
  1142	    for (int i = 0; i < NUM_POOLS; i++) {
  1143	        unsigned char* pool_start = fixed_pools[i].memory;
  1144	        unsigned char* pool_end = pool_start + (POOL_CHUNK_COUNT * fixed_pools[i].chunk_size);
  1145	        
  1146	        if ((unsigned char*)ptr >= pool_start && (unsigned char*)ptr < pool_end) {
  1147	            // Check alignment
  1148	            size_t offset = (unsigned char*)ptr - pool_start;
  1149	            if (offset % fixed_pools[i].chunk_size != 0)
  1150	                return 0;  // Not properly aligned
  1151	                
  1152	            // Add back to free list
  1153	            *((void**)ptr) = fixed_pools[i].free_chunks;
  1154	            fixed_pools[i].free_chunks = ptr;
  1155	            fixed_pools[i].used_count--;
  1156	            return 1;  // Successfully freed
  1157	        }
  1158	    }
  1159	    
  1160	    return 0;  // Not in our pools
  1161	}
  1162	
  1163	// Main malloc with fast path for common sizes
  1164	void* malloc(size_t size) {
  1165	    if (size == 0) return NULL;
  1166	    
  1167	    // Try fixed-size allocation for small sizes
  1168	    if (size <= 128) {
  1169	        void* ptr = fixed_malloc(size);
  1170	        if (ptr) return ptr;
  1171	    }
  1172	    
  1173	    // Fall back to basic malloc
  1174	    return basic_malloc(size);
  1175	}
