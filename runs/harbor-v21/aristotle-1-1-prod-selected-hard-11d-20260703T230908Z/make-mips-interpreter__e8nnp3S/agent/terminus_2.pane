   844	long syscall_fs(int syscall_num, ...) {
   845	    va_list args;
   846	    va_start(args, syscall_num);
   847	    long ret = 0;
   848	    
   849	    switch (syscall_num) {
   850	        case SYS_read: {
   851	            int fd = va_arg(args, int);
   852	            void* buf = va_arg(args, void*);
   853	            size_t count = va_arg(args, size_t);
   854	            ret = sys_read(fd, buf, count);
   855	            break;
   856	        }
   857	        case SYS_write: {
   858	            int fd = va_arg(args, int);
   859	            const void* buf = va_arg(args, const void*);
   860	            size_t count = va_arg(args, size_t);
   861	            ret = sys_write(fd, buf, count);
   862	            break;
   863	        }
   864	        case SYS_open: {
   865	            const char* pathname = va_arg(args, const char*);
   866	            int flags = va_arg(args, int);
   867	            mode_t mode = va_arg(args, mode_t);
   868	            ret = sys_open(pathname, flags, mode);
   869	            break;
   870	        }
   871	        case SYS_close: {
   872	            int fd = va_arg(args, int);
   873	            ret = sys_close(fd);
   874	            break;
   875	        }
   876	        case SYS_lseek: {
   877	            int fd = va_arg(args, int);
   878	            off_t offset = va_arg(args, off_t);
   879	            int whence = va_arg(args, int);
   880	            ret = sys_lseek(fd, offset, whence);
   881	            break;
   882	        }
   883	        case SYS_fsync: {
   884	            int fd = va_arg(args, int);
   885	            ret = sys_fsync(fd);
   886	            break;
   887	        }
   888	        case SYS_rename: {
   889	            const char* oldpath = va_arg(args, const char*);
   890	            const char* newpath = va_arg(args, const char*);
   891	            ret = sys_rename(oldpath, newpath);
   892	            break;
   893	        }
   894	        case SYS_mkdir: {
   895	            const char* pathname = va_arg(args, const char*);
   896	            mode_t mode = va_arg(args, mode_t);
   897	            ret = sys_mkdir(pathname, mode);
   898	            break;
   899	        }
   900	        case SYS_unlink: {
   901	            const char* pathname = va_arg(args, const char*);
   902	            ret = sys_unlink(pathname);
   903	            break;
   904	        }
   905	        default:
   906	            ret = -EINVAL; // Invalid system call
   907	    }
   908	    
   909	    va_end(args);
   910	    return ret;
   911	}
