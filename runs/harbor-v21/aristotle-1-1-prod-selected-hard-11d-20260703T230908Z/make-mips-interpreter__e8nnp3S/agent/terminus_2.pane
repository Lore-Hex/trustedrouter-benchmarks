999    999	    // Calculate total size needed including header
1000   1000	    size_t total_size = ALIGN_UP(HEADER_SIZE + size);
1001   1001
1002   1002	    // Ensure minimum block size
1003   1003	    if (total_size < MIN_BLOCK_SIZE)
1004   1004	        total_size = MIN_BLOCK_SIZE;
1005   1005
1006   1006	    // Get the appropriate size class
1007   1007	    int class_idx = size_class_index(total_size);
