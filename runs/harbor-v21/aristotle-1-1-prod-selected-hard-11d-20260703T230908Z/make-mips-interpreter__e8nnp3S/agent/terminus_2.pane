[?2004l[?2004h> // ---------- ELF Loader ----------
[?2004l[?2004h> function loadELF(mem, path) {
[?2004l[?2004h>   const buf = fs.readFileSync(path);
[?2004l[?2004h>   // 32-bit LE ELF
[?2004l[?2004h>   const e_type = buf.readUInt16LE(16);
[?2004l[?2004h>   const e_machine = buf.readUInt16LE(18);
[?2004l[?2004h>   if (e_machine !== 8) throw new Error(`Not MIPS: e_machine=${e_machine}`);
[?2004l[?2004h>   const e_entry = buf.readUInt32LE(24);
[?2004l[?2004h>   const e_phoff = buf.readUInt32LE(28);
[?2004l[?2004h>   const e_phentsize = buf.readUInt16LE(42);
[?2004l[?2004h>   const e_phnum = buf.readUInt16LE(44);
[?2004l[?2004h>   // also get .reginfo gp
[?2004l[?2004h>   const e_shoff = buf.readUInt32LE(32);
[?2004l[?2004h>   const e_shentsize = buf.readUInt16LE(46);
[?2004l[?2004h>   const e_shnum = buf.readUInt16LE(48);
[?2004l[?2004h>   const e_shstrndx = buf.readUInt16LE(50);
[?2004l[?2004h>   let gpValue = 0;
[?2004l[?2004h>   // Parse section headers to find .reginfo
[?2004l[?2004h>   for (let i = 0; i < e_shnum; i++) {
[?2004l[?2004h>     const off = e_shoff + i * e_shentsize;
[?2004l[?2004h>     const sh_name = buf.readUInt32LE(off);
[?2004l[?2004h>     const sh_type = buf.readUInt32LE(off + 4);
[?2004l[?2004h>     const sh_addr = buf.readUInt32LE(off + 12);
[?2004l[?2004h>     const sh_offset = buf.readUInt32LE(off + 16);
[?2004l[?2004h>     const sh_size = buf.readUInt32LE(off + 20);
[?2004l[?2004h>     if (sh_type === 0x7000000a && sh_size >= 24) { // .reginfo
[?2004l[?2004h>       gpValue = buf.readUInt32LE(sh_offset + 20);
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h>   // Load PT_LOAD segments
[?2004l[?2004h>   for (let i = 0; i < e_phnum; i++) {
[?2004l[?2004h>     const off = e_phoff + i * e_phentsize;
[?2004l[?2004h>     const p_type = buf.readUInt32LE(off);
[?2004l[?2004h>     if (p_type !== 1) continue; // PT_LOAD
[?2004l[?2004h>     const p_offset = buf.readUInt32LE(off + 4);
[?2004l[?2004h>     const p_vaddr = buf.readUInt32LE(off + 8);
[?2004l[?2004h>     const p_filesz = buf.readUInt32LE(off + 16);
[?2004l[?2004h>     const p_memsz = buf.readUInt32LE(off + 20);
[?2004l[?2004h>     const seg = buf.subarray(p_offset, p_offset + p_filesz);
[?2004l[?2004h>     mem.copyFromBuffer(p_vaddr, seg);
[?2004l[?2004h>     if (p_memsz > p_filesz) {
[?2004l[?2004h>       mem.zeroRange(p_vaddr + p_filesz, p_memsz - p_filesz);
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h>   return { entry: e_entry, gp: gpValue };
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> // ---------- Main ----------
[?2004l[?2004h> function main() {
[?2004l[?2004h>   const mem = new Memory();
[?2004l[?2004h>   const { entry, gp } = loadELF(mem, ELF_PATH);
[?2004l[?2004h>   const cpu = new CPU(mem);
[?2004l[?2004h>   cpu.setPC(entry);
[?2004l[?2004h>   cpu.r[28] = gp | 0; // $gp
[?2004l[?2004h>   cpu.r[29] = 0x80000000 | 0; // $sp - high address outside BSS; BSS starts at 0x4750c0 size ~0x4003c6d0 -> ~0x447???
[?2004l[?2004h>   // Actually BSS: 0x4750c0 + 0x4003c6d0 = 0x4480D190. So use sp=0x90000000.
[?2004l[?2004h>   cpu.r[29] = 0x90000000 | 0;
[?2004l[?2004h>   // Set up argc/argv on stack for main(0,0) via __start
[?2004l[?2004h>   // __start calls main(0,0), so no need for argv. But stack should be valid.
[?2004l[?2004h> 
[?2004l[?2004h>   let lastProgress = Date.now();
[?2004l[?2004h>   let lastInst = 0;
[?2004l[?2004h>   const startTime = Date.now();
[?2004l[?2004h> 
[?2004l[?2004h>   // Run
[?2004l[?2004h>   let checkInterval = 1000000;
[?2004l[?2004h>   while (cpu.running) {
[?2004l[?2004h>     cpu.step();
[?2004l[?2004h>     if ((cpu.instCount & (checkInterval - 1)) === 0) {
[?2004l[?2004h>       const now = Date.now();
[?2004l[?2004h>       if (now - lastProgress > 5000) {
[?2004l[?2004h>         const mips = ((cpu.instCount - lastInst) / 1000000).toFixed(2);
[?2004l[?2004h>         console.error(`[vm] pc=0x${cpu.pc.toString(16)} inst=${cpu.instCount} ${mips}Mips ${((now-startTime)/1000).toFixed(1)}s`);
[?2004l[?2004h>         lastProgress = now; lastInst = cpu.instCount;
[?2004l[?2004h>       }
[?2004l[?2004h>       // Check if /tmp/frame.bmp exists, but keep running for a while
[?2004l[?2004h>       if (cpu.instCount > 50000000 && fs.existsSync('/tmp/frame.bmp')) {
[?2004l[?2004h>         console.error('[vm] /tmp/frame.bmp exists, stopping after first frame');
[?2004l[?2004h>         cpu.running = false;
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h>     if (cpu.instCount > 1000000000) { console.error('[vm] instruction limit reached'); cpu.running = false; }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   console.error(`[vm] exited code=${cpu.exitCode} instCount=${cpu.instCount}`);
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> main();
