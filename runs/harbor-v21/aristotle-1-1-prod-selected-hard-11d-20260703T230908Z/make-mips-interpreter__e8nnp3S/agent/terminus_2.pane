=== sys_read/write/open/close/lseek ===
438    438	// SYS_read: Read from a file
439    439	ssize_t sys_read(int fd, void* buf, size_t count) {
440    440	    if (fd < 0 || fd >= MAX_FILE_DESCRIPTORS || !fd_table[fd].used) {
441    441	        return -EBADF;
442    442	    }
443    443
444    444	    FileNode* node = fd_table[fd].node;
445    445	    node->accessed = time(NULL);
446    446
447    447	    if (node->type != FILE_TYPE_REGULAR) {
448    448	        return -EISDIR;
449    449	    }
450    450
451    451	    // Calculate how many bytes to read
452    452	    size_t bytes_to_read = count;
453    453	    if (fd_table[fd].position + bytes_to_read > node->size) {
454    454	        bytes_to_read = node->size - fd_table[fd].position;
455    455	    }
456    456
457    457	    if (bytes_to_read > 0 && node->data != NULL) {
458    458	        memcpy(buf, node->data + fd_table[fd].position, bytes_to_read);
459    459	        fd_table[fd].position += bytes_to_read;
460    460	    }
461    461
462    462	    return bytes_to_read;
463    463	}
464    464
465    465	// SYS_write: Write to a file
466    466	ssize_t sys_write(int fd, const void* buf, size_t count) {
467    467	    if (fd < 0 || fd >= MAX_FILE_DESCRIPTORS || !fd_table[fd].used) {
468    468	        return -EBADF;
469    469	    }
470    470
471    471	    FileNode* node = fd_table[fd].node;
472    472
473    473	    if (node->type != FILE_TYPE_DIRECTORY) {
474    474	        // Calculate new file size
475    475	        size_t new_size = fd_table[fd].position + count;
476    476
477    477	        // Check if we need to expand the file
478    478	        if (new_size > node->capacity) {
479    479	            size_t new_capacity = node->capacity == 0 ? 1024 : node->capacity;
480    480	            while (new_capacity < new_size) {
481    481	                new_capacity *= 2;
482    482	            }
483    483
484    484	            if (new_capacity > MAX_FILE_SIZE) {
485    485	                new_capacity = MAX_FILE_SIZE;
486    486	                if (new_size > MAX_FILE_SIZE) {
487    487	                    count = MAX_FILE_SIZE - fd_table[fd].position;
488    488	                    new_size = MAX_FILE_SIZE;
489    489	                }
490    490	            }
491    491
492    492	            unsigned char* new_data = (unsigned char*)realloc(node->data, new_capacity);
493    493	            if (new_data == NULL) {
494    494	                return -ENOMEM;
495    495	            }
496    496
497    497	            node->data = new_data;
498    498	            node->capacity = new_capacity;
499    499	        }
500    500
501    501	        // Write the data
502    502	        memcpy(node->data + fd_table[fd].position, buf, count);
503    503	        fd_table[fd].position += count;
504    504
505    505	        if (fd_table[fd].position > node->size) {
506    506	            node->size = fd_table[fd].position;
507    507	        }
508    508
509    509	        node->modified = time(NULL);
510    510
511    511	        return count;
512    512	    } else {
513    513	        return -EISDIR; // Cannot write to a directory
514    514	    }
515    515	}
