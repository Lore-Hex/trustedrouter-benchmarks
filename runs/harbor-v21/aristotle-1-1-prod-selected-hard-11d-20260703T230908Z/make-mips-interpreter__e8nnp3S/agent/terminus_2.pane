   604	// SYS_lseek: Reposition read/write file offset
   605	off_t sys_lseek(int fd, off_t offset, int whence) {
   606	    if (fd < 0 || fd >= MAX_FILE_DESCRIPTORS || !fd_table[fd].used) {
   607	        return -EBADF;
   608	    }
   609	    
   610	    FileNode* node = fd_table[fd].node;
   611	    off_t new_pos = 0;
   612	    
   613	    switch (whence) {
   614	        case SEEK_SET:
   615	            new_pos = offset;
   616	            break;
   617	        case SEEK_CUR:
   618	            new_pos = fd_table[fd].position + offset;
   619	            break;
   620	        case SEEK_END:
   621	            new_pos = node->size + offset;
   622	            break;
   623	        default:
   624	            return -EINVAL;
   625	    }
   626	    
   627	    if (new_pos < 0) {
   628	        return -EINVAL;
   629	    }
   630	    
   631	    fd_table[fd].position = new_pos;
   632	    return new_pos;
   633	}
