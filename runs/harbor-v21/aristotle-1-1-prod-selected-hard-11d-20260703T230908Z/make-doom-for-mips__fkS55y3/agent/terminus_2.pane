   180	    // since we're not using X11 anymore
   181	}
   182	
   183	void DG_SleepMs(uint32_t ms)
   184	{
   185	    // Spinloop implementation for sleep using inline assembly
   186	    // Assuming 3GHz processor (3 billion cycles per second)
   187	    // 1ms = 3 million cycles
   188	    uint64_t cycles_per_ms = 3;
   189	    uint64_t total_cycles = cycles_per_ms * ms;
   190	    
   191	    volatile uint64_t i;
   192	    for (i = 0; i < total_cycles; i++)
   193	    {
   194	        // Use volatile inline assembly to ensure the loop isn't optimized away
   195	        __asm__ volatile("" ::: "memory");
   196	    }
   197	}
   198	
   199	int ms_ctr = 0;;
   200	uint32_t DG_GetTicksMs()
   201	{
   202	    return ms_ctr++;
   203	}
   204	
   205	int DG_GetKey(int* pressed, unsigned char* doomKey)
   206	{
   207	    if (s_KeyQueueReadIndex == s_KeyQueueWriteIndex)
   208	    {
   209	        //key queue is empty
   210	        return 0;
   211	    }
   212	    else
   213	    {
   214	        unsigned short keyData = s_KeyQueue[s_KeyQueueReadIndex];
   215	        s_KeyQueueReadIndex++;
   216	        s_KeyQueueReadIndex %= KEYQUEUE_SIZE;
   217	
   218	        *pressed = keyData >> 8;
   219	        *doomKey = keyData & 0xFF;
   220	
   221	        return 1;
   222	    }
   223	}
