   170	int drawk = 0;
   171	void DG_DrawFrame()
   172	{
   173	    // Save the current frame to a BMP file
   174	  if (drawk++%10 == 0) {
   175	    writeBMPFile("/tmp/frame.bmp", (uint32_t*)DG_ScreenBuffer, DOOMGENERIC_RESX, DOOMGENERIC_RESY);
   176	  }
