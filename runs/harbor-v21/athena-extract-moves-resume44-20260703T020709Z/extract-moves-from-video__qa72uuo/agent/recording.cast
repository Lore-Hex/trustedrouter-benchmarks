[700.446549, "i", "python3 - <<'PY'\nimport os, glob\nfor f in glob.glob('/app/ocr/*.txt.txt'):\n    new = f[:-4]  # remove last .txt\n    os.rename(f, new)\nprint('renamed')\nPY\n"]
[700.447019, "o", "python3 - <<'PY'\r\nimport os, glob\r\nfor f in glob.glob('/app/ocr/*.txt.txt'):\r\n    new = f[:-4]  # remove last .txt\r\n    os.rename(f, new)\r\nprint('renamed')\r\nPY\r\n"]
[700.650765, "i", "ls /app/ocr/frame_*.txt | wc -l\n"]
[700.650999, "o", "ls /app/ocr/frame_*.txt | wc -l\r\n"]
[700.827912, "i", "python3 - <<'PY'\nimport os, re, glob\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'))\nprint(f'Total OCR files: {len(files)}')\n# Print last frame text\nprint('=== last frame ===')\nwith open(files[-1]) as f:\n    print(f.read())\nPY\n"]
[700.828092, "o", "python3 - <<'PY'\r\nimport os, re, glob\r\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'))\r\nprint(f'Total OCR files: {len(files)}')\r\n# Print last frame text\r\nprint('=== last frame ===')\r\nwith open(files[-1]) as f:\r\n    print(f.read())\r\nPY\r\n"]
[701.446409, "i", "python3 - <<'PY'\nimport os, re, glob\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'))\nseen = set()\nfor fp in files:\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\n    with open(fp, errors='replace') as f:\n        text = f.read()\n    for line in text.splitlines():\n        s = line.strip()\n        # Lines that start with > followed by text (player input)\n        m = re.match(r'^>\\s*(.+)$', s)\n        if m:\n            cmd = m.group(1).strip()\n            if cmd and cmd not in seen:\n                seen.add(cmd)\n                print(f'frame {frame:03d}: {cmd}')\nprint(f'\\nTotal unique commands found: {len(seen)}')\nPY\n"]
[701.446925, "o", "python3 - <<'PY'\r\nimport os, re, glob\r\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'))\r\nseen = set()\r\nfor fp in files:\r\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\r\n    with open(fp, errors='replace') as f:\r\n        text = f.read()\r\n    for line in text.splitlines():\r\n        s = line.strip()\r\n        # Lines that start with > followed by text (player input)\r\n        m = re.match(r'^>\\s*(.+)$', s)\r\n        if m:\r\n            cmd = m.group(1).strip()\r\n            if cmd and cmd not in seen:\r\n                seen.add(cmd)\r\n                print(f'frame {frame:03d}: {cmd}')\r\nprint(f'\\nTotal unique commands found: {len(seen)}')\r\nPY\r\n"]
[702.434064, "i", "python3 - <<'PY' > /app/commands_1fps.txt\nimport os, re, glob\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'))\nseen = set()\nfor fp in files:\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\n    with open(fp, errors='replace') as f:\n        text = f.read()\n    for line in text.splitlines():\n        s = line.strip()\n        m = re.match(r'^>\\s*(.+)$', s)\n        if m:\n            cmd = m.group(1).strip()\n            if cmd and cmd not in seen:\n                seen.add(cmd)\n                print(f'frame {frame:03d}: {cmd}')\nprint(f'\\nTotal unique commands found: {len(seen)}')\nPY\n"]
[702.434289, "o", "python3 - <<'PY' > /app/commands_1fps.txt\r\nimport os, re, glob\r\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'))\r\nseen = set()\r\nfor fp in files:\r\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\r\n    with open(fp, errors='replace') as f:\r\n        text = f.read()\r\n    for line in text.splitlines():\r\n        s = line.strip()\r\n        m = re.match(r'^>\\s*(.+)$', s)\r\n        if m:\r\n            cmd = m.group(1).strip()\r\n            if cmd and cmd not in seen:\r\n                seen.add(cmd)\r\n                print(f'frame {frame:03d}: {cmd}')\r\nprint(f'\\nTotal unique commands found: {len(seen)}')\r\nPY\r\n"]
