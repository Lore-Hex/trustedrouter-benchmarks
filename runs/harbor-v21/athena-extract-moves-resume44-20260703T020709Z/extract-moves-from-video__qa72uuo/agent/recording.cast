[1805.906124, "i", "python3 - <<'PY' > /app/moves_progress.txt\nimport os, re, glob\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'), key=lambda x: int(re.search(r'frame_(\\d+)', x).group(1)))\nfor fp in files:\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\n    with open(fp, errors='replace') as f:\n        text = f.read()\n    moves = None\n    m = re.search(r'Moves:\\s*(\\d+)', text)\n    if m:\n        moves = int(m.group(1))\n    prompt = ''\n    for line in text.splitlines():\n        s = line.strip()\n        if s.startswith('>'):\n            prompt = s[1:].strip()\n    print(f'F{frame:03d} M={moves} P=[{prompt}]')\nPY\n"]
