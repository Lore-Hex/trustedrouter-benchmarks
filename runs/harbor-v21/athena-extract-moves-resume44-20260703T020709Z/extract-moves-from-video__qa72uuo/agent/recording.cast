[2182.847425, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> files = sorted(glob.glob('/app/ocr/frame_*.txt'), key=lambda x: int(re.search(r'frame_(\\d+)', x).group(1)))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def get_completed_cmds(text):\r\n\u001b[?2004l\r\u001b[?2004h>     lines = text.splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     cmds = []\r\n\u001b[?2004l\r\u001b[?2004h>     for i, line in enumerate(lines):\r\n\u001b[?2004l\r\u001b[?2004h>         s = line.strip()\r\n\u001b[?2004l\r\u001b[?2004h>         if s.startswith('>'):\r\n\u001b[?2004l\r\u001b[?2004h>             cmd = s[1:].strip()\r\n\u001b[?2004l\r\u001b[?2004h>             if not cmd:\r\n\u001b[?2004l\r\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h>             has_output = False\r\n\u001b[?2004l\r\u001b[?2004h>             for j in range(i+1, len(lines)):\r\n\u001b[?2004l\r\u001b[?2004h>                 nxt = lines[j].strip()\r\n\u001b[?2004l\r\u001b[?2004h>                 if nxt.startswith('>'):\r\n\u001b[?2004l\r\u001b[?2004h>                     break\r\n\u001b[?2004l\r\u001b[?2004h>                 if nxt:\r\n\u001b[?2004l\r\u001b[?2004h>                     has_output = True\r\n\u001b[?2004l\r\u001b[?2004h>                     break\r\n\u001b[?2004l\r\u001b[?2004h>             if has_output:\r\n\u001b[?2004l\r\u001b[?2004h>                 cmds.append(cmd)\r\n\u001b[?2004l\r\u001b[?2004h>     return cmds\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def normalize(cmd):\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('_', '')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('Dopen', 'open')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('elose', 'close')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('eage', 'cage')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('ceage', 'cage')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('fr_', 'from')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('sow_', 'sword')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('tor_', 'torch')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('tem_', 'temple')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('case_', 'case')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('wren_', 'wrench')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('boar_', 'board')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('def la', 'deflate')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('drpo b_', 'drop boat')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('shar_', 'shard')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('pum_', 'pump')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('ech_', 'etch')\r\n\u001b[?2004l\r\u001b[?2004h>     cmd = cmd.replace('rin_', 'ring')\r\n\u001b[?2004l\r\u001b[?2004h> "]
