[1819.493431, "o", "\u001b[?2004hroot@bf354780b555:/app# "]
[1819.595063, "i", "python3 - <<'PY' > /app/ordered_moves_v2.txt\nimport os, re, glob\n\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'), key=lambda x: int(re.search(r'frame_(\\d+)', x).group(1)))\n\ndef extract_completed_cmds(text):\n    \"\"\"Extract ordered list of completed commands from scrollback.\n    A completed command is a >line followed by non-> lines before the next >line.\"\"\"\n    lines = text.splitlines()\n    cmds = []\n    for i, line in enumerate(lines):\n        s = line.strip()\n        if s.startswith('>'):\n            cmd = s[1:].strip()\n            if not cmd:\n                continue\n            has_output = False\n            for j in range(i+1, len(lines)):\n                nxt = lines[j].strip()\n                if nxt.startswith('>'):\n                    break\n                if nxt:\n                    has_output = True\n                    break\n            if has_output:\n                cmds.append(cmd)\n    return cmds\n\n# For each frame, get the ordered list of completed commands\nframe_cmd_lists = {}\nfor fp in files:\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\n    with open(fp, errors='replace') as f:\n        text = f.read()\n    frame_cmd_lists[frame] = extract_completed_cmds(text)\n\n# Reconstruct sequence by comparing consecutive frames\n# Find new commands that appear at the end of the current frame's list\n# that weren't in the previous frame's list\nall_moves = []\nprev_list = []\nfor frame in sorted(frame_cmd_lists.keys()):\n    curr_list = frame_cmd_lists[frame]\n    # Find the overlap between prev and current lists\n    # New commands are those after the overlap\n    if prev_list:\n        # Find how many commands from the end of prev_list appear at the start of curr_list\n        max_overlap = min(len(prev_list), len(curr_list))\n        overlap = 0\n        for o in range(max_overlap, 0, -1):\n            if prev_list[-o:] == curr_list[:o]:\n                overlap = o\n                break\n        new_cmds = curr_list[overlap:]\n    else:\n        new_cmds = curr_list\n    for cmd in new_cmds:\n        all_moves.append((frame, cmd))\n    prev_list = curr_list\n\nfor frame, cmd in all_moves:\n    print(f'F{frame:03d}: {cmd}')\nprint(f'\\nTotal moves: {len(all_moves)}')\nPY\n"]
[1819.595552, "o", "python3 - <<'PY' > /app/ordered_moves_v2.txt\r\n\u001b[?2004l\r\u001b[?2004h"]
