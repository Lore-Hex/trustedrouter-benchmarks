[1778.556982, "o", "\u001b[?2004hroot@bf354780b555:/app# "]
[1786.145546, "i", "python3 - <<'PY'\nimport os, re, glob\n\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'), key=lambda x: int(re.search(r'frame_(\\d+)', x).group(1)))\n\n# For each frame, extract the full text and find all >command lines followed by output\n# A completed command is a >line that has non-> lines after it before the next >line\nframe_cmds = {}\nfor fp in files:\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\n    with open(fp, errors='replace') as f:\n        lines = f.read().splitlines()\n    cmds = []\n    for i, line in enumerate(lines):\n        s = line.strip()\n        if s.startswith('>'):\n            cmd = s[1:].strip()\n            if not cmd:\n                continue\n            # Check if followed by game output before next >\n            has_output = False\n            for j in range(i+1, len(lines)):\n                nxt = lines[j].strip()\n                if nxt.startswith('>'):\n                    break\n                if nxt:\n                    has_output = True\n                    break\n            cmds.append((cmd, has_output))\n    frame_cmds[frame] = cmds\n\n# Now reconstruct the sequence: for each frame, find completed commands\n# that weren't in the previous frame's command list\nprev_cmds = set()\nordered_moves = []\nfor frame in sorted(frame_cmds.keys()):\n    cmds = frame_cmds[frame]\n    completed = [cmd for cmd, has_out in cmds if has_out]\n    current_set = set(cmd for cmd, _ in cmds)\n    # Find new completed commands not in previous frame\n    for cmd in completed:\n        if cmd not in prev_cmds:\n            ordered_moves.append((frame, cmd))\n    prev_cmds = current_set\n\nfor frame, cmd in ordered_moves:\n    print(f'F{frame:03d}: {cmd}')\nprint(f'\\nTotal ordered moves: {len(ordered_moves)}')\nPY\n"]
