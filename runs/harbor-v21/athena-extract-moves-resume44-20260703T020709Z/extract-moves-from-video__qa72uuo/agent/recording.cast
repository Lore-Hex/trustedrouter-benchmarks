[1189.396532, "i", "python3 - <<'PY'\nimport os, glob, subprocess\nfrom concurrent.futures import ProcessPoolExecutor\n\ndef ocr_frame(png):\n    base = os.path.splitext(os.path.basename(png))[0]\n    out = f'/app/ocr5/{base}'\n    txt = out + '.txt'\n    if os.path.exists(txt) and os.path.getsize(txt) > 0:\n        return base, 'skip'\n    subprocess.run(['tesseract', png, out], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n    return base, 'done'\n\nframes = sorted(glob.glob('/app/frames5/frame_*.png'))\nprint(f'Frames to OCR: {len(frames)}')\nwith ProcessPoolExecutor(max_workers=16) as ex:\n    for i, (base, status) in enumerate(ex.map(ocr_frame, frames), 1):\n        if i % 100 == 0 or i == len(frames):\n            print(f'{i}/{len(frames)} processed')\nprint('done')\nPY\n"]
[1189.396681, "o", "python3 - <<'PY'"]
