[1754.366529, "i", "python3 - <<'PY'\nimport os, re, glob\n\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'))\nfor fp in files[:10]:\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\n    with open(fp, errors='replace') as f:\n        text = f.read()\n    print(f'\\n===== FRAME {frame:03d} =====')\n    print(text[:500])\nPY\n"]
