[1411.538567, "i", "python3 - <<'PY'\nimport os, glob, subprocess, sys\nframes = sorted(glob.glob('/app/frames5/frame_*.png'))\ntodo = []\nfor png in frames:\n    base = os.path.splitext(os.path.basename(png))[0]\n    txt = f'/app/ocr5/{base}.txt'\n    if not (os.path.exists(txt) and os.path.getsize(txt) > 0):\n        todo.append((png, base, txt))\nprint(f'Total frames: {len(frames)}, already done: {len(frames)-len(todo)}, to do: {len(todo)}')\nfor i, (png, base, txt) in enumerate(todo, 1):\n    subprocess.run(['tesseract', png, f'/app/ocr5/{base}'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n    if i % 50 == 0 or i == len(todo):\n        print(f'{i}/{len(todo)} done', flush=True)\nprint('ALL DONE')\nPY\n"]
[1411.538829, "o", "python3 - <<'PY'\r\nimport os, glob, subprocess, sys\r\nframes = sorted(glob.glob('/app/frames5/frame_*.png'))\r\ntodo = []\r\nfor png in frames:\r\n    base = os.path.splitext(os.path.basename(png))[0]\r\n    txt = f'/app/ocr5/{base}.txt'\r\n    if not (os.path.exists(txt) and os.path.getsize(txt) > 0):\r\n        todo.append((png, base, txt))\r\nprint(f'Total frames: {len(frames)}, already done: {len(frames)-len(todo)}, to do: {len(todo)}')\r\nfor i, (png, base, txt) in enumerate(todo, 1):\r\n    subprocess.run(['tesseract', png, f'/app/ocr5/{base}'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\r\n    if i % 50 == 0 or i == len(todo):\r\n        print(f'{i}/{len(todo)} done', flush=True)\r\nprint('ALL DONE')\r\nPY\r\n"]
