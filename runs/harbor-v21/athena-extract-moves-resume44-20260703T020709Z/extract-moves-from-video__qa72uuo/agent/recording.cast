[2006.089444, "i", "python3 - <<'PY'\nimport subprocess, time, os, glob\nframes = sorted(glob.glob('/app/frames5/frame_*.png'))[:20]\nstart = time.time()\nprocs = []\nfor png in frames:\n    base = os.path.splitext(os.path.basename(png))[0]\n    out = f'/app/ocr5/{base}'\n    p = subprocess.Popen(['tesseract', png, out], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\n    procs.append(p)\nfor p in procs:\n    p.wait()\nelapsed = time.time() - start\nprint(f'20 frames in {elapsed:.1f}s = {elapsed/20:.2f}s/frame')\nprint(f'Estimated for 950: {elapsed/20*950:.0f}s')\nPY\n"]
[2006.08983, "o", "python3 - <<'PY'"]
