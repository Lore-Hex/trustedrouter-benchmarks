[2189.541971, "i", "python3 - <<'PY'\nimport re\nwith open('/app/moves_progress.txt') as f:\n    lines = f.readlines()\nprev_m = 0\nfor line in lines:\n    m = re.search(r'F(\\d+)\\s+M=(\\S+)\\s+P=\\[([^\\]]*)\\]', line.strip())\n    if m:\n        frame, moves, prompt = m.groups()\n        if moves != 'None':\n            mi = int(moves)\n            if mi - prev_m > 2:\n                print(f'F{frame} M={mi} (jump of {mi-prev_m}) P=[{prompt}]')\n            prev_m = mi\nPY\n"]
[2189.542149, "o", "python3 - <<'PY'"]
