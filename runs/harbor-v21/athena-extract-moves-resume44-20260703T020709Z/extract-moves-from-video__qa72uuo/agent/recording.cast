[1754.474522, "o", "\u001b[?2004hroot@bf354780b555:/app# "]
[1760.711537, "i", "python3 - <<'PY'\nimport os, re, glob\n\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'), key=lambda x: int(re.search(r'frame_(\\d+)', x).group(1)))\n\ndata = []\nfor fp in files:\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\n    with open(fp, errors='replace') as f:\n        text = f.read()\n    # Extract moves counter\n    moves = None\n    m = re.search(r'Moves:\\s*(\\d+)', text)\n    if m:\n        moves = int(m.group(1))\n    # Extract last line after >\n    prompt_lines = []\n    for line in text.splitlines():\n        s = line.strip()\n        if s.startswith('>'):\n            cmd = s[1:].strip()\n            prompt_lines.append(cmd)\n    last_prompt = prompt_lines[-1] if prompt_lines else ''\n    data.append((frame, moves, last_prompt, text))\n\n# Print frame, moves, prompt for each frame\nfor frame, moves, prompt, text in data[:60]:\n    print(f'F{frame:03d} M={moves} prompt=[{prompt}]')\nPY\n"]
