[657.833521, "i", "python3 - <<'PY'\nimport os, subprocess\nfor i in range(1,191):\n    o=f'/app/ocr/frame_{i:03d}.txt'\n    if not os.path.exists(o) or os.path.getsize(o)==0:\n        f=f'/app/frames/frame_{i:03d}.png'\n        print('missing',i)\n        subprocess.run(['tesseract',f,o],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)\nprint('done')\nPY\n"]
[657.833993, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
