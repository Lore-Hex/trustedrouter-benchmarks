[284.763548, "i", "for t in 1 5 15 30 60 90 120 150 180; do ffmpeg -y -ss $t -i /app/video.mp4 -frames:v 1 /app/frames/sample_${t}.png >/dev/null 2>&1; done\n"]
[284.764878, "o", "for t in 1 5 15 30 60 90 120 150 180; do ffmpeg -y -ss $t -i /app/video.mp4 -frames:v 1 /app/frames/sample_${t}.png >/dev/null 2>&1; done\r\n\u001b[?2004l\r"]
