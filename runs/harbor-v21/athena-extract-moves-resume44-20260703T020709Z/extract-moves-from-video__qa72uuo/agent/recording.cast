[2182.84512, "i", "python3 - <<'PY' > /app/moves_v3.txt\nimport os, re, glob\n\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'), key=lambda x: int(re.search(r'frame_(\\d+)', x).group(1)))\n\ndef get_completed_cmds(text):\n    lines = text.splitlines()\n    cmds = []\n    for i, line in enumerate(lines):\n        s = line.strip()\n        if s.startswith('>'):\n            cmd = s[1:].strip()\n            if not cmd:\n                continue\n            has_output = False\n            for j in range(i+1, len(lines)):\n                nxt = lines[j].strip()\n                if nxt.startswith('>'):\n                    break\n                if nxt:\n                    has_output = True\n                    break\n            if has_output:\n                cmds.append(cmd)\n    return cmds\n\ndef normalize(cmd):\n    cmd = cmd.replace('_', '')\n    cmd = cmd.replace('Dopen', 'open')\n    cmd = cmd.replace('elose', 'close')\n    cmd = cmd.replace('eage', 'cage')\n    cmd = cmd.replace('ceage', 'cage')\n    cmd = cmd.replace('fr_', 'from')\n    cmd = cmd.replace('sow_', 'sword')\n    cmd = cmd.replace('tor_', 'torch')\n    cmd = cmd.replace('tem_', 'temple')\n    cmd = cmd.replace('case_', 'case')\n    cmd = cmd.replace('wren_', 'wrench')\n    cmd = cmd.replace('boar_', 'board')\n    cmd = cmd.replace('def la', 'deflate')\n    cmd = cmd.replace('drpo b_', 'drop boat')\n    cmd = cmd.replace('shar_', 'shard')\n    cmd = cmd.replace('pum_', 'pump')\n    cmd = cmd.replace('ech_', 'etch')\n    cmd = cmd.replace('rin_', 'ring')\n    cmd = cmd.replace('pu,', 'put')\n    cmd = cmd.replace('ease_', 'inflate')\n    cmd = cmd.replace('1lid', 'lid')\n    cmd = cmd.replace('1li', 'li')\n    cmd = cmd.replace('ulysse', 'ulysses')\n    cmd = cmd.replace('slay trol', 'slay troll')\n    cmd = cmd.replace('pray_', 'pray')\n    cmd = cmd.replace('too_', 'tools')\n    cmd = cmd.replace('ne.', 'ne')\n    cmd = cmd.replace('n.', 'n')\n    cmd = cmd.replace('d.', 'd')\n    cmd = cmd.replace('A.', 'a')\n    cmd = cmd.replace('gY', 'g')\n    cmd = cmd.replace('wW', 'w')\n    return cmd.strip()\n\nall_moves = []\nprev_cmds_set = set()\nfor fp in files:\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\n    with open(fp, errors='replace') as f:\n        text = f.read()\n    curr_cmds = get_completed_cmds(text)\n    curr_cmds_norm = [normalize(c) for c in curr_cmds]\n    curr_set = set(curr_cmds_norm)\n    for cmd in curr_cmds_norm:\n        if cmd not in prev_cmds_set:\n            all_moves.append((frame, cmd))\n    prev_cmds_set = curr_set\n\nfor frame, cmd in all_moves:\n    print(f'{cmd}')\nprint(f'\\nTotal moves: {len(all_moves)}', file=__import__(\"sys\").stderr)\nPY\n"]
[2182.845631, "o", "python3 - <<'PY' > /app/moves_v3.txt\r\n\u001b[?2004l\r\u001b[?2004h> import os, re, glob"]
[2182.845672, "o", "\r\n"]
