[2006.090561, "o", "frames = sorted(glob.glob('/app/frames5/frame_*.png'))[:20]"]
[2006.091382, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> start = time.time()\r\n\u001b[?2004l\r\u001b[?2004h> procs = []\r\n\u001b[?2004l\r\u001b[?2004h> for png in frames:\r\n\u001b[?2004l\r\u001b[?2004h>     base = os.path.splitext(os.path.basename(png))[0]\r\n\u001b[?2004l\r\u001b[?2004h>     out = f'/app/ocr5/{base}'\r\n\u001b[?2004l\r\u001b[?2004h>     p = subprocess.Popen(['tesseract', png, out], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)\r\n\u001b[?2004l\r\u001b[?2004h>     procs.append(p)\r\n\u001b[?2004l\r\u001b[?2004h> for p in procs:\r\n\u001b[?2004l\r\u001b[?2004h>     p.wait()\r\n\u001b[?2004l\r\u001b[?2004h> elapsed = time.time() - start\r\n\u001b[?2004l\r\u001b[?2004h> print(f'20 frames in {elapsed:.1f}s = {elapsed/20:.2f}s/frame')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Estimated for 950: {elapsed/20*950:.0f}s')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
