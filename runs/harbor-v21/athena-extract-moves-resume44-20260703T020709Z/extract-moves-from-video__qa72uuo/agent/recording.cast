[1786.265586, "o", "\u001b[?2004hroot@bf354780b555:/app# "]
[1793.397468, "i", "python3 - <<'PY'\nimport os, re, glob\n\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'), key=lambda x: int(re.search(r'frame_(\\d+)', x).group(1)))\n\n# Print moves counter for each frame\nfor fp in files:\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\n    with open(fp, errors='replace') as f:\n        text = f.read()\n    moves = None\n    m = re.search(r'Moves:\\s*(\\d+)', text)\n    if m:\n        moves = int(m.group(1))\n    # Extract last prompt\n    prompt = ''\n    for line in text.splitlines():\n        s = line.strip()\n        if s.startswith('>'):\n            prompt = s[1:].strip()\n    if moves is not None or prompt:\n        print(f'F{frame:03d} M={moves} P=[{prompt}]')\nPY\n"]
[1793.397694, "o", "python3 - <<'PY'"]
