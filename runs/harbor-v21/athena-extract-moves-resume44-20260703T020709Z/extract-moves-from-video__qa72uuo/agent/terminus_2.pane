python3 - <<'PY'
import os, re, glob
files = sorted(glob.glob('/app/ocr/frame_*.txt'))
seen = set()
for fp in files:
    frame = int(re.search(r'frame_(\d+)', fp).group(1))
    with open(fp, errors='replace') as f:
        text = f.read()
    for line in text.splitlines():
        s = line.strip()
        # Lines that start with > followed by text (player input)
        m = re.match(r'^>\s*(.+)$', s)
        if m:
            cmd = m.group(1).strip()
            if cmd and cmd not in seen:
                seen.add(cmd)
                print(f'frame {frame:03d}: {cmd}')
print(f'\nTotal unique commands found: {len(seen)}')
PY
python3 - <<'PY' > /app/commands_1fps.txt
import os, re, glob
files = sorted(glob.glob('/app/ocr/frame_*.txt'))
seen = set()
for fp in files:
    frame = int(re.search(r'frame_(\d+)', fp).group(1))
    with open(fp, errors='replace') as f:
        text = f.read()
    for line in text.splitlines():
        s = line.strip()
        m = re.match(r'^>\s*(.+)$', s)
        if m:
            cmd = m.group(1).strip()
            if cmd and cmd not in seen:
                seen.add(cmd)
                print(f'frame {frame:03d}: {cmd}')
print(f'\nTotal unique commands found: {len(seen)}')
