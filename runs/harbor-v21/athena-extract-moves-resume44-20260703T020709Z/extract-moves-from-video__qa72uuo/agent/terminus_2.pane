[?2004hroot@bf354780b555:/app# python3 - <<'PY' > /app/ordered_moves_v2.txt
[?2004l[?2004h> import os, re, glob
[?2004l[?2004h> 
[?2004l[?2004h> files = sorted(glob.glob('/app/ocr/frame_*.txt'), key=lambda x: int(re.search(r'frame_(\d+)', x).group(1)))
[?2004l[?2004h> 
[?2004l[?2004h> def extract_completed_cmds(text):
[?2004l[?2004h>     """Extract ordered list of completed commands from scrollback.
[?2004l[?2004h>     A completed command is a >line followed by non-> lines before the next >line."""
[?2004l[?2004h>     lines = text.splitlines()
[?2004l[?2004h>     cmds = []
[?2004l[?2004h>     for i, line in enumerate(lines):
[?2004l[?2004h>         s = line.strip()
[?2004l[?2004h>         if s.startswith('>'):
[?2004l[?2004h>             cmd = s[1:].strip()
[?2004l[?2004h>             if not cmd:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             has_output = False
[?2004l[?2004h>             for j in range(i+1, len(lines)):
[?2004l[?2004h>                 nxt = lines[j].strip()
[?2004l[?2004h>                 if nxt.startswith('>'):
[?2004l[?2004h>                     break
[?2004l[?2004h>                 if nxt:
[?2004l[?2004h>                     has_output = True
[?2004l[?2004h>                     break
[?2004l[?2004h>             if has_output:
[?2004l[?2004h>                 cmds.append(cmd)
[?2004l[?2004h>     return cmds
[?2004l[?2004h> 
[?2004l[?2004h> # For each frame, get the ordered list of completed commands
[?2004l[?2004h> frame_cmd_lists = {}
[?2004l[?2004h> for fp in files:
[?2004l[?2004h>     frame = int(re.search(r'frame_(\d+)', fp).group(1))
[?2004l[?2004h>     with open(fp, errors='replace') as f:
[?2004l[?2004h>         text = f.read()
[?2004l[?2004h>     frame_cmd_lists[frame] = extract_completed_cmds(text)
[?2004l[?2004h> 
[?2004l[?2004h> # Reconstruct sequence by comparing consecutive frames
[?2004l[?2004h> # Find new commands that appear at the end of the current frame's list
[?2004l[?2004h> # that weren't in the previous frame's list
[?2004l[?2004h> all_moves = []
[?2004l[?2004h> prev_list = []
[?2004l[?2004h> for frame in sorted(frame_cmd_lists.keys()):
[?2004l[?2004h>     curr_list = frame_cmd_lists[frame]
[?2004l[?2004h>     # Find the overlap between prev and current lists
[?2004l[?2004h>     # New commands are those after the overlap
[?2004l[?2004h>     if prev_list:
[?2004l[?2004h>         # Find how many commands from the end of prev_list appear at the start of curr_list
[?2004l[?2004h>         max_overlap = min(len(prev_list), len(curr_list))
[?2004l[?2004h>         overlap = 0
[?2004l[?2004h>         for o in range(max_overlap, 0, -1):
[?2004l[?2004h>             if prev_list[-o:] == curr_list[:o]:
[?2004l[?2004h>                 overlap = o
[?2004l[?2004h>                 break
[?2004l[?2004h>         new_cmds = curr_list[overlap:]
[?2004l[?2004h>     else:
[?2004l[?2004h>         new_cmds = curr_list
[?2004l[?2004h>     for cmd in new_cmds:
[?2004l[?2004h>         all_moves.append((frame, cmd))
[?2004l[?2004h>     prev_list = curr_list
[?2004l[?2004h> 
[?2004l[?2004h> for frame, cmd in all_moves:
[?2004l[?2004h>     print(f'F{frame:03d}: {cmd}')
[?2004l[?2004h> print(f'\nTotal moves: {len(all_moves)}')
[?2004l[?2004h> PY
