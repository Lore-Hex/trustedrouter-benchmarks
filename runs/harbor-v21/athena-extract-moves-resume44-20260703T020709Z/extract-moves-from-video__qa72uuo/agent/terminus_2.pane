[?2004hroot@bf354780b555:/app# python3 - <<'PY'
[?2004l[?2004h> import os, re, glob
[?2004l[?2004h> 
[?2004l[?2004h> files = sorted(glob.glob('/app/ocr/frame_*.txt'), key=lambda x: int(re.search(r'frame_(\d+)', x).group(1)))
[?2004l[?2004h> 
[?2004l[?2004h> # For each frame, extract the full text and find all >command lines followed by output
[?2004l[?2004h> # A completed command is a >line that has non-> lines after it before the next >line
[?2004l[?2004h> frame_cmds = {}
[?2004l[?2004h> for fp in files:
[?2004l[?2004h>     frame = int(re.search(r'frame_(\d+)', fp).group(1))
[?2004l[?2004h>     with open(fp, errors='replace') as f:
[?2004l[?2004h>         lines = f.read().splitlines()
[?2004l[?2004h>     cmds = []
[?2004l[?2004h>     for i, line in enumerate(lines):
[?2004l[?2004h>         s = line.strip()
[?2004l[?2004h>         if s.startswith('>'):
[?2004l[?2004h>             cmd = s[1:].strip()
[?2004l[?2004h>             if not cmd:
[?2004l[?2004h>                 continue
[?2004l[?2004h>             # Check if followed by game output before next >
[?2004l[?2004h>             has_output = False
[?2004l[?2004h>             for j in range(i+1, len(lines)):
[?2004l[?2004h>                 nxt = lines[j].strip()
[?2004l[?2004h>                 if nxt.startswith('>'):
[?2004l[?2004h>                     break
[?2004l[?2004h>                 if nxt:
[?2004l[?2004h>                     has_output = True
[?2004l[?2004h>                     break
[?2004l[?2004h>             cmds.append((cmd, has_output))
[?2004l[?2004h>     frame_cmds[frame] = cmds
[?2004l[?2004h> 
[?2004l[?2004h> # Now reconstruct the sequence: for each frame, find completed commands
[?2004l[?2004h> # that weren't in the previous frame's command list
[?2004l[?2004h> prev_cmds = set()
[?2004l[?2004h> ordered_moves = []
[?2004l[?2004h> for frame in sorted(frame_cmds.keys()):
[?2004l[?2004h>     cmds = frame_cmds[frame]
[?2004l[?2004h>     completed = [cmd for cmd, has_out in cmds if has_out]
[?2004l[?2004h>     current_set = set(cmd for cmd, _ in cmds)
[?2004l[?2004h>     # Find new completed commands not in previous frame
[?2004l[?2004h>     for cmd in completed:
[?2004l[?2004h>         if cmd not in prev_cmds:
[?2004l[?2004h>             ordered_moves.append((frame, cmd))
[?2004l[?2004h>     prev_cmds = current_set
[?2004l[?2004h> 
[?2004l[?2004h> for frame, cmd in ordered_moves:
[?2004l[?2004h>     print(f'F{frame:03d}: {cmd}')
[?2004l[?2004h> print(f'\nTotal ordered moves: {len(ordered_moves)}')
