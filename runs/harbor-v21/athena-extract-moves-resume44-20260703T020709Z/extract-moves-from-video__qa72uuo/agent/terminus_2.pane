[?2004l[?2004h> import os, re, glob
[?2004l[?2004h> 
[?2004l[?2004h> files = sorted(glob.glob('/app/ocr/frame_*.txt'), key=lambda x: int(re.search(r'frame_(\d+)', x).group(1)))
[?2004l[?2004h> 
[?2004l[?2004h> # Print moves counter for each frame
[?2004l[?2004h> for fp in files:
[?2004l[?2004h>     frame = int(re.search(r'frame_(\d+)', fp).group(1))
[?2004l[?2004h>     with open(fp, errors='replace') as f:
[?2004l[?2004h>         text = f.read()
[?2004l[?2004h>     moves = None
[?2004l[?2004h>     m = re.search(r'Moves:\s*(\d+)', text)
[?2004l[?2004h>     if m:
[?2004l[?2004h>         moves = int(m.group(1))
[?2004l[?2004h>     # Extract last prompt
[?2004l[?2004h>     prompt = ''
[?2004l[?2004h>     for line in text.splitlines():
[?2004l[?2004h>         s = line.strip()
[?2004l[?2004h>         if s.startswith('>'):
[?2004l[?2004h>             prompt = s[1:].strip()
[?2004l[?2004h>     if moves is not None or prompt:
[?2004l[?2004h>         print(f'F{frame:03d} M={moves} P=[{prompt}]')
