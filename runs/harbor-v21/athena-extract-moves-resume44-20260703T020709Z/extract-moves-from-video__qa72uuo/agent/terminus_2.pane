import os, glob, subprocess, sys
frames = sorted(glob.glob('/app/frames5/frame_*.png'))
todo = []
for png in frames:
    base = os.path.splitext(os.path.basename(png))[0]
    txt = f'/app/ocr5/{base}.txt'
    if not (os.path.exists(txt) and os.path.getsize(txt) > 0):
        todo.append((png, base, txt))
print(f'Total frames: {len(frames)}, already done: {len(frames)-len(todo)}, to do: {len(todo)}')
for i, (png, base, txt) in enumerate(todo, 1):
    subprocess.run(['tesseract', png, f'/app/ocr5/{base}'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if i % 50 == 0 or i == len(todo):
        print(f'{i}/{len(todo)} done', flush=True)
print('ALL DONE')
