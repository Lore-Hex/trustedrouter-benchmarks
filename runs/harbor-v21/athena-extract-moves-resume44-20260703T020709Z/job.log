Sending keys: ["python3 - <<'PY'\nimport os, re, glob\n\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'), key=lambda x: int(re.search(r'frame_(\\d+)', x).group(1)))\n\n# Collect all > lines from all frames\nall_cmds = []\nseen_cmds = set()\nfor fp in files:\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\n    with open(fp, errors='replace') as f:\n        lines = f.read().splitlines()\n    for i, line in enumerate(lines):\n        s = line.strip()\n        if s.startswith('>'):\n            cmd = s[1:].strip()\n            if cmd:\n                # Check if there's game output after this line (completed command)\n                has_output = False\n                for j in range(i+1, min(i+5, len(lines))):\n                    nxt = lines[j].strip()\n                    if nxt and not nxt.startswith('>'):\n                        has_output = True\n                        break\n                key = (frame, cmd, has_output)\n                if key not in seen_cmds:\n                    seen_cmds.add(key)\n                    all_cmds.append((frame, cmd, has_output))\n\n# Print all commands with frame and whether followed by output\nfor frame, cmd, has_output in all_cmds:\n    flag = 'OUT' if has_output else '   '\n    print(f'F{frame:03d} {flag} [{cmd}]')\nprint(f'\\nTotal command instances: {len(all_cmds)}')\nPY\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
