[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import sys
[?2004l[?2004h> 
[?2004l[?2004h> sys.path.insert(0, '/app')
[?2004l[?2004h> from forward import forward
[?2004l[?2004h> 
[?2004l[?2004h> DIM = 10
[?2004l[?2004h> N_HIDDEN = 20
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def f(x):
[?2004l[?2004h>     return forward(x)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def grad_at(x, h=1e-3):
[?2004l[?2004h>     """Central-difference gradient of f at x (10 queries)."""
[?2004l[?2004h>     g = np.zeros(DIM)
[?2004l[?2004h>     for i in range(DIM):
[?2004l[?2004h>         xp = x.copy(); xp[i] += h
[?2004l[?2004h>         xm = x.copy(); xm[i] -= h
[?2004l[?2004h>         g[i] = (f(xp) - f(xm)) / (2.0 * h)
[?2004l[?2004h>     return g
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> # Collect gradient-jump directions with frequency counting.
[?2004l[?2004h> # Each entry: [unit_direction, count, vector_sum]
[?2004l[?2004h> collected = []
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def add_jump(v, sim_threshold=0.999):
[?2004l[?2004h>     """Record a gradient jump vector, grouping by direction."""
[?2004l[?2004h>     n = np.linalg.norm(v)
[?2004l[?2004h>     if n < 1e-10:
[?2004l[?2004h>         return
[?2004l[?2004h>     v_unit = v / n
[?2004l[?2004h>     for entry in collected:
[?2004l[?2004h>         u = entry[0]
[?2004l[?2004h>         cos = np.dot(u, v_unit)
[?2004l[?2004h>         if abs(cos) > sim_threshold:
[?2004l[?2004h>             entry[1] += 1
[?2004l[?2004h>             entry[2] += v if cos > 0 else -v
[?2004l[?2004h>             entry[0] = entry[2] / np.linalg.norm(entry[2])
[?2004l[?2004h>             return
[?2004l[?2004h>     collected.append([v_unit, 1, v.copy()])
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> rng = np.random.RandomState(42)
[?2004l[?2004h> 
[?2004l[?2004h> for attempt in range(20):
[?2004l[?2004h>     x0 = rng.randn(DIM) * 0.5
[?2004l[?2004h>     d = rng.randn(DIM)
[?2004l[?2004h>     d /= np.linalg.norm(d)
[?2004l[?2004h> 
[?2004l[?2004h>     n_samples = 3000
[?2004l[?2004h>     ts = np.linspace(-12.0, 12.0, n_samples)
[?2004l[?2004h>     dt = ts[1] - ts[0]
[?2004l[?2004h>     vals = np.array([f(x0 + t * d) for t in ts])
[?2004l[?2004h> 
[?2004l[?2004h>     slopes = (vals[1:] - vals[:-1]) / dt
[?2004l[?2004h>     second_diffs = slopes[1:] - slopes[:-1]
[?2004l[?2004h> 
[?2004l[?2004h>     kink_idx = np.where(np.abs(second_diffs) > 1e-7)[0]
[?2004l[?2004h> 
[?2004l[?2004h>     kinks = []
[?2004l[?2004h>     for idx in kink_idx:
[?2004l[?2004h>         t_k = ts[idx + 1]
[?2004l[?2004h>         if not kinks or abs(t_k - kinks[-1]) > 5 * dt:
[?2004l[?2004h>             kinks.append(t_k)
[?2004l[?2004h> 
[?2004l[?2004h>     for ki, t_k in enumerate(kinks):
[?2004l[?2004h>         # Adaptive eps: avoid crossing neighboring kinks on this line
[?2004l[?2004h>         other_dists = [abs(t_k - t_other) for kj, t_other in enumerate(kinks) if ki != kj]
[?2004l[?2004h>         min_dist = min(other_dists) if other_dists else 1.0
[?2004l[?2004h>         eps = min(0.02, min_dist / 3.0)
[?2004l[?2004h> 
[?2004l[?2004h>         if eps < 2e-3:
[?2004l[?2004h>             continue  # too close to another kink to resolve cleanly
[?2004l[?2004h> 
[?2004l[?2004h>         p = x0 + t_k * d
[?2004l[?2004h>         jump = grad_at(p + eps * d) - grad_at(p - eps * d)
[?2004l[?2004h>         add_jump(jump)
[?2004l[?2004h> 
[?2004l[?2004h> # Select the N_HIDDEN most frequently observed directions
[?2004l[?2004h> collected.sort(key=lambda e: -e[1])
[?2004l[?2004h> A1_stolen = np.array([e[0] for e in collected[:N_HIDDEN]])
[?2004l[?2004h> 
[?2004l[?2004h> np.save('/app/stolen_A1.npy', A1_stolen)
[?2004l[?2004h> print(A1_stolen)
