[?2004l[?2004h> 
[?2004l[?2004h> def add_direction(v):
[?2004l[?2004h>     """Add v as a new A1 row direction if it is nonzero and unique up to sign."""
[?2004l[?2004h>     n = np.linalg.norm(v)
[?2004l[?2004h>     if n < 1e-8:
[?2004l[?2004h>         return False
