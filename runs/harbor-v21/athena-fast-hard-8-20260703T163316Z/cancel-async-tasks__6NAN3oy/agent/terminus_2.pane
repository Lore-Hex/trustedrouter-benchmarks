[?2004hroot@9ae1bb49ea43:/app# cat > /app/run.py <<'PY'
[?2004l[?2004h> from __future__ import annotations
[?2004l[?2004h> 
[?2004l[?2004h> import asyncio
[?2004l[?2004h> from typing import Awaitable, Callable
[?2004l[?2004h> 
[?2004l[?2004h> __all__ = ["run_tasks"]
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> async def run_tasks(
[?2004l[?2004h>     tasks: list[Callable[[], Awaitable[None]]],
[?2004l[?2004h>     max_concurrent: int,
[?2004l[?2004h> ) -> None:
[?2004l[?2004h>     """Run async tasks with a concurrency limit.
[?2004l[?2004h> 
[?2004l[?2004h>     Each entry in ``tasks`` is a callable that returns an awaitable when
[?2004l[?2004h>     invoked.  At most ``max_concurrent`` awaitables are allowed to run at the
[?2004l[?2004h>     same time.
[?2004l[?2004h> 
[?2004l[?2004h>     If this coroutine is cancelled or interrupted, for example by Ctrl+C,
[?2004l[?2004h>     all started tasks are cancelled and awaited so their ``finally``/cleanup
[?2004l[?2004h>     blocks have a chance to run before the cancellation propagates.
[?2004l[?2004h>     """
[?2004l[?2004h>     if max_concurrent < 1:
[?2004l[?2004h>         raise ValueError("max_concurrent must be at least 1")
[?2004l[?2004h> 
[?2004l[?2004h>     semaphore = asyncio.Semaphore(max_concurrent)
[?2004l[?2004h> 
[?2004l[?2004h>     async def _run_one(factory: Callable[[], Awaitable[None]]) -> None:
[?2004l[?2004h>         async with semaphore:
[?2004l[?2004h>             await factory()
[?2004l[?2004h> 
[?2004l[?2004h>     background_tasks = [
[?2004l[?2004h>         asyncio.ensure_future(_run_one(factory)) for factory in tasks
[?2004l[?2004h>     ]
[?2004l[?2004h> 
[?2004l[?2004h>     try:
[?2004l[?2004h>         await asyncio.gather(*background_tasks)
[?2004l[?2004h>     except BaseException:
[?2004l[?2004h>         for task in background_tasks:
[?2004l[?2004h>             if not task.done():
[?2004l[?2004h>                 task.cancel()
[?2004l[?2004h> 
[?2004l[?2004h>         if background_tasks:
[?2004l[?2004h>             await asyncio.gather(*background_tasks, return_exceptions=True)
[?2004l[?2004h> 
[?2004l[?2004h>         raise
[?2004l[?2004h> PY
[?2004l[?2004hroot@9ae1bb49ea43:/app# python3 -m py_compile /app/run.py
[?2004l[?2004hroot@9ae1bb49ea43:/app# python3 - <<'PY'
[?2004l[?2004h> import asyncio
[?2004l[?2004h> from run import run_tasks
[?2004l[?2004h> 
[?2004l[?2004h> active = 0
[?2004l[?2004h> max_active = 0
[?2004l[?2004h> 
[?2004l[?2004h> async def job():
[?2004l[?2004h>     global active, max_active
[?2004l[?2004h>     active += 1
[?2004l[?2004h>     max_active = max(max_active, active)
[?2004l[?2004h>     await asyncio.sleep(0.05)
[?2004l[?2004h>     active -= 1
[?2004l[?2004h> 
[?2004l[?2004h> asyncio.run(run_tasks([lambda: job() for _ in range(10)], 3))
[?2004l[?2004h> assert max_active == 3, max_active
[?2004l[?2004h> 
[?2004l[?2004h> cleaned = asyncio.Event()
[?2004l[?2004h> 
[?2004l[?2004h> async def slow():
[?2004l[?2004h>     try:
[?2004l[?2004h>         await asyncio.sleep(10)
[?2004l[?2004h>     finally:
[?2004l[?2004h>         cleaned.set()
[?2004l[?2004h> 
[?2004l[?2004h> async def main():
[?2004l[?2004h>     task = asyncio.create_task(run_tasks([lambda: slow()], 1))
[?2004l[?2004h>     await asyncio.sleep(0.05)
[?2004l[?2004h>     task.cancel()
[?2004l[?2004h>     try:
[?2004l[?2004h>         await task
[?2004l[?2004h>     except asyncio.CancelledError:
[?2004l[?2004h>         pass
[?2004l[?2004h>     assert cleaned.is_set()
[?2004l[?2004h> 
[?2004l[?2004h> asyncio.run(main())
[?2004l[?2004h> print("ok")
[?2004l[?2004h> PY
[?2004lok
