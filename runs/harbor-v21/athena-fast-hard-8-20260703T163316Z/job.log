Sending keys: ['cat > /app/polyglot/main.rs <<\'EOF\'\n/* /* */ #if 0\n*/\nfn main() {\n    let args: Vec<String> = std::env::args().collect();\n    if args.len() != 2 {\n        eprintln!("Usage: program N");\n        std::process::exit(1);\n    }\n\n    let n: u64 = match args[1].parse::<u64>() {\n        Ok(value) => value,\n        Err(_) => {\n            eprintln!("Invalid N");\n            std::process::exit(1);\n        }\n    };\n\n    let mut a = "1".to_string();\n    let mut b = "1".to_string();\n\n    if n == 0 {\n        println!("{}", a);\n        return;\n    }\n\n    let mut i = 1u64;\n    while i < n {\n        let c = add_dec(&a, &b);\n        a = b;\n        b = c;\n        i += 1;\n    }\n\n    println!("{}", b);\n}\n\nfn add_dec(x: &str, y: &str) -> String {\n    let a: Vec<u8> = x.bytes().rev().map(|c| c - 48).collect();\n    let b: Vec<u8> = y.bytes().rev().map(|c| c - 48).collect();\n    let mut result: Vec<u8> = Vec::new();\n    let mut carry = 0u8;\n    let len = a.len().max(b.len());\n    let mut i = 0usize;\n\n    while i < len {\n        let av = a.get(i).copied().unwrap_or(0);\n        let bv = b.get(i).copied().unwrap_or(0);\n        let sum = av + bv + carry;\n        result.push(sum % 10);\n        carry = sum / 10;\n        i += 1;\n    }\n\n    if carry != 0 {\n        result.push(carry);\n    }\n\n    result.iter().rev().map(|d| (*d + 48) as char).collect()\n}\n/* /* */ #endif // */\n/* /* */\n#include <cstdio>\n#include <cstdlib>\n#include <string>\n#include <vector>\n#include <cstdint>\n\nusing namespace std;\n\nstring add_dec(const string& x, const string& y) {\n    vector<uint8_t> a(x.rbegin(), x.rend());\n    vector<uint8_t> b(y.rbegin(), y.rend());\n\n    for (size_t i = 0; i < a.size(); ++i) a[i] -= static_cast<uint8_t>(\'0\');\n    for (size_t i = 0; i < b.size(); ++i) b[i] -= static_cast<uint8_t>(\'0\');\n\n    vector<uint8_t> result;\n    size_t len = a.size() > b.size() ? a.size() : b.size();\n    uint8_t carry = 0;\n\n    for (size_t i = 0; i < len; ++i) {\n        uint8_t av = i < a.size() ? a[i] : 0;\n        uint8_t bv = i < b.size() ? b[i] : 0;\n        uint8_t sum = av + bv + carry;\n        result.push_back(sum % 10);\n        carry = sum / 10;\n    }\n\n    if (carry) result.push_back(carry);\n\n    string s;\n    for (auto it = result.rbegin(); it != result.rend(); ++it) {\n        s.push_back(static_cast<char>(*it + \'0\'));\n    }\n    return s;\n}\n\nint main(int argc, char** argv) {\n    if (argc != 2) {\n        fprintf(stderr, "Usage: program N\\n");\n        return 1;\n    }\n\n    char* end = nullptr;\n    long long n = strtoll(argv[1], &end, 10);\n    if (end == argv[1] || *end != \'\\0\' || n < 0) {\n        fprintf(stderr, "Invalid N\\n");\n        return 1;\n    }\n\n    string a = "1";\n    string b = "1";\n\n    if (n == 0) {\n        printf("%s\\n", a.c_str());\n        return 0;\n    }\n\n    for (long long i = 1; i < n; ++i) {\n        string c = add_dec(a, b);\n        a = b;\n        b = c;\n    }\n\n    printf("%s\\n", b.c_str());\n    return 0;\n}\n//*/\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
