          "r" (arg4),
          "r" (arg5),
          "r" (arg6)
        
        /* Clobbered registers */
        : "v0", "a0", "a1", "a2", "a3", "t0", "t1", "memory"
    );
    
    /* 
     * MIPS typically uses negative return values for errors
     * and sets errno accordingly
     */
    if (result < 0) {
        errno = -result;
        return -1;
    }
    
    return result;
}
