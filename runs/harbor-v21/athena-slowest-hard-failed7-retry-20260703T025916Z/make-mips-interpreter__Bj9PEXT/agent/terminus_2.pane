1534                      long arg4, long arg5, long arg6) {
1535     long result;
1536 
1537     /* Special case for stdout/stderr writes - bypass fake filesystem */
1538     if (syscall_num == SYS_write && (arg1 == 0 || arg1 == 1)) {
1539         /* Use the real syscall for stdout/stderr */
1540       return real_syscall6(syscall_num, arg1, arg2, arg3, arg4, arg5, arg6);
1541     }
1542 
1543     /* Check if this is a file-related syscall that should be handled by fake_fs.c */
1544     switch (syscall_num) {
1545         case SYS_read:
1546         case SYS_write:
1547         case SYS_open:
1548         case SYS_close:
1549         case SYS_lseek:
1550         case SYS_fsync:
1551         case SYS_rename:
1552         case SYS_mkdir:
1553         case SYS_unlink:
1554 	  #ifdef USE_FS
