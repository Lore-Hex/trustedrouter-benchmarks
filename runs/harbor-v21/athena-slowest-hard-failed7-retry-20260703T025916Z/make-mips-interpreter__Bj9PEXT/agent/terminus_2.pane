   263	//
   264	// I_FinishUpdate
   265	//
   266	
   267	void I_FinishUpdate (void)
   268	{
   269	    int y;
   270	    int x_offset, y_offset, x_offset_end;
   271	    unsigned char *line_in, *line_out;
   272	
   273	    /* Offsets in case FB is bigger than DOOM */
   274	    /* 600 = s_Fb heigt, 200 screenheight */
   275	    /* 600 = s_Fb heigt, 200 screenheight */
   276	    /* 2048 =s_Fb width, 320 screenwidth */
   277	    y_offset     = (((s_Fb.yres - (SCREENHEIGHT * fb_scaling)) * s_Fb.bits_per_pixel/8)) / 2;
   278	    x_offset     = (((s_Fb.xres - (SCREENWIDTH  * fb_scaling)) * s_Fb.bits_per_pixel/8)) / 2; // XXX: siglent FB hack: /4 instead of /2, since it seems to handle the resolution in a funny way
   279	    //x_offset     = 0;
   280	    x_offset_end = ((s_Fb.xres - (SCREENWIDTH  * fb_scaling)) * s_Fb.bits_per_pixel/8) - x_offset;
   281	
   282	    /* DRAW SCREEN */
   283	    line_in  = (unsigned char *) I_VideoBuffer;
   284	    line_out = (unsigned char *) DG_ScreenBuffer;
   285	
   286	    y = SCREENHEIGHT;
   287	
   288	    while (y--)
   289	    {
   290	        int i;
   291	        for (i = 0; i < fb_scaling; i++) {
   292	            line_out += x_offset;
   293	#ifdef CMAP256
   294	            if (fb_scaling == 1) {
   295	                memcpy(line_out, line_in, SCREENWIDTH); /* fb_width is bigger than Doom SCREENWIDTH... */
   296	            } else {
   297	                int j;
   298	
   299	                for (j = 0; j < SCREENWIDTH; j++) {
   300	                    int k;
   301	                    for (k = 0; k < fb_scaling; k++) {
   302	                        line_out[j * fb_scaling + k] = line_in[j];
   303	                    }
   304	                }
   305	            }
   306	#else
   307	            //cmap_to_rgb565((void*)line_out, (void*)line_in, SCREENWIDTH);
   308	            cmap_to_fb((void*)line_out, (void*)line_in, SCREENWIDTH);
   309	#endif
   310	            line_out += (SCREENWIDTH * fb_scaling * (s_Fb.bits_per_pixel/8)) + x_offset_end;
   311	        }
   312	        line_in += SCREENWIDTH;
   313	    }
   314	
   315		DG_DrawFrame();
   316	}
