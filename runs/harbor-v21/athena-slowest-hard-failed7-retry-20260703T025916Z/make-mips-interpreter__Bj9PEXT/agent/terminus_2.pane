  24:     uint16_t bits_per_pixel;    // Bits per pixel
  25:     uint32_t compression;       // Compression type
  26:     uint32_t image_size_bytes;  // Image size in bytes
  27:     int32_t  x_resolution_ppm;  // Pixels per meter
  28:     int32_t  y_resolution_ppm;  // Pixels per meter
  29:     uint32_t num_colors;        // Number of colors
  30:     uint32_t important_colors;  // Important colors
  31: } BMPHeader;
