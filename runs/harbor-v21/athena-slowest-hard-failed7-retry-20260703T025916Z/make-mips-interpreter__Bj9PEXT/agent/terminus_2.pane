 152     }
 153     else
 154     {
 155         default_ram = DEFAULT_RAM;
 156         min_ram = MIN_RAM;
 157     }
 158 
 159     zonemem = AutoAllocMemory(size, default_ram, min_ram);
 160 
 161     printf("zone memory: %p, %x allocated for zone\n", 
 162            zonemem, *size);
 163 
 164     return zonemem;
 165 }
