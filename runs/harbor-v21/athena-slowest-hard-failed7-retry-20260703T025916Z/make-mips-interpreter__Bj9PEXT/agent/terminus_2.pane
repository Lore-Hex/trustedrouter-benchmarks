import struct
b=open('doomgeneric_mips','rb').read()
hdr=struct.unpack('<16sHHIIIIIHHHHHH', b[:52])
entry,phoff,shoff,flags,ehsize,phentsize,phnum,shentsize,shnum,shstrndx=hdr[4],hdr[5],hdr[6],hdr[7],hdr[8],hdr[9],hdr[10],hdr[11],hdr[12],hdr[13]
secs=[]
for i in range(shnum):
    o=shoff+i*shentsize
    vals=struct.unpack('<IIIIIIIIII', b[o:o+40])
    secs.append(vals)
def getstr(tab,off):
    e=tab.find(b'\0',off); return tab[off:e].decode('latin1','replace')
shstr=secs[shstrndx]; shstrtab=b[shstr[4]:shstr[4]+shstr[5]]
with open('/tmp/symbols.txt','w') as out:
    for si,s in enumerate(secs):
        nm=getstr(shstrtab,s[0]) if s[0]<len(shstrtab) else ''
        if s[1] in (2,11):
            strsec=secs[s[6]]; strtab=b[strsec[4]:strsec[4]+strsec[5]]
            cnt=s[5]//max(1,s[9])
            for j in range(cnt):
                ent=b[s[4]+j*s[9]:s[4]+(j+1)*s[9]]
                if len(ent)<16: break
                st_name,st_value,st_size,st_info,st_other,st_shndx=struct.unpack('<IIIBBH', ent[:16])
                n=getstr(strtab,st_name) if st_name<len(strtab) else ''
                if n:
                    out.write(f'{st_value:08x} {st_size:6} {n}\n')
print('wrote /tmp/symbols.txt')
