 517: // SYS_open: Open a file
 518: int sys_open(const char* pathname, int flags, mode_t mode) {
 519:     if (root == NULL) {
 520:         init_filesystem();
 521:     }
 522:     
 523:     FileNode* parent_dir = NULL;
 524:     FileNode* node = find_node(pathname, &parent_dir);
 525:     
 526:     if (node == NULL) {
 527:         // File not found
 528:         if (flags & O_CREAT) {
 529:             // Create a new file
 530:             char dir_path[MAX_PATH_LENGTH];
 531:             char filename[MAX_PATH_LENGTH];
 532:             
 533:             split_path(pathname, dir_path, filename);
 534:             
 535:             if (strlen(filename) == 0) {
 536:                 return -EINVAL; // Invalid filename
 537:             }
 538:             
 539:             if (parent_dir == NULL) {
 540:                 parent_dir = find_node(dir_path, NULL);
 541:                 if (parent_dir == NULL) {
 542:                     return -ENOENT; // Parent directory not found
 543:                 }
 544:             }
 545:             
 546:             if (parent_dir->type != FILE_TYPE_DIRECTORY) {
 547:                 return -ENOTDIR;
 548:             }
 549:             
 550:             node = create_node(filename, FILE_TYPE_REGULAR, parent_dir);
 551:             int result = add_to_directory(parent_dir, filename, node);
 552:             if (result < 0) {
 553:                 free(node);
 554:                 return result;
 555:             }
 556:         } else {
 557:             return -ENOENT; // File not found and we're not creating it
 558:         }
 559:     } else if (flags & O_CREAT && flags & O_EXCL) {
 560:         return -EEXIST; // File exists but O_CREAT|O_EXCL was specified
 561:     }
 562:     
 563:     if (node->type == FILE_TYPE_DIRECTORY && (flags & O_WRONLY || flags & O_RDWR)) {
 564:         return -EISDIR; // Cannot open directory for writing
 565:     }
 566:     
 567:     if (flags & O_TRUNC && (flags & O_WRONLY || flags & O_RDWR)) {
 568:         // Truncate the file
 569:         if (node->data != NULL) {
 570:             free(node->data);
 571:             node->data = NULL;
 572:         }
 573:         node->size = 0;
 574:         node->capacity = 0;
 575:         node->modified = time(NULL);
 576:     }
 577:     
 578:     int fd = allocate_fd(node, flags);
 579:     if (fd < 0) {
 580:         return fd;
 581:     }
 582:     
 583:     if (flags & O_APPEND) {
 584:         fd_table[fd].position = node->size;
 585:     } else {
 586:         fd_table[fd].position = 0;
 587:     }
 588:     
 589:     node->accessed = time(NULL);
 590:     
 591:     return fd;
 592: }
 593: 
 594: // SYS_close: Close a file
 595: int sys_close(int fd) {
 596:     if (fd < 0 || fd >= MAX_FILE_DESCRIPTORS || !fd_table[fd].used) {
 597:         return -EBADF;
 598:     }
 599:     
 600:     fd_table[fd].used = 0;
 601:     return 0;
 602: }
 603: 
 604: // SYS_lseek: Reposition read/write file offset
 605: off_t sys_lseek(int fd, off_t offset, int whence) {
 606:     if (fd < 0 || fd >= MAX_FILE_DESCRIPTORS || !fd_table[fd].used) {
 607:         return -EBADF;
 608:     }
 609:     
 610:     FileNode* node = fd_table[fd].node;
 611:     off_t new_pos = 0;
 612:     
 613:     switch (whence) {
 614:         case SEEK_SET:
 615:             new_pos = offset;
 616:             break;
 617:         case SEEK_CUR:
 618:             new_pos = fd_table[fd].position + offset;
 619:             break;
 620:         case SEEK_END:
 621:             new_pos = node->size + offset;
 622:             break;
 623:         default:
 624:             return -EINVAL;
 625:     }
 626:     
 627:     if (new_pos < 0) {
 628:         return -EINVAL;
 629:     }
 630:     
 631:     fd_table[fd].position = new_pos;
 632:     return new_pos;
 633: }
 634: 
 635: // SYS_fsync: Synchronize a file's in-memory state (no-op for in-memory FS)
 636: int sys_fsync(int fd) {
 637:     if (fd < 0 || fd >= MAX_FILE_DESCRIPTORS || !fd_table[fd].used) {
 638:         return -EBADF;
 639:     }
 640:     
==== 641-820 ====
 641:     // Nothing to do for an in-memory filesystem
 642:     return 0;
 643: }
