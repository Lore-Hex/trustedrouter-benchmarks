   131	// Palette converted to RGB565
   132	
   133	static uint16_t rgb565_palette[256];
   134	
   135	void cmap_to_rgb565(uint16_t * out, uint8_t * in, int in_pixels)
   136	{
   137	    int i, j;
   138	    struct color c;
   139	    uint16_t r, g, b;
   140	
   141	    for (i = 0; i < in_pixels; i++)
   142	    {
   143	        c = colors[*in]; 
   144	        r = ((uint16_t)(c.r >> 3)) << 11;
   145	        g = ((uint16_t)(c.g >> 2)) << 5;
   146	        b = ((uint16_t)(c.b >> 3)) << 0;
   147	        *out = (r | g | b);
   148	
   149	        in++;
   150	        for (j = 0; j < fb_scaling; j++) {
   151	            out++;
   152	        }
   153	    }
   154	}
   155	
   156	void cmap_to_fb(uint8_t * out, uint8_t * in, int in_pixels)
   157	{
   158	    int i, j, k;
   159	    struct color c;
   160	    uint32_t pix;
   161	    uint16_t r, g, b;
   162	
   163	    for (i = 0; i < in_pixels; i++)
   164	    {
   165	        c = colors[*in];  /* R:8 G:8 B:8 format! */
   166	        r = (uint16_t)(c.r >> (8 - s_Fb.red.length));
   167	        g = (uint16_t)(c.g >> (8 - s_Fb.green.length));
   168	        b = (uint16_t)(c.b >> (8 - s_Fb.blue.length));
   169	        pix = r << s_Fb.red.offset;
   170	        pix |= g << s_Fb.green.offset;
   171	        pix |= b << s_Fb.blue.offset;
   172	
   173	        for (k = 0; k < fb_scaling; k++) {
   174	            for (j = 0; j < s_Fb.bits_per_pixel/8; j++) {
   175	                *out = (pix >> (j*8));
   176	                out++;
   177	            }
   178	        }
   179	        in++;
   180	    }
   181	}
