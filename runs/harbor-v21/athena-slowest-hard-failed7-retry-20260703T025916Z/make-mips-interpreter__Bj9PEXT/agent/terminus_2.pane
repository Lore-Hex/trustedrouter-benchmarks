 205: int DG_GetKey(int* pressed, unsigned char* doomKey)
 206: {
 207:     if (s_KeyQueueReadIndex == s_KeyQueueWriteIndex)
 208:     {
 209:         //key queue is empty
 210:         return 0;
 211:     }
 212:     else
 213:     {
 214:         unsigned short keyData = s_KeyQueue[s_KeyQueueReadIndex];
 215:         s_KeyQueueReadIndex++;
 216:         s_KeyQueueReadIndex %= KEYQUEUE_SIZE;
 217: 
 218:         *pressed = keyData >> 8;
 219:         *doomKey = keyData & 0xFF;
 220: 
 221:         return 1;
 222:     }
 223: }
