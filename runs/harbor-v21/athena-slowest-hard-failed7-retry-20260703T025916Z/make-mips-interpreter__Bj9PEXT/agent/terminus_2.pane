1396 char* strstr(const char* haystack, const char* needle) {
1397     size_t needle_len = strlen(needle);
1398     if (needle_len == 0) {
1399         return (char*)haystack;
1400     }
1401     
1402     while (*haystack) {
1403         if (*haystack == *needle && strncmp(haystack, needle, needle_len) == 0) {
1404             return (char*)haystack;
1405         }
1406         haystack++;
1407     }
1408     return NULL;
1409 }
1410 
1411 char* strncpy(char* dest, const char* src, size_t n) {
1412     size_t i;
1413     for (i = 0; i < n && src[i] != '\0'; i++) {
1414         dest[i] = src[i];
1415     }
1416     for (; i < n; i++) {
1417         dest[i] = '\0';
1418     }
1419     return dest;
1420 }
1421 
1422 char* strcpy(char* dest, const char* src) {
1423     char* original_dest = dest;
1424     
1425     // Copy characters from src to dest until null terminator is reached
1426     while ((*dest++ = *src++) != '\0');
1427     
1428     // Return pointer to the destination string
1429     return original_dest;
1430 }
1431 
1432 char* strtok(char* str, const char* delim) {
1433     // Static variable to keep track of the next token between calls
1434     static char* next_token = NULL;
1435     
1436     // If str is NULL, use the saved pointer from the previous call
1437     char* current = (str != NULL) ? str : next_token;
1438     
1439     // Return NULL if there are no more tokens
1440     if (current == NULL || *current == '\0') {
1441         next_token = NULL;
1442         return NULL;
1443     }
1444     
1445     // Skip leading delimiters
1446     current += strspn(current, delim);
1447     
1448     // If we've reached the end of the string, return NULL
1449     if (*current == '\0') {
1450         next_token = NULL;
1451         return NULL;
1452     }
1453     
1454     // Find the end of the token
1455     char* token_end = current + strcspn(current, delim);
1456     
1457     // If we found a delimiter, replace it with a null terminator and update next_token
1458     if (*token_end != '\0') {
1459         *token_end = '\0';
1460         next_token = token_end + 1;
