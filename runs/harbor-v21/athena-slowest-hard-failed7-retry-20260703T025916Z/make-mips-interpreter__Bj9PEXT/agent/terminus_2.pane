  91 
  92 // Zone memory auto-allocation function that allocates the zone size
  93 // by trying progressively smaller zone sizes until one is found that
  94 // works.
  95 
  96 static byte *AutoAllocMemory(int *size, int default_ram, int min_ram)
  97 {
  98     byte *zonemem;
  99 
 100     // Allocate the zone memory.  This loop tries progressively smaller
 101     // zone sizes until a size is found that can be allocated.
 102     // If we used the -mb command line parameter, only the parameter
 103     // provided is accepted.
 104 
 105     zonemem = NULL;
 106 
 107     while (zonemem == NULL)
 108     {
 109         // We need a reasonable minimum amount of RAM to start.
 110 
 111         if (default_ram < min_ram)
 112         {
 113             I_Error("Unable to allocate %i MiB of RAM for zone", default_ram);
 114         }
 115 
 116         // Try to allocate the zone memory.
 117 
 118         *size = default_ram * 1024 * 1024;
 119 
 120         zonemem = malloc(*size);
 121 
