   107	
   108	// Mouse acceleration
   109	//
   110	// This emulates some of the behavior of DOS mouse drivers by increasing
   111	// the speed when the mouse is moved fast.
   112	//
   113	// The mouse input values are input directly to the game, but when
   114	// the values exceed the value of mouse_threshold, they are multiplied
   115	// by mouse_acceleration to increase the speed.
