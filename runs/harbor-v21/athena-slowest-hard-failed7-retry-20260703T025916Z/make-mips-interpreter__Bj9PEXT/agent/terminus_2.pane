  13: // BMP file header structure
  14: typedef struct {
  15:     uint16_t type;              // Magic identifier: 0x4d42
  16:     uint32_t size;              // File size in bytes
  17:     uint16_t reserved1;         // Not used
  18:     uint16_t reserved2;         // Not used
  19:     uint32_t offset;            // Offset to image data in bytes
  20:     uint32_t dib_header_size;   // DIB Header size in bytes
