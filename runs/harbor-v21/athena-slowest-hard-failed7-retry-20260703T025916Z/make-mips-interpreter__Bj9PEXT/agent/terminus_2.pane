   183	void I_InitGraphics (void)
   184	{
   185	    int i;
   186	
   187		memset(&s_Fb, 0, sizeof(struct FB_ScreenInfo));
   188		s_Fb.xres = DOOMGENERIC_RESX;
   189		s_Fb.yres = DOOMGENERIC_RESY;
   190		s_Fb.xres_virtual = s_Fb.xres;
   191		s_Fb.yres_virtual = s_Fb.yres;
   192	
   193	#ifdef CMAP256
   194	
   195		s_Fb.bits_per_pixel = 8;
   196	
   197	#else  // CMAP256
   198	
   199		s_Fb.bits_per_pixel = 32;
   200	
   201		s_Fb.blue.length = 8;
   202		s_Fb.green.length = 8;
   203		s_Fb.red.length = 8;
   204		s_Fb.transp.length = 8;
   205	
   206		s_Fb.blue.offset = 0;
   207		s_Fb.green.offset = 8;
   208		s_Fb.red.offset = 16;
   209		s_Fb.transp.offset = 24;
   210		
   211	#endif  // CMAP256
   212	
   213	    printf("I_InitGraphics: framebuffer: x_res: %d, y_res: %d, x_virtual: %d, y_virtual: %d, bpp: %d\n",
   214	            s_Fb.xres, s_Fb.yres, s_Fb.xres_virtual, s_Fb.yres_virtual, s_Fb.bits_per_pixel);
   215	
   216	    printf("I_InitGraphics: framebuffer: RGBA: %d%d%d%d, red_off: %d, green_off: %d, blue_off: %d, transp_off: %d\n",
   217	            s_Fb.red.length, s_Fb.green.length, s_Fb.blue.length, s_Fb.transp.length, s_Fb.red.offset, s_Fb.green.offset, s_Fb.blue.offset, s_Fb.transp.offset);
   218	
   219	    printf("I_InitGraphics: DOOM screen size: w x h: %d x %d\n", SCREENWIDTH, SCREENHEIGHT);
   220	
   221	
   222	    i = M_CheckParmWithArgs("-scaling", 1);
   223	    if (i > 0) {
   224	        i = atoi(myargv[i + 1]);
   225	        fb_scaling = i;
   226	        printf("I_InitGraphics: Scaling factor: %d\n", fb_scaling);
   227	    } else {
   228	        fb_scaling = s_Fb.xres / SCREENWIDTH;
   229	        if (s_Fb.yres / SCREENHEIGHT < fb_scaling)
   230	            fb_scaling = s_Fb.yres / SCREENHEIGHT;
   231	        printf("I_InitGraphics: Auto-scaling factor: %d\n", fb_scaling);
   232	    }
   233	
   234	
   235	    /* Allocate screen to draw to */
   236		I_VideoBuffer = (byte*)Z_Malloc (SCREENWIDTH * SCREENHEIGHT, PU_STATIC, NULL);  // For DOOM to draw on
   237	
   238		screenvisible = true;
   239	
   240	    extern void I_InitInput(void);
   241	    I_InitInput();
   242	}
