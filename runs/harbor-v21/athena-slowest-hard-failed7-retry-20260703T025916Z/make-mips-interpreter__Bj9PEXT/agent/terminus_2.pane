 930: void* calloc(size_t nmemb, size_t size) {
 931:     size_t total_size = nmemb * size;
 932:     
 933:     // Check for overflow
 934:     if (size != 0 && total_size / size != nmemb) {
 935:       printf("NULL\n");
 936:         return NULL;
 937:     }
 938:     
 939:     void* ptr = malloc(total_size);
 940:     if (ptr) {
 941:         // Zero out the allocated memory
 942:         memset(ptr, 0, total_size);
 943:     }
 944:     return ptr;
 945: }
