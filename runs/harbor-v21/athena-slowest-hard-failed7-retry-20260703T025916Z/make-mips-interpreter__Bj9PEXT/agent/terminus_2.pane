 335: // Helper function to create a new file node
 336: FileNode* create_node(const char* name, int type, FileNode* parent) {
 337:     FileNode* node = (FileNode*)malloc(sizeof(FileNode));
 338:     strncpy(node->name, name, MAX_PATH_LENGTH);
 339:     node->name[MAX_PATH_LENGTH - 1] = '\0';
 340:     node->type = type;
 341:     node->created = node->modified = node->accessed = time(NULL);
 342:     node->parent = parent;
 343:     
 344:     if (type == FILE_TYPE_REGULAR) {
 345:         // Initialize as an empty file
 346:         node->data = NULL;
 347:         node->size = 0;
 348:         node->capacity = 0;
 349:         node->entries = NULL;
 350:         node->num_entries = 0;
 351:         node->max_entries = 0;
 352:     } else {
 353:         // Initialize as an empty directory
 354:         node->data = NULL;
 355:         node->size = 0;
 356:         node->capacity = 0;
 357:         node->entries = (DirEntry*)malloc(10 * sizeof(DirEntry));
 358:         node->num_entries = 0;
 359:         node->max_entries = 10;
 360:     }
 361:     
 362:     return node;
 363: }
