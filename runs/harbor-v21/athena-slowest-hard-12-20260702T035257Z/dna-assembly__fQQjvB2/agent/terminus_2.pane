[?2004l[?2004h>     print "flag: output[$idx..",$a-1,"] = flag[$off..",$b-1,"], matched $b-",$off,"=",$b-$off," of flag len ",length($s{flag}),"\n";
[?2004l[?2004h>     print "  flag excluded left: flag[0..$off-1]=",substr($s{flag},0,$off),"\n" if $off>0;
[?2004l[?2004h>     print "  flag excluded right: flag[$b..]=",substr($s{flag},$b),"\n" if $b<length($s{flag});
[?2004l[?2004h>     last;
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Find longest exact match of snap in output, allowing offset
[?2004l[?2004h> for my $off (0..length($s{snap})-20){
[?2004l[?2004h>   my $sub=substr($s{snap},$off,20);
[?2004l[?2004h>   my $idx=index($s{output},$sub);
[?2004l[?2004h>   if($idx>=0){
[?2004l[?2004h>     my $a=$idx; my $b=$off;
