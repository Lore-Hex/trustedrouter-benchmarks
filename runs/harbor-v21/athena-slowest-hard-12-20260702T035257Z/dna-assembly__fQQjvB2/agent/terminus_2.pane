[?2004hroot@ea9aae5dd25d:/app# cat > design_primers.pl <<'PERL'
[?2004l[?2004h> use strict;
[?2004l[?2004h> use warnings;
[?2004l[?2004h> 
[?2004l[?2004h> # Parse sequences
[?2004l[?2004h> my %s; my $n;
[?2004l[?2004h> open my $F, '<', 'sequences.fasta' or die $!;
[?2004l[?2004h> while (<$F>) { chomp; if (/^>(\S+)/) { $n = $1 } else { $s{$n} .= uc($_) } }
[?2004l[?2004h> close $F;
[?2004l[?2004h> 
[?2004l[?2004h> sub rev_comp {
[?2004l[?2004h>   my $seq = shift;
[?2004l[?2004h>   my $comp = reverse($seq);
[?2004l[?2004h>   $comp =~ tr/ACGT/TGCA/;
[?2004l[?2004h>   return $comp;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> sub oligotm {
[?2004l[?2004h>   my $seq = shift;
[?2004l[?2004h>   my $result = `oligotm -tp 1 -sc 1 -mv 50 -dv 2 -n 0.8 -d 500 $seq`;
[?2004l[?2004h>   chomp $result;
[?2004l[?2004h>   return $result + 0;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Primer constant: 5' spacer (T) + BsaI recognition (GGTCTC) + 1nt spacer (A)
[?2004l[?2004h> my $const = "TGGTCTCA";
[?2004l[?2004h> 
[?2004l[?2004h> # Fragment definitions:
[?2004l[?2004h> # fwd_oh = left overhang (NOT from this template, added as non-annealing tail)
[?2004l[?2004h> # rev_oh = right overhang on top strand (FROM this template, part of annealing)
[?2004l[?2004h> # fwd_start = template start position for forward primer annealing
[?2004l[?2004h> # rev_end = template end position for reverse primer annealing (last base of fragment in output)
[?2004l[?2004h> my @frags = (
[?2004l[?2004h>   # input: circular, linearized as input[687..end]+input[0..209]
[?2004l[?2004h>   { name => 'input', seq => $s{input}, fwd_oh => 'GGGT', rev_oh => 'ACAT',
[?2004l[?2004h>     fwd_start => 687, rev_end => 209 },
[?2004l[?2004h>   # egfp: egfp[0..713] (excludes TAA stop)
[?2004l[?2004h>   { name => 'egfp', seq => $s{egfp}, fwd_oh => 'ACAT', rev_oh => 'CAAA',
[?2004l[?2004h>     fwd_start => 0, rev_end => 713 },
[?2004l[?2004h>   # flag: flag[3..86] (excludes ATG start and TAA stop)
[?2004l[?2004h>   { name => 'flag', seq => $s{flag}, fwd_oh => 'CAAA', rev_oh => 'TTCA',
[?2004l[?2004h>     fwd_start => 3, rev_end => 86 },
[?2004l[?2004h>   # snap: snap[3..545] (excludes ATG start; TAA at 546-548 overlaps input[687-689])
[?2004l[?2004h>   { name => 'snap', seq => $s{snap}, fwd_oh => 'TTCA', rev_oh => 'GGGT',
[?2004l[?2004h>     fwd_start => 3, rev_end => 545 },
[?2004l[?2004h> );
[?2004l[?2004h> 
[?2004l[?2004h> my @primers;
[?2004l[?2004h> 
[?2004l[?2004h> for my $fr (@frags) {
[?2004l[?2004h>   my $name = $fr->{name};
[?2004l[?2004h>   my $seq = $fr->{seq};
[?2004l[?2004h>   my $fwd_oh = $fr->{fwd_oh};
[?2004l[?2004h>   my $rev_oh = $fr->{rev_oh};
[?2004l[?2004h>   my $rev_oh_rc = rev_comp($rev_oh);
[?2004l[?2004h>   my $fwd_start = $fr->{fwd_start};
[?2004l[?2004h>   my $rev_end = $fr->{rev_end};
[?2004l[?2004h> 
[?2004l[?2004h>   # Forward primer candidates: annealing = template[fwd_start..fwd_start+N-1]
[?2004l[?2004h>   my @fwd_cand;
[?2004l[?2004h>   for my $N (15..45) {
[?2004l[?2004h>     my $anneal = substr($seq, $fwd_start, $N);
[?2004l[?2004h>     my $tm = oligotm($anneal);
[?2004l[?2004h>     if ($tm >= 58 && $tm <= 72) {
[?2004l[?2004h>       push @fwd_cand, { N => $N, anneal => $anneal, tm => $tm };
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   # Reverse primer candidates: annealing = rev_comp(template[rev_end-L+1..rev_end])
[?2004l[?2004h>   # First 4 nt of annealing = rev_oh_rc (part of template, included in Tm)
[?2004l[?2004h>   my @rev_cand;
[?2004l[?2004h>   for my $L (15..45) {
[?2004l[?2004h>     my $template_region = substr($seq, $rev_end - $L + 1, $L);
[?2004l[?2004h>     my $anneal = rev_comp($template_region);
[?2004l[?2004h>     my $tm = oligotm($anneal);
[?2004l[?2004h>     if ($tm >= 58 && $tm <= 72) {
[?2004l[?2004h>       push @rev_cand, { L => $L, anneal => $anneal, tm => $tm };
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   printf "%s: %d fwd candidates, %d rev candidates\n", $name, scalar(@fwd_cand), scalar(@rev_cand);
[?2004l[?2004h> 
[?2004l[?2004h>   # Find best pair: minimize Tm difference, then closeness to 65\302\260C
[?2004l[?2004h>   my $best;
[?2004l[?2004h>   for my $f (@fwd_cand) {
[?2004l[?2004h>     for my $r (@rev_cand) {
[?2004l[?2004h>       my $dtm = abs($f->{tm} - $r->{tm});
[?2004l[?2004h>       next if $dtm > 5;
[?2004l[?2004h>       my $score = $dtm * 100 + abs($f->{tm} - 65) + abs($r->{tm} - 65);
[?2004l[?2004h>       if (!defined $best || $score < $best->{score}) {
[?2004l[?2004h>         $best = { score => $score, f => $f, r => $r };
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   die "No valid primer pair for $name\n" unless $best;
[?2004l[?2004h> 
[?2004l[?2004h>   my $f = $best->{f};
[?2004l[?2004h>   my $r = $best->{r};
[?2004l[?2004h> 
[?2004l[?2004h>   # Forward primer: [const][fwd_oh][annealing] (overhang is non-annealing)
[?2004l[?2004h>   my $fwd_primer = $const . $fwd_oh . $f->{anneal};
[?2004l[?2004h> 
[?2004l[?2004h>   # Reverse primer: [const][annealing] (first 4 nt of annealing = overhang_rc, which IS annealing)
[?2004l[?2004h>   my $rev_primer = $const . $r->{anneal};
[?2004l[?2004h> 
[?2004l[?2004h>   # Verify reverse overhang
[?2004l[?2004h>   my $rev_oh_check = substr($r->{anneal}, 0, 4);
[?2004l[?2004h>   die "Reverse overhang mismatch for $name: expected $rev_oh_rc, got $rev_oh_check\n"
[?2004l[?2004h>     if $rev_oh_check ne $rev_oh_rc;
[?2004l[?2004h> 
[?2004l[?2004h>   # Check for internal BsaI sites
[?2004l[?2004h>   my $fwd_ggtctc = () = ($fwd_primer =~ /GGTCTC/g);
[?2004l[?2004h>   my $fwd_gagacc = () = ($fwd_primer =~ /GAGACC/g);
[?2004l[?2004h>   my $rev_ggtctc = () = ($rev_primer =~ /GGTCTC/g);
[?2004l[?2004h>   my $rev_gagacc = () = ($rev_primer =~ /GAGACC/g);
[?2004l[?2004h>   if ($fwd_ggtctc != 1) { warn "WARNING: ${name}_fwd has $fwd_ggtctc GGTCTC sites\n" }
[?2004l[?2004h>   if ($fwd_gagacc > 0)  { warn "WARNING: ${name}_fwd has $fwd_gagacc GAGACC sites\n" }
[?2004l[?2004h>   if ($rev_ggtctc != 1) { warn "WARNING: ${name}_rev has $rev_ggtctc GGTCTC sites\n" }
[?2004l[?2004h>   if ($rev_gagacc > 0)  { warn "WARNING: ${name}_rev has $rev_gagacc GAGACC sites\n" }
[?2004l[?2004h> 
[?2004l[?2004h>   push @primers, { name => $name, dir => 'fwd', seq => $fwd_primer, tm => $f->{tm},
[?2004l[?2004h>     anneal => $f->{anneal}, anneal_len => $f->{N} };
[?2004l[?2004h>   push @primers, { name => $name, dir => 'rev', seq => $rev_primer, tm => $r->{tm},
[?2004l[?2004h>     anneal => $r->{anneal}, anneal_len => $r->{L} };
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Write primers.fasta (no blank lines)
[?2004l[?2004h> open my $out, '>', 'primers.fasta' or die $!;
[?2004l[?2004h> for my $p (@primers) {
[?2004l[?2004h>   print $out ">$p->{name}_$p->{dir}\n";
[?2004l[?2004h>   print $out "$p->{seq}\n";
[?2004l[?2004h> }
[?2004l[?2004h> close $out;
[?2004l[?2004h> 
[?2004l[?2004h> # Print summary
[?2004l[?2004h> print "\n=== Primer Summary ===\n";
[?2004l[?2004h> for my $p (@primers) {
[?2004l[?2004h>   printf "%s_%s: len=%d anneal_len=%d tm=%.2f\n", $p->{name}, $p->{dir}, length($p->{seq}), $p->{anneal_len}, $p->{tm};
[?2004l[?2004h>   printf "  full:    %s\n", $p->{seq};
[?2004l[?2004h>   printf "  anneal:  %s\n", $p->{anneal};
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Print Tm pair check
[?2004l[?2004h> print "\n=== Tm Pair Check ===\n";
[?2004l[?2004h> for (my $i = 0; $i < scalar(@primers); $i += 2) {
[?2004l[?2004h>   my $f = $primers[$i];
[?2004l[?2004h>   my $r = $primers[$i+1];
[?2004l[?2004h>   printf "%s: fwd_tm=%.2f rev_tm=%.2f diff=%.2f %s\n",
[?2004l[?2004h>     $f->{name}, $f->{tm}, $r->{tm}, abs($f->{tm}-$r->{tm}),
[?2004l[?2004h>     abs($f->{tm}-$r->{tm}) <= 5 ? "OK" : "FAIL";
[?2004l[?2004h> }
[?2004l[?2004h> PERL
