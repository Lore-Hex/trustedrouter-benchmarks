[?2004l[?2004h>     if ($a eq $b) { print "DUPLICATE: $a\n" }
[?2004l[?2004h>     if ($a eq rev_comp($b)) { print "COMPLEMENTARY PAIR: $a / $b\n" }
[?2004l[?2004h>   }
[?2004l[?2004h> }
