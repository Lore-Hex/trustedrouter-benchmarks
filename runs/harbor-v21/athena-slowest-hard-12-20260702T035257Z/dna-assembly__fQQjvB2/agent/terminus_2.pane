[?2004l[?2004h>     print "snap: output[$idx..",$a-1,"] = snap[$off..",$b-1,"], matched $b-",$off,"=",$b-$off," of snap len ",length($s{snap}),"\n";
[?2004l[?2004h>     print "  snap excluded left: snap[0..$off-1]=",substr($s{snap},0,$off),"\n" if $off>0;
[?2004l[?2004h>     print "  snap excluded right: snap[$b..]=",substr($s{snap},$b),"\n" if $b<length($s{snap});
[?2004l[?2004h>     last;
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Print exact junctions with coordinates
[?2004l[?2004h> print "\nJunction 1 input->egfp:\n";
