[?2004l[?2004h>   # fwd_anneal starts at fwd_start, so fragment = template[fwd_start..rev_end] with fwd_oh prepended
[?2004l[?2004h>   # But for circular input, we need to handle wraparound
[?2004l[?2004h> 
[?2004l[?2004h>   my $frag;
[?2004l[?2004h>   if ($name eq 'input') {
[?2004l[?2004h>     # Circular: input[687..end] + input[0..209]
[?2004l[?2004h>     $frag = $fwd_oh . substr($fr->{seq}, $fr->{fwd_start}) . substr($fr->{seq}, 0, $fr->{rev_end} + 1);
[?2004l[?2004h>   } else {
[?2004l[?2004h>     $frag = $fwd_oh . substr($fr->{seq}, $fr->{fwd_start}, $fr->{rev_end} - $fr->{fwd_start} + 1);
[?2004l[?2004h>   }
[?2004l[?2004h>   push @frag_seqs, $frag;
[?2004l[?2004h>   printf "%s fragment (after BsaI): len=%d\n", $name, length($frag);
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> # Assemble: the overhang at each junction is shared (appears once)
[?2004l[?2004h> # frag1: ...OH1 | frag2: OH1...OH2 | frag3: OH2...OH3 | frag4: OH3...OH4
[?2004l[?2004h> # Circular assembly: frag1 + frag2[4:] + frag3[4:] + frag4[4:]
[?2004l[?2004h> # But need to account for which fragment contributes the overhang
[?2004l[?2004h> 
[?2004l[?2004h> # Each fragment starts with its left overhang (4nt)
[?2004l[?2004h> # When ligating, the left overhang of the next fragment = right overhang of current
[?2004l[?2004h> # So we take fragment1 + fragment2[4:] + fragment3[4:] + fragment4[4:]
[?2004l[?2004h> # This forms a circle where frag4's right overhang = frag1's left overhang
[?2004l[?2004h> 
[?2004l[?2004h> my $assembled = $frag_seqs[0] . substr($frag_seqs[1], 4) . substr($frag_seqs[2], 4) . substr($frag_seqs[3], 4);
[?2004l[?2004h> # This is linear but represents the circular product starting at input[687]
[?2004l[?2004h> # To compare with output, we need to rotate
[?2004l[?2004h> 
[?2004l[?2004h> # The assembled sequence starts with GGGT + input[687..end] + input[0..209] + egfp... + snap...
[?2004l[?2004h> # = GGGT + input[687..end] + input[0..209] + ACAT + egfp + CAAA + flag + TTCA + snap
[?2004l[?2004h> # The output starts at input[0], so we need to rotate
[?2004l[?2004h> 
[?2004l[?2004h> # Find input[0..209] in assembled (after the first part)
[?2004l[?2004h> # assembled = GGGT + input[687..] + input[0..209] + rest
[?2004l[?2004h> # The output = input[0..209] + egfp[0..713] + flag[3..86] + snap[3..545] + input[687..]
[?2004l[?2004h> # So we need to rotate assembled to start at input[0]
[?2004l[?2004h> 
[?2004l[?2004h> # Remove the leading GGGT (it's the overhang from snap, which is the last fragment's right overhang)
[?2004l[?2004h> # and the assembled circle is: input[687..] + input[0..209] + ACAT + egfp + CAAA + flag + TTCA + snap + GGGT
[?2004l[?2004h> # = input[687..] + input[0..209] + egfp fragment + flag fragment + snap fragment (circular)
[?2004l[?2004h> # Linearized at input[0]: input[0..209] + egfp_frag + flag_frag + snap_frag + input[687..]
[?2004l[?2004h> 
[?2004l[?2004h> # Let's just compare with output directly
[?2004l[?2004h> # assembled = GGGT + input[687..end] + input[0..209] + (ACAT+egfp[0..713]) + (CAAA+flag[3..86]) + (TTCA+snap[3..545])
[?2004l[?2004h> # = GGGT + input[687..] + input[0..209] + output[210..1550] essentially
[?2004l[?2004h> 
[?2004l[?2004h> # Remove leading overhang GGGT
[?2004l[?2004h> my $circ = substr($assembled, 4);
[?2004l[?2004h> # circ = input[687..] + input[0..209] + rest
[?2004l[?2004h> # This is the circular product linearized at input[687]
[?2004l[?2004h> # Rotate to start at input[0]
[?2004l[?2004h> my $input_part_len = length($s{input}) - 687;  # input[687..end] length
[?2004l[?2004h> my $rotated = substr($circ, $input_part_len) . substr($circ, 0, $input_part_len);
[?2004l[?2004h> 
[?2004l[?2004h> print "Assembled length: ", length($rotated), "\n";
[?2004l[?2004h> print "Output length: ", length($s{output}), "\n";
[?2004l[?2004h> print "Match: ", ($rotated eq $s{output} ? "YES - EXACT MATCH" : "NO - MISMATCH"), "\n";
[?2004l[?2004h> 
[?2004l[?2004h> if ($rotated ne $s{output}) {
[?2004l[?2004h>   # Find first mismatch
[?2004l[?2004h>   for my $i (0..length($rotated)-1) {
[?2004l[?2004h>     if (substr($rotated,$i,1) ne substr($s{output},$i,1)) {
[?2004l[?2004h>       print "First mismatch at position $i\n";
[?2004l[?2004h>       print "  assembled: ", substr($rotated, $i-10, 30), "\n";
[?2004l[?2004h>       print "  output:    ", substr($s{output}, $i-10, 30), "\n";
[?2004l[?2004h>       last;
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> }
