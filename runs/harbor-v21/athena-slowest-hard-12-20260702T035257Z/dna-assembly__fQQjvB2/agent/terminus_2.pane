[?2004l[?2004h>   # For reverse side, the overhang comes from the template
[?2004l[?2004h>   my $fwd_oh = substr($fwd_seq, 8, 4);
[?2004l[?2004h>   my $fwd_anneal = substr($fwd_seq, 12);
[?2004l][?2004h> 
