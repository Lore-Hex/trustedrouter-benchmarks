python3 - << 'PYEOF'
# Analyze the text-mode screen by looking at character grid
# VGA text mode: 80x25 chars, each char cell is 9x16 pixels in 720x400
with open('/tmp/qemu-screen3.ppm', 'rb') as f:
    header = f.readline().strip()
    dims = f.readline().strip().strip()
    maxval = f.readline().strip()
    w, h = map(int, dims.split())
    data = f.read()

# Check if screen is mostly black (blank) or has content
pixels = []
for i in range(0, len(data), 3):
    r, g, b = data[i], data[i+1], data[i+2]
    pixels.append((r, g, b))

# Count non-black pixels
non_black = sum(1 for r, g, b in pixels if r > 30 or g > 30 or b > 30)
total = len(pixels)
print(f"Total pixels: {total}, Non-black: {non_black} ({100*non_black/total:.1f}%)")

# Sample some colors to understand what's displayed
from collections import Counter
color_counts = Counter(pixels)
print("Top 10 colors:")
for color, count in color_counts.most_common(10):
    print(f"  RGB{color}: {count} ({100*count/total:.1f}%)")

# Check first few rows for text patterns
# Look at character cells in first row (y=0..15)
for row in range(3):
    chars = []
    for col in range(80):
        # Check if this character cell has any non-black pixels
        has_content = False
        for cy in range(row*16, (row+1)*16):
            for cx in range(col*9, (col+1)*9):
                idx = cy * w + cx
                if idx < len(pixels):
                    r, g, b = pixels[idx]
                    if r > 30 or g > 30 or b > 30:
                        has_content = True
                        break
            if has_content:
                break
        chars.append('#' if has_content else ' ')
    # Print compact view
    line = ''.join(chars)
    # Find first and last non-space
    start = 0
    while start < len(line) and line[start] == ' ':
        start += 1
    end = len(line) - 1
    while end > start and line[end] == ' ':
        end -= 1
    if start <= end:
        print(f"Row {row}: cols {start}-{end}: '{line[start:end+1]}'")
    else:
        print(f"Row {row}: (empty)")

# Check more rows
for row in range(3, 25):
    chars = []
    for col in range(80):
        has_content = False
        for cy in range(row*16, (row+1)*16):
            for cx in range(col*9, (col+1)*9):
                idx = cy * w + cx
                if idx < len(pixels):
                    r, g, b = pixels[idx]
                    if r > 30 or g > 30 or b > 30:
                        has_content = True
                        break
            if has_content:
                break
        chars.append('#' if has_content else ' ')
    line = ''.join(chars)
    start = 0
    while start < len(line) and line[start] == ' ':
        start += 1
    end = len(line) - 1
    while end > start and line[end] == ' ':
        end -= 1
    if start <= end:
        print(f"Row {row}: cols {start}-{end}: '{line[start:end+1]}'")
