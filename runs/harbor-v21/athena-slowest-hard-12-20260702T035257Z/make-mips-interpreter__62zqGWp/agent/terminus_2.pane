   415	// Helper function to split a path into directory and filename
   416	void split_path(const char* path, char* dir_path, char* filename) {
   417	    const char* last_slash = strrchr(path, '/');
   418	    
   419	    if (last_slash == NULL) {
   420	        // No directory part
   421	        strcpy(dir_path, ".");
   422	        strcpy(filename, path);
   423	    } else if (last_slash == path) {
   424	        // Root directory
   425	        strcpy(dir_path, "/");
   426	        strcpy(filename, last_slash + 1);
   427	    } else {
   428	        // Extract directory path and filename
   429	        size_t dir_len = last_slash - path;
   430	        strncpy(dir_path, path, dir_len);
   431	        dir_path[dir_len] = '\0';
   432	        strcpy(filename, last_slash + 1);
   433	    }
   434	}
