   401	// Helper function to allocate a file descriptor
   402	int allocate_fd(FileNode* node, int mode) {
   403	    for (int i = 0; i < MAX_FILE_DESCRIPTORS; i++) {
   404	        if (!fd_table[i].used) {
   405	            fd_table[i].node = node;
   406	            fd_table[i].position = 0;
   407	            fd_table[i].mode = mode;
   408	            fd_table[i].used = 1;
   409	            return i;
   410	        }
   411	    }
   412	    return -EMFILE; // Too many open files
   413	}
