   253	                        
   254	                        // Add the file to the root directory
   255	                        add_to_directory(root, "doom.wad", wad_node);
   256	                        
   257	                        printf("Loaded doom.wad (%d bytes) into in-memory filesystem\n", file_size);
   258	                    } else {
   259	                        free(wad_data);
   260	                        printf("Failed to read doom.wad: read %d of %d bytes\n", bytes_read, file_size);
   261	                    }
   262	                } else {
   263	                    printf("Failed to allocate memory for doom.wad (%d bytes)\n", file_size);
   264	                }
   265	            } else {
   266	                printf("doom.wad file size invalid: %d bytes\n", file_size);
   267	            }
   268	            
   269	            // Close the real file
   270	            real_syscall6(SYS_close, real_fd, 0, 0, 0, 0, 0);
   271	        } else {
   272	            printf("Failed to open doom.wad: error %d\n", errno);
   273	        }
   274	    }
   275	}
   276	
   277	// Helper function to find a file node by path
   278	FileNode* find_node(const char* path, FileNode** parent_dir) {
   279	    if (root == NULL) {
   280	        init_filesystem();
   281	    }
   282	    
   283	    // Handle empty or root path
   284	    if (path == NULL || path[0] == '\0' || strcmp(path, "/") == 0) {
   285	        if (parent_dir) *parent_dir = NULL;
   286	        return root;
   287	    }
   288	    
   289	    // Make a copy of the path to tokenize
   290	    char path_copy[MAX_PATH_LENGTH];
   291	    strncpy(path_copy, path, MAX_PATH_LENGTH);
   292	    path_copy[MAX_PATH_LENGTH - 1] = '\0';
   293	    
   294	    // Start at root
   295	    FileNode* current = root;
   296	    FileNode* parent = NULL;
   297	    
   298	    // Handle absolute path
   299	    char* token = strtok(path_copy, "/");
   300	    if (path[0] == '/') {
   301	        // Path starts with /, so we start at the root
   302	        current = root;
   303	    }
   304	    
   305	    // Traverse the path
   306	    while (token != NULL) {
   307	        if (current->type != FILE_TYPE_DIRECTORY) {
   308	            return NULL; // Not a directory
   309	        }
   310	        
   311	        parent = current;
   312	        current = NULL;
   313	        
   314	        // Look for the token in the current directory
   315	        for (size_t i = 0; i < parent->num_entries; i++) {
   316	            if (strcmp(parent->entries[i].name, token) == 0) {
   317	                current = parent->entries[i].node;
   318	                break;
   319	            }
   320	        }
   321	        
   322	        if (current == NULL) {
   323	            // Not found
   324	            if (parent_dir) *parent_dir = parent;
   325	            return NULL;
   326	        }
   327	        
   328	        token = strtok(NULL, "/");
   329	    }
   330	    
   331	    if (parent_dir) *parent_dir = parent;
   332	    return current;
   333	}
   334	
   335	// Helper function to create a new file node
   336	FileNode* create_node(const char* name, int type, FileNode* parent) {
   337	    FileNode* node = (FileNode*)malloc(sizeof(FileNode));
   338	    strncpy(node->name, name, MAX_PATH_LENGTH);
   339	    node->name[MAX_PATH_LENGTH - 1] = '\0';
   340	    node->type = type;
   341	    node->created = node->modified = node->accessed = time(NULL);
   342	    node->parent = parent;
   343	    
   344	    if (type == FILE_TYPE_REGULAR) {
   345	        // Initialize as an empty file
   346	        node->data = NULL;
   347	        node->size = 0;
   348	        node->capacity = 0;
   349	        node->entries = NULL;
   350	        node->num_entries = 0;
   351	        node->max_entries = 0;
   352	    } else {
   353	        // Initialize as an empty directory
   354	        node->data = NULL;
   355	        node->size = 0;
   356	        node->capacity = 0;
   357	        node->entries = (DirEntry*)malloc(10 * sizeof(DirEntry));
   358	        node->num_entries = 0;
   359	        node->max_entries = 10;
   360	    }
   361	    
   362	    return node;
   363	}
   364	
   365	// Helper function to add a node to a directory
   366	int add_to_directory(FileNode* dir, const char* name, FileNode* node) {
   367	    if (dir->type != FILE_TYPE_DIRECTORY) {
   368	        return -ENOTDIR;
   369	    }
   370	    
   371	    // Check if a file with this name already exists
   372	    for (size_t i = 0; i < dir->num_entries; i++) {
   373	        if (strcmp(dir->entries[i].name, name) == 0) {
   374	            return -EEXIST;
   375	        }
   376	    }
   377	    
   378	    // Expand the directory if needed
   379	    if (dir->num_entries >= dir->max_entries) {
   380	        size_t new_max = dir->max_entries * 2;
   381	        DirEntry* new_entries = (DirEntry*)realloc(dir->entries, new_max * sizeof(DirEntry));
   382	        if (new_entries == NULL) {
   383	            return -ENOMEM;
   384	        }
   385	        dir->entries = new_entries;
   386	        dir->max_entries = new_max;
   387	    }
   388	    
   389	    // Add the new entry
   390	    strncpy(dir->entries[dir->num_entries].name, name, MAX_PATH_LENGTH);
   391	    dir->entries[dir->num_entries].name[MAX_PATH_LENGTH - 1] = '\0';
   392	    dir->entries[dir->num_entries].node = node;
   393	    dir->num_entries++;
   394	    
   395	    // Update directory modification time
   396	    dir->modified = time(NULL);
   397	    
   398	    return 0;
   399	}
   400	
   401	// Helper function to allocate a file descriptor
   402	int allocate_fd(FileNode* node, int mode) {
   403	    for (int i = 0; i < MAX_FILE_DESCRIPTORS; i++) {
   404	        if (!fd_table[i].used) {
   405	            fd_table[i].node = node;
   406	            fd_table[i].position = 0;
   407	            fd_table[i].mode = mode;
   408	            fd_table[i].used = 1;
   409	            return i;
   410	        }
   411	    }
   412	    return -EMFILE; // Too many open files
   413	}
   414	
   415	// Helper function to split a path into directory and filename
   416	void split_path(const char* path, char* dir_path, char* filename) {
   417	    const char* last_slash = strrchr(path, '/');
   418	    
   419	    if (last_slash == NULL) {
   420	        // No directory part
   421	        strcpy(dir_path, ".");
   422	        strcpy(filename, path);
   423	    } else if (last_slash == path) {
   424	        // Root directory
   425	        strcpy(dir_path, "/");
   426	        strcpy(filename, last_slash + 1);
   427	    } else {
   428	        // Extract directory path and filename
   429	        size_t dir_len = last_slash - path;
   430	        strncpy(dir_path, path, dir_len);
   431	        dir_path[dir_len] = '\0';
   432	        strcpy(filename, last_slash + 1);
   433	    }
   434	}
