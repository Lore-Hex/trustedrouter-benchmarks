    21	// Real syscall function for Linux x86_64
    22	static long real_syscall6(long syscall_num, long arg1, long arg2, long arg3,
    23	                     long arg4, long arg5, long arg6) {
    24	    long result;
    25	    
    26	    /*
    27	     * Use a simplified approach that directly specifies which
    28	     * registers to use for each argument
    29	     */
    30	    __asm__ volatile(
    31	        /* Input arguments are already in the right locations */
    32	        "syscall"
    33	        : "=a" (result)
    34	        : "a" (syscall_num),
    35	          "D" (arg1),
    36	          "S" (arg2),
    37	          "d" (arg3),
    38	          "r" (arg4)   /* r10 */,
    39	          "r" (arg5)   /* r8 */,
    40	          "r" (arg6)   /* r9 */
    41	        : "rcx", "r11", "memory"
    42	    );
    43	    
    44	    /* Check for error and set errno */
    45	    if (result < 0 && result > -4096) {
    46	        errno = -result;
    47	        return -1;
    48	    }
    49	    
    50	    return result;
    51	
    52	}
    53	
    54	
    55	#else
    56	// Real syscall function for MIPS
    57	static long real_syscall6(long syscall_num, long arg1, long arg2, long arg3,
    58	                     long arg4, long arg5, long arg6) {
    59	    long result;
    60	    
    61	    /*
    62	     * Hacky MIPS syscall approach:
    63	     * - Syscall number goes in $v0 (register 2)
    64	     * - First four arguments go in $a0-$a3 (registers 4-7)
    65	     * - Additional arguments go in $t0-$t1 (registers 8-9)
    66	     * - Result comes back in $v0 (register 2)
    67	     */
    68	    __asm__ volatile(
    69	        /* Load syscall number into $v0 */
    70	        "move $v0, %1\n\t"
    71	        
    72	        /* Load first four arguments into $a0-$a3 */
    73	        "move $a0, %2\n\t"
    74	        "move $a1, %3\n\t"
    75	        "move $a2, %4\n\t"
    76	        "move $a3, %5\n\t"
    77	        
    78	        /* Load additional arguments into $t0-$t1 */
    79	        "move $t0, %6\n\t"  /* 5th arg in $t0 */
    80	        "move $t1, %7\n\t"  /* 6th arg in $t1 */
    81	        
    82	        /* Make the syscall */
    83	        "syscall\n\t"
    84	        
    85	        /* Get the return value */
    86	        "move %0, $v0"
    87	        
    88	        /* Output parameter */
    89	        : "=r" (result)
    90	        
    91	        /* Input parameters */
    92	        : "r" (syscall_num),
    93	          "r" (arg1),
    94	          "r" (arg2),
