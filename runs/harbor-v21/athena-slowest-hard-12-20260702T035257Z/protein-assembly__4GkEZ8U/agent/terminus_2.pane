[?2004l[?2004h>         need_higher = w < 15
[?2004l[?2004h>         cstart = pos // 3
[?2004l[?2004h>         cend = (pos + 50 + 2) // 3
[?2004l[?2004h>         for cp in range(cstart, min(cend, len(fusion))):
[?2004l[?2004h>             aa = fusion[cp]
[?2004l[?2004h>             cur = dna_seq[3*cp:3*cp+3]
[?2004l[?2004h>             cur_gc = gc_count(cur)
[?2004l[?2004h>             candidates = []
[?2004l[?2004h>             for nc in ct[aa]:
