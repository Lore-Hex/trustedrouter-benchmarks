[?2004l[?2004h> def window_penalty(gc_val):
[?2004l[?2004h>     if gc_val < 15:
[?2004l[?2004h>         return (15 - gc_val) ** 2 * 100
[?2004l[?2004h>     elif gc_val > 35:
[?2004l[?2004h>         return (gc_val - 35) ** 2 * 100
[?2004l[?2004h>     else:
[?2004l[?2004h>         return (gc_val - 25) ** 2
[?2004l[?2004h> 
[?2004l[?2004h> dna = []
[?2004l[?2004h> for i, aa in enumerate(fusion):
[?2004l[?2004h>     best, best_pen = None, 99999
[?2004l[?2004h>     for codon in ct[aa]:
[?2004l[?2004h>         temp = ''.join(dna) + codon
[?2004l[?2004h>         L = len(temp)
[?2004l[?2004h>         pen = 0
[?2004l[?2004h>         for start in range(max(0, L - 50), L - 49):
[?2004l[?2004h>             if start >= 0 and start + 50 <= L:
[?2004l[?2004h>                 pen += window_penalty(gc_count(temp[start:start+50]))
[?2004l[?2004h>         if pen < best_pen:
[?2004l[?2004h>             best_pen = pen
[?2004l[?2004h>             best = codon
[?2004l[?2004h>     dna.append(best)
[?2004l[?2004h> 
[?2004l[?2004h> dna_seq = ''.join(dna)
[?2004l[?2004h> 
[?2004l[?2004h> # Iterative fix-up
[?2004l[?2004h> def find_violations(seq):
[?2004l[?2004h>     return [i for i in range(len(seq) - 49) if gc_count(seq[i:i+50]) < 15 or gc_count(seq[i:i+50]) > 35]
