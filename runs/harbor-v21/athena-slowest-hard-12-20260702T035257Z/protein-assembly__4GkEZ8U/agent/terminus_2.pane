[?2004l[?2004h>                 nc_gc = gc_count(nc)
[?2004l[?2004h>                 if need_higher and nc_gc > cur_gc:
[?2004l[?2004h>                     candidates.append(nc)
[?2004l[?2004h>                 elif not need_higher and nc_gc < cur_gc:
[?2004l[?2004h>                     candidates.append(nc)
[?2004l[?2004h>             candidates.sort(key=lambda c: gc_count(c), reverse=need_higher)
[?2004l[?2004h>             for nc in candidates:
[?2004l[?2004h>                 nd = dna_seq[:3*cp] + nc + dna_seq[3*cp+3:]
[?2004l[?2004h>                 new_vols = find_violations(nd)
[?2004l[?2004h>                 if len(new_vols) < len(vols):
[?2004l[?2004h>                     dna_seq = nd
[?2004l[?2004h>                     fixed = True
