[?2004l[?2004h>     try:
[?2004l[?2004h>         with urllib.request.urlopen(url, timeout=15) as r:
[?2004l[?2004h>             data = r.read().decode()
[?2004l[?2004h>         lines = data.strip().split('\n')
[?2004l[?2004h>         headers = [l for l in lines if l.startswith('>')]
[?2004l[?2004h>         seqs = []
[?2004l[?2004h>         cur = []
[?2004l[?2004h>         for l in lines:
[?2004l[?2004h>             if l.startswith('>'):
[?2004l[?2004h>                 if cur:
[?2004l[?2004h>                     seqs.append(''.join(cur)); cur=[]
[?2004l[?2004h>             else:
[?2004l[?2004h>                 cur.append(l.strip())
[?2004l[?2004h>         if cur: seqs.append(''.join(cur))
[?2004l[?2004h>         print(f"\n{pid}: {len(seqs)} chain(s)")
[?2004l[?2004h>         for h,s in zip(headers, seqs):
[?2004l[?2004h>             print(f"  {h[:100]}")
[?2004l[?2004h>             print(f"  seq_len={len(s)} seq_start={s[:60]}")
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"{pid}: ERROR {e}")
[?2004l[?2004h>     time.sleep(0.2)
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Try fpbase API endpoints
[?2004l[?2004h> print("\n=== FPBASE API ===")
[?2004l[?2004h> for endpoint in ["https://www.fpbase.org/api/proteins/", "https://www.fpbase.org/api/spectra/", "https://fpbase.org/api/proteins/"]:
[?2004l[?2004h>     try:
[?2004l[?2004h>         with urllib.request.urlopen(endpoint, timeout=15) as r:
