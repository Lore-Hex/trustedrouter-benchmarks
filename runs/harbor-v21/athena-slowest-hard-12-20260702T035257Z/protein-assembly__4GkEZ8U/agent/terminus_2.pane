[?2004l[?2004h>         print(f"{endpoint}: {len(data)} bytes, start={data[:200]}")
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"{endpoint}: ERROR {e}")
[?2004l[?2004h> 
[?2004l[?2004h> # 3. PubChem for SMILES molecule
