[?2004l[?2004h> import cv2, numpy as np
[?2004l[?2004h> cap=cv2.VideoCapture('/app/example_video.mp4')
[?2004l[?2004h> frames=[]
[?2004l[?2004h> while True:
[?2004l[?2004h>     ret, frame=cap.read()
[?2004l[?2004h>     if not ret: break
[?2004l[?2004h>     frames.append(frame)
[?2004l[?2004h> cap.release()
[?2004l[?2004h> print('total', len(frames))
[?2004l[?2004h> bg=frames[0]
[?2004l[?2004h> bg_gray=cv2.cvtColor(bg, cv2.COLOR_BGR2GRAY).astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> # Try different thresholds and look at the central track region
[?2004l[?2004h> for thresh in [30, 40, 50, 60]:
[?2004l[?2004h>     print(f'\n=== threshold {thresh} ===')
[?2004l[?2004h>     for i in range(0, len(frames), 5):
[?2004l[?2004h>         gray=cv2.cvtColor(frames[i], cv2.COLOR_BGR2GRAY).astype(np.float32)
[?2004l[?2004h>         diff=np.abs(gray-bg_gray)
[?2004l[?2004h>         mask=(diff>thresh).astype(np.uint8)*255
[?2004l[?2004h>         # focus on lower half of frame (ground/track area)
[?2004l[?2004h>         mask[:200,:]=0  # remove top sky area noise
[?2004l[?2004h>         mask=cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3,3),np.uint8))
[?2004l[?2004h>         mask=cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((7,7),np.uint8))
[?2004l[?2004h>         contours,_=cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
[?2004l[?2004h>         if not contours:
[?2004l[?2004h>             print(f'{i:3d} no contours')
[?2004l[?2004h>             continue
[?2004l[?2004h>         c=max(contours, key=cv2.contourArea)
[?2004l[?2004h>         area=cv2.contourArea(c)
[?2004l[?2004h>         x,y,w,h=cv2.boundingRect(c)
[?2004l[?2004h>         print(f'{i:3d} area={area:7.0f} x={x:4d} y={y:4d} w={w:4d} h={h:4d} bot={y+h:4d} cx={x+w//2:4d}')
[?2004l[?2004h> 
[?2004l[?2004h> # Also look at the first frame to find hurdle position
[?2004l[?2004h> print('\n=== First frame analysis ===')
[?2004l[?2004h> gray0=cv2.cvtColor(bg, cv2.COLOR_BGR2GRAY)
[?2004l[?2004h> # Look for vertical edges that could be hurdle
[?2004l[?2004h> edges=cv2.Canny(gray0, 50, 150)
[?2004l[?2004h> # Sum edges column-wise to find vertical structures
[?2004l[?2004h> col_sums=edges.sum(axis=0).astype(float)
[?2004l[?2004h> # Print top columns with edge content
[?2004l[?2004h> top_cols=np.argsort(col_sums)[-20:]
[?2004l[?2004h> print('Top edge columns:', sorted(top_cols.tolist()))
[?2004l[?2004h> print('Edge values:', [int(col_sums[c]) for c in sorted(top_cols)])
[?2004l[?2004h> # Look at row profile
[?2004l[?2004h> row_sums=edges.sum(axis=1).astype(float)
[?2004l[?2004h> top_rows=np.argsort(row_sums)[-20:]
[?2004l[?2004h> print('Top edge rows:', sorted(top_rows.tolist()))
[?2004l[?2004h> print('Edge values:', [int(row_sums[r]) for r in sorted(top_rows)])
[?2004l[?2004h> PY
