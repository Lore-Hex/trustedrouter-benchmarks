[?2004hroot@1984d6ce7966:/app# python3 - <<'PY'
[?2004l[?2004h> import cv2, numpy as np
[?2004l[?2004h> cap=cv2.VideoCapture('/app/example_video.mp4')
[?2004l[?2004h> frames=[]
[?2004l[?2004h> while True:
[?2004l[?2004h>     ret, frame=cap.read()
[?2004l[?2004h>     if not ret: break
[?2004l[?2004h>     frames.append(frame)
[?2004l[?2004h> cap.release()
[?2004l[?2004h> bg_gray=cv2.cvtColor(frames[0], cv2.COLOR_BGR2GRAY).astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h> print('total', len(frames))
[?2004l[?2004h> print()
[?2004l[?2004h> print('frame  feet20  feet25  feet30  bot25  cx25  ground_contact  upper_contact  total_motion')
[?2004l[?2004h> for i in range(40, 80):
[?2004l[?2004h>     gray=cv2.cvtColor(frames[i], cv2.COLOR_BGR2GRAY).astype(np.float32)
[?2004l[?2004h>     diff=np.abs(gray-bg_gray)
[?2004l[?2004h>     
[?2004l[?2004h>     # Track feet position with different thresholds
[?2004l[?2004h>     feet_positions = []
[?2004l[?2004h>     for thresh in [20, 25, 30]:
[?2004l[?2004h>         mask = (diff>thresh).astype(np.uint8)
[?2004l[?2004h>         mask[:200,:] = 0  # focus on track region
[?2004l[?2004h>         # Clean up
[?2004l[?2004h>         mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3,3),np.uint8))
[?2004l[?2004h>         ys, xs = np.where(mask>0)
[?2004l[?2004h>         if len(ys) > 50:
[?2004l[?2004h>             # Use 95th percentile of y to be robust against noise
[?2004l[?2004h>             feet_y = int(np.percentile(ys, 95))
[?2004l[?2004h>         else:
[?2004l[?2004h>             feet_y = -1
[?2004l[?2004h>         feet_positions.append(feet_y)
[?2004l[?2004h>     
[?2004l[?2004h>     # Use threshold 25 for contour analysis
[?2004l[?2004h>     mask25 = (diff>25).astype(np.uint8)*255
[?2004l[?2004h>     mask25[:200,:] = 0
[?2004l[?2004h>     mask25 = cv2.morphologyEx(mask25, cv2.MORPH_OPEN, np.ones((3,3),np.uint8))
[?2004l[?2004h>     mask25 = cv2.morphologyEx(mask25, cv2.MORPH_CLOSE, np.ones((7,7),np.uint8))
[?2004l[?2004h>     contours,_ = cv2.findContours(mask25, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
[?2004l[?2004h>     valid = [c for c in contours if cv2.contourArea(c)>100]
[?2004l[?2004h>     if valid:
[?2004l[?2004h>         c = max(valid, key=cv2.contourArea)
[?2004l[?2004h>         x,y,w,h = cv2.boundingRect(c)
[?2004l[?2004h>         bot25 = y+h
[?2004l[?2004h>         cx25 = x+w//2
[?2004l[?2004h>     else:
[?2004l[?2004h>         bot25 = -1
[?2004l[?2004h>         cx25 = -1
[?2004l[?2004h>     
[?2004l[?2004h>     # Ground contact: motion pixels in y=340-380 (ground level)
[?2004l[?2004h>     ground_mask = (diff>25).astype(np.uint8)
[?2004l[?2004h>     ground_mask[:340,:] = 0
[?2004l[?2004h>     ground_mask[380:,:] = 0
[?2004l[?2004h>     ground_contact = int(ground_mask.sum())
[?2004l[?2004h>     
[?2004l[?2004h>     # Upper contact: motion pixels in y=200-280 (elevated)
[?2004l[?2004h>     upper_mask = (diff>25).astype(np.uint8)
[?2004l[?2004h>     upper_mask[:200,:] = 0
[?2004l[?2004h>     upper_mask[280:,:] = 0
[?2004l[?2004h>     upper_contact = int(upper_mask.sum())
[?2004l[?2004h>     
[?2004l[?2004h>     # Total motion in track region
[?2004l[?2004h>     total_mask = (diff>25).astype(np.uint8)
[?2004l[?2004h>     total_mask[:200,:] = 0
[?2004l[?2004h>     total_motion = int(total_mask.sum())
[?2004l[?2004h>     
[?2004l[?2004h>     print(f'{i:3d}   {feet_positions[0]:5d}  {feet_positions[1]:5d}  {feet_positions[2]:5d}  {bot25:5d}  {cx25:5d}  {ground_contact:8d}  {upper_contact:8d}  {ttotal_motion:8d}')
