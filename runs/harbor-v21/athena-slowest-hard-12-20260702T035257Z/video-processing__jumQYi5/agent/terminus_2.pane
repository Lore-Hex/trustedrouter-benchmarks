[?2004l[?2004hroot@1984d6ce7966:/app# cat > /app/jump_analyzer.py <<'PY'
[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> import sys
[?2004l[?2004h> import cv2
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def analyze_video(video_path):
[?2004l[?2004h>     cap = cv2.VideoCapture(video_path)
[?2004l[?2004h>     if not cap.isOpened():
[?2004l[?2004h>         return 0, 0
[?2004l[?2004h> 
[?2004l[?2004h>     frames = []
[?2004l[?2004h>     while True:
[?2004l[?2004h>         ret, frame = cap.read()
[?2004l[?2004h>         if not ret:
[?2004l[?2004h>             break
[?2004l[?2004h>         frames.append(frame)
[?2004l[?2004h>     cap.release()
[?2004l[?2004h> 
[?2004l[?2004h>     if len(frames) < 2:
[?2004l[?2004h>         return 0, 0
[?2004l[?2004h> 
[?2004l[?2004h>     # First frame is background (no runner on track)
[?2004l[?2004h>     bg_blur = cv2.GaussianBlur(frames[0], (5, 5), 0)
[?2004l[?2004h>     bg_gray = cv2.cvtColor(bg_blur, cv2.COLOR_BGR2GRAY).astype(np.float32)
[?2004l[?2004h> 
[?2004l[?2004h>     feet_positions = []
[?2004l[?2004h> 
[?2004l[?2004h>     for frame in frames:
[?2004l[?2004h>         fblur = cv2.GaussianBlur(frame, (5, 5), 0)
[?2004l[?2004h>         gray = cv2.cvtColor(fblur, cv2.COLOR_BGR2GRAY).astype(np.float32)
[?2004l[?2004h>         diff = np.abs(gray - bg_gray)
[?2004l[?2004h> 
[?2004l[?2004h>         # Background subtraction mask
[?2004l[?2004h>         mask = (diff > 30).astype(np.uint8) * 255
[?2004l[?2004h> 
[?2004l[?2004h>         # Focus on track region (below y=190)
[?2004l[?2004h>         mask[:190, :] = 0
[?2004l[?2004h> 
[?2004l[?2004h>         # Morphological cleanup
[?2004l[?2004h>         mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((5, 5), np.uint8))
[?2004l[?2004h>         mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((15, 15), np.uint8))
[?2004l[?2004h> 
[?2004l[?2004h>         # Find contours
[?2004l[?2004h>         contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
[?2004l[?2004h>         valid = [c for c in contours if cv2.contourArea(c) > 200]
[?2004l[?2004h> 
[?2004l[?2004h>         if valid:
[?2004l[?2004h>             all_pts = np.vstack(valid)
[?2004l[?2004h>             x, y, w, h = cv2.boundingRect(all_pts)
[?2004l[?2004h>             feet = y + h
[?2004l[?2004h>         else:
[?2004l[?2004h>             feet = -1
[?2004l[?2004h> 
[?2004l[?2004h>         feet_positions.append(feet)
[?2004l[?2004h> 
[?2004l[?2004h>     # Smooth feet positions with a window of 3
[?2004l[?2004h>     smoothed = []
[?2004l[?2004h>     for i in range(len(feet_positions)):
[?2004l[?2004h>         window = feet_positions[max(0, i - 1):i + 2]
[?2004l[?2004h>         window = [w for w in window if w > 0]
[?2004l[?2004h>         if window:
[?2004l[?2004h>             smoothed.append(sum(window) / len(window))
[?2004l[?2004h>         else:
[?2004l[?2004h>             smoothed.append(-1.0)
[?2004l[?2004h> 
[?2004l[?2004h>     # Find valid frames (feet detected)
[?2004l[?2004h>     valid_frames = [(i, f) for i, f in enumerate(smoothed) if f > 0]
[?2004l[?2004h> 
[?2004l[?2004h>     if len(valid_frames) < 5:
[?2004l[?2004h>         return 0, 0
[?2004l[?2004h> 
[?2004l[?2004h>     # Find peak frame (minimum feet position = highest point of jump)
[?2004l[?2004h>     peak_frame, peak_feet = min(valid_frames, key=lambda x: x[1])
[?2004l[?2004h> 
[?2004l[?2004h>     # Find ground level (maximum feet position before peak)
[?2004l[?2004h>     before_peak = [(i, f) for i, f in valid_frames if i < peak_frame]
[?2004l[?2004h>     if not before_peak:
[?2004l[?2004h>         return 0, 0
[?2004l[?2004h> 
[?2004l[?2004h>     ground_level = max(f for i, f in before_peak)
[?2004l[?2004h> 
[?2004l[?2004h>     # Jump height and adaptive threshold (10% of jump height)
[?2004l[?2004h>     jump_height = ground_level - peak_feet
[?2004l[?2004h>     if jump_height < 20:
[?2004l[?2004h>         # No significant jump detected
[?2004l[?2004h>         return 0, 0
[?2004l[?2004h> 
[?2004l[?2004h>     threshold = ground_level - jump_height * 0.1
[?2004l[?2004h> 
[?2004l[?2004h>     # Takeoff: look backwards from peak for last frame at ground level
[?2004l[?2004h>     takeoff = None
[?2004l[?2004h>     for i in range(peak_frame - 1, -1, -1):
[?2004l[?2004h>         if smoothed[i] > 0 and smoothed[i] >= threshold:
[?2004l[?2004h>             takeoff = i + 1  # First frame after ground contact
[?2004l[?2004h>             break
[?2004l[?2004h> 
[?2004l[?2004h>     if takeoff is None:
[?2004l[?2004h>         takeoff = max(0, peak_frame - 10)
[?2004l[?2004h> 
[?2004l[?2004h>     # Landing: look forwards from peak for first frame back at ground level
[?2004l[?2004h>     landing = None
[?2004l[?2004h>     for i in range(peak_frame + 1, len(smoothed)):
[?2004l[?2004h>         if smoothed[i] > 0 and smoothed[i] >= threshold:
[?2004l[?2004h>             landing = i
[?2004l[?2004h>             break
[?2004l[?2004h> 
[?2004l[?2004h>     if landing is None:
[?2004l[?2004h>         landing = min(len(frames) - 1, peak_frame + 10)
[?2004l[?2004h> 
[?2004l[?2004h>     return int(takeoff), int(landing)
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def write_toml(takeoff, landing, output_path='/app/output.toml'):
[?2004l[?2004h>     with open(output_path, 'w') as f:
[?2004l[?2004h>         f.write(f'jump_takeoff_frame_number = {takeoff}\n')
[?2004l[?2004h>         f.write(f'jump_land_frame_number = {landing}\n')
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     if len(sys.argv) < 2:
[?2004l[?2004h>         print("Usage: python3 jump_analyzer.py <video.mp4>")
[?2004l[?2004h>         sys.exit(1)
[?2004l[?2004h> 
[?2004l[?2004h>     video_path = sys.argv[1]
[?2004l[?2004h>     takeoff, landing = analyze_video(video_path)
[?2004l[?2004h>     write_toml(takeoff, landing)
[?2004l[?2004h>     print(f'jump_takeoff_frame_number = {takeoff}')
[?2004l[?2004h>     print(f'jump_land_frame_number = {landing}')
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == '__main__':
[?2004l[?2004h>     main()
[?2004l[?2004h> PY
