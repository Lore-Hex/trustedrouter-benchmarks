[?2004l[?2004h>         checks.append(r'(?!.{' + str(idx(4, ef - 1)) + r'}p)')
[?2004l[?2004h>     if ef < 7:
[?2004l[?2004h>         checks.append(r'(?!.{' + str(idx(4, ef + 1)) + r'}p)')
[?2004l[?2004h>     pattern = r'(?m)^CAND:' + ''.join(checks) + r'(.{71}) b (K[01]Q[01]k[01]q[01]) ' + ep + r' 0 0$'
[?2004l[?2004h>     repl = r'CAND:\\1 b \\2 - 0 0'
[?2004l[?2004h>     add(pattern, repl)
[?2004l[?2004h> 
[?2004l[?2004h> '''
[?2004l[?2004h> 
