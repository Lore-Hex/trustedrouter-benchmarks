[?2004l[?2004h> import json, re, chess
[?2004l[?2004h> 
[?2004l[?2004h> def all_legal_next_positions(fen):
[?2004l[?2004h>     for pattern, repl in json.load(open("/app/re.json")):
[?2004l[?2004h>         fen = re.sub(pattern, repl, fen)
[?2004l[?2004h>     return fen.split("\n")
[?2004l[?2004h> 
[?2004l[?2004h> def run_solution(fen):
[?2004l[?2004h>     return [" ".join(x.split(" ")[:-2]) for x in all_legal_next_positions(fen)]
[?2004l[?2004h> 
[?2004l[?2004h> tests = [
[?2004l[?2004h>     "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
[?2004l[?2004h>     "rnbqkbnr/ppp1pppp/8/3p4/4P3/8/PPPP1PPP/RNBQKBNR w KQkq d6 0 2",
[?2004l[?2004h>     "r3k2r/pppppppp/8/8/8/8/PPPPPPPP/R3K2R w KQkq - 0 1",
[?2004l[?2004h>     "r3k2r/pppppppp/8/8/8/8/PPPPPPPP/R3K2R w Kkq - 0 1",
[?2004l[?2004h>     "rnbqkbnr/pp1ppppp/8/2p5/4P3/8/PPPP1PPP/RNBQKBNR w KQkq c6 0 2",
[?2004l[?2004h>     "8/PPPPPPPP/8/8/8/8/8/4K2k w - - 0 1",
[?2004l[?2004h>     "rnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR w KQkq e3 0 1",
[?2004l[?2004h>     "4k3/8/8/8/8/8/8/4K2R w K - 0 1",
[?2004l[?2004h>     "4k3/8/8/8/8/8/8/R3K3 w Q - 0 1",
[?2004l[?2004h>     "r3k2r/8/8/8/8/8/8/4K3 w kq - 0 1",
[?2004l[?2004h>     "8/8/8/8/8/8/6k1/4K2R w K - 0 1",
[?2004l[?2004h>     "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1",
[?2004l[?2004h>     "rnbqkbnr/pppp1ppp/8/4p3/4P3/8/PPPP1PPP/RNBQKBNR w KQkq e6 0 2",
[?2004l[?2004h>     "1n1Qkb1r/ppp1pppp/8/8/8/8/PPPPPPPP/4K2R w K - 0 1",
[?2004l[?2004h>     "r1bqkbnr/pppp1ppp/2n5/1B2p3/4P3/5N2/PPPP1PPP/RNBQK2R w KQkq - 4 4",
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> all_ok = True
[?2004l[?2004h> for fen in tests:
[?2004l[?2004h>     our = set(run_solution(fen))
[?2004l[?2004h>     board = chess.Board(fen)
[?2004l[?2004h>     ref = set()
[?2004l[?2004h>     for move in board.legal_moves:
[?2004l[?2004h>         if move.promotion and move.promotion != chess.QUEEN:
[?2004l[?2004h>             continue
[?2004l[?2004h>         bc = board.copy()
[?2004l[?2004h>         bc.push(move)
[?2004l[?2004h>         ref.add(" ".join(bc.fen().split(" ")[:-2]))
[?2004l[?2004h>     ok = our == ref
[?2004l[?2004h>     print(f"{'OK' if ok else 'FAIL'} {fen} our={len(our)} ref={len(ref)}")
[?2004l[?2004h>     if not ok:
[?2004l[?2004h>         all_ok = False
[?2004l[?2004h>         print("  missing:", ref - our)
[?2004l[?2004h>         print("  extra:", our - ref)
