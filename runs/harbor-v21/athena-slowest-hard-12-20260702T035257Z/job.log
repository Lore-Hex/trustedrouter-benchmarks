Sending keys: ['python3 - <<\'PY\'\nimport urllib.request, urllib.parse, json, time\n\n# 1. Fetch PDB FASTA for all IDs\nids = open(\'/app/pdb_ids.txt\').read().split()\nprint("=== PDB FASTA FETCH ===")\nfor pid in ids:\n    url = f"https://www.rcsb.org/fasta/entry/{pid}/display"\n    try:\n        with urllib.request.urlopen(url, timeout=15) as r:\n            data = r.read().decode()\n        lines = data.strip().split(\'\\n\')\n        headers = [l for l in lines if l.startswith(\'>\')]\n        seqs = []\n        cur = []\n        for l in lines:\n            if l.startswith(\'>\'):\n                if cur:\n                    seqs.append(\'\'.join(cur)); cur=[]\n            else:\n                cur.append(l.strip())\n        if cur: seqs.append(\'\'.join(cur))\n        print(f"\\n{pid}: {len(seqs)} chain(s)")\n        for h,s in zip(headers, seqs):\n            print(f"  {h[:100]}")\n            print(f"  seq_len={len(s)} seq_start={s[:60]}")\n    except Exception as e:\n        print(f"{pid}: ERROR {e}")\n    time.sleep(0.2)\n\n# 2. Try fpbase API endpoints\nprint("\\n=== FPBASE API ===")\nfor endpoint in ["https://www.fpbase.org/api/proteins/", "https://www.fpbase.org/api/spectra/", "https://fpbase.org/api/proteins/"]:\n    try:\n        with urllib.request.urlopen(endpoint, timeout=15) as r:\n            data = r.read().decode()\n        print(f"{endpoint}: {len(data)} bytes, start={data[:200]}")\n    except Exception as e:\n        print(f"{endpoint}: ERROR {e}")\n\n# 3. PubChem for SMILES molecule\nprint("\\n=== PUBCHEM ===")\nsmiles = "Nc3nc(OCc1ccccc1)c2nc[nH]c2n3"\nencoded = urllib.parse.quote(smiles)\nurl = f"https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/smiles/{encoded}/property/Title,IUPACName,CanonicalSMILES/JSON"\ntry:\n    with urllib.request.urlopen(url, timeout=15) as r:\n        data = json.loads(r.read())\n    print(json.dumps(data, indent=2)[:500])\nexcept Exception as e:\n    print(f"PubChem: ERROR {e}")\n\n# 4. Search RCSB by SMILES\nprint("\\n=== RCSB LIGAND SEARCH ===")\nquery = {\n    "query": {\n        "type": "terminal",\n        "service": "chemical",\n        "parameters": {\n            "value": smiles,\n            "type": "exact"\n        }\n    },\n    "return_type": "entry",\n    "request_options": {"return_all_hits": True}\n}\ntry:\n    req = urllib.request.Request("https://search.rcsb.org/rcsbsearch/v2/query",\n                                 data=json.dumps(query).encode(),\n                                 headers={"Content-Type":"application/json"})\n    with urllib.request.urlopen(req, timeout=15) as r:\n        data = json.loads(r.read())\n    print(json.dumps(data, indent=2)[:1000])\nexcept Exception as e:\n    print(f"RCSB search: ERROR {e}")\n\nPY\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
