Sending keys: ['python3 - <<\'PY\'\nimport urllib.request, urllib.parse, json, csv, io, time\n\nheaders = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"}\n\ndef fetch(url, data=None, timeout=30, content_type=None):\n    h = dict(headers)\n    if content_type:\n        h["Content-Type"] = content_type\n    req = urllib.request.Request(url, data=data, headers=h)\n    with urllib.request.urlopen(req, timeout=timeout) as r:\n        return r.read().decode()\n\n# 1. Download full fpbase proteins CSV\nprint("=== DOWNLOADING FPBASE PROTEINS CSV ===")\ntry:\n    data = fetch("https://www.fpbase.org/api/proteins/")\n    with open(\'/app/fpbase_proteins.csv\', \'w\') as f:\n        f.write(data)\n    print(f"Saved {len(data)} bytes to /app/fpbase_proteins.csv")\n    \n    # Parse CSV\n    reader = csv.DictReader(io.StringIO(data))\n    # Find all state columns\n    fieldnames = reader.fieldnames\n    print(f"Fields: {fieldnames[:20]}...")\n    \n    # Collect proteins with spectral data\n    proteins = []\n    for row in reader:\n        name = row.get(\'name\', \'\')\n        slug = row.get(\'slug\', \'\')\n        pdb_ids = []\n        for k, v in row.items():\n            if k.startswith(\'pdb\') and v:\n                pdb_ids.append(v)\n        # Check all states\n        states = []\n        i = 0\n        while f\'states.{i}.ex_max\' in row:\n            ex = row.get(f\'states.{i}.ex_max\', \'\')\n            em = row.get(f\'states.{i}.em_max\', \'\')\n            if ex and em:\n                try:\n                    states.append((int(ex), int(em), row.get(f\'states.{i}.name\', \'\')))\n                except:\n                    pass\n            i += 1\n        if states:\n            proteins.append((name, slug, pdb_ids, states, row.get(\'seq\', \'\')))\n    \n    print(f"\\nTotal proteins with states: {len(proteins)}")\n    \n    # Find proteins matching ex=505, em=610\n    print("\\n=== PROTEINS WITH ex_max=505 AND em_max=610 ===")\n    for name, slug, pdb_ids, states, seq in proteins:\n        for ex, em, state_name in states:\n            if ex == 505 and em == 610:\n                print(f"  {name} (slug={slug}, pdb={pdb_ids}, state={state_name}, seq_len={len(seq)})")\n    \n    # Find proteins matching ex=505 only (donor candidates)\n    print("\\n=== PROTEINS WITH ex_max=505 ===")\n    for name, slug, pdb_ids, states, seq in proteins:\n        for ex, em, state_name in states:\n            if ex == 505:\n                print(f"  {name} (slug={slug}, pdb={pdb_ids}, state={state_name}, ex={ex}, em={em})")\n    \n    # Find proteins matching em=610 only (acceptor candidates)\n    print("\\n=== PROTEINS WITH em_max=610 ===")\n    for name, slug, pdb_ids, states, seq in proteins:\n        for ex, em, state_name in states:\n            if em == 610:\n                print(f"  {name} (slug={slug}, pdb={pdb_ids}, state={state_name}, ex={ex}, em={em})")\n    \n    # Also show proteins in pdb_ids.txt with their spectral data\n    print("\\n=== FP PROTEINS IN pdb_ids.txt ===")\n    target_pdbs = set(open(\'/app/pdb_ids.txt\').read().split())\n    for name, slug, pdb_ids, states, seq in proteins:\n        if any(p in target_pdbs for p in pdb_ids):\n            print(f"  {name} (slug={slug}, pdb={pdb_ids}, states={states}, seq_len={len(seq)})")\n\nexcept Exception as e:\n    print(f"ERROR: {e}")\n\n# 2. Parse saved PDB FASTA\nprint("\\n=== PDB FASTA SUMMARY ===")\ndata = open(\'/app/pdb_fasta_all.txt\').read()\nentries = []\ncur_header = None\ncur_seq = []\nfor line in data.strip().split(\'\\n\'):\n    if line.startswith(\'>\'):\n        if cur_header:\n            entries.append((cur_header, \'\'.join(cur_seq)))\n        cur_header = line\n        cur_seq = []\n    else:\n        cur_seq.append(line.strip())\nif cur_header:\n    entries.append((cur_header, \'\'.join(cur_seq)))\n\nfor h, s in entries:\n    pid = h[1:5]\n    print(f"{pid}: len={len(s)} header={h[:80]}")\n    if pid in [\'2H5Q\', \'3M22\', \'4KGE\', \'3KZY\']:\n        print(f"  FULL SEQ: {s}")\n\n# 3. RCSB 3KZY ligand details\nprint("\\n=== 3KZY DETAILS ===")\ntry:\n    url = "https://data.rcsb.org/rest/v1/core/entry/3KZY"\n    data = json.loads(fetch(url))\n    nonpoly_ids = data.get("rcsb_entry_container_identifiers", {}).get("non_polymer_entity_ids", [])\n    print(f"Non-polymer entity IDs: {nonpoly_ids}")\n    for eid in nonpoly_ids:\n        try:\n            url2 = f"https://data.rcsb.org/rest/v1/core/nonpolymer_entity/3KZY/{eid}"\n            data2 = json.loads(fetch(url2))\n            print(f"Entity {eid}: {json.dumps(data2, indent=2)[:1500]}")\n        except Exception as e:\n            print(f"Entity {eid}: ERROR {e}")\nexcept Exception as e:\n    print(f"3KZY entry: ERROR {e}")\n\n# 4. Antibody target - try BLAST\nprint("\\n=== ANTIBODY TARGET BLAST ===")\nhv = "QVQLQQSAAELARPGASVKMSCKASGYSFTTYTIHWVKQRPGQGLEWIGYINPSSGYAAYNQNFKDETTLTADPSSSTAYMELNSLTSEDSAVYYCAREKFYGYDYWGQGATLTVSS"\nlv = "DVLMTQIPLSLPVSLGDQASISCRSSQSIVHRNGNTYLEWYLLKPGQSPKLLIYKVSNRFSGVPDRFSGSGSGTDFTLKISRVEAEDLGVYYCFQGSHVPYTFGGGTKLEIK"\n\n# Try SAbDab search\ntry:\n    url = "https://search.rcsb.org/rcsbsearch/v2/query"\n    query = {\n        "query": {\n            "type": "terminal",\n            "service": "text",\n            "parameters": {"attribute": "rcsb_entry_container_identifiers.entity_id", "operator": "equals", "value": "3KZY"}\n        },\n        "return_type": "entry"\n    }\n    # Try SAbDab\n    url2 = "http://opig.stats.ox.ac.uk/webapps/sabdab-sabpred/sabdapred/"\n    print("SAbDab would require web interface")\nexcept:\n    pass\n\n# Try NCBI BLAST URL API\nprint("\\n=== NCBI BLAST ===")\ntry:\n    # Use qblast API\n    params = urllib.parse.urlencode({\n        \'CMD\': \'Put\',\n        \'PROGRAM\': \'blastp\',\n        \'DATABASE\': \'nr\',\n        \'QUERY\': hv,\n        \'EXPECT\': \'0.001\',\n        \'HITLIST_SIZE\': \'10\',\n        \'FORMAT_TYPE\': \'JSON2\'\n    })\n    url = f"https://blast.ncbi.nlm.nih.gov/blast/Blast.cgi?{params}"\n    result = fetch(url, timeout=30)\n    # Extract RID\n    import re\n    m = re.search(r\'RID = (\\S+)\', result)\n    if m:\n        rid = m.group(1)\n        print(f"BLAST RID: {rid}")\n    else:\n        print(f"No RID found, response start: {result[:500]}")\nexcept Exception as e:\n    print(f"BLAST error: {e}")\n\n# 5. DHFR from plasmid\nprint("\\n=== DHFR SEQUENCE ===")\ngb = open(\'/app/plasmid.gb\').read()\nimport re\n# Extract translation\nm = re.search(r\'/translation="([^"]+)"\', gb.replace(\'\\n\', \' \'))\nif m:\n    dhfr = m.group(1).replace(\' \', \'\').strip()\n    print(f"DHFR protein seq ({len(dhfr)} aa): {dhfr}")\nelse:\n    print("DHFR translation not found")\n\nPY\n'] min_timeout_sec: 20.0 max_timeout_sec: 180.0
