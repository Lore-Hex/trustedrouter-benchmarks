Sending keys: ['cat > /app/jump_analyzer.py <<\'PY\'\n#!/usr/bin/env python3\nimport sys\nimport cv2\nimport numpy as np\n\n\ndef analyze_video(video_path):\n    cap = cv2.VideoCapture(video_path)\n    if not cap.isOpened():\n        return 0, 0\n\n    frames = []\n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            break\n        frames.append(frame)\n    cap.release()\n\n    if len(frames) < 2:\n        return 0, 0\n\n    # First frame is background (no runner on track)\n    bg_blur = cv2.GaussianBlur(frames[0], (5, 5), 0)\n    bg_gray = cv2.cvtColor(bg_blur, cv2.COLOR_BGR2GRAY).astype(np.float32)\n\n    feet_positions = []\n\n    for frame in frames:\n        fblur = cv2.GaussianBlur(frame, (5, 5), 0)\n        gray = cv2.cvtColor(fblur, cv2.COLOR_BGR2GRAY).astype(np.float32)\n        diff = np.abs(gray - bg_gray)\n\n        # Background subtraction mask\n        mask = (diff > 30).astype(np.uint8) * 255\n\n        # Focus on track region (below y=190)\n        mask[:190, :] = 0\n\n        # Morphological cleanup\n        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((5, 5), np.uint8))\n        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((15, 15), np.uint8))\n\n        # Find contours\n        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n        valid = [c for c in contours if cv2.contourArea(c) > 200]\n\n        if valid:\n            all_pts = np.vstack(valid)\n            x, y, w, h = cv2.boundingRect(all_pts)\n            feet = y + h\n        else:\n            feet = -1\n\n        feet_positions.append(feet)\n\n    # Smooth feet positions with a window of 3\n    smoothed = []\n    for i in range(len(feet_positions)):\n        window = feet_positions[max(0, i - 1):i + 2]\n        window = [w for w in window if w > 0]\n        if window:\n            smoothed.append(sum(window) / len(window))\n        else:\n            smoothed.append(-1.0)\n\n    # Find valid frames (feet detected)\n    valid_frames = [(i, f) for i, f in enumerate(smoothed) if f > 0]\n\n    if len(valid_frames) < 5:\n        return 0, 0\n\n    # Find peak frame (minimum feet position = highest point of jump)\n    peak_frame, peak_feet = min(valid_frames, key=lambda x: x[1])\n\n    # Find ground level (maximum feet position before peak)\n    before_peak = [(i, f) for i, f in valid_frames if i < peak_frame]\n    if not before_peak:\n        return 0, 0\n\n    ground_level = max(f for i, f in before_peak)\n\n    # Jump height and adaptive threshold (10% of jump height)\n    jump_height = ground_level - peak_feet\n    if jump_height < 20:\n        # No significant jump detected\n        return 0, 0\n\n    threshold = ground_level - jump_height * 0.1\n\n    # Takeoff: look backwards from peak for last frame at ground level\n    takeoff = None\n    for i in range(peak_frame - 1, -1, -1):\n        if smoothed[i] > 0 and smoothed[i] >= threshold:\n            takeoff = i + 1  # First frame after ground contact\n            break\n\n    if takeoff is None:\n        takeoff = max(0, peak_frame - 10)\n\n    # Landing: look forwards from peak for first frame back at ground level\n    landing = None\n    for i in range(peak_frame + 1, len(smoothed)):\n        if smoothed[i] > 0 and smoothed[i] >= threshold:\n            landing = i\n            break\n\n    if landing is None:\n        landing = min(len(frames) - 1, peak_frame + 10)\n\n    return int(takeoff), int(landing)\n\n\ndef write_toml(takeoff, landing, output_path=\'/app/output.toml\'):\n    with open(output_path, \'w\') as f:\n        f.write(f\'jump_takeoff_frame_number = {takeoff}\\n\')\n        f.write(f\'jump_land_frame_number = {landing}\\n\')\n\n\ndef main():\n    if len(sys.argv) < 2:\n        print("Usage: python3 jump_analyzer.py <video.mp4>")\n        sys.exit(1)\n\n    video_path = sys.argv[1]\n    takeoff, landing = analyze_video(video_path)\n    write_toml(takeoff, landing)\n    print(f\'jump_takeoff_frame_number = {takeoff}\')\n    print(f\'jump_land_frame_number = {landing}\')\n\n\nif __name__ == \'__main__\':\n    main()\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
