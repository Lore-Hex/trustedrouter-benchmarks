Sending keys: ['cat > /app/optimize.py <<\'PY\'\n#!/usr/bin/env python3\nimport json, os, sys, math, collections\nsys.path.insert(0, \'/app/task_file/scripts\')\nfrom cost_model import CostModel, HEADS, HIDDEN, align\n\nGRAN = 64\nMAX_SHAPES = 8\n\ndef load_requests(path):\n    return [json.loads(l) for l in open(path)]\n\ndef compute_plan_exact_genlen(reqs, shapes, bid_start=0):\n    """Group by (aligned_prompt, gen_len); each group is one batch."""\n    groups = collections.defaultdict(list)\n    for r in reqs:\n        s = align(r[\'prompt_len\'], GRAN)\n        g = r[\'gen_len\']\n        groups[(s, g)].append(r)\n    plan = []\n    bid = bid_start\n    for (s, g), group_reqs in sorted(groups.items()):\n        shape_s = min(sh for sh in shapes if sh >= s)\n        bid += 1\n        batch_id = f"b-{bid:04d}"\n        for r in group_reqs:\n            plan.append({\n                \'request_id\': r[\'request_id\'],\n                \'batch_id\': batch_id,\n                \'shape\': {\n                    \'seq_align\': shape_s,\n                    \'heads_align\': HEADS,\n                    \'hidden_align\': HIDDEN,\n                }\n            })\n    return plan, bid\n\ndef evaluate(reqs, plan, label):\n    cm = CostModel(GRAN)\n    requests = {r[\'request_id\']: r for r in reqs}\n    m = cm.plan_metrics(requests, plan)\n    nb = len(set(p[\'batch_id\'] for p in plan))\n    ns = len(set((p[\'shape\'][\'seq_align\'], p[\'shape\'][\'heads_align\'], p[\'shape\'][\'hidden_align\']) for p in plan))\n    print(f"\\n{label}:")\n    print(f"  Cost: {m[\'cost\']:.4e}")\n    print(f"  Pad Ratio: {m[\'pad_ratio\']:.6f}")\n    print(f"  P95 Latency: {m[\'p95_latency_ms\']:.4e}")\n    print(f"  Sequential Timecost: {m[\'sequential_timecost\']:.4e}")\n    print(f"  Num batches: {nb}, Num shapes: {ns}")\n    return m\n\nreqs1 = load_requests(\'/app/task_file/input_data/requests_bucket_1.jsonl\')\nreqs2 = load_requests(\'/app/task_file/input_data/requests_bucket_2.jsonl\')\n\n# Compute fixed pad_prefill\nfor label, reqs in [(\'Bucket 1\', reqs1), (\'Bucket 2\', reqs2)]:\n    pad_prefill = sum(align(r[\'prompt_len\'], GRAN) - r[\'prompt_len\'] for r in reqs)\n    real_tokens = sum(r[\'prompt_len\'] + r[\'gen_len\'] for r in reqs)\n    print(f"{label}: pad_prefill={pad_prefill}, real_tokens={real_tokens}, min_pad_ratio={pad_prefill/real_tokens:.6f}")\n\nall_aligned = sorted(set(align(r[\'prompt_len\'], GRAN) for reqs in [reqs1, reqs2] for r in reqs))\nprint(f"\\nAll unique aligned prompts: {all_aligned}")\nprint(f"Count: {len(all_aligned)}")\n\n# Count groups\nfor label, reqs in [(\'Bucket 1\', reqs1), (\'Bucket 2\', reqs2)]:\n    groups = set((align(r[\'prompt_len\'], GRAN), r[\'gen_len\']) for r in reqs)\n    print(f"{label}: {len(groups)} unique (aligned_prompt, gen_len) groups")\n\n# Try shape set\nshapes = [128, 256, 384, 512, 640, 1024, 1408, 2048]\nprint(f"\\nShapes: {shapes}")\n\nplan1, _ = compute_plan_exact_genlen(reqs1, shapes)\nplan2, _ = compute_plan_exact_genlen(reqs2, shapes)\n\nm1 = evaluate(reqs1, plan1, \'Bucket 1\')\nm2 = evaluate(reqs2, plan2, \'Bucket 2\')\n\nthresholds = {\n    \'Bucket 1\': {\'cost\': 3e11, \'pad_ratio\': 0.055, \'p95_latency_ms\': 2.1e6, \'sequential_timecost\': 2.7e8},\n    \'Bucket 2\': {\'cost\': 4.8e10, \'pad_ratio\': 0.15, \'p95_latency_ms\': 2.1e5, \'sequential_timecost\': 3.2e7},\n}\nfor label, m, thresh in [(\'Bucket 1\', m1, thresholds[\'Bucket 1\']), (\'Bucket 2\', m2, thresholds[\'Bucket 2\'])]:\n    print(f"\\n{label} threshold check:")\n    for k, v in thresh.items():\n        ok = m[k] < v\n        print(f"  {k}: {m[k]:.4e} < {v:.4e} -> {\'OK\' if ok else \'FAIL\'}")\nPY\npython3 /app/optimize.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
