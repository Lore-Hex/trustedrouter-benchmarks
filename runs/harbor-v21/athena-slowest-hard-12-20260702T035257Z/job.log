Sending keys: ["python3 - <<'PY'\nimport cv2, numpy as np\ncap=cv2.VideoCapture('/app/example_video.mp4')\nframes=[]\nwhile True:\n    ret, frame=cap.read()\n    if not ret: break\n    frames.append(frame)\ncap.release()\nbg_gray=cv2.cvtColor(frames[0], cv2.COLOR_BGR2GRAY).astype(np.float32)\n\nprint('total', len(frames))\nprint()\nprint('frame  feet20  feet25  feet30  bot25  cx25  ground_contact  upper_contact  total_motion')\nfor i in range(40, 80):\n    gray=cv2.cvtColor(frames[i], cv2.COLOR_BGR2GRAY).astype(np.float32)\n    diff=np.abs(gray-bg_gray)\n    \n    # Track feet position with different thresholds\n    feet_positions = []\n    for thresh in [20, 25, 30]:\n        mask = (diff>thresh).astype(np.uint8)\n        mask[:200,:] = 0  # focus on track region\n        # Clean up\n        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3,3),np.uint8))\n        ys, xs = np.where(mask>0)\n        if len(ys) > 50:\n            # Use 95th percentile of y to be robust against noise\n            feet_y = int(np.percentile(ys, 95))\n        else:\n            feet_y = -1\n        feet_positions.append(feet_y)\n    \n    # Use threshold 25 for contour analysis\n    mask25 = (diff>25).astype(np.uint8)*255\n    mask25[:200,:] = 0\n    mask25 = cv2.morphologyEx(mask25, cv2.MORPH_OPEN, np.ones((3,3),np.uint8))\n    mask25 = cv2.morphologyEx(mask25, cv2.MORPH_CLOSE, np.ones((7,7),np.uint8))\n    contours,_ = cv2.findContours(mask25, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    valid = [c for c in contours if cv2.contourArea(c)>100]\n    if valid:\n        c = max(valid, key=cv2.contourArea)\n        x,y,w,h = cv2.boundingRect(c)\n        bot25 = y+h\n        cx25 = x+w//2\n    else:\n        bot25 = -1\n        cx25 = -1\n    \n    # Ground contact: motion pixels in y=340-380 (ground level)\n    ground_mask = (diff>25).astype(np.uint8)\n    ground_mask[:340,:] = 0\n    ground_mask[380:,:] = 0\n    ground_contact = int(ground_mask.sum())\n    \n    # Upper contact: motion pixels in y=200-280 (elevated)\n    upper_mask = (diff>25).astype(np.uint8)\n    upper_mask[:200,:] = 0\n    upper_mask[280:,:] = 0\n    upper_contact = int(upper_mask.sum())\n    \n    # Total motion in track region\n    total_mask = (diff>25).astype(np.uint8)\n    total_mask[:200,:] = 0\n    total_motion = int(total_mask.sum())\n    \n    print(f'{i:3d}   {feet_positions[0]:5d}  {feet_positions[1]:5d}  {feet_positions[2]:5d}  {bot25:5d}  {cx25:5d}  {ground_contact:8d}  {upper_contact:8d}  {total_motion:8d}')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
