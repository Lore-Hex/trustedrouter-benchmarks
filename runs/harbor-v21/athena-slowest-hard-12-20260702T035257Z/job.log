Sending keys: ['cat > design_primers.pl <<\'PERL\'\nuse strict;\nuse warnings;\n\n# Parse sequences\nmy %s; my $n;\nopen my $F, \'<\', \'sequences.fasta\' or die $!;\nwhile (<$F>) { chomp; if (/^>(\\S+)/) { $n = $1 } else { $s{$n} .= uc($_) } }\nclose $F;\n\nsub rev_comp {\n  my $seq = shift;\n  my $comp = reverse($seq);\n  $comp =~ tr/ACGT/TGCA/;\n  return $comp;\n}\n\nsub oligotm {\n  my $seq = shift;\n  my $result = `oligotm -tp 1 -sc 1 -mv 50 -dv 2 -n 0.8 -d 500 $seq`;\n  chomp $result;\n  return $result + 0;\n}\n\n# Primer constant: 5\' spacer (T) + BsaI recognition (GGTCTC) + 1nt spacer (A)\nmy $const = "TGGTCTCA";\n\n# Fragment definitions:\n# fwd_oh = left overhang (NOT from this template, added as non-annealing tail)\n# rev_oh = right overhang on top strand (FROM this template, part of annealing)\n# fwd_start = template start position for forward primer annealing\n# rev_end = template end position for reverse primer annealing (last base of fragment in output)\nmy @frags = (\n  # input: circular, linearized as input[687..end]+input[0..209]\n  { name => \'input\', seq => $s{input}, fwd_oh => \'GGGT\', rev_oh => \'ACAT\',\n    fwd_start => 687, rev_end => 209 },\n  # egfp: egfp[0..713] (excludes TAA stop)\n  { name => \'egfp\', seq => $s{egfp}, fwd_oh => \'ACAT\', rev_oh => \'CAAA\',\n    fwd_start => 0, rev_end => 713 },\n  # flag: flag[3..86] (excludes ATG start and TAA stop)\n  { name => \'flag\', seq => $s{flag}, fwd_oh => \'CAAA\', rev_oh => \'TTCA\',\n    fwd_start => 3, rev_end => 86 },\n  # snap: snap[3..545] (excludes ATG start; TAA at 546-548 overlaps input[687-689])\n  { name => \'snap\', seq => $s{snap}, fwd_oh => \'TTCA\', rev_oh => \'GGGT\',\n    fwd_start => 3, rev_end => 545 },\n);\n\nmy @primers;\n\nfor my $fr (@frags) {\n  my $name = $fr->{name};\n  my $seq = $fr->{seq};\n  my $fwd_oh = $fr->{fwd_oh};\n  my $rev_oh = $fr->{rev_oh};\n  my $rev_oh_rc = rev_comp($rev_oh);\n  my $fwd_start = $fr->{fwd_start};\n  my $rev_end = $fr->{rev_end};\n\n  # Forward primer candidates: annealing = template[fwd_start..fwd_start+N-1]\n  my @fwd_cand;\n  for my $N (15..45) {\n    my $anneal = substr($seq, $fwd_start, $N);\n    my $tm = oligotm($anneal);\n    if ($tm >= 58 && $tm <= 72) {\n      push @fwd_cand, { N => $N, anneal => $anneal, tm => $tm };\n    }\n  }\n\n  # Reverse primer candidates: annealing = rev_comp(template[rev_end-L+1..rev_end])\n  # First 4 nt of annealing = rev_oh_rc (part of template, included in Tm)\n  my @rev_cand;\n  for my $L (15..45) {\n    my $template_region = substr($seq, $rev_end - $L + 1, $L);\n    my $anneal = rev_comp($template_region);\n    my $tm = oligotm($anneal);\n    if ($tm >= 58 && $tm <= 72) {\n      push @rev_cand, { L => $L, anneal => $anneal, tm => $tm };\n    }\n  }\n\n  printf "%s: %d fwd candidates, %d rev candidates\\n", $name, scalar(@fwd_cand), scalar(@rev_cand);\n\n  # Find best pair: minimize Tm difference, then closeness to 65°C\n  my $best;\n  for my $f (@fwd_cand) {\n    for my $r (@rev_cand) {\n      my $dtm = abs($f->{tm} - $r->{tm});\n      next if $dtm > 5;\n      my $score = $dtm * 100 + abs($f->{tm} - 65) + abs($r->{tm} - 65);\n      if (!defined $best || $score < $best->{score}) {\n        $best = { score => $score, f => $f, r => $r };\n      }\n    }\n  }\n\n  die "No valid primer pair for $name\\n" unless $best;\n\n  my $f = $best->{f};\n  my $r = $best->{r};\n\n  # Forward primer: [const][fwd_oh][annealing] (overhang is non-annealing)\n  my $fwd_primer = $const . $fwd_oh . $f->{anneal};\n\n  # Reverse primer: [const][annealing] (first 4 nt of annealing = overhang_rc, which IS annealing)\n  my $rev_primer = $const . $r->{anneal};\n\n  # Verify reverse overhang\n  my $rev_oh_check = substr($r->{anneal}, 0, 4);\n  die "Reverse overhang mismatch for $name: expected $rev_oh_rc, got $rev_oh_check\\n"\n    if $rev_oh_check ne $rev_oh_rc;\n\n  # Check for internal BsaI sites\n  my $fwd_ggtctc = () = ($fwd_primer =~ /GGTCTC/g);\n  my $fwd_gagacc = () = ($fwd_primer =~ /GAGACC/g);\n  my $rev_ggtctc = () = ($rev_primer =~ /GGTCTC/g);\n  my $rev_gagacc = () = ($rev_primer =~ /GAGACC/g);\n  if ($fwd_ggtctc != 1) { warn "WARNING: ${name}_fwd has $fwd_ggtctc GGTCTC sites\\n" }\n  if ($fwd_gagacc > 0)  { warn "WARNING: ${name}_fwd has $fwd_gagacc GAGACC sites\\n" }\n  if ($rev_ggtctc != 1) { warn "WARNING: ${name}_rev has $rev_ggtctc GGTCTC sites\\n" }\n  if ($rev_gagacc > 0)  { warn "WARNING: ${name}_rev has $rev_gagacc GAGACC sites\\n" }\n\n  push @primers, { name => $name, dir => \'fwd\', seq => $fwd_primer, tm => $f->{tm},\n    anneal => $f->{anneal}, anneal_len => $f->{N} };\n  push @primers, { name => $name, dir => \'rev\', seq => $rev_primer, tm => $r->{tm},\n    anneal => $r->{anneal}, anneal_len => $r->{L} };\n}\n\n# Write primers.fasta (no blank lines)\nopen my $out, \'>\', \'primers.fasta\' or die $!;\nfor my $p (@primers) {\n  print $out ">$p->{name}_$p->{dir}\\n";\n  print $out "$p->{seq}\\n";\n}\nclose $out;\n\n# Print summary\nprint "\\n=== Primer Summary ===\\n";\nfor my $p (@primers) {\n  printf "%s_%s: len=%d anneal_len=%d tm=%.2f\\n", $p->{name}, $p->{dir}, length($p->{seq}), $p->{anneal_len}, $p->{tm};\n  printf "  full:    %s\\n", $p->{seq};\n  printf "  anneal:  %s\\n", $p->{anneal};\n}\n\n# Print Tm pair check\nprint "\\n=== Tm Pair Check ===\\n";\nfor (my $i = 0; $i < scalar(@primers); $i += 2) {\n  my $f = $primers[$i];\n  my $r = $primers[$i+1];\n  printf "%s: fwd_tm=%.2f rev_tm=%.2f diff=%.2f %s\\n",\n    $f->{name}, $f->{tm}, $r->{tm}, abs($f->{tm}-$r->{tm}),\n    abs($f->{tm}-$r->{tm}) <= 5 ? "OK" : "FAIL";\n}\nPERL\nperl design_primers.pl\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
