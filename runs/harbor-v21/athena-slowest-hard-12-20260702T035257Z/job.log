Sending keys: ['cat > /app/pipeline_parallel.py << \'PYEOF\'\nimport torch\nimport torch.distributed as dist\nfrom torch.distributed import P2POp\n\n\ndef _partition_layers(num_layers, rank, world_size):\n    """Partition decoder layers roughly evenly across pipeline stages."""\n    base = num_layers // world_size\n    rem = num_layers % world_size\n    count = base + (1 if rank < rem else 0)\n    start = rank * base + min(rank, rem)\n    end = start + count\n    return start, end\n\n\ndef _p2p_send(tensor, peer):\n    """Send a contiguous tensor to *peer* via P2POp."""\n    tensor = tensor.contiguous()\n    ops = [P2POp(dist.isend, tensor, peer)]\n    reqs = dist.batch_isend_irecv(ops)\n    for req in reqs:\n        req.wait()\n\n\ndef _p2p_recv(shape, peer, device, dtype):\n    """Allocate and receive a tensor from *peer* via P2POp."""\n    tensor = torch.empty(shape, device=device, dtype=dtype)\n    ops = [P2POp(dist.irecv, tensor, peer)]\n    reqs = dist.batch_isend_irecv(ops)\n    for req in reqs:\n        req.wait()\n    return tensor\n\n\ndef train_step_pipeline_afab(model, inputs, targets, device, dtype):\n    """Run one AFAB pipeline-parallel training step for LlamaForCausalLM.\n\n    All forward passes for every microbatch are executed first, then all\n    backward passes.  Layer partitioning is balanced across ranks.  P2P\n    communication is used to pass hidden states forward and gradients\n    backward between adjacent stages.\n    """\n    rank = dist.get_rank()\n    world_size = dist.get_world_size()\n\n    num_layers = len(model.model.layers)\n    hidden_size = model.config.hidden_size\n\n    start, end = _partition_layers(num_layers, rank, world_size)\n    layers = model.model.layers[start:end]\n\n    # ---- Broadcast microbatch count and per-microbatch shapes from rank 0 ----\n    num_mb_tensor = torch.tensor(\n        [len(inputs) if rank == 0 else 0], device=device, dtype=torch.long\n    )\n    dist.broadcast(num_mb_tensor, src=0)\n    num_microbatches = int(num_mb_tensor.item())\n\n    if rank == 0:\n        shape_values = []\n        for inp in inputs:\n            shape_values.extend(inp.shape[:2])\n        shapes_tensor = torch.tensor(shape_values, device=device, dtype=torch.long)\n    else:\n        shapes_tensor = torch.zeros(\n            num_microbatches * 2, device=device, dtype=torch.long\n        )\n    dist.broadcast(shapes_tensor, src=0)\n\n    input_shapes = []\n    for i in range(num_microbatches):\n        mb_size = int(shapes_tensor[i * 2].item())\n        seq_len = int(shapes_tensor[i * 2 + 1].item())\n        input_shapes.append((mb_size, seq_len))\n\n    # Zero gradients at the start of the training step.\n    model.zero_grad()\n\n    # Storage needed for the backward phase.\n    forward_data = []\n\n    # ======================= All-Forward =======================\n    for mb_idx in range(num_microbatches):\n        mb_size, seq_len = input_shapes[mb_idx]\n\n        if rank == 0:\n            # First stage: embed token IDs into hidden states.\n            input_ids = inputs[mb_idx].to(device)\n            h = model.model.embed_tokens(input_ids)\n            h = h.to(device=device, dtype=dtype)\n            input_h = None\n        else:\n            # Receive hidden states from the previous stage.\n            recv = _p2p_recv(\n                (mb_size, seq_len, hidden_size), rank - 1, device, dtype\n            )\n            h = recv.to(device=device, dtype=dtype)\n            h.requires_grad_(True)\n            input_h = h\n\n        # Run through this stage\'s decoder layers.\n        for layer in layers:\n            h = layer(h)\n\n        h = h.to(dtype)\n\n        if rank < world_size - 1:\n            # Send hidden states to the next stage.\n            _p2p_send(h.detach(), rank + 1)\n            forward_data.append({"input_h": input_h, "output_h": h})\n        else:\n            # Last stage: final norm, LM head, and scaled loss.\n            h = model.model.norm(h)\n            logits = model.lm_head(h)\n            logits = logits.to(dtype)\n\n            target = targets[mb_idx].to(device)\n            loss = torch.nn.functional.cross_entropy(\n                logits.view(-1, logits.size(-1)),\n                target.view(-1),\n            )\n            loss = loss / num_microbatches\n            loss = loss.to(dtype)\n\n            forward_data.append({"input_h": input_h, "loss": loss})\n\n    # ======================= All-Backward =======================\n    for mb_idx in range(num_microbatches):\n        data = forward_data[mb_idx]\n        mb_size, seq_len = input_shapes[mb_idx]\n\n        if rank == world_size - 1:\n            # Last stage: start backward from the scaled loss.\n            data["loss"].backward()\n            grad_input = (\n                data["input_h"].grad if data["input_h"] is not None else None\n            )\n        else:\n            # Receive gradient w.r.t. this stage\'s output from the next stage.\n            grad_recv = _p2p_recv(\n                (mb_size, seq_len, hidden_size), rank + 1, device, dtype\n            )\n            grad_output = grad_recv.to(device=device, dtype=dtype)\n\n            # Backward through this stage\'s layers.\n            torch.autograd.backward(data["output_h"], grad_output)\n            grad_input = (\n                data["input_h"].grad if data["input_h"] is not None else None\n            )\n\n        # Send gradient w.r.t. this stage\'s input to the previous stage.\n        if rank > 0 and grad_input is not None:\n            _p2p_send(grad_input.detach(), rank - 1)\nPYEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
