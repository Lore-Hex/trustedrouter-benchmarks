Sending keys: ["python3 - <<'PY'\nimport cv2, numpy as np\ncap=cv2.VideoCapture('/app/example_video.mp4')\nframes=[]\nwhile True:\n    ret, frame=cap.read()\n    if not ret: break\n    frames.append(frame)\ncap.release()\nbg_blur=cv2.GaussianBlur(frames[0], (5,5), 0)\nbg_gray_blur=cv2.cvtColor(bg_blur, cv2.COLOR_BGR2GRAY).astype(np.float32)\nfeet_positions=[]\nareas=[]\nprint('frame  feet  area   cx   ground_pixels  air_pixels')\nfor i, frame in enumerate(frames):\n    fblur=cv2.GaussianBlur(frame, (5,5), 0)\n    gray=cv2.cvtColor(fblur, cv2.COLOR_BGR2GRAY).astype(np.float32)\n    diff=np.abs(gray-bg_gray_blur)\n    mask=(diff>30).astype(np.uint8)*255\n    mask[:190,:]=0\n    mask=cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((5,5),np.uint8))\n    mask=cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((15,15),np.uint8))\n    contours,_=cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    valid=[c for c in contours if cv2.contourArea(c)>200]\n    if valid:\n        all_pts=np.vstack(valid)\n        x,y,w,h=cv2.boundingRect(all_pts)\n        feet=y+h\n        area=sum(cv2.contourArea(c) for c in valid)\n        cx=int(all_pts[:,0,:,:].mean())\n    else:\n        feet=-1\n        area=0\n        cx=-1\n    ground_mask=(diff>30).astype(np.uint8)\n    ground_mask[:340,:]=0\n    ground_mask[380:,:]=0\n    ground_pix=int(ground_mask.sum())\n    air_mask=(diff>30).astype(np.uint8)\n    air_mask[:190,:]=0\n    air_mask[280:,:]=0\n    air_pix=int(air_mask.sum())\n    feet_positions.append(feet)\n    areas.append(area)\n    if 40 <= i <= 80:\n        print(f'{i:3d}  {feet:5d}  {area:6.0f}  {cx:4d}  {ground_pix:8d}  {air_pix:8d}')\nprint('\\nFeet position visualization (frames 45-75):')\nfor i in range(45, 75):\n    f=feet_positions[i]\n    if f > 0:\n        bar='.' * ((f-190)//5) + 'X'\n        print(f'{i:3d}  {f:5d}  {bar}')\n    else:\n        print(f'{i:3d}  {f:5d}  (no detection)')\nprint('\\nSmoothed feet positions (frames 45-75):')\nfor i in range(45, 75):\n    window=feet_positions[max(0,i-1):i+2]\n    window=[w for w in window if w>0]\n    if window:\n        avg=sum(window)/len(window)\n        bar='.' * int((avg-190)//5) + 'O'\n        print(f'{i:3d}  {avg:7.1f}  {bar}')\n    else:\n        print(f'{i:3d}      -1  (no detection)')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
