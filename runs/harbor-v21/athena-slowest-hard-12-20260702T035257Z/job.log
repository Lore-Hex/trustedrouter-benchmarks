Sending keys: ['python3 - <<\'PY\'\nimport urllib.request, urllib.parse, json, time\n\nheaders = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"}\n\ndef fetch(url, data=None, timeout=20):\n    req = urllib.request.Request(url, data=data, headers=headers)\n    with urllib.request.urlopen(req, timeout=timeout) as r:\n        return r.read().decode()\n\n# 1. fpbase with headers\nprint("=== FPBASE WITH HEADERS ===")\nfor endpoint in ["https://www.fpbase.org/api/proteins/", "https://www.fpbase.org/api/spectra/", "https://www.fpbase.org/api/"]:\n    try:\n        data = fetch(endpoint)\n        print(f"{endpoint}: {len(data)} bytes, start={data[:300]}")\n    except Exception as e:\n        print(f"{endpoint}: ERROR {e}")\n\n# Try fpbase search for specific proteins\nprint("\\n=== FPBASE SPECIFIC ===")\nfor name in ["mCherry", "EGFP", "GFP", "TagRFP", "mCherry2", "Azami Green"]:\n    try:\n        url = f"https://www.fpbase.org/api/proteins/?name={urllib.parse.quote(name)}"\n        data = fetch(url)\n        print(f"{name}: {data[:400]}")\n    except Exception as e:\n        print(f"{name}: ERROR {e}")\n\n# 2. RCSB ligand info for 3KZY and chemical component search\nprint("\\n=== RCSB LIGAND INFO ===")\nfor pid in ["3KZY", "5P21", "1AK4"]:\n    try:\n        url = f"https://data.rcsb.org/rest/v1/core/entry/{pid}"\n        data = json.loads(fetch(url))\n        # Get non-polymer entities\n        nonpoly = [e for e in data.get("rcsb_entry_container_identifiers", {}).get("non_polymer_entity_ids", [])]\n        print(f"{pid} non_polymer_entities: {nonpoly}")\n    except Exception as e:\n        print(f"{pid} entry: ERROR {e}")\n\n# Get chemical component details for 3KZY\nprint("\\n=== 3KZY NONPOLYMER DETAILS ===")\ntry:\n    url = "https://data.rcsb.org/rest/v1/core/nonpolymer_entity/3KZY"\n    data = json.loads(fetch(url))\n    print(json.dumps(data, indent=2)[:2000])\nexcept Exception as e:\n    print(f"3KZY nonpoly: ERROR {e}")\n\n# Search PDB chem comp by name/smiles\nprint("\\n=== RCSB CHEM SEARCH ===")\nsmiles = "Nc3nc(OCc1ccccc1)c2nc[nH]c2n3"\nfor search_type in ["exact", "similarity"]:\n    query = {\n        "query": {\n            "type": "terminal",\n            "service": "chemical",\n            "parameters": {"value": smiles, "type": search_type, "limit": 10}\n        },\n        "return_type": "entry",\n        "request_options": {"return_all_hits": True}\n    }\n    try:\n        data = fetch("https://search.rcsb.org/rcsbsearch/v2/query", json.dumps(query).encode())\n        result = json.loads(data)\n        print(f"{search_type}: {json.dumps(result, indent=2)[:800]}")\n    except Exception as e:\n        print(f"{search_type}: ERROR {e}")\n\n# 3. Search for antibody target - try NCBI BLAST URL API\nprint("\\n=== ANTIBODY TARGET SEARCH ===")\nhv = "QVQLQQSAAELARPGASVKMSCKASGYSFTTYTIHWVKQRPGQGLEWIGYINPSSGYAAYNQNFKDETTLTADPSSSTAYMELNSLTSEDSAVYYCAREKFYGYDYWGQGATLTVSS"\nlv = "DVLMTQIPLSLPVSLGDQASISCRSSQSIVHRNGNTYLEWYLLKPGQSPKLLIYKVSNRFSGVPDRFSGSGSGTDFTLKISRVEAEDLGVYYCFQGSHVPYTFGGGTKLEIK"\n\n# Try UniProt search by sequence\nfor label, seq in ["heavy_v", hv], ["light_v", lv]:\n    try:\n        url = f"https://rest.uniprot.org/search?query={urllib.parse.quote(seq[:30])}&format=json&size=5"\n        data = fetch(url)\n        print(f"UniProt {label} search: {data[:500]}")\n    except Exception as e:\n        print(f"UniProt {label}: ERROR {e}")\n\n# Try searching NCBI for the CDR3 sequences\nprint("\\n=== CDR SEARCH ===")\nfor cdr in ["AREKFYGYDY", "FQGSHVPYT"]:\n    try:\n        url = f"https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi?db=protein&term={urllib.parse.quote(cdr)}&retmode=json&retmax=5"\n        data = json.loads(fetch(url))\n        print(f"CDR {cdr}: {json.dumps(data, indent=2)[:500]}")\n    except Exception as e:\n        print(f"CDR {cdr}: ERROR {e}")\n\n# 4. Save all full PDB FASTA sequences\nprint("\\n=== SAVING PDB FASTA ===")\nids = open(\'/app/pdb_ids.txt\').read().split()\nwith open(\'/app/pdb_fasta_all.txt\', \'w\') as out:\n    for pid in ids:\n        url = f"https://www.rcsb.org/fasta/entry/{pid}/display"\n        try:\n            data = fetch(url)\n            out.write(data)\n            if not data.endswith(\'\\n\'): out.write(\'\\n\')\n            print(f"{pid}: saved {len(data)} bytes")\n        except Exception as e:\n            print(f"{pid}: ERROR {e}")\n        time.sleep(0.2)\n\nPY\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
