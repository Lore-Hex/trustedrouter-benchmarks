Sending keys: ['perl - <<\'PERL\'\nuse strict;\nuse warnings;\n\n# Parse sequences\nmy %s; my $n;\nopen my $F, \'<\', \'sequences.fasta\' or die $!;\nwhile (<$F>) { chomp; if (/^>(\\S+)/) { $n = $1 } else { $s{$n} .= uc($_) } }\nclose $F;\n\n# Parse primers\nmy %p; my $pn;\nopen my $PF, \'<\', \'primers.fasta\' or die $!;\nwhile (<$PF>) { chomp; if (/^>(\\S+)/) { $pn = $1 } else { $p{$pn} .= uc($_) } }\nclose $PF;\n\nsub rev_comp {\n  my $seq = shift;\n  my $comp = reverse($seq);\n  $comp =~ tr/ACGT/TGCA/;\n  return $comp;\n}\n\nsub oligotm {\n  my $seq = shift;\n  my $result = `oligotm -tp 1 -sc 1 -mv 50 -dv 2 -n 0.8 -d 500 $seq`;\n  chomp $result;\n  return $result + 0;\n}\n\nprint "=== Primer File Validation ===\\n";\n# Check no blank lines\nopen my $BF, \'<\', \'primers.fasta\' or die $!;\nmy $line_num = 0;\nmy $blank = 0;\nwhile (<$BF>) {\n  $line_num++;\n  if (/^\\s*$/) { $blank++; print "BLANK LINE at line $line_num\\n"; }\n}\nclose $BF;\nprint "Total lines: $line_num, Blank lines: $blank\\n\\n";\n\n# Check format and Tm\nprint "=== Tm and Constraint Validation ===\\n";\nmy @expected = qw(input_fwd input_rev egfp_fwd egfp_rev flag_fwd flag_rev snap_fwd snap_rev);\nfor my $name (@expected) {\n  if (!exists $p{$name}) { print "MISSING: $name\\n"; next; }\n  my $seq = $p{$name};\n  print "$name: $seq\\n";\n}\n\n# Extract annealing regions and check Tm\n# Fragment definitions matching the design script\nmy @frags = (\n  { name => \'input\', fwd_oh => \'GGGT\', rev_oh => \'ACAT\', fwd_start => 687, rev_end => 209, seq => $s{input} },\n  { name => \'egfp\', fwd_oh => \'ACAT\', rev_oh => \'CAAA\', fwd_start => 0, rev_end => 713, seq => $s{egfp} },\n  { name => \'flag\', fwd_oh => \'CAAA\', rev_oh => \'TTCA\', fwd_start => 3, rev_end => 86, seq => $s{flag} },\n  { name => \'snap\', fwd_oh => \'TTCA\', rev_oh => \'GGGT\', fwd_start => 3, rev_end => 545, seq => $s{snap} },\n);\n\nfor my $fr (@frags) {\n  my $name = $fr->{name};\n  my $fwd_seq = $p{"${name}_fwd"};\n  my $rev_seq = $p{"${name}_rev"};\n\n  # Forward: const(8) + overhang(4) + annealing\n  my $const = "TGGTCTCA";\n  my $fwd_tail = substr($fwd_seq, 0, 8);  # const\n  my $fwd_oh = substr($fwd_seq, 8, 4);    # overhang\n  my $fwd_anneal = substr($fwd_seq, 12);  # annealing\n\n  # Reverse: const(8) + annealing (first 4 = overhang_rc)\n  my $rev_tail = substr($rev_seq, 0, 8);  # const\n  my $rev_anneal = substr($rev_seq, 8);   # annealing\n  my $rev_oh_rc = substr($rev_anneal, 0, 4);\n\n  my $fwd_tm = oligotm($fwd_anneal);\n  my $rev_tm = oligotm($rev_anneal);\n\n  # Verify const\n  my $const_ok = ($fwd_tail eq $const && $rev_tail eq $const) ? "OK" : "FAIL";\n  # Verify overhangs\n  my $fwd_oh_ok = ($fwd_oh eq $fr->{fwd_oh}) ? "OK" : "FAIL(exp $fr->{fwd_oh})";\n  my $rev_oh_ok = ($rev_oh_rc eq rev_comp($fr->{rev_oh})) ? "OK" : "FAIL(exp " . rev_comp($fr->{rev_oh}) . ")";\n  # Verify annealing matches template\n  my $fwd_exp = substr($fr->{seq}, $fr->{fwd_start}, length($fwd_anneal));\n  my $rev_exp = rev_comp(substr($fr->{seq}, $fr->{rev_end} - length($rev_anneal) + 1, length($rev_anneal)));\n  my $fwd_anneal_ok = ($fwd_anneal eq $fwd_exp) ? "OK" : "FAIL";\n  my $rev_anneal_ok = ($rev_anneal eq $rev_exp) ? "OK" : "FAIL";\n  # Check BsaI sites\n  my $fwd_ggtctc = () = ($fwd_seq =~ /GGTCTC/g);\n  my $fwd_gagacc = () = ($fwd_seq =~ /GAGACC/g);\n  my $rev_ggtctc = () = ($rev_seq =~ /GGTCTC/g);\n  my $rev_gagacc = () = ($rev_seq =~ /GAGACC/g);\n  my $bsai_ok = ($fwd_ggtctc == 1 && $fwd_gagacc == 0 && $rev_ggtctc == 1 && $rev_gagacc == 0) ? "OK" : "FAIL";\n\n  # Tm checks\n  my $fwd_tm_ok = ($fwd_tm >= 58 && $fwd_tm <= 72) ? "OK" : "FAIL";\n  my $rev_tm_ok = ($rev_tm >= 58 && $rev_tm <= 72) ? "OK" : "FAIL";\n  my $pair_tm_ok = (abs($fwd_tm - $rev_tm) <= 5) ? "OK" : "FAIL";\n  my $len_ok = (length($fwd_anneal) >= 15 && length($fwd_anneal) <= 45 &&\n                length($rev_anneal) >= 15 && length($rev_anneal) <= 45) ? "OK" : "FAIL";\n\n  printf "  %s: const=%s fwd_oh=%s rev_oh=%s anneal=%s/%s bsai=%s len=%s\\n",\n    $name, $const_ok, $fwd_oh_ok, $rev_oh_ok, $fwd_anneal_ok, $rev_anneal_ok, $bsai_ok, $len_ok;\n  printf "  fwd_anneal(%d): %s tm=%.2f %s\\n", length($fwd_anneal), $fwd_anneal, $fwd_tm, $fwd_tm_ok;\n  printf "  rev_anneal(%d): %s tm=%.2f %s\\n", length($rev_anneal), $rev_anneal, $rev_tm, $rev_tm_ok;\n  printf "  pair_tm_diff=%.2f %s\\n\\n", abs($fwd_tm - $rev_tm), $pair_tm_ok;\n}\n\n# Simulate assembly: extract fragment sequences after BsaI digestion\nprint "=== Assembly Simulation ===\\n";\nmy @frag_seqs;\nfor my $fr (@frags) {\n  my $name = $fr->{name};\n  my $fwd_seq = $p{"${name}_fwd"};\n  my $rev_seq = $p{"${name}_rev"};\n\n  # After BsaI digestion, fragment = overhang + annealing region (for forward side)\n  # For reverse side, the overhang comes from the template\n  my $fwd_oh = substr($fwd_seq, 8, 4);\n  my $fwd_anneal = substr($fwd_seq, 12);\n\n  # The fragment top strand = fwd_oh + fwd_anneal + ... + template up to rev_end\n  # fwd_anneal starts at fwd_start, so fragment = template[fwd_start..rev_end] with fwd_oh prepended\n  # But for circular input, we need to handle wraparound\n\n  my $frag;\n  if ($name eq \'input\') {\n    # Circular: input[687..end] + input[0..209]\n    $frag = $fwd_oh . substr($fr->{seq}, $fr->{fwd_start}) . substr($fr->{seq}, 0, $fr->{rev_end} + 1);\n  } else {\n    $frag = $fwd_oh . substr($fr->{seq}, $fr->{fwd_start}, $fr->{rev_end} - $fr->{fwd_start} + 1);\n  }\n  push @frag_seqs, $frag;\n  printf "%s fragment (after BsaI): len=%d\\n", $name, length($frag);\n}\n\n# Assemble: the overhang at each junction is shared (appears once)\n# frag1: ...OH1 | frag2: OH1...OH2 | frag3: OH2...OH3 | frag4: OH3...OH4\n# Circular assembly: frag1 + frag2[4:] + frag3[4:] + frag4[4:]\n# But need to account for which fragment contributes the overhang\n\n# Each fragment starts with its left overhang (4nt)\n# When ligating, the left overhang of the next fragment = right overhang of current\n# So we take fragment1 + fragment2[4:] + fragment3[4:] + fragment4[4:]\n# This forms a circle where frag4\'s right overhang = frag1\'s left overhang\n\nmy $assembled = $frag_seqs[0] . substr($frag_seqs[1], 4) . substr($frag_seqs[2], 4) . substr($frag_seqs[3], 4);\n# This is linear but represents the circular product starting at input[687]\n# To compare with output, we need to rotate\n\n# The assembled sequence starts with GGGT + input[687..end] + input[0..209] + egfp... + snap...\n# = GGGT + input[687..end] + input[0..209] + ACAT + egfp + CAAA + flag + TTCA + snap\n# The output starts at input[0], so we need to rotate\n\n# Find input[0..209] in assembled (after the first part)\n# assembled = GGGT + input[687..] + input[0..209] + rest\n# The output = input[0..209] + egfp[0..713] + flag[3..86] + snap[3..545] + input[687..]\n# So we need to rotate assembled to start at input[0]\n\n# Remove the leading GGGT (it\'s the overhang from snap, which is the last fragment\'s right overhang)\n# and the assembled circle is: input[687..] + input[0..209] + ACAT + egfp + CAAA + flag + TTCA + snap + GGGT\n# = input[687..] + input[0..209] + egfp fragment + flag fragment + snap fragment (circular)\n# Linearized at input[0]: input[0..209] + egfp_frag + flag_frag + snap_frag + input[687..]\n\n# Let\'s just compare with output directly\n# assembled = GGGT + input[687..end] + input[0..209] + (ACAT+egfp[0..713]) + (CAAA+flag[3..86]) + (TTCA+snap[3..545])\n# = GGGT + input[687..] + input[0..209] + output[210..1550] essentially\n\n# Remove leading overhang GGGT\nmy $circ = substr($assembled, 4);\n# circ = input[687..] + input[0..209] + rest\n# This is the circular product linearized at input[687]\n# Rotate to start at input[0]\nmy $input_part_len = length($s{input}) - 687;  # input[687..end] length\nmy $rotated = substr($circ, $input_part_len) . substr($circ, 0, $input_part_len);\n\nprint "Assembled length: ", length($rotated), "\\n";\nprint "Output length: ", length($s{output}), "\\n";\nprint "Match: ", ($rotated eq $s{output} ? "YES - EXACT MATCH" : "NO - MISMATCH"), "\\n";\n\nif ($rotated ne $s{output}) {\n  # Find first mismatch\n  for my $i (0..length($rotated)-1) {\n    if (substr($rotated,$i,1) ne substr($s{output},$i,1)) {\n      print "First mismatch at position $i\\n";\n      print "  assembled: ", substr($rotated, $i-10, 30), "\\n";\n      print "  output:    ", substr($s{output}, $i-10, 30), "\\n";\n      last;\n    }\n  }\n}\n\n# Verify overhangs are unique and non-palindromic\nprint "\\n=== Overhang Validation ===\\n";\nmy @ohs = (\'ACAT\', \'CAAA\', \'TTCA\', \'GGGT\');\nfor my $oh (@ohs) {\n  my $rc = rev_comp($oh);\n  my $palindrome = ($oh eq $rc) ? "PALINDROMIC" : "non-palindromic";\n  print "$oh (rc=$rc): $palindrome\\n";\n}\n# Check all pairs for uniqueness and cross-complementarity\nfor my $i (0..3) {\n  for my $j ($i+1..3) {\n    my $a = $ohs[$i]; my $b = $ohs[$j];\n    if ($a eq $b) { print "DUPLICATE: $a\\n" }\n    if ($a eq rev_comp($b)) { print "COMPLEMENTARY PAIR: $a / $b\\n" }\n  }\n}\nprint "Overhangs unique and non-cross-complementary: OK\\n" if (!grep { $ohs[$_] eq $ohs[$_+1] } 0..2);\nPERL\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
