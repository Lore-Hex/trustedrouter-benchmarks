Sending keys: ["python3 - <<'PY'\nimport cv2, numpy as np, os\ncap=cv2.VideoCapture('/app/example_video.mp4')\nframes=[]\nwhile True:\n    ret, frame=cap.read()\n    if not ret: break\n    frames.append(frame)\ncap.release()\nprint('total', len(frames))\nos.makedirs('/app/debug_frames', exist_ok=True)\nprev=None\nfor i, frame in enumerate(frames):\n    gray=cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n    if prev is None:\n        prev=gray\n        print(f'{i:3d} no prev')\n        continue\n    diff=np.abs(gray.astype(np.int16)-prev.astype(np.int16))\n    mask=(diff>20).astype(np.uint8)*255\n    mask=cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((3,3),np.uint8))\n    mask=cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((9,9),np.uint8))\n    contours,_=cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    if not contours:\n        print(f'{i:3d} no contours')\n        prev=gray\n        continue\n    c=max(contours, key=cv2.contourArea)\n    area=cv2.contourArea(c)\n    x,y,w,h=cv2.boundingRect(c)\n    if area>100:\n        print(f'{i:3d} area={area:7.0f} x={x:4d} y={y:4d} w={w:4d} h={h:4d} bot={y+h:4d} top={y:4d} cx={x+w//2:4d}')\n    else:\n        print(f'{i:3d} area={area:7.0f} too small')\n    if i in [0,5,20,40,47,48,49,50,55,60,65,70,71,72,75,80,85,90,95,100,105,110,115,119]:\n        cv2.imwrite(f'/app/debug_frames/frame_{i:03d}.jpg', frame)\n        cv2.imwrite(f'/app/debug_frames/mask_{i:03d}.jpg', mask)\n    prev=gray\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
