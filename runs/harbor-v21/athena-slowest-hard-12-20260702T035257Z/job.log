uares = {67:'e1', 68:'f1', 69:'g1', 65:'c1', 66:'d1'}\nfor k, name in castle_squares.items():\n    for k2, piece, t, path in attack_pairs:\n        if k2 != k:\n            continue\n        neg = r'(?!.*A' + name + r')'\n        look = [la_at(t, piece)]\n        for p in path:\n            look.append(la_at(p, r'\\.'))\n        pattern = r'(?m)^BASE:' + neg + ''.join(look) + r'(.*)$'\n        repl = r'BASE:\\1 A' + name\n        add(pattern, repl)\n\n# ---------- castling generation ----------\n# kingside\nadd(\n    r'(?m)^BASE:(?=.{67}K)(?=.{68}\\.)(?=.{69}\\.)(?=.{70}R)(?!.*Ae1)(?!.*Af1)(?!.*Ag1)(.{67})(K)(.)(\\.)(R) w (K1Q[01]k[01]q[01]) (\\S+)( .*)?$',\n    r'BASE:\\1\\2\\3\\4\\5 w \\6 \\7\\8\\nCAND:\\1.RK. b \\6 - 0 0'\n)\n# queenside\nadd(\n    r'(?m)^BASE:(?=.{63}R)(?=.{64}\\.)(?=.{65}\\.)(?=.{66}\\.)(?=.{67}K)(?!.*Ae1)(?!.*Ad1)(?!.*Ac1)(.{63})(R)(.)(\\.)(\\.)(K)(.{3}) w (K[01]Q1k[01]q[01]) (\\S+)( .*)?$',\n    r'BASE:\\1\\2\\3\\4\\5\\6\\7 w \\8 \\9\\g<10>\\nCAND:\\1.\\3KR.\\7 b \\8 - 0 0'\n)\n\n# ensure trailing newline before line deletions\nadd(r'([^\\n])\\Z', r'\\1\\n')\n\n# mark illegal candidates: white king attacked\nfor k, piece, t, path in attack_pairs:\n    look = [la_at(k, 'K'), la_at(t, piece)]\n    for p in path:\n        look.append(la_at(p, r'\\.'))\n    pattern = r'(?m)^CAND:(?!ILLEGAL)' + ''.join(look) + r'(.*)$'\n    repl = r'CAND:ILLEGAL\\1'\n    add(pattern, repl)\n\n# delete illegal candidates\nadd(r'(?m)^CAND:ILLEGAL.*\\n', r'')\n\n# remove base line\nadd(r'(?m)^BASE:.*\\n', r'')\n\n# update castling rights based on resulting position\nadd(r'(?m)^CAND:(.{67}[^K].{3}) b K([01])Q([01])k([01])q([01]) (\\S+) 0 0$',\n    r'CAND:\\1 b K0Q0k\\4q\\5 \\6 0 0')\nadd(r'(?m)^CAND:(.{63}[^R].{7}) b K([01])Q([01])k([01])q([01]) (\\S+) 0 0$',\n    r'CAND:\\1 b K\\2Q0k\\4q\\5 \\6 0 0')\nadd(r'(?m)^CAND:(.{70}[^R]) b K([01])Q([01])k([01])q([01]) (\\S+) 0 0$',\n    r'CAND:\\1 b K0Q\\3k\\4q\\5 \\6 0 0')\nadd(r'(?m)^CAND:([^r].{70}) b K([01])Q([01])k([01])