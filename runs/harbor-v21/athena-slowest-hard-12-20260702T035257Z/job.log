Sending keys: ['cat > /app/optimize2.py <<\'PY\'\n#!/usr/bin/env python3\nimport json, os, sys, math, collections\nsys.path.insert(0, \'/app/task_file/scripts\')\nfrom cost_model import CostModel, HEADS, HIDDEN, align\n\nGRAN = 64\nMAX_SHAPES = 8\nBATCH_OVERHEAD_COST = 10_000_000.0\n\ndef load_requests(path):\n    return [json.loads(l) for l in open(path)]\n\ndef sum_sq_arith(a, n):\n    return n*(a*a) + a*n*(n-1) + (n*(n-1)*(2*n-1))//6\n\ndef decode_cost_per_req(S, G):\n    A = 1.0\n    B = 0.5 * 4096\n    return A * sum_sq_arith(S, G) + B * (G*S + G*(G-1)/2)\n\ndef batch_lat(S, G):\n    prefill_lat = 0.002 * S**2 + 0.0015 * S * 4096\n    A2 = 0.0012\n    B2 = 0.0006 * 4096\n    return prefill_lat + A2 * sum_sq_arith(S, G) + B2 * (G*S + G*(G-1)/2) + 8\n\ndef dp_partition(gen_lens, S, alpha, gamma=0):\n    n = len(gen_lens)\n    if n == 0:\n        return []\n    prefix = [0]*(n+1)\n    for i in range(n):\n        prefix[i+1] = prefix[i] + gen_lens[i]\n    dp = [float(\'inf\')]*(n+1)\n    dp[0] = 0.0\n    parent = [0]*(n+1)\n    cost_cache = {}\n    for j in range(1, n+1):\n        G = gen_lens[j-1]\n        if G not in cost_cache:\n            cost_cache[G] = (decode_cost_per_req(S, G), batch_lat(S, G))\n    for j in range(1, n+1):\n        G = gen_lens[j-1]\n        fc, fl = cost_cache[G]\n        for k in range(j):\n            cnt = j - k\n            pad = cnt * G - (prefix[j] - prefix[k])\n            cost = cnt * fc + BATCH_OVERHEAD_COST + alpha * fl + gamma * pad\n            if dp[k] + cost < dp[j]:\n                dp[j] = dp[k] + cost\n                parent[j] = k\n    parts = []\n    j = n\n    while j > 0:\n        k = parent[j]\n        parts.append((k, j))\n        j = k\n    parts.reverse()\n    return parts\n\ndef make_plan(reqs, alpha, gamma=0):\n    by_S = collections.defaultdict(list)\n    for r in reqs:\n        S = align(r[\'prompt_len\'], GRAN)\n        by_S[S].append(r)\n    plan = []\n    bid = 0\n    for S in sorted(by_S.keys()):\n        group = sorted(by_S[S], key=lambda r: r[\'gen_len\'])\n        gl = [r[\'gen_len\'] for r in group]\n        parts = dp_partition(gl, S, alpha, gamma)\n        for (k, j) in parts:\n            bid += 1\n            bid_id = f"b-{bid:04d}"\n            for r in group[k:j]:\n                plan.append({\n                    \'request_id\': r[\'request_id\'],\n                    \'batch_id\': bid_id,\n                    \'shape\': {\'seq_align\': S, \'heads_align\': HEADS, \'hidden_align\': HIDDEN}\n                })\n    return plan\n\ndef choose_shapes(all_S):\n    all_S = sorted(set(all_S))\n    if len(all_S) <= MAX_SHAPES:\n        return all_S\n    n = len(all_S)\n    K = MAX_SHAPES\n    def cc(s):\n        return 500.0*s**2 + 2.0*s*4096\n    INF = float(\'inf\')\n    dp = [[INF]*(K+1) for _ in range(n)]\n    par = [[-1]*(K+1) for _ in range(n)]\n    for i in range(n):\n        dp[i][1] = cc(all_S[i])\n    for k in range(2, K+1):\n        for i in range(k-1, n):\n            for prev in range(k-2, i):\n                if dp[prev][k-1] < INF:\n                    c = dp[prev][k-1] + cc(all_S[i])\n                    if c < dp[i][k]:\n                        dp[i][k] = c\n                        par[i][k] = prev\n    shapes = []\n    i = n-1\n    k = K\n    while i >= 0 and k > 0:\n        shapes.append(all_S[i])\n        i = par[i][k]\n        k -= 1\n    shapes.reverse()\n    return shapes\n\ndef assign_shapes(plan, shapes):\n    for p in plan:\n        S = p[\'shape\'][\'seq_align\']\n        p[\'shape\'][\'seq_align\'] = min(s for s in shapes if s >= S)\n\ndef evaluate(reqs, plan, label):\n    cm = CostModel(GRAN)\n    requests = {r[\'request_id\']: r for r in reqs}\n    m = cm.plan_metrics(requests, plan)\n    nb = len(set(p[\'batch_id\'] for p in plan))\n    ns = len(set((p[\'shape\'][\'seq_align\'], p[\'shape\'][\'heads_align\'], p[\'shape\'][\'hidden_align\']) for p in plan))\n    print(f"\\n{label}:")\n    print(f"  Cost: {m[\'cost\']:.4e}")\n    print(f"  Pad Ratio: {m[\'pad_ratio\']:.6f}")\n    print(f"  P95 Latency: {m[\'p95_latency_ms\']:.4e}")\n    print(f"  Sequential Timecost: {m[\'sequential_timecost\']:.4e}")\n    print(f"  Num batches: {nb}, Num shapes: {ns}")\n    return m\n\nreqs1 = load_requests(\'/app/task_file/input_data/requests_bucket_1.jsonl\')\nreqs2 = load_requests(\'/app/task_file/input_data/requests_bucket_2.jsonl\')\n\nthresholds = {\n    \'Bucket 1\': {\'cost\': 3e11, \'pad_ratio\': 0.055, \'p95_latency_ms\': 2.1e6, \'sequential_timecost\': 2.7e8},\n    \'Bucket 2\': {\'cost\': 4.8e10, \'pad_ratio\': 0.15, \'p95_latency_ms\': 2.1e5, \'sequential_timecost\': 3.2e7},\n}\n\nall_S = set()\nfor reqs in [reqs1, reqs2]:\n    for r in reqs:\n        all_S.add(align(r[\'prompt_len\'], GRAN))\nshapes = choose_shapes(all_S)\nprint(f"Shapes: {shapes}")\n\nbest = None\nfor alpha in [0, 1, 10, 50, 100, 500, 1e3, 5e3, 1e4, 5e4, 1e5, 5e5, 1e6, 5e6, 1e7, 5e7, 1e8]:\n    plan1 = make_plan(reqs1, alpha, 0)\n    plan2 = make_plan(reqs2, alpha, 0)\n    assign_shapes(plan1, shapes)\n    assign_shapes(plan2, shapes)\n    cm = CostModel(GRAN)\n    m1 = cm.plan_metrics({r[\'request_id\']: r for r in reqs1}, plan1)\n    m2 = cm.plan_metrics({r[\'request_id\']: r for r in reqs2}, plan2)\n    ok1 = all(m1[k] < thresholds[\'Bucket 1\'][k] for k in thresholds[\'Bucket 1\'])\n    ok2 = all(m2[k] < thresholds[\'Bucket 2\'][k] for k in thresholds[\'Bucket 2\'])\n    nb1 = len(set(p[\'batch_id\'] for p in plan1))\n    nb2 = len(set(p[\'batch_id\'] for p in plan2))\n    print(f"a={alpha:.1e}: b1={nb1} c={m1[\'cost\']:.3e} p={m1[\'pad_ratio\']:.4f} p95={m1[\'p95_latency_ms\']:.3e} sq={m1[\'sequential_timecost\']:.3e} {\'OK\' if ok1 else \'X\'} | b2={nb2} c={m2[\'cost\']:.3e} p={m2[\'pad_ratio\']:.4f} p95={m2[\'p95_latency_ms\']:.3e} sq={m2[\'sequential_timecost\']:.3e} {\'OK\' if ok2 else \'X\'}")\n    if ok1 and ok2:\n        best = (alpha, 0, m1, m2, plan1, plan2)\n        break\n\nif not best:\n    print("\\nTrying with gamma...")\n    for gamma in [1, 10, 100, 1000, 1e4, 1e5]:\n        for alpha in [0, 100, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8]:\n            plan1 = make_plan(reqs1, alpha, gamma)\n            plan2 = make_plan(reqs2, alpha, gamma)\n            assign_shapes(plan1, shapes)\n            assign_shapes(plan2, shapes)\n            cm = CostModel(GRAN)\n            m1 = cm.plan_metrics({r[\'request_id\']: r for r in reqs1}, plan1)\n            m2 = cm.plan_metrics({r[\'request_id\']: r for r in reqs2}, plan2)\n            ok1 = all(m1[k] < thresholds[\'Bucket 1\'][k] for k in thresholds[\'Bucket 1\'])\n            ok2 = all(m2[k] < thresholds[\'Bucket 2\'][k] for k in thresholds[\'Bucket 2\'])\n            if ok1 and ok2:\n                nb1 = len(set(p[\'batch_id\'] for p in plan1))\n                nb2 = len(set(p[\'batch_id\'] for p in plan2))\n                print(f"g={gamma:.1e} a={alpha:.1e}: b1={nb1} b2={nb2} OK")\n                best = (alpha, gamma, m1, m2, plan1, plan2)\n                break\n        if best:\n            break\n\nif best:\n    alpha, gamma, m1, m2, plan1, plan2 = best\n    print(f"\\nBest: alpha={alpha}, gamma={gamma}")\n    evaluate(reqs1, plan1, \'Bucket 1\')\n    evaluate(reqs2, plan2, \'Bucket 2\')\n    os.makedirs(\'/app/task_file/output_data\', exist_ok=True)\n    with open(\'/app/task_file/output_data/plan_b1.jsonl\', \'w\') as f:\n        for p in plan1:\n            f.write(json.dumps(p) + \'\\n\')\n    with open(\'/app/task_file/output_data/plan_b2.jsonl\', \'w\') as f:\n        for p in plan2:\n            f.write(json.dumps(p) + \'\\n\')\n    print("\\nPlans written!")\nelse:\n    print("\\nNo solution found.")\nPY\npython3 /app/optimize2.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
