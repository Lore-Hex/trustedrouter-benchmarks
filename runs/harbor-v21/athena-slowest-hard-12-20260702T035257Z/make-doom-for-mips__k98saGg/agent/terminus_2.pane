1946:/**
1947: * Get a null-terminated string from a string table
1948: * @param {Buffer} strTab - The string table data
1949: * @param {number} offset - Offset in the string table
1950: * @returns {string} The null-terminated string
1951: */
1952:function getString(strTab, offset) {
1953:  if (offset >= strTab.length) return '';
1954:  
1955:  let end = offset;
1956:  while (end < strTab.length && strTab[end] !== 0) {
1957:    end++;
1958:  }
1959:  
1960:  return strTab.slice(offset, end).toString();
1961:}
