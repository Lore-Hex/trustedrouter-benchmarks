1679:          break;
1680:        }
1681:      }
1682:      
1683:      console.log(`Executed ${instructionCount} instructions`);
1684:      return this.registers[2]; // Return value in $v0
1685:    } catch (error) {
1686:      console.error(`Execution error at PC=0x${this.pc.toString(16)}: ${error.message}`);
1687:      return -1;
1688:    }
1689:  }
1690:}
