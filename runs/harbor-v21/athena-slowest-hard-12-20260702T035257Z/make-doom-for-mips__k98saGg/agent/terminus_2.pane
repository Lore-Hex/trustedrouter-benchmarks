1661:          this.pc = (this.pc + 4) >>> 0; // Increment PC before execution
1662:        
1663:          const result = this.runInstruction(instruction);
1664:          instructionCount++;
1665:
1666:	  if (this.pc != ((oldPc + 4) >>> 0)) {
1667:	      const newPc = this.pc;
