1648:  // Method to run a program
1649:  runProgram(startAddress) {
1650:    this.pc = startAddress >>> 0; // Force 32-bit unsigned
1651:    let instructionCount = 0;
1652:
1653:
1654:      let counter = 0;
1655:	try {  
1656:      while (1) {
1657:	  const instruction = this.memory[this.pc] || 0;
