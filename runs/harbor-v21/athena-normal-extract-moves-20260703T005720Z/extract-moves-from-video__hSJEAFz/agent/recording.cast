[947.004939, "i", "python3 - <<'PY'\nimport os, glob\nfor f in glob.glob('/app/ocr/*.txt.txt'):\n    new = f[:-4]  # remove last .txt\n    os.rename(f, new)\nprint('renamed')\nPY\n"]
[947.005282, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
