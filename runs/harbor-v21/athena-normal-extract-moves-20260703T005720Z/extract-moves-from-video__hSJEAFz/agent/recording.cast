[947.408048, "i", "python3 - <<'PY'\nimport os, re, glob\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'))\nprint(f'Total OCR files: {len(files)}')\n# Print last frame text\nprint('=== last frame ===')\nwith open(files[-1]) as f:\n    print(f.read())\nPY\n"]
[947.408513, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import os, re, glob\r\n\u001b[?2004l\r\u001b[?2004h> files = sorted(glob.glob('/app/ocr/frame_*.txt'))\r\n\u001b[?2004l\r"]
[947.408661, "o", "\u001b[?2004h> print(f'Total OCR files: {len(files)}')\r\n\u001b[?2004l\r\u001b[?2004h> # Print last frame text\r\n\u001b[?2004l\r\u001b[?2004h> print('=== last frame ===')\r\n\u001b[?2004l\r\u001b[?2004h> with open(files[-1]) as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[947.40872, "o", ">     print(f.read())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[947.488247, "o", "Total OCR files: 190\r\n=== last frame ===\r\n"]
[947.488774, "o", "There is a small mailbox here.\r\n\r\nsw\r\n\r\nStone Barrow\r\n\r\nYou are standing in front of a massive barrow of stone. In the east face is a\r\nhuge stone door which is open. You cannot see into the dark of the tomb.\r\n\r\n>w\r\n\r\nInside the Barrow\r\n\r\nAs you enter the barrow, the door closes inexorably behind you. Around you it\r\nis dark, but ahead is an enormous cavern, brightly lit. Through its center\r\nruns a wide stream. Spanning the stream is a small wooden footbridge, and\r\nbeyond a path leads into a dark tunnel. Above the bridge, floating in the air,\r\nis a large sign. It reads: All ye who stand before this bridge have completed\r\na great and perilous adventure which has tested your wit and courage. You have\r\nmastered the first part of the ZORK trilogy. Those who pass over this bridge\r\nmust be prepared to undertake an even greater adventure that will severely\r\ntest your skill and bravery!\r\n\r\nThe ZORK trilogy continues with “ZORK II: The Wizard of Frobozz\" and is\r\ncompleted in “ZORK III: The Dungeon Master.”\r\n\r\nYour score is 350 (total of 350 points), in 262 moves.\r\n\r\nThis gives you the rank of Master Adventurer.\r\n\r\nCNL\r\n\r\n"]
[947.494424, "o", "\u001b[?2004hroot@310b128eb140:/app# "]
[952.955995, "i", "python3 - <<'PY'\nimport os, re, glob\nfiles = sorted(glob.glob('/app/ocr/frame_*.txt'))\nseen = set()\nfor fp in files:\n    frame = int(re.search(r'frame_(\\d+)', fp).group(1))\n    with open(fp, errors='replace') as f:\n        text = f.read()\n    for line in text.splitlines():\n        s = line.strip()\n        # Lines that start with > followed by text (player input)\n        m = re.match(r'^>\\s*(.+)$', s)\n        if m:\n            cmd = m.group(1).strip()\n            if cmd and cmd not in seen:\n                seen.add(cmd)\n                print(f'frame {frame:03d}: {cmd}')\nprint(f'\\nTotal unique commands found: {len(seen)}')\nPY\n"]
[952.956129, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[952.956236, "o", "\u001b[?2004h"]
