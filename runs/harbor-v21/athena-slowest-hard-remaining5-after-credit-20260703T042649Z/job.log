Sending keys: ['python3 - <<\'PY\'\nimport json, re, urllib.request, time\n\n# 1. Search fpbase for em_max=610 with PDB IDs in our list\nproteins = json.load(open(\'/app/fpbase_proteins.json\'))\npdb_ids = set(open(\'/app/pdb_ids.txt\').read().split())\n\nprint("=== FPbase proteins with em_max=610 AND PDB in our list ===")\nfor p in proteins:\n    for s in p.get(\'states\',[]):\n        if s.get(\'em_max\') == 610:\n            pbs = set(str(x).upper() for x in p.get(\'pdb\',[]))\n            common = pbs & pdb_ids\n            if common:\n                print(f"  MATCH: name={p[\'name\']}, slug={p[\'slug\']}, pdb={p.get(\'pdb\')}, ex={s.get(\'ex_max\')}, em={s.get(\'em_max\')}")\n                print(f"  seq={p.get(\'seq\',\'\')}")\n                print(f"  seq_len={len(p.get(\'seq\',\'\'))}")\n\nprint("\\n=== ALL FPbase proteins with em_max=610 (first 30) ===")\ncount = 0\nfor p in proteins:\n    for s in p.get(\'states\',[]):\n        if s.get(\'em_max\') == 610:\n            print(f"  name={p[\'name\']}, slug={p[\'slug\']}, pdb={p.get(\'pdb\',[])}, ex={s.get(\'ex_max\')}, em={s.get(\'em_max\')}")\n            count += 1\n            if count >= 30:\n                break\n    if count >= 30:\n        break\n\n# 2. Check fpbase for mCherry specifically\nprint("\\n=== FPbase entries named mCherry or with pdb 2H5Q ===")\nfor p in proteins:\n    if p[\'name\'].lower() == \'mcherry\' or \'2H5Q\' in [str(x).upper() for x in p.get(\'pdb\',[])]:\n        states = [(s.get(\'ex_max\'), s.get(\'em_max\'), s.get(\'slug\')) for s in p.get(\'states\',[])]\n        print(f"  name={p[\'name\']}, slug={p[\'slug\']}, pdb={p.get(\'pdb\',[])}, states={states}")\n        print(f"  seq={p.get(\'seq\',\'\')}")\n        print(f"  seq_len={len(p.get(\'seq\',\'\'))}")\n\n# 3. Retrieve BLAST results\nrids = {\'heavy_v\':\'4EEM8H02014\', \'light_v\':\'4EEMAE00014\'}\nfor name, rid in rids.items():\n    for attempt in range(4):\n        url = f"https://blast.ncbi.nlm.nih.gov/blast/Blast.cgi?CMD=Get&RID={rid}&FORMAT_TYPE=XML&ALIGNMENTS=20"\n        try:\n            req = urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n            with urllib.request.urlopen(req, timeout=30) as r:\n                data = r.read().decode(errors=\'replace\')\n            if \'Status=WAITING\' in data or \'Status=QUEUED\' in data or \'Status=PENDING\' in data or \'Status=UNKNOWN\' in data:\n                print(f"\\n{name}: RID={rid} still waiting (attempt {attempt+1})")\n                time.sleep(8)\n                continue\n            # Parse XML for hit descriptions\n            hits = re.findall(r\'<Hit_def>(.*?)</Hit_def>\', data, re.DOTALL)\n            hit_ids = re.findall(r\'<Hit_id>(.*?)</Hit_id>\', data, re.DOTALL)\n            accessions = re.findall(r\'<Hit_accession>(.*?)</Hit_accession>\', data, re.DOTALL)\n            print(f"\\n=== {name} BLAST hits ===")\n            for i, (hid, hdef, acc) in enumerate(zip(hit_ids, hits, accessions)):\n                hdef_clean = re.sub(r\'<[^>]+>\', \'\', hdef)\n                print(f"  {i+1}. {acc}: {hdef_clean[:150]}")\n                if i >= 15:\n                    break\n            break\n        except Exception as e:\n            print(f"\\n{name}: ERROR {e}")\n            time.sleep(5)\n\n# 4. Compare fpbase vs PDB sequences for Clover and mCherry\nprint("\\n=== Sequence comparison ===")\npdb_fastas = {}\ntext = open(\'/app/pdb_fastas.txt\').read()\nfor m in re.finditer(r\'>(\\S+)_\\d+\\|([^\\n]*)\\n([A-Z\\n]+)\', text):\n    pid = m.group(1)\n    desc = m.group(2)\n    seq = m.group(3).replace(\'\\n\',\'\')\n    if pid not in pdb_fastas:\n        pdb_fastas[pid] = []\n    pdb_fastas[pid].append((desc, seq))\n\nfor pid in [\'5WJ2\', \'2H5Q\', \'3KZY\']:\n    print(f"\\nPDB {pid}:")\n    for desc, seq in pdb_fastas.get(pid, []):\n        print(f"  desc: {desc}")\n        print(f"  seq: {seq}")\n        print(f"  len: {len(seq)}")\n\n# fpbase sequences\nfor pname in [\'Clover\', \'mCherry\']:\n    for p in proteins:\n        if p[\'name\'] == pname:\n            print(f"\\nfpbase {pname}:")\n            print(f"  seq: {p.get(\'seq\',\'\')}")\n            print(f"  len: {len(p.get(\'seq\',\'\'))}")\n            break\nPY\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
