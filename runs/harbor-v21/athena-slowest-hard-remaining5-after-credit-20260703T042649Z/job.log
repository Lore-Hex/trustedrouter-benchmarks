Sending keys: ['python3 - <<\'PY\'\nimport urllib.request, urllib.parse, json, time\n\n# BLAST the antibody heavy chain variable region via NCBI URL API\nheavy = "QVQLQQSAAELARPGASVKMSCKASGYSFTTYTIHWVKQRPGQGLEWIGYINPSSGYAAYNQNFKDETTLTADPSSSTAYMELNSLTSEDSAVYYCAREKFYGYDYWGQGATLTVSS"\nlight = "DVLMTQIPLSLPVSLGDQASISCRSSQSIVHRNGNTYLEWYLLKPGQSPKLLIYKVSNRFSGVPDRFSGSGSGTDFTLKISRVEAEDLGVYYCFQGSHVPYTFGGGTKLEIR"\n\nfor name, seq in [(\'heavy_v\', heavy), (\'light_v\', light)]:\n    params = urllib.parse.urlencode({\n        \'CMD\': \'Put\',\n        \'PROGRAM\': \'blastp\',\n        \'DATABASE\': \'nr\',\n        \'QUERY\': seq,\n        \'HITLIST_SIZE\': \'10\',\n        \'EXPECT\': \'0.001\',\n    })\n    url = \'https://blast.ncbi.nlm.nih.gov/blast/Blast.cgi?\' + params\n    try:\n        req = urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n        with urllib.request.urlopen(req, timeout=30) as r:\n            html = r.read().decode(errors=\'replace\')\n        # Extract RID\n        import re\n        m = re.search(r\'RID = (\\S+)\', html)\n        if m:\n            print(f"{name}: RID={m.group(1)}")\n        else:\n            print(f"{name}: no RID found, html snippet:")\n            print(html[:500])\n    except Exception as e:\n        print(f"{name}: ERROR {e}")\n    time.sleep(1)\nPY\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
