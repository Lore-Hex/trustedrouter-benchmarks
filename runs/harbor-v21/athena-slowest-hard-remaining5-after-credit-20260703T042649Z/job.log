Sending keys: ['python3 - <<\'PY\'\nimport urllib.request, json, re, time\n\n# Load fpbase proteins\nheaders = {\'User-Agent\':\'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\',\'Accept\':\'application/json\'}\nreq = urllib.request.Request("https://www.fpbase.org/api/proteins/", headers=headers)\nwith urllib.request.urlopen(req, timeout=30) as r:\n    proteins = json.load(r)\n\npdb_ids = set(open(\'/app/pdb_ids.txt\').read().split())\n\nprint("=== FPbase proteins with ex_max=505 ===")\nfor p in proteins:\n    for s in p.get(\'states\',[]):\n        if s.get(\'ex_max\') == 505:\n            print(f"name={p[\'name\']}, slug={p[\'slug\']}, uuid={p[\'uuid\']}, pdb={p.get(\'pdb\',[])}, ex={s.get(\'ex_max\')}, em={s.get(\'em_max\')}")\n            print(f"  seq={p.get(\'seq\',\'\')[:80]}...")\n\nprint("\\n=== FPbase proteins with em_max=610 ===")\nfor p in proteins:\n    for s in p.get(\'states\',[]):\n        if s.get(\'em_max\') == 610:\n            print(f"name={p[\'name\']}, slug={p[\'slug\']}, uuid={p[\'uuid\']}, pdb={p.get(\'pdb\',[])}, ex={s.get(\'ex_max\')}, em={s.get(\'em_max\')}")\n            print(f"  seq={p.get(\'seq\',\'\')[:80]}...")\n\nprint("\\n=== FPbase proteins referencing our PDB IDs ===")\nfor p in proteins:\n    pbs = p.get(\'pdb\',[])\n    if pbs:\n        common = set(str(x).upper() for x in pbs) & pdb_ids\n        if common:\n            states = [(s.get(\'ex_max\'),s.get(\'em_max\')) for s in p.get(\'states\',[])]\n            print(f"name={p[\'name\']}, slug={p[\'slug\']}, pdb={pbs}, states={states}")\n            print(f"  seq={p.get(\'seq\',\'\')[:100]}...")\n\n# Save fpbase data for later use\nwith open(\'/app/fpbase_proteins.json\',\'w\') as f:\n    json.dump(proteins, f)\nprint("\\nSaved /app/fpbase_proteins.json")\nPY\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
Sending keys: ['python3 - <<\'PY\'\nimport urllib.request, re, time\n\nrids = {\'heavy_v\':\'4EEM8H02014\', \'light_v\':\'4EEMAE00014\'}\nfor name, rid in rids.items():\n    for attempt in range(3):\n        url = f"https://blast.ncbi.nlm.nih.gov/blast/Blast.cgi?CMD=Get&RID={rid}&FORMAT_TYPE=Text&ALIGNMENTS=10"\n        try:\n            req = urllib.request.Request(url, headers={\'User-Agent\':\'Mozilla/5.0\'})\n            with urllib.request.urlopen(req, timeout=30) as r:\n                html = r.read().decode(errors=\'replace\')\n            if \'Status=WAITING\' in html or \'Status=QUEUED\' in html or \'Status=PENDING\' in html:\n                print(f"{name}: RID={rid} still waiting")\n                time.sleep(5)\n                continue\n            # Print text result or relevant snippet\n            # Remove HTML tags for readability\n            text = re.sub(r\'<[^>]+>\', \'\', html)\n            text = re.sub(r\'\\n\\s*\\n+\', \'\\n\', text)\n            print(f"\\n=== {name} BLAST result ===")\n            # Print portion around hits\n            idx = text.find(\'Sequences producing\')\n            if idx >= 0:\n                print(text[idx:idx+3000])\n            else:\n                print(text[:3000])\n            break\n        except Exception as e:\n            print(f"{name}: ERROR {e}")\n            time.sleep(3)\nPY\n'] min_timeout_sec: 20.0 max_timeout_sec: 180.0
