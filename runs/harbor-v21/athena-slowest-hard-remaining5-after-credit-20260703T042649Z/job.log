p,plan)\n    print(' group exact S only',len(groups),'batches')\n    for k in ['cost','pad_ratio','p95_latency_ms','sequential_timecost']:\n        print(' ',k,m[k])\n    print()\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
