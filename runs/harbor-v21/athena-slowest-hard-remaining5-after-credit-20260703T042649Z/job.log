(his_tag):].replace(\'X\', \'GYG\')\nif clover_pdb_clean == clover_fp:\n    print("Clover: fpbase matches PDB (after tag removal and X->GYG) ✓")\nelse:\n    print("Clover MISMATCH!")\n    print(f"  PDB cleaned len={len(clover_pdb_clean)}, fpbase len={len(clover_fp)}")\n    for i, (a, b) in enumerate(zip(clover_pdb_clean, clover_fp)):\n        if a != b:\n            print(f"  First diff at pos {i}: PDB={a}, fpbase={b}")\n            break\n\n# mCherry: replace X with MYG\nmcherry_pdb = pdb_seqs[\'2H5Q\']\nmcherry_pdb_clean = mcherry_pdb.replace(\'X\', \'MYG\')\nif mcherry_pdb_clean == mcherry_fp:\n    print("mCherry: fpbase matches PDB (after X->MYG) ✓")\nelse:\n    print("mCherry MISMATCH!")\n    print(f"  PDB cleaned len={len(mcherry_pdb_clean)}, fpbase len={len(mcherry_fp)}")\n    for i, (a, b) in enumerate(zip(mcherry_pdb_clean, mcherry_fp)):\n        if a != b:\n            print(f"  First diff at pos {i}: PDB={a}, fpbase={b}")\n            break\n\n# Verify PDB IDs are in the list\npdb_ids = set(open(\'/app/pdb_ids.txt\').read().split())\nfor pid in [\'5WJ2\', \'2H5Q\', \'3KZY\']:\n    assert pid in pdb_ids, f"{pid} not in pdb_ids.txt"\nprint("All PDB IDs found in pdb_ids.txt ✓")\n\n# === Remove N-terminal M ===\ndef remove_m(seq):\n    return seq[1:] if seq.startswith(\'M\') else seq\n\nflag_clean = remove_m(flag)\nclover_clean = remove_m(clover_fp)\ndhfr_clean = remove_m(dhfr)\nmcherry_clean = remove_m(mcherry_fp)\nsnaptag_clean = remove_m(snaptag)\n\nprint(f"\\n=== Component Lengths (after M removal) ===")\nprint(f"  FLAG (antibody binder): {len(flag_clean)} aa")\nprint(f"  Clover (donor): {len(clover_clean)} aa")\nprint(f"  DHFR: {len(dhfr_clean)} aa")\nprint(f"  mCherry (acceptor): {len(mcherry_clean)} aa")\nprint(f"  SNAP-tag (molecule binder): {len(snaptag_clean)} aa")\n\n# === Assemble fusion protein ===\n# Order: antibody binder - donor - dhfr - acceptor - molecule binder\nlinker = "GSGSGSGSGS"  # 10 aa, between 5 and 20\nfusion = (flag_clean + linker + clover_clean + linker +\n          dhfr_clean + linker + mcherry_clean + linker + snaptag_clean)\n\nprint(f"\\n=== Fusion Protein ===")\nprint(f"  Total length: {len(fusion)} aa ({len(fusion)*3} nt)")\nprint(f"  Linker: {linker} ({len(linker)} aa)")\n\n# === Back-translate with GC optimization ===\ncodon_table = {\n    \'A\': [\'GCT\', \'GCC\', \'GCA\', \'GCG\'],\n    \'R\': [\'CGT\', \'CGC\', \'CGA\', \'CGG\', \'AGA\', \'AGG\'],\n    \'N\': [\'AAT\', \'AAC\'],\n    \'D\': [\'GAT\', \'GAC\'],\n    \'C\': [\'TGT\', \'TGC\'],\n    \'E\': [\'GAA\', \'GAG\'],\n    \'Q\': [\'CAA\', \'CAG\'],\n    \'G\': [\'GGT\', \'GGC\', \'GGA\', \'GGG\'],\n    \'H\': [\'CAT\', \'CAC\'],\n    \'I\': [\'ATT\', \'ATC\', \'ATA\'],\n    \'L\': [\'TTA\', \'TTG\', \'CTT\', \'CTC\', \'CTA\', \'CTG\'],\n    \'K\': [\'AAA\', \'AAG\'],\n    \'M\': [\'ATG\'],\n    \'F\': [\'TTT\', \'TTC\'],\n    \'P\': [\'CCT\', \'CCC\', \'CCA\', \'CCG\'],\n    \'S\': [\'TCT\', \'TCC\', \'TCA\', \'TCG\', \'AGT\', \'AGC\'],\n    \'T\': [\'ACT\', \'ACC\', \'ACA\', \'ACG\'],\n    \'W\': [\'TGG\'],\n    \'Y\': [\'TAT\', \'TAC\'],\n    \'V\': [\'GTT\', \'GTC\', \'GTA\', \'GTG\'],\n}\n\ndef gc_count(s):\n    return sum(1 for c in s if c in \'GC\')\n\ndef back_translate(protein):\n    dna = []\n    for aa in protein:\n        codons = codon_table[aa]\n        if len(codons) == 1:\n            dna.append(codons[0])\n            continue\n        \n        current = \'\'.join(dna)\n        best_codon = None\n        best_score = float(\'inf\')\n        best_gc_dist = float(\'inf\')\n        \n        for codon in codons:\n            test = current + codon\n            max_dev = 0\n            # Check all 50 nt windows that include the new codon\n            for start in range(max(0, len(test) - 50), max(0, len(test) - 49) + 1):\n                end = start + 50\n                if end > len(test):\n                    end = len(test)\n                window = test[start:end]\n                if len(window) >= 50:\n                    gc = gc_count(window)\n                    dev = max(0, 15 - gc, gc - 35)\n                    max_dev = max(max_dev, dev)\n            \n            # Also check partial windows at the beginning\n            if len(test) < 50:\n                gc = gc_count(test)\n                est_gc = gc * 50 / len(test)\n                dev = max(0, 15 - est_gc, est_gc - 35)\n                max_dev = max(max_dev, dev)\n            \n            gc_dist = abs(gc_count(codon) - 1.5)\n            \n            if max_dev < best_score or (max_dev == best_score and gc_dist < best_gc_dist):\n                best_score = max_dev\n                best_codon = codon\n                best_gc_dist = gc_dist\n        \n        if best_codon is None:\n            best_codon = codons[0]\n        dna.append(best_codon)\n    return \'\'.join(dna)\n\ndef fix_gc_violations(dna, protein, max_iter=500):\n    for iteration in range(max_iter):\n        violations = []\n        for i in range(len(dna) - 49):\n            window = dna[i:i+50]\n            gc = gc_count(window)\n            if gc < 15 or gc > 35:\n                violations.append((i, gc))\n        \n        if not violations:\n            print(f"  GC violations fixed after {iteration} iterations")\n            return dna\n        \n        # Find the worst violation\n        worst_pos, worst_gc = max(violations, key=lambda x: abs(x[1] - 25))\n        \n        # Find codons in the worst window that can be adjusted\n        codon_start = (worst_pos // 3) * 3\n        codon_end = min(((worst_pos + 50 - 1) // 3 + 1) * 3, len(dna))\n        \n        fixed = False\n        # Try each codon position in the window\n        for cpos in range(codon_start, codon_end, 3):\n            codon_idx = cpos // 3\n            aa = protein[codon_idx]\n            codons = codon_table[aa]\n            if len(codons) <= 1:\n                continue\n            \n            # Try all alternative codons and pick the one that minimizes max deviation\n            best_codon = dna[cpos:cpos+3]\n            best_max_dev = float(\'inf\')\n            for c in codons:\n                test_dna = dna[:cpos] + c + dna[cpos+3:]\n                max_dev = 0\n                for start in range(max(0, cpos - 49), min(len(test_dna) - 49, cpos + 3)):\n                    window = test_dna[start:start+50]\n                    if len(window) == 50:\n                        gc = gc_count(window)\n                        dev = max(0, 15 - gc, gc - 35)\n                        max_dev = max(max_dev, dev)\n                if max_dev < best_max_dev:\n                    best_max_dev = max_dev\n                    best_codon = c\n            \n            if best_codon != dna[cpos:cpos+3]:\n                dna = dna[:cpos] + best_codon + dna[cpos+3:]\n                fixed = True\n                break\n        \n        if not fixed:\n            # Try broader search\n            for cpos in range(codon_start, codon_end, 3):\n                codon_idx = cpos // 3\n                aa = protein[codon_idx]\n                codons = codon_table[aa]\n                if len(codons) <= 1:\n                    continue\n                current_codon = dna[cpos:cpos+3]\n                current_gc = gc_count(current_codon)\n                if worst_gc < 15:\n                    candidates = [(c, gc_count(c)) for c in codons if gc_count(c) > current_gc]\n                    if candidates:\n                        new_codon = max(candidates, key=lambda x: x[1])[0]\n                        dna = dna[:cpos] + new_codon + dna[cpos+3:]\n                        fixed = True\n                        break\n                elif worst_gc > 35:\n                    candidates = [(c, gc_count(c)) for c in codons if gc_count(c) < current_gc]\n                    if candidates:\n                        new_codon = min(candidates, key=lambda x: x[1])[0]\n                        dna = dna[:cpos] + new_codon + dna[cpos+3:]\n                        fixed = True\n                        break\n        \n        if not fixed:\n            print(f"  Could not fix violation at pos {worst_pos} (GC={worst_gc})")\n            break\n    \n    return dna\n\nprint("\\n=== Back-translation ===")\ndna = back_translate(fusion)\nprint(f"  Initial DNA length: {len(dna)} nt")\n\n# Check initial GC violations\ninit_violations = 0\nfor i in range(len(dna) - 49):\n    gc = gc_count(dna[i:i+50])\n    if gc < 15 or gc > 35:\n        init_violations += 1\nprint(f"  Initial GC violations: {init_violations}")\n\n# Fix GC violations\ndna = fix_gc_violations(dna, fusion)\n\n# === Validate ===\nprint("\\n=== Validation ===")\n\n# 1. Length\nprint(f"1. DNA length: {len(dna)} nt (max 3000)")\nassert len(dna) <= 3000, "DNA too long"\nprint("   PASS")\n\n# 2. Translation\naa_map = {}\nfor aa, codons in codon_table.items():\n    for c in codons:\n        aa_map[c] = aa\ntranslated = \'\'.join(aa_map[dna[i:i+3]] for i in range(0, len(dna), 3))\nprint(f"2. Translation matches fusion: {translated == fusion}")\nassert translated == fusion, "Translation mismatch"\nprint("   PASS")\n\n# 3. GC content in all 50 nt windows\ngc_violations = []\nfor i in range(len(dna) - 49):\n    window = dna[i:i+50]\n    gc = gc_count(window)\n    gc_pct = gc / 50 * 100\n    if gc_pct < 30 or gc_pct > 70:\n        gc_violations.append((i, gc, gc_pct))\nif gc_violations:\n    print(f"3. GC content: {len(gc_violations)} violations")\n    for pos, gc, pct in gc_violations[:10]:\n        print(f"   Position {pos}: GC={gc}/50 ({pct:.1f}%)")\nelse:\n    print("3. GC content: All 50 nt windows within 30-70%")\nprint("   PASS" if not gc_violations else "   FAIL")\n\n# 4. No start/stop codons at boundaries\nprint(f"4. Starts with ATG: {dna.startswith(\'ATG\')}")\nprint(f"   Ends with stop: {dna[-3:] in {\'TAA\', \'TAG\', \'TGA\'}}")\nassert not dna.startswith(\'ATG\'), "Starts with ATG"\nassert dna[-3:] not in {\'TAA\', \'TAG\', \'TGA\'}, "Ends with stop codon"\nprint("   PASS")\n\n# 5. No internal stop codons\ninternal_stops = []\nfor i in range(0, len(dna), 3):\n    if dna[i:i+3] in {\'TAA\', \'TAG\', \'TGA\'}:\n        internal_stops.append(i)\nprint(f"5. Internal stop codons: {len(internal_stops)}")\nassert len(internal_stops) == 0, "Internal stop codons found"\nprint("   PASS")\n\n# 6. Protein order\nexpected = (flag_clean + linker + clover_clean + linker +\n            dhfr_clean + linker + mcherry_clean + linker + snaptag_clean)\nassert fusion == expected, "Protein order mismatch"\nprint("6. Protein order: antibody_binder - donor - dhfr - acceptor - molecule_binder")\nprint("   PASS")\n\n# 7. GS linkers\nprint(f"7. Linker: \'{linker}\' ({len(linker)} aa, must be 5-20)")\nassert 5 <= len(linker) <= 20, "Linker length out of range"\nassert not fusion.startswith(\'GSGS\'), "N-terminal GS linker"\nassert not fusion.endswith(\'GSGS\'), "C-terminal GS linker"\nprint("   PASS")\n\n# 8. Donor and acceptor separated by DHFR and GS linkers only\ndonor_end = len(flag_clean) + len(linker) + len(clover_clean)\nbetween = linker + dhfr_clean + linker\nacceptor_start = donor_end + len(between)\nassert fusion[donor_end:acceptor_start] == between, "Donor-acceptor separation mismatch"\nprint("8. Donor and acceptor separated by DHFR and GS linkers only")\nprint("   PASS")\n\n# 9. Spectral properties\nprint(f"9. Spectral: Donor ex={clover_states[0][0]} (filter=505), Acceptor em={mcherry_states[0][1]} (filter=610)")\nassert clover_states[0][0] == 505, "Donor ex mismatch"\nassert mcherry_states[0][1] == 610, "Acceptor em mismatch"\nprint("   PASS")\n\n# === Write to file ===\nwith open(\'/app/gblock.txt\', \'w\') as f:\n    f.write(dna)\n\nprint(f"\\n=== gBlock written to /app/gblock.txt ===")\nprint(f"Length: {len(dna)} nt")\nprint(f"Protein length: {len(fusion)} aa")\nprint(f"Overall GC content: {gc_count(dna)/len(dna)*100:.1f}%")\nPY\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
