[?2004limport inspect

import torch
import torch.distributed as dist
import torch.nn.functional as F


def _model_parts(model):
    """Return (base, layers, norm, embed_tokens, lm_head, config)."""
    base = getattr(model, "model", model)
    layers = getattr(base, "layers", None)
    if layers is None:
        raise ValueError("Expected a LLaMA-like model with .model.layers or .layers")

    norm = getattr(base, "norm", None)
    embed_tokens = getattr(base, "embed_tokens", None) or getattr(model, "embed_tokens", None)
    lm_head = getattr(model, "lm_head", None) or getattr(base, "lm_head", None)
    config = getattr(model, "config", getattr(base, "config", None))
    return base, layers, norm, embed_tokens, lm_head, config


def _partition(num_layers, rank, world_size):
    """Roughly balanced partition; remainder layers go to earlier ranks."""
    q, r = divmod(num_layers, world_size)
    start = rank * q + min(rank, r)
    end = start + q + (1 if rank < r else 0)
    return start, end


def _hidden_size(config, embed_tokens, layers):
    if config is not None and getattr(config, "hidden_size", None) is not None:
        return int(config.hidden_size)
    if embed_tokens is not None:
        return int(embed_tokens.weight.shape[-1])
    if len(layers) > 0:
        q_proj = getattr(getattr(layers[0], "self_attn", None), "q_proj", None)
        if q_proj is not None:
            return int(q_proj.weight.shape[1])
        gate_proj = getattr(getattr(layers[0], "mlp", None), "gate_proj", None)
        if gate_proj is not None:
            return int(gate_proj.weight.shape[1])
    raise ValueError("Could not determine hidden_size")


def _position_ids(seq_len, batch_size, device):
    return torch.arange(seq_len, device=device, dtype=torch.long).unsqueeze(0).expand(batch_size, -1)


def _cache_position(seq_len, device):
    return torch.arange(seq_len, device=device, dtype=torch.long)


def _causal_mask(batch_size, seq_len, dtype, device):
    mask_dtype = dtype if dtype.is_floating_point else torch.float32
    min_val = torch.finfo(mask_dtype).min
    mask = torch.full((seq_len, seq_len), min_val, device=device, dtype=mask_dtype)
    mask = torch.triu(mask, diagonal=1)
    return mask.unsqueeze(0).unsqueeze(0).expand(batch_size, 1, seq_len, seq_len).contiguous()


def _get_rotary_emb(base, layers):
    rotary = getattr(base, "rotary_emb", None)
    if rotary is None and len(layers) > 0:
        rotary = getattr(getattr(layers[0], "self_attn", None), "rotary_emb", None)
    return rotary


def _compute_position_embeddings(rotary_emb, hidden, position_ids, cache_position):
    if rotary_emb is None:
        return None
    forward = getattr(rotary_emb, "forward", rotary_emb)
    try:
        params = inspect.signature(forward).parameters
    except (ValueError, TypeError):
        params = {}
    if "position_ids" in params:
        return rotary_emb(hidden, position_ids)
    if "cache_position" in params:
        return rotary_emb(hidden, cache_position)
    return rotary_emb(hidden, cache_position)


def _call_layer(layer, hidden, position_ids, cache_position, attention_mask, position_embeddings):
    sig = inspect.signature(layer.forward)
    kw = {}
    if "attention_mask" in sig.parameters:
        kw["attention_mask"] = attention_mask
    if "position_ids" in sig.parameters:
        kw["position_ids"] = position_ids
    if "past_key_value" in sig.parameters:
        kw["past_key_value"] = None
    if "use_cache" in sig.parameters:
        kw["use_cache"] = False
    if "output_attentions" in sig.parameters:
        kw["output_attentions"] = False
    if "output_router_logits" in sig.parameters:
        kw["output_router_logits"] = False
    if "cache_position" in sig.parameters:
        kw["cache_position"] = cache_position
    if "position_embeddings" in sig.parameters and position_embeddings is not None:
        kw["position_embeddings"] = position_embeddings

    out = layer(hidden, **kw)
    return out[0] if isinstance(out, (tuple, list)) else out


def _run_layer_range(layers, start, end, hidden, position_ids, cache_position, attention_mask, position_embeddings):
    for i in range(start, end):
        hidden = _call_layer(layers[i], hidden, position_ids, cache_position, attention_mask, position_embeddings)
    return hidden


def _send_tensor(tensor, peer):
    if tensor is None:
        return
    send_tensor = tensor.contiguous()
    reqs = dist.batch_isend_irecv([dist.P2POp(dist.isend, send_tensor, peer)])
    for req in reqs:
        req.wait()


def _recv_tensor(shape, dtype, device, peer, requires_grad=False):
    buf = torch.empty(shape, dtype=dtype, device=device)
    reqs = dist.batch_isend_irecv([dist.P2POp(dist.irecv, buf, peer)])
    for req in reqs:
        req.wait()
    if requires_grad:
        buf.requires_grad_(True)
    return buf


def _grad_or_zeros(tensor, device, dtype):
    grad = tensor.grad
    if grad is None:
        grad = torch.zeros_like(tensor)
    return grad.to(device=device, dtype=dtype).contiguous()


def _compute_loss(norm, lm_head, hidden, target, num_microbatches):
    features = hidden
    if norm is not None:
        features = norm(features)
    logits = lm_head(features)

    # Standard causal LM shift: position t predicts t+1.
    shift_logits = logits[..., :-1, :].contiguous()
    shift_target = target[..., 1:].contiguous()
    loss = F.cross_entropy(
        shift_logits.view(-1, shift_logits.size(-1)),
        shift_target.view(-1).to(shift_logits.device),
        ignore_index=-100,
        reduction="mean",
    )
    return loss / num_microbatches


def train_step_pipeline_afab(model, inputs, targets, device, dtype):
    """Run one all-forward-all-backward pipeline-parallel training step.

    Args:
        model: LlamaForCausalLM instance.
        inputs: list of input ID microbatch tensors.
        targets: list of target ID microbatch tensors.
        device: torch device.
        dtype: torch dtype.
    """
    assert dist.is_available() and dist.is_initialized(), "torch.distributed must be initialized"
    rank = dist.get_rank()
    world_size = dist.get_world_size()
    device = torch.device(device)

    num_microbatches = len(inputs)
    if num_microbatches == 0:
        return None

    base, layers, norm, embed_tokens, lm_head, config = _model_parts(model)
    num_layers = len(layers)
    start, end = _partition(num_layers, rank, world_size)

    is_first = rank == 0
    is_last = rank == world_size - 1
    hidden_size = _hidden_size(config, embed_tokens, layers)

    local_inputs = [t.to(device=device, dtype=torch.long) for t in inputs] if is_first else None
    local_targets = [t.to(device=device, dtype=torch.long) for t in targets] if is_last else None

    stage_inputs = []   # incoming leaf hidden / embedding output
    stage_outputs = []  # stage output (hidden) or loss (last rank)

    # ---- Forward all microbatches ----
    for mb in range(num_microbatches):
        if is_first:
            ids = local_inputs[mb]
            batch_size, seq_len = int(ids.shape[0]), int(ids.shape[1])
            hidden = embed_tokens(ids).to(device=device, dtype=dtype)
            stage_inputs.append(hidden)
        else:
            if inputs is not None and len(inputs) > mb and inputs[mb] is not None:
                batch_size, seq_len = int(inputs[mb].shape[0]), int(inputs[mb].shape[1])
            elif len(stage_inputs) > 0:
                batch_size, seq_len = int(stage_inputs[-1].shape[0]), int(stage_inputs[-1].shape[1])
            else:
                batch_size, seq_len = 1, 1
            shape = (batch_size, seq_len, hidden_size)
            hidden = _recv_tensor(shape, dtype, device, rank - 1, requires_grad=True)
            stage_inputs.append(hidden)
            batch_size, seq_len = int(hidden.shape[0]), int(hidden.shape[1])

        position_ids = _position_ids(seq_len, batch_size, device)
        cache_position = _cache_position(seq_len, device)
        attention_mask = _causal_mask(batch_size, seq_len, dtype, device)
        rotary_emb = _get_rotary_emb(base, layers)
        position_embeddings = _compute_position_embeddings(rotary_emb, hidden, position_ids, cache_position)

        hidden = _run_layer_range(
            layers, start, end, hidden, position_ids, cache_position, attention_mask, position_embeddings
        )

        if is_last:
            loss = _compute_loss(norm, lm_head, hidden, local_targets[mb], num_microbatches)
            stage_outputs.append(loss)
        else:
            hidden = hidden.contiguous()
            stage_outputs.append(hidden)
            _send_tensor(hidden.detach().to(device=device, dtype=dtype), rank + 1)

    # ---- Backward all microbatches ----
    for mb in range(num_microbatches):
        if is_last:
            loss = stage_outputs[mb]
            loss.backward()
            if not is_first:
                _send_tensor(_grad_or_zeros(stage_inputs[mb], device, dtype), rank - 1)
        else:
            grad = _recv_tensor(stage_outputs[mb].shape, dtype, device, rank + 1)
            stage_outputs[mb].backward(grad)
            if not is_first:
                _send_tensor(_grad_or_zeros(stage_inputs[mb], device, dtype), rank - 1)

    return None
