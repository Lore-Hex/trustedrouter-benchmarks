[?2004ldef _compute_position_embeddings(rotary_emb, hidden, position_ids, cache_position):
    if rotary_emb is None:
        return None
    forward = getattr(rotary_emb, "forward", rotary_emb)
    try:
        params = inspect.signature(forward).parameters
    except (ValueError, TypeError):
        params = {}
    if "position_ids" in params:
        return rotary_emb(hidden, position_ids=position_ids)
