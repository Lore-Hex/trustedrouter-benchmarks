    logits = lm_head(features)

    loss = F.cross_entropy(
        logits.reshape(-1, logits.size(-1)),
        target.reshape(-1).to(logits.device),
        ignore_index=-100,
        reduction="mean",
    )
    return loss / num_microbatches


def train_step_pipeline_afab(model, inputs, targets, device, dtype):
    """Run one all-forward-all-backward pipeline-parallel training step.

    Args:
        model: LlamaForCausalLM instance.
        inputs: list of input ID microbatch tensors.
        targets: list of target ID microbatch tensors.
        device: torch device.
        dtype: torch dtype.
    """
    assert dist.is_available() and dist.is_initialized(), "torch.distributed must be initialized"
    rank = dist.get_rank()
    world_size = dist.get_world_size()
    device = torch.device(device)

    num_microbatches = len(inputs)
    if num_microbatches == 0:
        return None

    base, layers, norm, embed_tokens, lm_head, config = _model_parts(model)
    num_layers = len(layers)
    start, end = _partition(num_layers, rank, world_size)

    is_first = rank == 0
    is_last = rank == world_size - 1
    hidden_size = _hidden_size(config, embed_tokens, layers)

    local_inputs = [t.to(device=device, dtype=torch.long) for t in inputs] if is_first else None
    local_targets = [t.to(device=device, dtype=torch.long) for t in targets] if is_last else None

    stage_inputs = []   # incoming leaf hidden / embedding output
    stage_outputs = []  # stage output (hidden) or loss (last rank)

    # ---- Forward all microbatches ----
    for mb in range(num_microbatches):
        if is_first:
            ids = local_inputs[mb]
            batch_size, seq_len = int(ids.shape[0]), int(ids.shape[1])
            hidden = embed_tokens(ids).to(device=device, dtype=dtype)
            stage_inputs.append(hidden)
        else:
            if inputs is not None and len(inputs) > mb and inputs[mb] is not None:
                batch_size, seq_len = int(inputs[mb].shape[0]), int(inputs[mb].shape[1])
            elif len(stage_inputs) > 0:
                batch_size, seq_len = int(stage_inputs[-1].shape[0]), int(stage_inputs[-1].shape[1])
            else:
                batch_size, seq_len = 1, 1
            shape = (batch_size, seq_len, hidden_size)
            hidden = _recv_tensor(shape, dtype, device, rank - 1, requires_grad=True)
            stage_inputs.append(hidden)
            batch_size, seq_len = int(hidden.shape[0]), int(hidden.shape[1])

        position_ids = _position_ids(seq_len, batch_size, device)
        cache_position = _cache_position(seq_len, device)
        attention_mask = _causal_mask(batch_size, seq_len, dtype, device)
        if _needs_position_embeddings(layers, start, end):
            rotary_emb = _get_rotary_emb(base, layers)
            position_embeddings = _compute_position_embeddings(rotary_emb, hidden, position_ids, cache_position)
        else:
            position_embeddings = None

        hidden = _run_layer_range(
            layers, start, end, hidden, position_ids, cache_position, attention_mask, position_embeddings
        )

        if is_last:
            loss = _compute_loss(norm, lm_head, hidden, local_targets[mb], num_microbatches)
            stage_outputs.append(loss)
        else:
            hidden = hidden.contiguous()
            stage_outputs.append(hidden)
            _send_tensor(hidden.detach().to(device=device, dtype=dtype), rank + 1)

    # ---- Backward all microbatches ----
    for mb in range(num_microbatches):
        if is_last:
            loss = stage_outputs[mb]
            loss.backward()
            if not is_first:
                _send_tensor(_grad_or_zeros(stage_inputs[mb], device, dtype), rank - 1)
        else:
            grad = _recv_tensor(stage_outputs[mb].shape, dtype, device, rank + 1)
            stage_outputs[mb].backward(grad)
            if not is_first:
                _send_tensor(_grad_or_zeros(stage_inputs[mb], device, dtype), rank - 1)

    return None
