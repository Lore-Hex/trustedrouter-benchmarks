[?2004l[?2004h>         if s.get('ex_max') == 505:
[?2004l[?2004h>             print(f"name={p['name']}, slug={p['slug']}, uuid={p['uuid']}, pdb={p.get('pdb',[])}, ex={s.get('ex_max')}, em={s.get('em_max')}")
[?2004l[?2004h>             print(f"  seq={p.get('seq','')[:80]}...")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== FPbase proteins with em_max=610 ===")
[?2004l[?2004h> for p in proteins:
[?2004l[?2004h>     for s in p.get('states',[]):
[?2004l[?2004h>         if s.get('em_max') == 610:
[?2004l[?2004h>             print(f"name={p['name']}, slug={p['slug']}, uuid={p['uuid']}, pdb={p.get('pdb',[])}, ex={s.get('ex_max')}, em={s.get('em_max')}")
[?2004l[?2004h>             print(f"  seq={p.get('seq','')[:80]}...")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== FPbase proteins referencing our PDB IDs ===")
[?2004l[?2004h> for p in proteins:
[?2004l[?2004h>     pbs = p.get('pdb',[])
[?2004l[?2004h>     if pbs:
[?2004l[?2004h>         common = set(str(x).upper() for x in pbs) & pdb_ids
[?2004l[?2004h>         if common:
[?2004l[?2004h>             states = [(s.get('ex_max'),s.get('em_max')) for s in p.get('states',[])]
[?2004l[?2004h>             print(f"name={p['name']}, slug={p['slug']}, pdb={pbs}, states={states}")
[?2004l[?2004h>             print(f"  seq={p.get('seq','')[:100]}...")
[?2004l[?2004h> 
[?2004l[?2004h> # Save fpbase data for later use
[?2004l[?2004h> with open('/app/fpbase_proteins.json','w') as f:
[?2004l[?2004h>     json.dump(proteins, f)
[?2004l[?2004h> print("\nSaved /app/fpbase_proteins.json")
