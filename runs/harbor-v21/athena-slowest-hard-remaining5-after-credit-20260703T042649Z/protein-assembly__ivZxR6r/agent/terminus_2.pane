[?2004hroot@6df22992c450:/app# python3 - <<'PY'
[?2004l[?2004h> import urllib.request, urllib.parse, json, time
[?2004l[?2004h> 
[?2004l[?2004h> # BLAST the antibody heavy chain variable region via NCBI URL API
[?2004l[?2004h> heavy = "QVQLQQSAAELARPGASVKMSCKASGYSFTTYTIHWVKQRPGQGLEWIGYINPSSGYAAYNQNFKDETTLTADPSSSTAYMELNSLTSEDSAVYYCAREKFYGYDYWGQGATLTVSS"
[?2004l[?2004h> light = "DVLMTQIPLSLPVSLGDQASISCRSSQSIVHRNGNTYLEWYLLKPGQSPKLLIYKVSNRFSGVPDRFSGSGSGTDFTLKISRVEAEDLGVYYCFQGSHVPYTFGGGTKLEIR"
[?2004l[?2004h> 
[?2004l[?2004h> for name, seq in [('heavy_v', heavy), ('light_v', light)]:
[?2004l[?2004h>     params = urllib.parse.urlencode({
[?2004l[?2004h>         'CMD': 'Put',
[?2004l[?2004h>         'PROGRAM': 'blastp',
[?2004l[?2004h>         'DATABASE': 'nr',
[?2004l[?2004h>         'QUERY': seq,
[?2004l[?2004h>         'HITLIST_SIZE': '10',
[?2004l[?2004h>         'EXPECT': '0.001',
[?2004l[?2004h>     })
[?2004l[?2004h>     url = 'https://blast.ncbi.nlm.nih.gov/blast/Blast.cgi?' + params
[?2004l[?2004h>     try:
[?2004l[?2004h>         req = urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0'})
[?2004l[?2004h>         with urllib.request.urlopen(req, timeout=30) as r:
[?2004l[?2004h>             html = r.read().decode(errors='replace')
[?2004l[?2004h>         # Extract RID
[?2004l[?2004h>         import re
[?2004l[?2004h>         m = re.search(r'RID = (\S+)', html)
[?2004l[?2004h>         if m:
[?2004l[?2004h>             print(f"{name}: RID={m.group(1)}")
[?2004l[?2004h>         else:
[?2004l[?2004h>             print(f"{name}: no RID found, html snippet:")
[?2004l[?2004h>             print(html[:500])
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"{name}: ERROR {e}")
[?2004l[?2004h>     time.sleep(1)
[?2004l[?2004h> PY
