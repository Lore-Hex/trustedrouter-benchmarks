[?2004l[?2004h>         title = data.get('struct',{}).get('title','')
[?2004l[?2004h>         pdb_desc = data.get('pdbx_database_status',{}).get('recvd_initial_deposition_date','')
[?2004l[?2004h>         # Get polymer entity info
[?2004l[?2004h>         print(f"\n--- {pid} ---")
[?2004l[?2004h>         print(f"Title: {title}")
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"\n--- {pid} ERROR: {e} ---")
