[?2004hroot@6df22992c450:/app# python3 - <<'PY'
[?2004l[?2004h> import json, re, urllib.request, time
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Search fpbase for em_max=610 with PDB IDs in our list
[?2004l[?2004h> proteins = json.load(open('/app/fpbase_proteins.json'))
[?2004l[?2004h> pdb_ids = set(open('/app/pdb_ids.txt').read().split())
[?2004l[?2004h> 
[?2004l[?2004h> print("=== FPbase proteins with em_max=610 AND PDB in our list ===")
[?2004l[?2004h> for p in proteins:
[?2004l[?2004h>     for s in p.get('states',[]):
[?2004l[?2004h>         if s.get('em_max') == 610:
[?2004l[?2004h>             pbs = set(str(x).upper() for x in p.get('pdb',[]))
[?2004l[?2004h>             common = pbs & pdb_ids
[?2004l[?2004h>             if common:
[?2004l[?2004h>                 print(f"  MATCH: name={p['name']}, slug={p['slug']}, pdb={p.get('pdb')}, ex={s.get('ex_max')}, em={s.get('em_max')}")
[?2004l[?2004h>                 print(f"  seq={p.get('seq','')}")
[?2004l[?2004h>                 print(f"  seq_len={len(p.get('seq',''))}")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== ALL FPbase proteins with em_max=610 (first 30) ===")
[?2004l[?2004h> count = 0
[?2004l[?2004h> for p in proteins:
[?2004l[?2004h>     for s in p.get('states',[]):
[?2004l[?2004h>         if s.get('em_max') == 610:
[?2004l[?2004h>             print(f"  name={p['name']}, slug={p['slug']}, pdb={p.get('pdb',[])}, ex={s.get('ex_max')}, em={s.get('em_max')}")
[?2004l[?2004h>             count += 1
[?2004l[?2004h>             if count >= 30:
[?2004l[?2004h>                 break
[?2004l[?2004h>     if count >= 30:
[?2004l[?2004h>         break
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Check fpbase for mCherry specifically
[?2004l[?2004h> print("\n=== FPbase entries named mCherry or with pdb 2H5Q ===")
[?2004l[?2004h> for p in proteins:
[?2004l[?2004h>     if p['name'].lower() == 'mcherry' or '2H5Q' in [str(x).upper() for x in p.get('pdb',[])]:
[?2004l[?2004h>         states = [(s.get('ex_max'), s.get('em_max'), s.get('slug')) for s in p.get('states',[])]
[?2004l[?2004h>         print(f"  name={p['name']}, slug={p['slug']}, pdb={p.get('pdb',[])}, states={states}")
[?2004l[?2004h>         print(f"  seq={p.get('seq','')}")
[?2004l[?2004h>         print(f"  seq_len={len(p.get('seq',''))}")
[?2004l[?2004h> 
[?2004l[?2004h> # 3. Retrieve BLAST results
[?2004l[?2004h> rids = {'heavy_v':'4EEM8H02014', 'light_v':'4EEMAE00014'}
[?2004l[?2004h> for name, rid in rids.items():
[?2004l[?2004h>     for attempt in range(4):
[?2004l[?2004h>         url = f"https://blast.ncbi.nlm.nih.gov/blast/Blast.cgi?CMD=Get&RID={rid}&FORMAT_TYPE=XML&ALIGNMENTS=20"
[?2004l[?2004h>         try:
[?2004l[?2004h>             req = urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0'})
[?2004l[?2004h>             with urllib.request.urlopen(req, timeout=30) as r:
[?2004l[?2004h>                 data = r.read().decode(errors='replace')
[?2004l[?2004h>             if 'Status=WAITING' in data or 'Status=QUEUED' in data or 'Status=PENDING' in data or 'Status=UNKNOWN' in data:
[?2004l[?2004h>                 print(f"\n{name}: RID={rid} still waiting (attempt {attempt+1})")
[?2004l[?2004h>                 time.sleep(8)
[?2004l[?2004h>                 continue
[?2004l[?2004h>             # Parse XML for hit descriptions
[?2004l[?2004h>             hits = re.findall(r'<Hit_def>(.*?)</Hit_def>', data, re.DOTALL)
[?2004l[?2004h>             hit_ids = re.findall(r'<Hit_id>(.*?)</Hit_id>', data, re.DOTALL)
[?2004l[?2004h>             accessions = re.findall(r'<Hit_accession>(.*?)</Hit_accession>', data, re.DOTALL)
[?2004l[?2004h>             print(f"\n=== {name} BLAST hits ===")
[?2004l[?2004h>             for i, (hid, hdef, acc) in enumerate(zip(hit_ids, hits, accessions)):
[?2004l[?2004h>                 hdef_clean = re.sub(r'<[^>]+>', '', hdef)
[?2004l[?2004h>                 print(f"  {i+1}. {acc}: {hdef_clean[:150]}")
[?2004l[?2004h>                 if i >= 15:
[?2004l[?2004h>                     break
[?2004l[?2004h>             break
[?2004l[?2004h>         except Exception as e:
[?2004l[?2004h>             print(f"\n{name}: ERROR {e}")
[?2004l[?2004h>             time.sleep(5)
[?2004l[?2004h> 
[?2004l[?2004h> # 4. Compare fpbase vs PDB sequences for Clover and mCherry
[?2004l[?2004h> print("\n=== Sequence comparison ===")
[?2004l[?2004h> pdb_fastas = {}
[?2004l[?2004h> text = open('/app/pdb_fastas.txt').read()
[?2004l[?2004h> for m in re.finditer(r'>(\S+)_\d+\|([^\n]*)\n([A-Z\n]+)', text):
[?2004l[?2004h>     pid = m.group(1)
[?2004l[?2004h>     desc = m.group(2)
[?2004l[?2004h>     seq = m.group(3).replace('\n','')
[?2004l[?2004h>     if pid not in pdb_fastas:
[?2004l[?2004h>         pdb_fastas[pid] = []
[?2004l[?2004h>     pdb_fastas[pid].append((desc, seq))
[?2004l[?2004h> 
[?2004l[?2004h> for pid in ['5WJ2', '2H5Q', '3KZY']:
[?2004l[?2004h>     print(f"\nPDB {pid}:")
[?2004l[?2004h>     for desc, seq in pdb_fastas.get(pid, []):
[?2004l[?2004h>         print(f"  desc: {desc}")
[?2004l[?2004h>         print(f"  seq: {seq}")
[?2004l[?2004h>         print(f"  len: {len(seq)}")
[?2004l[?2004h> 
[?2004l[?2004h> # fpbase sequences
[?2004l[?2004h> for pname in ['Clover', 'mCherry']:
[?2004l[?2004h>     for p in proteins:
[?2004l[?2004h>         if p['name'] == pname:
[?2004l[?2004h>             print(f"\nfpbase {pname}:")
[?2004l[?2004h>             print(f"  seq: {p.get('seq','')}")
[?2004l[?2004h>             print(f"  len: {len(p.get('seq',''))}")
[?2004l[?2004h>             break
