405:void doomgeneric_Tick()
406:{
407:    // frame syncronous IO operations
408:    I_StartFrame ();
409:
410:    TryRunTics (); // will run at least one tic
411:
412:    S_UpdateSounds (players[consoleplayer].mo);// move positional sounds
413:
414:    // Update display, next frame, with current state.
415:    if (screenvisible)
416:    {
417:        D_Display ();
418:    }
419:}
420:
421://
422://  D_DoomLoop
423://
424:void D_DoomLoop (void)
425:{
426:    if (bfgedition &&
427:        (demorecording || (gameaction == ga_playdemo) || netgame))
428:    {
429:        printf(" WARNING: You are playing using one of the Doom Classic\n"
430:               " IWAD files shipped with the Doom 3: BFG Edition. These are\n"
431:               " known to be incompatible with the regular IWAD files and\n"
432:               " may cause demos and network games to get out of sync.\n");
433:    }
434:
435:    if (demorecording)
436:    	G_BeginRecording ();
437:
438:    main_loop_started = true;
439:
440:    TryRunTics();
441:
442:    I_SetWindowTitle(gamedescription);
443:    I_GraphicsCheckCommandLine();
444:    I_SetGrabMouseCallback(D_GrabMouseCallback);
445:    I_InitGraphics();
446:    I_EnableLoadingDisk();
447:
448:    V_RestoreBuffer();
449:    R_ExecuteSetViewSize();
450:
451:    D_StartGameLoop();
452:
453:    if (testcontrols)
454:    {
455:        wipegamestate = gamestate;
456:    }
457:
458:    doomgeneric_Tick();
459:}
