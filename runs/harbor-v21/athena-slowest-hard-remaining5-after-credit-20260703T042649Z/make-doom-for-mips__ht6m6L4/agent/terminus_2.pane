   163	void DG_Init()
   164	{
   165	    memset(s_KeyQueue, 0, KEYQUEUE_SIZE * sizeof(unsigned short));
   166	    // No X11 initialization needed
   167	    printf("DoomGeneric initialized. Frames will be saved to /tmp/frame.bmp\n");
   168	}
