      "keystrokes": "python3 - <<'PY' > /app/prompt6_groups.txt\nimport re\nlines=open('/app/prompt_ocr6.txt').read().splitlines()\nents=[]\nfor i,l in enumerate(lines,1):\n    m=re.match(r'(\\d+)\\s+(.*)', l)\n    if not m: continue\n    fr=int(m.group(1)); txt=m.group(2).strip()\n    ents.append((fr,txt))\n\ndef clean(t):\n    t=t.replace('_','').strip()\n    if t.startswith('>'): t=t[1:].strip()\n    # remove trailing cursor artifacts\n    t=t.rstrip('[]|').strip()\n    return t.strip()\n\ndef has_letter(t):\n    return bool(re.search(r'[A-Za-z]', t))\n\ngroups=[]\ncur=[]\nlastfr=None\nfor fr,txt in ents:\n    c=clean(txt)\n    if txt.startswith('>') and has_letter(c):\n        if cur and lastfr is not None and fr-lastfr>6:\n            groups.append(cur); cur=[]\n        cur.append((fr,txt,c))\n        lastfr=fr\n    else:\n        if cur:\n            groups.append(cur); cur=[]\n        lastfr=fr\nif cur: groups.append(cur)\n\nprint('groups',len(groups))\nfor idx,g in enumerate(groups,1):\n    frs=[x[0] for x in g]\n    longest=max(g,key=lambda x:len(x[2]))\n    print(f'{idx:03d} [{frs[0]:04d}-{frs[-1]:04d}] candidate={longest[2]!r}')\n    print('   '+' | '.join(f'{fr}:{c!r}' for fr,raw,c in g))\nPY\n",
